@inject AppState State
@inject IJSRuntime JS
@implements IDisposable

@{
    var trip = SelectedTrip;
}
@if (trip is null)
{
    <div class="section-header" style="margin-top:12px">
        <span class="section-title">Holiday Planning</span>
        <button class="btn btn-secondary btn-sm" @onclick='() => _newTripDraft = new Trip()'>+ Add</button>
    </div>

    @if (!State.Trips.Any())
    {
        <div class="empty-state" style="margin-top:40px">
            <span>No holidays planned yet. Tap "+ Add" to start dates, schedules, budgets, and checklists.</span>
        </div>
    }
    else
    {
        var nextTrip = State.Trips
            .Where(t => t.StartDate is not null && t.StartDate.Value.Date >= DateTime.Today)
            .OrderBy(t => t.StartDate)
            .FirstOrDefault();
        var plannedTotal = State.Trips.Sum(PlannedTotal);
        var paidTotal = State.Trips.Sum(PaidTotal);

        <div class="metric-strip">
            <div>
                <span>Planned</span>
                <strong>@plannedTotal.ToString("C")</strong>
            </div>
            <div>
                <span>Paid</span>
                <strong>@paidTotal.ToString("C")</strong>
            </div>
            <div>
                <span>Next</span>
                <strong>@(nextTrip is null ? "-" : DaysUntil(nextTrip).ToString())d</strong>
            </div>
        </div>

        <div class="list-card">
            @foreach (var t in State.Trips.OrderBy(t => t.StartDate ?? DateTime.MaxValue))
            {
                var budgetTotal = PlannedTotal(t);
                var paid = PaidTotal(t);
                var saved = SavingsBalance(t);
                var funded = Math.Min(paid + saved, budgetTotal);
                var progress = budgetTotal > 0 ? Math.Clamp(funded / budgetTotal, 0, 1) : 0;
                var remaining = Math.Max(budgetTotal - funded, 0);
                <div style="padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer" @onclick="() => _selectedTripId = t.Id">
                    <div style="display:flex;align-items:center;gap:10px">
                        <div style="flex:1">
                            <div style="font-size:15px;font-weight:600">@t.Name</div>
                            @if (!string.IsNullOrWhiteSpace(t.Destination))
                            {
                                <div style="font-size:12px;color:var(--text3)">@t.Destination</div>
                            }
                        </div>
                        @if (budgetTotal > 0)
                        {
                            <div style="text-align:right">
                                <div style="font-size:15px;font-weight:600">@budgetTotal.ToString("C")</div>
                                <div style="font-size:11px;color:var(--text3)">@remaining.ToString("C") left</div>
                            </div>
                        }
                    </div>
                    @if (t.StartDate is not null || t.EndDate is not null)
                    {
                        <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text3);margin-top:6px">
                            <span>@FormatDateRange(t.StartDate, t.EndDate)</span>
                            @if (t.StartDate is not null)
                            {
                                <span>@DaysUntil(t)d to go</span>
                            }
                        </div>
                    }
                    @if (budgetTotal > 0)
                    {
                        <div class="progress-bar" style="margin-top:8px">
                            <div class="progress-fill" style="width:@((int)(progress * 100))%;background:var(--teal)"></div>
                        </div>
                        <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:3px">
                            <span>@funded.ToString("C") funded</span>
                            <span>@progress.ToString("P0")</span>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div style="height:16px"></div>
}
else
{
    <div class="back-row" @onclick="() => _selectedTripId = null" role="button" aria-label="Holidays">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"/>
        </svg>
        <span>Holidays</span>
    </div>

    var plannedTotal = trip.BudgetItems.Sum(b => b.PlannedDollars);
        var paidTotal = trip.BudgetItems.Where(b => b.Paid).Sum(b => b.ActualDollars > 0 ? b.ActualDollars : b.PlannedDollars);
        var remainingTotal = Math.Max(plannedTotal - paidTotal, 0);
        var savingsAccount = trip.SavingsAccountId is null ? null : State.Accounts.FirstOrDefault(a => a.Id == trip.SavingsAccountId.Value);
        var savingsBalance = savingsAccount is null ? 0 : Math.Max(State.GetAccountBalance(savingsAccount.Id), 0);
        var fundedTotal = Math.Min(paidTotal + savingsBalance, plannedTotal);
        var remainingToSave = Math.Max(plannedTotal - paidTotal - savingsBalance, 0);
        int? daysToGo = trip.StartDate is null ? null : Math.Max((trip.StartDate.Value.Date - DateTime.Today).Days, 0);
        int? tripDays = trip.StartDate is null || trip.EndDate is null ? null : Math.Max((trip.EndDate.Value.Date - trip.StartDate.Value.Date).Days + 1, 1);
        var weeklyNeeded = daysToGo is null or 0 ? remainingToSave : Math.Ceiling((remainingToSave / Math.Max(daysToGo.Value / 7m, 1m)) * 100m) / 100m;
        var spareAfterSaving = State.BudgetLeftover - weeklyNeeded;
        var dailyGuide = tripDays is > 0 ? remainingTotal / tripDays.Value : 0m;
        var checklistProgress = trip.Checklist.Count == 0 ? 0 : (decimal)trip.Checklist.Count(c => c.Done) / trip.Checklist.Count;
        var outstandingTasks = trip.Checklist.Count(c => !c.Done);
        var nextPlan = trip.Itinerary.Where(i => i.Date.Date >= DateTime.Today).OrderBy(i => i.Date).ThenBy(i => i.Time ?? string.Empty).FirstOrDefault();
        var budgetProgress = plannedTotal > 0 ? Math.Clamp(fundedTotal / plannedTotal, 0, 1) : 0;
        var fundingOptions = State.GetHolidayFundingOptions(trip);
        var spareFundingTotal = fundingOptions.Sum(o => o.SpareDollars);
        var suggestedTopUp = Math.Min(spareFundingTotal, remainingToSave);
        var tripCalendarDays = GetTripCalendarDays(trip);

    <div style="padding:12px 16px 0;display:flex;align-items:center;justify-content:space-between;gap:10px">
        <div>
            <div style="font-size:20px;font-weight:700">@trip.Name</div>
            @if (!string.IsNullOrWhiteSpace(trip.Destination))
            {
                <div style="font-size:13px;color:var(--text3);margin-top:2px">@trip.Destination</div>
            }
            @if (trip.StartDate is not null || trip.EndDate is not null)
            {
                <div style="font-size:12px;color:var(--text3);margin-top:2px">@FormatDateRange(trip.StartDate, trip.EndDate)</div>
            }
        </div>
        <button class="btn btn-secondary btn-sm" @onclick="() => _editTripDraft = trip">Edit</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(trip.Notes))
    {
        <div style="padding:10px 16px 0">
            <div style="font-size:13px;color:var(--text2);line-height:1.45;white-space:pre-wrap">@trip.Notes</div>
        </div>
    }

    <div class="metric-strip">
        <div>
            <span>To go</span>
            <strong>@(daysToGo is null ? "-" : $"{daysToGo}d")</strong>
        </div>
        <div>
            <span>Length</span>
            <strong>@(tripDays is null ? "-" : $"{tripDays}d")</strong>
        </div>
        <div>
            <span>Planned</span>
            <strong>@plannedTotal.ToString("C")</strong>
        </div>
    </div>

    <div style="padding:0 16px 0">
        <div class="card" style="margin-top:12px">
            <div style="font-size:12px;color:var(--text3);margin-bottom:10px">Holiday Readiness</div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                <span style="color:var(--text3)">Funded</span>
                <span style="font-weight:700">@fundedTotal.ToString("C") of @plannedTotal.ToString("C")</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" style="width:@((int)(budgetProgress * 100))%;background:var(--teal)"></div>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:3px">
                <span>@budgetProgress.ToString("P0") funded</span>
                <span>@remainingToSave.ToString("C") left to save</span>
            </div>
            <div style="border-top:1px solid var(--border);margin-top:10px;padding-top:10px;display:flex;justify-content:space-between;font-size:13px">
                <span style="color:var(--text3)">Suggested saving</span>
                <span style="font-weight:700;color:@(spareAfterSaving >= 0 ? "var(--green)" : "var(--red)")">@weeklyNeeded.ToString("C")/wk</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-top:5px">
                <span style="color:var(--text3)">Spare after that</span>
                <span style="font-weight:700;color:@(spareAfterSaving >= 0 ? "var(--green)" : "var(--red)")">@spareAfterSaving.ToString("C")/wk</span>
            </div>
            @if (trip.WeeklyContributionDollars > 0 || savingsAccount is not null)
            {
                <div style="border-top:1px solid var(--border);margin-top:10px;padding-top:10px;display:flex;justify-content:space-between;font-size:13px">
                    <span style="color:var(--text3)">Tracked transfer</span>
                    <span style="font-weight:700;color:var(--teal)">@trip.WeeklyContributionDollars.ToString("C")/wk</span>
                </div>
                @if (savingsAccount is not null)
                {
                    <div style="display:flex;justify-content:space-between;font-size:13px;margin-top:5px">
                        <span style="color:var(--text3)">@savingsAccount.Name balance</span>
                        <span style="font-weight:700">@savingsBalance.ToString("C")</span>
                    </div>
                }
            }
            @if (dailyGuide > 0)
            {
                <div style="display:flex;justify-content:space-between;font-size:13px;margin-top:5px">
                    <span style="color:var(--text3)">Trip-day guide</span>
                    <span style="font-weight:700">@dailyGuide.ToString("C")/day</span>
                </div>
            }
            <div style="border-top:1px solid var(--border);margin-top:10px;padding-top:10px;display:flex;justify-content:space-between;font-size:13px">
                <span style="color:var(--text3)">Outstanding tasks</span>
                <span style="font-weight:700;color:@(outstandingTasks == 0 ? "var(--green)" : "var(--amber)")">@outstandingTasks</span>
            </div>
            @if (nextPlan is not null)
            {
                <div style="display:flex;justify-content:space-between;gap:12px;font-size:13px;margin-top:5px">
                    <span style="color:var(--text3)">Next scheduled</span>
                    <span style="font-weight:700;text-align:right">@nextPlan.Date.ToString("dd MMM") - @nextPlan.Title</span>
                </div>
            }
        </div>

        <div class="card" style="margin-top:12px;border-color:@(suggestedTopUp > 0 ? "rgba(52,211,153,0.35)" : "var(--border)")">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px">
                <div>
                    <div style="font-size:12px;color:var(--text3)">Smart Funding</div>
                    <div style="font-size:18px;font-weight:700;color:@(suggestedTopUp > 0 ? "var(--green)" : "var(--text)")">
                        @(suggestedTopUp > 0 ? $"{suggestedTopUp:C} available" : "No safe top-up found")
                    </div>
                </div>
                @if (remainingToSave > 0)
                {
                    <div style="text-align:right">
                        <div style="font-size:11px;color:var(--text3)">Still needed</div>
                        <div style="font-size:15px;font-weight:700">@remainingToSave.ToString("C")</div>
                    </div>
                }
            </div>
            <div style="font-size:12px;color:var(--text3);line-height:1.4;margin-top:8px">
                Keeps enough aside for unpaid bills before @((fundingOptions.FirstOrDefault()?.ProtectedUntil ?? (trip.StartDate?.Date ?? DateTime.Today.AddDays(30))).ToString("dd MMM")), and protects account targets when they exist.
            </div>

            @if (fundingOptions.Any())
            {
                <div style="border-top:1px solid var(--border);margin-top:10px;padding-top:10px;display:flex;flex-direction:column;gap:8px">
                    @{
                        var remainingSuggestion = remainingToSave;
                    }
                    @foreach (var option in fundingOptions.Take(4))
                    {
                        var useAmount = Math.Min(option.SpareDollars, remainingSuggestion);
                        remainingSuggestion = Math.Max(remainingSuggestion - useAmount, 0);
                        <div style="display:flex;justify-content:space-between;gap:12px;font-size:13px">
                            <div style="min-width:0">
                                <div style="font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@option.AccountName</div>
                                <div style="font-size:11px;color:var(--text3)">
                                    @option.CurrentBalance.ToString("C") now - @option.ReservedBills.ToString("C") bills
                                    @if (option.HasTarget)
                                    {
                                        <span> - @option.TargetBalance.ToString("C") target</span>
                                    }
                                </div>
                            </div>
                            <div style="text-align:right;flex-shrink:0">
                                <div style="font-weight:800;color:var(--green)">@option.SpareDollars.ToString("C")</div>
                                @if (useAmount > 0)
                                {
                                    <div style="font-size:11px;color:var(--text3)">move @useAmount.ToString("C")</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="border-top:1px solid var(--border);margin-top:10px;padding-top:10px;font-size:12px;color:var(--text3)">
                    Other accounts are either needed for upcoming bills, protected by their targets, or below zero.
                </div>
            }
        </div>
    </div>

    <!-- Budget breakdown -->
    <div class="section-header" style="margin-top:16px">
        <span class="section-title">Budget</span>
        <button class="btn btn-secondary btn-sm" @onclick="ToggleBudgetForm">+ Add</button>
    </div>
    @if (_showBudgetForm)
    {
        <div style="padding:12px 16px;background:var(--surface);border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px">
            <input class="form-input" @bind="_newBudgetCategory" @bind:event="oninput" placeholder="Category (e.g. Flights, hotel, food)" />
            <div style="display:flex;gap:8px">
                <input class="form-input" style="flex:1" type="number" step="0.01" min="0" @bind="_newBudgetAmount" @bind:event="oninput" placeholder="Planned" />
                <input class="form-input" style="flex:1" type="number" step="0.01" min="0" @bind="_newBudgetActual" @bind:event="oninput" placeholder="Paid/spent" />
            </div>
            <input class="form-input" @bind="_newBudgetNotes" @bind:event="oninput" placeholder="Notes (booking ref, due date, link)" />
            <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text2)">
                <input type="checkbox" @bind="_newBudgetPaid" style="width:18px;height:18px;accent-color:var(--teal)" />
                Paid or booked
            </label>
            <div style="display:flex;gap:8px">
                <button class="btn btn-secondary" style="flex:1" @onclick="ToggleBudgetForm">Cancel</button>
                <button class="btn btn-primary" style="flex:1" @onclick="AddBudgetItem">Add</button>
            </div>
        </div>
    }
    @if (trip.BudgetItems.Any())
    {
        <div class="list-card">
            @foreach (var item in trip.BudgetItems)
            {
                var displayPaid = item.ActualDollars > 0 ? item.ActualDollars : (item.Paid ? item.PlannedDollars : 0);
                @if (_editingBudgetId == item.Id)
                {
                    <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:8px">
                        <input class="form-input" @bind="_newBudgetCategory" @bind:event="oninput" placeholder="Category" />
                        <div style="display:flex;gap:8px">
                            <input class="form-input" style="flex:1" type="number" step="0.01" min="0" @bind="_newBudgetAmount" @bind:event="oninput" placeholder="Planned" />
                            <input class="form-input" style="flex:1" type="number" step="0.01" min="0" @bind="_newBudgetActual" @bind:event="oninput" placeholder="Paid/spent" />
                        </div>
                        <input class="form-input" @bind="_newBudgetNotes" @bind:event="oninput" placeholder="Notes" />
                        <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text2)">
                            <input type="checkbox" @bind="_newBudgetPaid" style="width:18px;height:18px;accent-color:var(--teal)" />
                            Paid or booked
                        </label>
                        <div style="display:flex;gap:8px">
                            <button class="btn btn-secondary" style="flex:1" @onclick="CancelBudgetEdit">Cancel</button>
                            <button class="btn btn-primary" style="flex:1" @onclick="SaveBudgetEdit">Save</button>
                        </div>
                    </div>
                }
                else
                {
                    <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px">
                        <input type="checkbox" checked="@item.Paid" @onchange="(ChangeEventArgs e) => ToggleBudgetPaid(item.Id, e)" style="width:18px;height:18px;accent-color:var(--teal)" />
                        <div style="flex:1">
                            <div style="font-size:14px;font-weight:600">@item.Category</div>
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <div style="font-size:11px;color:var(--text3);margin-top:2px">@item.Notes</div>
                            }
                        </div>
                        <div style="text-align:right">
                            <div style="font-size:14px;font-weight:700">@item.PlannedDollars.ToString("C")</div>
                            @if (displayPaid > 0)
                            {
                                <div style="font-size:11px;color:var(--green)">@displayPaid.ToString("C") paid</div>
                            }
                        </div>
                        <button class="btn btn-secondary btn-sm" @onclick="() => StartBudgetEdit(item.Id)">Edit</button>
                        <button class="btn btn-icon" @onclick="() => RemoveBudgetItem(item.Id)">x</button>
                    </div>
                }
            }
            <div style="padding:12px 16px;display:grid;grid-template-columns:1fr auto;gap:6px 12px;font-size:14px">
                <span style="color:var(--text3)">Remaining</span>
                <span style="font-weight:700">@remainingTotal.ToString("C")</span>
                <span style="color:var(--text3)">Paid/booked</span>
                <span style="font-weight:700;color:var(--green)">@paidTotal.ToString("C")</span>
            </div>
        </div>
    }
    else
    {
        <div class="list-card" style="padding:20px;text-align:center;color:var(--text3);font-size:13px">
            No budget items yet. Add flights, accommodation, spending money, insurance, transfers, and activities.
        </div>
    }

    <!-- Calendar -->
    <div class="section-header" style="margin-top:16px">
        <span class="section-title">Calendar</span>
    </div>
    <div style="padding:0 16px">
        <div class="budget-calendar" style="margin-top:0">
            <div class="budget-calendar-head">
                <div>
                    <div style="font-size:12px;color:var(--text3)">Holiday Calendar</div>
                    <div style="font-size:16px;font-weight:700">@GetTripCalendarTitle(trip)</div>
                </div>
                <div style="font-size:11px;color:var(--text3);text-align:right">
                    @tripCalendarDays.Count date@(tripCalendarDays.Count == 1 ? "" : "s")
                </div>
            </div>
            <div class="holiday-calendar-list">
                @foreach (var day in tripCalendarDays)
                {
                    <div class="holiday-calendar-day @(day.Date.Date == DateTime.Today ? "is-today" : "")">
                        <div class="holiday-calendar-date">
                            <span>@day.Date.ToString("ddd").ToUpper()</span>
                            <strong>@day.Date.ToString("dd MMM")</strong>
                        </div>
                        @if (day.Activities.Any())
                        {
                            <div class="holiday-calendar-activities">
                                @foreach (var activity in day.Activities)
                                {
                                    <div class="holiday-activity-chip @activity.TimeClass">
                                        @if (!string.IsNullOrWhiteSpace(activity.TimeRange))
                                        {
                                            <span>@activity.TimeRange</span>
                                        }
                                        <strong>@activity.Title</strong>
                                        @if (activity.Amount > 0)
                                        {
                                            <em>@activity.Amount.ToString("C")</em>
                                        }
                                    </div>
                                }
                            </div>
                            @if (day.TotalAmount > 0)
                            {
                                <div class="holiday-day-total">@day.TotalAmount.ToString("C") total</div>
                            }
                        }
                        else
                        {
                            <div class="holiday-calendar-empty">No activities yet</div>
                        }
                    </div>
                }
            </div>
            <div class="forecast-legend" style="padding:10px 12px;border-top:1px solid var(--border);margin-top:0">
                <span style="--legend-color:var(--green)">Morning</span>
                <span style="--legend-color:var(--blue)">Afternoon</span>
                <span style="--legend-color:var(--purple)">Evening</span>
            </div>
        </div>
    </div>

    <!-- Itinerary -->
    <div class="section-header" style="margin-top:16px">
        <span class="section-title">Schedule</span>
        <button class="btn btn-secondary btn-sm" @onclick="ToggleItineraryForm">+ Add</button>
    </div>
    @if (_showItineraryForm)
    {
        <div style="padding:12px 16px;background:var(--surface);border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px">
            <input class="form-input" type="date" @bind="_newItineraryDate" @bind:event="oninput" />
            <div style="display:flex;gap:8px;align-items:center">
                <input class="form-input" style="flex:1" type="time" value="@_newItineraryTime" @oninput="(ChangeEventArgs e) => _newItineraryTime = e.Value?.ToString()" />
                <span style="color:var(--text3);font-size:12px">to</span>
                <input class="form-input" style="flex:1" type="time" value="@_newItineraryEndTime" @oninput="(ChangeEventArgs e) => _newItineraryEndTime = e.Value?.ToString()" />
            </div>
            <input class="form-input" @bind="_newItineraryTitle" placeholder="e.g. Flight to Tokyo" />
            <input class="form-input" type="number" step="0.01" min="0" @bind="_newItineraryAmount" placeholder="Cost (optional)" />
            <input class="form-input" @bind="_newItineraryNotes" placeholder="Notes (optional)" />
            <div style="display:flex;gap:8px">
                <button class="btn btn-secondary" style="flex:1" @onclick="ToggleItineraryForm">Cancel</button>
                <button class="btn btn-primary" style="flex:1" @onclick="AddItineraryItem">Add</button>
            </div>
        </div>
    }
    @if (trip.Itinerary.Any())
    {
        <div class="list-card">
            @foreach (var item in GetOrderedItinerary(trip))
            {
                @if (_editingItineraryId == item.Id)
                {
                    <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:8px">
                        <input class="form-input" type="date" @bind="_newItineraryDate" @bind:event="oninput" />
                        <div style="display:flex;gap:8px;align-items:center">
                            <input class="form-input" style="flex:1" type="time" value="@_newItineraryTime" @oninput="(ChangeEventArgs e) => _newItineraryTime = e.Value?.ToString()" />
                            <span style="color:var(--text3);font-size:12px">to</span>
                            <input class="form-input" style="flex:1" type="time" value="@_newItineraryEndTime" @oninput="(ChangeEventArgs e) => _newItineraryEndTime = e.Value?.ToString()" />
                        </div>
                        <input class="form-input" @bind="_newItineraryTitle" placeholder="Title" />
                        <input class="form-input" type="number" step="0.01" min="0" @bind="_newItineraryAmount" placeholder="Cost (optional)" />
                        <input class="form-input" @bind="_newItineraryNotes" placeholder="Notes" />
                        <div style="display:flex;gap:8px">
                            <button class="btn btn-secondary" style="flex:1" @onclick="CancelItineraryEdit">Cancel</button>
                            <button class="btn btn-primary" style="flex:1" @onclick="SaveItineraryEdit">Save</button>
                        </div>
                    </div>
                }
                else
                {
                    <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;gap:10px;align-items:flex-start">
                        <div style="min-width:68px">
                            <div style="font-size:12px;color:var(--text3)">@item.Date.ToString("dd MMM")</div>
                            @if (!string.IsNullOrWhiteSpace(FormatTimeRange(item.Time, item.EndTime)))
                            {
                                <div style="font-size:12px;color:var(--text3)">@FormatTimeRange(item.Time, item.EndTime)</div>
                            }
                        </div>
                        <div style="flex:1">
                            <div style="font-size:14px;font-weight:600">@item.Title</div>
                            @if (item.AmountDollars > 0)
                            {
                                <div style="font-size:11px;color:var(--green);font-weight:700;margin-top:2px">@item.AmountDollars.ToString("C")</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <div style="font-size:12px;color:var(--text3);margin-top:2px">@item.Notes</div>
                            }
                        </div>
                        <button class="btn btn-secondary btn-sm" @onclick="() => StartItineraryEdit(item.Id)">Edit</button>
                        <button class="btn btn-icon" @onclick="() => RemoveItineraryItem(item.Id)">x</button>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="list-card" style="padding:20px;text-align:center;color:var(--text3);font-size:13px">
            No schedule items yet. Add flights, check-in times, activities, bookings, and reminders.
        </div>
    }

    <!-- Checklist -->
    <div class="section-header" style="margin-top:16px">
        <span class="section-title">Checklist</span>
        <div style="display:flex;gap:6px">
            <button class="btn btn-secondary btn-sm" @onclick="ToggleChecklistTemplates">Templates</button>
            <button class="btn btn-secondary btn-sm" @onclick="ToggleChecklistForm">+ Add</button>
        </div>
    </div>
    @if (_showChecklistTemplates)
    {
        <div style="padding:12px 16px;background:var(--surface);border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px">
            <div style="font-size:12px;color:var(--text3)">Tap a pack to add its tasks — items already on your checklist are skipped.</div>
            @foreach (var pack in ChecklistTemplates)
            {
                <button class="btn btn-secondary btn-full" style="justify-content:space-between" @onclick="() => ApplyChecklistTemplate(pack.Items)">
                    <span>@pack.Name</span>
                    <span style="color:var(--text3);font-size:11px">@pack.Items.Length items</span>
                </button>
            }
        </div>
    }
    @if (_showChecklistForm)
    {
        <div style="padding:12px 16px;background:var(--surface);border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px">
            <input class="form-input" @bind="_newChecklistText" placeholder="e.g. Renew passport" />
            <input class="form-input" type="date" @bind="_newChecklistDueDate" @bind:event="oninput" />
            <div style="display:flex;gap:8px">
                <button class="btn btn-secondary" style="flex:1" @onclick="ToggleChecklistForm">Cancel</button>
                <button class="btn btn-primary" style="flex:1" @onclick="AddChecklistItem">Add</button>
            </div>
        </div>
    }
    @if (trip.Checklist.Any())
    {
        <div class="list-card">
            <div style="padding:10px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;font-size:12px;color:var(--text3)">
                <span>@checklistProgress.ToString("P0") complete</span>
                <span>@DueSoonCount(trip) due soon</span>
            </div>
            @foreach (var item in GetOrderedChecklist(trip))
            {
                @if (_editingChecklistId == item.Id)
                {
                    <div @key="item.Id" style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:8px">
                        <input class="form-input" @bind="_newChecklistText" placeholder="Task" />
                        <input class="form-input" type="date" @bind="_newChecklistDueDate" @bind:event="oninput" />
                        <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text2)">
                            <input type="checkbox" @bind="_newChecklistDone" style="width:18px;height:18px;accent-color:var(--teal)" />
                            Done
                        </label>
                        <div style="display:flex;gap:8px">
                            <button class="btn btn-secondary" style="flex:1" @onclick="CancelChecklistEdit">Cancel</button>
                            <button class="btn btn-primary" style="flex:1" @onclick="SaveChecklistEdit">Save</button>
                        </div>
                    </div>
                }
                else
                {
                    <div @key="item.Id" style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px">
                        <input type="checkbox" checked="@item.Done" @onchange="(ChangeEventArgs e) => ToggleChecklistItem(item.Id, e)" style="width:18px;height:18px;accent-color:var(--teal)" />
                        <div style="flex:1">
                            <div style="font-size:14px;text-decoration:@(item.Done ? "line-through" : "none");color:@(item.Done ? "var(--text3)" : "var(--text)")">@item.Text</div>
                            @if (item.DueDate is not null)
                            {
                                <div style="font-size:11px;color:@(item.Done ? "var(--text3)" : item.DueDate.Value.Date <= DateTime.Today.AddDays(7) ? "var(--amber)" : "var(--text3)")">Due @item.DueDate.Value.ToString("dd MMM yy")</div>
                            }
                        </div>
                        <button class="btn btn-secondary btn-sm" @onclick="() => StartChecklistEdit(item.Id)">Edit</button>
                        <button class="btn btn-icon" @onclick="() => RemoveChecklistItem(item.Id)">x</button>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="list-card" style="padding:20px;text-align:center;color:var(--text3);font-size:13px">
            No checklist items yet. Add passports, leave, packing, tickets, insurance, and pet care.
        </div>
    }

    <div style="height:16px"></div>
}

@if (_newTripDraft is not null)
{
    <AddEditTripModal Trip="@_newTripDraft"
        OnClose="() => _newTripDraft = null"
        OnSaved="@((Trip t) => { _newTripDraft = null; _selectedTripId = t.Id; })" />
}

@if (_editTripDraft is not null)
{
    <AddEditTripModal Trip="@_editTripDraft"
        OnClose="() => _editTripDraft = null"
        OnSaved="@((Trip t) => _editTripDraft = null)" />
}

@code {
    private int? _selectedTripId;
    private Trip? _newTripDraft;
    private Trip? _editTripDraft;

    protected override void OnInitialized()
    {
        State.OnTripIdAdopted += OnTripIdAdopted;
        // A background sync can briefly show a stale Trip snapshot (mid wholesale
        // reload, before the reapply step corrects it) and that's the *only* render
        // this component gets unless it reacts to OnChange — without this subscription
        // the stale snapshot just sits on screen, looking like a permanent revert, until
        // some unrelated interaction happens to trigger another render.
        State.OnChange += OnAppStateChanged;
    }

    private void OnAppStateChanged() => StateHasChanged();

    private void OnTripIdAdopted(int oldId, int newId)
    {
        if (_selectedTripId == oldId) _selectedTripId = newId;
    }

    public void Dispose()
    {
        State.OnTripIdAdopted -= OnTripIdAdopted;
        State.OnChange -= OnAppStateChanged;
    }

    private bool _showBudgetForm;
    private string _newBudgetCategory = string.Empty;
    private decimal? _newBudgetAmount;
    private decimal? _newBudgetActual;
    private bool _newBudgetPaid;
    private string _newBudgetNotes = string.Empty;
    private string? _editingBudgetId;

    private bool _showItineraryForm;
    private DateTime? _newItineraryDate;
    private string? _newItineraryTime;
    private string? _newItineraryEndTime;
    private string _newItineraryTitle = string.Empty;
    private string _newItineraryNotes = string.Empty;
    private decimal? _newItineraryAmount;
    private string? _editingItineraryId;

    private bool _showChecklistForm;
    private bool _showChecklistTemplates;
    private string _newChecklistText = string.Empty;
    private DateTime? _newChecklistDueDate;
    private bool _newChecklistDone;
    private string? _editingChecklistId;

    private static readonly (string Name, string[] Items)[] ChecklistTemplates =
    [
        ("International trip essentials", new[] { "Check passport expiry", "Travel insurance", "Notify bank of travel", "Currency / travel card", "Phone roaming or eSIM", "Power adapter", "Photocopy of documents" }),
        ("Domestic trip essentials", new[] { "Book parking or transfers", "Pet/house sitter", "Pause subscriptions/deliveries", "Pack chargers", "Check weather & pack accordingly" }),
        ("Before you fly", new[] { "Online check-in", "Print/save boarding passes", "Arrange airport transport", "Check baggage allowance" })
    ];

    private Trip? SelectedTrip => _selectedTripId is null ? null : State.Trips.FirstOrDefault(t => t.Id == _selectedTripId);

    private static decimal PlannedTotal(Trip trip) => trip.BudgetItems.Sum(b => b.PlannedDollars);
    private static decimal PaidTotal(Trip trip) => trip.BudgetItems.Where(b => b.Paid).Sum(b => b.ActualDollars > 0 ? b.ActualDollars : b.PlannedDollars);
    private decimal SavingsBalance(Trip trip)
    {
        if (trip.SavingsAccountId is null || !State.Accounts.Any(a => a.Id == trip.SavingsAccountId.Value)) return 0;
        return Math.Max(State.GetAccountBalance(trip.SavingsAccountId.Value), 0);
    }

    private static int DaysUntil(Trip trip)
    {
        if (trip.StartDate is null) return 0;
        return Math.Max((trip.StartDate.Value.Date - DateTime.Today).Days, 0);
    }

    private static string FormatDateRange(DateTime? start, DateTime? end)
    {
        if (start is not null && end is not null)
            return $"{start.Value:dd MMM} - {end.Value:dd MMM yyyy}";
        if (start is not null)
            return $"From {start.Value:dd MMM yyyy}";
        return $"Until {end!.Value:dd MMM yyyy}";
    }

    private static string FormatTimeRange(string? start, string? end)
    {
        if (string.IsNullOrWhiteSpace(start)) return string.Empty;
        return string.IsNullOrWhiteSpace(end) ? start : $"{start}–{end}";
    }

    private static string GetTripCalendarTitle(Trip trip)
    {
        var anchor = trip.StartDate ?? DateTime.Today;
        if (trip.StartDate is not null && trip.EndDate is not null && trip.StartDate.Value.Month != trip.EndDate.Value.Month)
            return $"{trip.StartDate.Value:MMM} - {trip.EndDate.Value:MMM yyyy}";
        return anchor.ToString("MMMM yyyy");
    }

    private static IEnumerable<TripItineraryItem> GetOrderedItinerary(Trip trip) =>
        trip.Itinerary
            .OrderBy(x => x.Date)
            .ThenBy(x => x.Time ?? string.Empty);

    // Caches the sort position of each item the first time a trip's checklist is
    // viewed (unchecked-first, soonest-due-first) and only recomputes it when an
    // item is added/removed or a different trip is selected — NOT on every
    // toggle. Re-sorting live on every toggle made a just-ticked item jump to the
    // bottom immediately, with a different (still-unchecked) item sliding into
    // the screen position the user was watching — indistinguishable, at a glance,
    // from the tick having silently reverted.
    private static IEnumerable<TripChecklistItem> GetOrderedChecklist(Trip trip) =>
        trip.Checklist
            .OrderBy(x => x.Done)
            .ThenBy(x => x.DueDate ?? DateTime.MaxValue)
            .ThenBy(x => x.Text, StringComparer.OrdinalIgnoreCase);

    private static int DueSoonCount(Trip trip) =>
        trip.Checklist.Count(c => !c.Done && c.DueDate is not null && c.DueDate.Value.Date <= DateTime.Today.AddDays(7));

    private static List<TripCalendarDay> GetTripCalendarDays(Trip trip)
    {
        var start = trip.StartDate?.Date ?? DateTime.Today;
        var end = (trip.EndDate ?? trip.StartDate ?? DateTime.Today).Date;
        if (end < start) end = start;
        var result = new List<TripCalendarDay>();

        for (var date = start; date <= end; date = date.AddDays(1))
        {
            var activities = trip.Itinerary
                .Where(x => x.Date.Date == date.Date)
                .OrderBy(x => x.Time ?? string.Empty)
                .Select(x => new TripCalendarActivity(FormatTimeRange(x.Time, x.EndTime), x.Title, x.AmountDollars, GetActivityTimeClass(x.Time)))
                .ToList();

            result.Add(new TripCalendarDay(date, activities, activities.Sum(x => x.Amount)));
        }

        return result;
    }

    private static string GetActivityTimeClass(string? time)
    {
        if (!TimeSpan.TryParse(time, out var parsed)) return "time-any";
        if (parsed.Hours < 12) return "time-morning";
        if (parsed.Hours < 17) return "time-afternoon";
        return "time-evening";
    }

    private sealed record TripCalendarDay(DateTime Date, List<TripCalendarActivity> Activities, decimal TotalAmount);
    private sealed record TripCalendarActivity(string? TimeRange, string Title, decimal Amount, string TimeClass);

    private void ToggleBudgetForm()
    {
        _showBudgetForm = !_showBudgetForm;
        _editingBudgetId = null;
        ResetBudgetDraft();
    }

    private async Task AddBudgetItem()
    {
        var trip = SelectedTrip;
        if (trip is null || string.IsNullOrWhiteSpace(_newBudgetCategory)) return;

        await State.AddBudgetItemAsync(trip.Id, new TripBudgetItem
        {
            Category = _newBudgetCategory.Trim(),
            PlannedDollars = _newBudgetAmount ?? 0,
            ActualDollars = _newBudgetActual ?? 0,
            Paid = _newBudgetPaid || (_newBudgetActual ?? 0) > 0,
            Notes = string.IsNullOrWhiteSpace(_newBudgetNotes) ? null : _newBudgetNotes.Trim()
        });
        ToggleBudgetForm();
    }

    private async Task StartBudgetEdit(string id)
    {
        var trip = SelectedTrip;
        var item = trip?.BudgetItems.FirstOrDefault(b => b.Id == id);
        if (trip is null || item is null) return;
        _showBudgetForm = false;
        _editingBudgetId = id;
        _newBudgetCategory = item.Category;
        _newBudgetAmount = item.PlannedDollars;
        _newBudgetActual = item.ActualDollars;
        _newBudgetPaid = item.Paid;
        _newBudgetNotes = item.Notes ?? string.Empty;
        // Swapping the read-only row for the (taller) edit form grows .page-content's
        // content height with no user-gesture-attached repaint of WKWebView's
        // compositor — the same WKWebView quirk nudgeRepaint already works around on
        // resume/sync. Left unrepaired here, WKWebView's cached scrollHeight goes
        // stale right as editing starts, which is what's behind both the visible
        // jump on opening the form and the scroll lock that follows it.
        await RepairScrollAfterKeyboardAsync();
    }

    private async Task SaveBudgetEdit()
    {
        var trip = SelectedTrip;
        if (trip is null || _editingBudgetId is null || string.IsNullOrWhiteSpace(_newBudgetCategory)) return;
        var editingId = _editingBudgetId;
        var category = _newBudgetCategory.Trim();
        var planned = _newBudgetAmount ?? 0;
        var actual = _newBudgetActual ?? 0;
        var paid = _newBudgetPaid || actual > 0;
        var notes = string.IsNullOrWhiteSpace(_newBudgetNotes) ? null : _newBudgetNotes.Trim();
        var item = trip.BudgetItems.FirstOrDefault(b => b.Id == editingId);
        if (item is not null)
        {
            item.Category = category;
            item.PlannedDollars = planned;
            item.ActualDollars = actual;
            item.Paid = paid;
            item.Notes = notes;
        }
        await CancelBudgetEdit();

        await State.SaveTripSnapshotAsync(trip);
    }

    private async Task CancelBudgetEdit()
    {
        _editingBudgetId = null;
        ResetBudgetDraft();
        await RepairScrollAfterKeyboardAsync();
    }

    private void ResetBudgetDraft()
    {
        _newBudgetCategory = string.Empty;
        _newBudgetAmount = null;
        _newBudgetActual = null;
        _newBudgetPaid = false;
        _newBudgetNotes = string.Empty;
    }

    private async Task ToggleBudgetPaid(string id, ChangeEventArgs e)
    {
        var trip = SelectedTrip;
        if (trip is null) return;
        var paid = e.Value is bool paidValue && paidValue;
        var item = trip.BudgetItems.FirstOrDefault(b => b.Id == id);
        if (item is not null)
        {
            item.Paid = paid;
            if (!paid) item.ActualDollars = 0;
            StateHasChanged();
        }
        // Untick clears the recorded actual amount too — otherwise the row's "paid"
        // badge and the funded/remaining totals keep counting it (ActualDollars > 0
        // takes priority over Paid in the display logic) until the user reopens Edit
        // and re-saves, which is what made unticking look like it needed an extra step.
        await State.SaveTripSnapshotAsync(trip);
    }

    private async Task RemoveBudgetItem(string id)
    {
        var trip = SelectedTrip;
        if (trip is null) return;
        await State.RemoveBudgetItemAsync(trip.Id, id);
    }

    private void ToggleItineraryForm()
    {
        _showItineraryForm = !_showItineraryForm;
        _editingItineraryId = null;
        _newItineraryDate = SelectedTrip?.StartDate ?? DateTime.Today;
        _newItineraryTime = null;
        _newItineraryEndTime = null;
        _newItineraryTitle = string.Empty;
        _newItineraryNotes = string.Empty;
        _newItineraryAmount = null;
    }

    private async Task AddItineraryItem()
    {
        var trip = SelectedTrip;
        if (trip is null || string.IsNullOrWhiteSpace(_newItineraryTitle)) return;

        await State.AddItineraryItemAsync(trip.Id, new TripItineraryItem
        {
            Date = _newItineraryDate ?? DateTime.Today,
            Time = string.IsNullOrWhiteSpace(_newItineraryTime) ? null : _newItineraryTime,
            EndTime = string.IsNullOrWhiteSpace(_newItineraryEndTime) ? null : _newItineraryEndTime,
            Title = _newItineraryTitle.Trim(),
            AmountDollars = _newItineraryAmount ?? 0,
            Notes = string.IsNullOrWhiteSpace(_newItineraryNotes) ? null : _newItineraryNotes.Trim()
        });
        ToggleItineraryForm();
    }

    private async Task StartItineraryEdit(string id)
    {
        var trip = SelectedTrip;
        var item = trip?.Itinerary.FirstOrDefault(i => i.Id == id);
        if (trip is null || item is null) return;
        _showItineraryForm = false;
        _editingItineraryId = id;
        _newItineraryDate = item.Date;
        _newItineraryTime = item.Time;
        _newItineraryEndTime = item.EndTime;
        _newItineraryTitle = item.Title;
        _newItineraryNotes = item.Notes ?? string.Empty;
        _newItineraryAmount = item.AmountDollars;
        await RepairScrollAfterKeyboardAsync();
    }

    private async Task SaveItineraryEdit()
    {
        var trip = SelectedTrip;
        if (trip is null || _editingItineraryId is null || string.IsNullOrWhiteSpace(_newItineraryTitle)) return;

        await State.SaveItineraryItemAsync(trip.Id, _editingItineraryId,
            _newItineraryDate ?? DateTime.Today,
            string.IsNullOrWhiteSpace(_newItineraryTime) ? null : _newItineraryTime,
            string.IsNullOrWhiteSpace(_newItineraryEndTime) ? null : _newItineraryEndTime,
            _newItineraryTitle.Trim(),
            _newItineraryAmount ?? 0,
            string.IsNullOrWhiteSpace(_newItineraryNotes) ? null : _newItineraryNotes.Trim());
        await CancelItineraryEdit();
    }

    private async Task CancelItineraryEdit()
    {
        _editingItineraryId = null;
        _newItineraryDate = SelectedTrip?.StartDate ?? DateTime.Today;
        _newItineraryTime = null;
        _newItineraryEndTime = null;
        _newItineraryTitle = string.Empty;
        _newItineraryNotes = string.Empty;
        _newItineraryAmount = null;
        await RepairScrollAfterKeyboardAsync();
    }

    private async Task RemoveItineraryItem(string id)
    {
        var trip = SelectedTrip;
        if (trip is null) return;
        await State.RemoveItineraryItemAsync(trip.Id, id);
    }

    private void ToggleChecklistForm()
    {
        _showChecklistForm = !_showChecklistForm;
        _showChecklistTemplates = false;
        _editingChecklistId = null;
        _newChecklistText = string.Empty;
        _newChecklistDueDate = null;
        _newChecklistDone = false;
    }

    private void ToggleChecklistTemplates()
    {
        _showChecklistTemplates = !_showChecklistTemplates;
        _showChecklistForm = false;
    }

    private async Task ApplyChecklistTemplate(string[] items)
    {
        var trip = SelectedTrip;
        if (trip is null) return;

        await State.ApplyChecklistTemplateAsync(trip.Id, items);
        _showChecklistTemplates = false;
    }

    private async Task AddChecklistItem()
    {
        var trip = SelectedTrip;
        if (trip is null || string.IsNullOrWhiteSpace(_newChecklistText)) return;

        await State.AddChecklistItemAsync(trip.Id, new TripChecklistItem
        {
            Text = _newChecklistText.Trim(),
            Done = false,
            DueDate = _newChecklistDueDate
        });
        ToggleChecklistForm();
    }

    private async Task StartChecklistEdit(string id)
    {
        var trip = SelectedTrip;
        var item = trip?.Checklist.FirstOrDefault(c => c.Id == id);
        if (trip is null || item is null) return;
        _showChecklistForm = false;
        _editingChecklistId = id;
        _newChecklistText = item.Text;
        _newChecklistDueDate = item.DueDate;
        _newChecklistDone = item.Done;
        await RepairScrollAfterKeyboardAsync();
    }

    private async Task SaveChecklistEdit()
    {
        var trip = SelectedTrip;
        if (trip is null || _editingChecklistId is null || string.IsNullOrWhiteSpace(_newChecklistText)) return;

        await State.SaveChecklistItemAsync(trip.Id, _editingChecklistId,
            _newChecklistText.Trim(), _newChecklistDone, _newChecklistDueDate);
        await CancelChecklistEdit();
    }

    private async Task CancelChecklistEdit()
    {
        _editingChecklistId = null;
        _newChecklistText = string.Empty;
        _newChecklistDueDate = null;
        _newChecklistDone = false;
        await RepairScrollAfterKeyboardAsync();
    }

    // Saving/cancelling an inline edit form blurs its focused input, dismissing
    // the iOS keyboard. WKWebView frequently fails to re-attach .page-content as
    // a scrollable layer when that happens (the existing financeBlade.nudgeRepaint
    // workaround documents the same WKWebView quirk for background-sync repaints) —
    // without this, the page looks like it scrolled (keyboard collapsing) but
    // overflow-y:auto stops responding to touch until some other reflow happens.
    private async Task RepairScrollAfterKeyboardAsync()
    {
        try { await JS.InvokeVoidAsync("financeBlade.nudgeRepaint"); }
        catch (JSDisconnectedException) { }
    }

    private async Task RemoveChecklistItem(string id)
    {
        var trip = SelectedTrip;
        if (trip is null) return;
        await State.RemoveChecklistItemAsync(trip.Id, id);
    }

    private async Task ToggleChecklistItem(string id, ChangeEventArgs e)
    {
        var trip = SelectedTrip;
        if (trip is null) return;
        var done = e.Value is bool doneValue && doneValue;
        var item = trip.Checklist.FirstOrDefault(c => c.Id == id);
        if (item is not null)
        {
            item.Done = done;
            StateHasChanged();
        }
        await State.SaveTripSnapshotAsync(trip);
    }
}
