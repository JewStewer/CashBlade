@inject AppState State

@if (!State.IsLoaded)
{
    <div class="empty-state"><LoadingRings /><span>Loading…</span></div>
}
else
{
    @if (Streak > 0)
    {
        var (icon, tierLabel, tierColor) = StreakTier(Streak);
        <div style="margin:12px 16px 0;background:color-mix(in srgb, @tierColor, transparent 88%);border:1px solid color-mix(in srgb, @tierColor, transparent 65%);border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:12px">
            <div style="color:@tierColor;display:flex"><Icon Name="@icon" Size="26" StrokeWidth="1.75" /></div>
            <div style="flex:1">
                <div style="font-size:15px;font-weight:600;color:@tierColor">@Streak day streak · @tierLabel</div>
                <div style="font-size:12px;color:var(--text3)">No unnecessary spending</div>
            </div>
            @if (BestStreak > Streak)
            {
                <div style="text-align:right;flex-shrink:0">
                    <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:0.04em">Best</div>
                    <div style="font-size:15px;font-weight:700;color:var(--text)">@BestStreak</div>
                </div>
            }
        </div>
    }

    <div style="padding:14px 16px 8px;display:flex;justify-content:space-between;align-items:baseline">
        <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--text3)">@DateRangeLabel</span>
        @if (AvgScore.HasValue)
        {
            <span style="font-size:13px;color:var(--text2)">avg <strong style="color:@GradeColor(AvgScore.Value)">@AvgScore.Value%</strong></span>
        }
    </div>

    <div style="padding:0 12px">
        <div style="display:grid;grid-template-columns:repeat(7,1fr);margin-bottom:4px">
            @foreach (var h in new[] { "M", "T", "W", "T", "F", "S", "S" })
            {
                <div style="text-align:center;font-size:11px;color:var(--text3);font-weight:500;padding:2px 0">@h</div>
            }
        </div>
        <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px">
            @for (var p = 0; p < PadStart; p++)
            {
                <div></div>
            }
            @foreach (var day in Scores)
            {
                var isSelected = _selectedDay?.Date == day.Date;
                var cellStyle = "aspect-ratio:1;border-radius:7px;" + CellBg(day)
                    + ";position:relative;display:flex;align-items:center;justify-content:center;cursor:pointer;-webkit-tap-highlight-color:transparent;"
                    + (day.IsToday ? "outline:2px solid var(--teal);outline-offset:-2px;" : "")
                    + (isSelected ? "box-shadow:0 0 0 2px #fff;" : "");
                <div @onclick="() => SelectDay(day)" style="@cellStyle">
                    <span style="position:absolute;top:3px;left:4px;font-size:9px;color:@day.ColorHex">@day.Date.Day</span>
                    <span style="font-size:11px;font-weight:700;color:@day.ColorHex;margin-top:5px">@day.Grade</span>
                </div>
            }
        </div>
    </div>

    <div style="display:flex;gap:10px;padding:10px 16px;justify-content:center">
        @foreach (var (g, c) in Legend)
        {
            <div style="display:flex;align-items:center;gap:3px;font-size:11px;color:var(--text2)">
                <div style="width:9px;height:9px;border-radius:2px;background:@c"></div>@g
            </div>
        }
    </div>

    <div class="stat-grid" style="margin-top:4px">
        <div class="stat-tile">
            <div class="stat-label">Unnecessary</div>
            <div class="stat-value" style="font-size:18px;color:@(TotalUnnecessary > 0 ? "var(--red)" : "var(--green)")">@TotalUnnecessary.ToString("C")</div>
            <div class="stat-sub">last 35 days</div>
        </div>
        <div class="stat-tile">
            <div class="stat-label">Clean Days</div>
            <div class="stat-value" style="font-size:18px;color:var(--green)">@CleanCount<span style="font-size:13px;color:var(--text3)"> / @SpendingDayCount</span></div>
            <div class="stat-sub">spending days</div>
        </div>
    </div>

    <!-- Day detail panel (shown when a day cell is tapped) -->
    @if (_selectedDay is not null)
    {
        var dayTxns = State.GetTransactionsForDate(_selectedDay.Date);
        <div style="margin:12px 16px 0">
            <div class="card" style="border-color:@_selectedDay.ColorHex">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
                    <div>
                        <span style="font-size:15px;font-weight:700">@_selectedDay.Date.ToString("dddd d MMM")</span>
                        <span style="margin-left:8px;font-size:13px;font-weight:600;color:@_selectedDay.ColorHex">@_selectedDay.Grade</span>
                    </div>
                    <button @onclick="() => _selectedDay = null" style="background:transparent;border:none;color:var(--text3);padding:0 4px;cursor:pointer;display:flex"><Icon Name="x" Size="16" /></button>
                </div>
                @if (!dayTxns.Any())
                {
                    <div style="font-size:13px;color:var(--text3);text-align:center;padding:8px 0">No transactions this day.</div>
                }
                else
                {
                    @foreach (var t in dayTxns)
                    {
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
                            <div style="flex:1;min-width:0">
                                <div style="font-size:14px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;@(t.IsUnnecessary?"color:var(--amber)":"")">
                                    @t.Description
                                    @if (t.IsUnnecessary) { <span style="font-size:10px;margin-left:4px;color:var(--amber)">unnecessary</span> }
                                </div>
                                <div style="font-size:11px;color:var(--text3)">@t.CategoryName · @t.AccountName</div>
                            </div>
                            <span style="font-size:14px;font-weight:600;flex-shrink:0;color:@(t.AmountCents>=0?"var(--green)":"var(--text)")">
                                @t.AmountDollars.ToString("C")
                            </span>
                        </div>
                    }
                    <div style="border-top:1px solid var(--border);padding-top:8px;display:flex;justify-content:space-between;font-size:13px">
                        <span style="color:var(--text3)">Total spent</span>
                        <span style="font-weight:700;color:var(--red)">@_selectedDay.SpendingTotal.ToString("C")</span>
                    </div>
                    @if (_selectedDay.UnnecessaryTotal > 0)
                    {
                        <div style="display:flex;justify-content:space-between;font-size:12px;margin-top:4px">
                            <span style="color:var(--text3)">Unnecessary</span>
                            <span style="font-weight:600;color:var(--amber)">@_selectedDay.UnnecessaryTotal.ToString("C")</span>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <div style="height:16px"></div>
}

@code {
    private DailyScore? _selectedDay;

    private void SelectDay(DailyScore day)
        => _selectedDay = _selectedDay?.Date == day.Date ? null : day;

    private List<DailyScore> Scores => State.GetDailyScores(35);
    private int Streak => State.GetCleanStreak();
    private int BestStreak => State.GetBestCleanStreak();

    private static (string Icon, string Label, string Color) StreakTier(int streak) => streak switch
    {
        >= 60 => ("crown", "Legendary", "#A855F7"),
        >= 30 => ("award", "Money Master", "#FBBF24"),
        >= 14 => ("zap", "Unstoppable", "#34D399"),
        >= 7 => ("flame", "On a roll", "#6EE7B7"),
        _ => ("flame", "Streak", "var(--green)")
    };

    private int PadStart
    {
        get
        {
            if (!Scores.Any()) return 0;
            var dow = (int)Scores.First().Date.DayOfWeek;
            return (dow - 1 + 7) % 7;
        }
    }

    private int? AvgScore
    {
        get
        {
            var days = Scores.Where(d => d.HasSpending).ToList();
            return days.Any() ? (int)days.Average(d => d.Score) : null;
        }
    }

    private decimal TotalUnnecessary => Scores.Sum(d => d.UnnecessaryTotal);
    private int CleanCount => Scores.Count(d => d.SpendingTotal > 0 && d.UnnecessaryTotal == 0);
    private int SpendingDayCount => Scores.Count(d => d.SpendingTotal > 0);

    private string DateRangeLabel
    {
        get
        {
            if (!Scores.Any()) return "";
            var first = Scores.First().Date;
            var last = Scores.Last().Date;
            return first.Month == last.Month
                ? $"{first.Day}–{last.Day} {last:MMM yyyy}"
                : $"{first.Day} {first:MMM} – {last.Day} {last:MMM yyyy}";
        }
    }

    private static string CellBg(DailyScore d) =>
        $"background:{d.ColorHex}28";

    private static string GradeColor(int score) => score switch
    {
        >= 90 => "#34D399",
        >= 80 => "#6EE7B7",
        >= 60 => "#FBBF24",
        >= 40 => "#F97316",
        _ => "#F87171"
    };

    private static readonly (string Grade, string Color)[] Legend =
    [
        ("A+", "#34D399"), ("A/B", "#6EE7B7"), ("C", "#FBBF24"), ("D", "#F97316"), ("F", "#F87171")
    ];
}
