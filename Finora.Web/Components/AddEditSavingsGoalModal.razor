@inject AppState State
@inject IJSRuntime JS

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-sheet" @onclick:stopPropagation>
        <div class="modal-handle"></div>
        <div class="modal-title">@(Goal?.Id == 0 ? "Add Savings Goal" : "Edit Savings Goal")</div>

        <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
            <div>
                <label class="form-label">Name</label>
                <input class="form-input" @bind="name" placeholder="e.g. Holiday Fund" autofocus />
            </div>
            <div style="display:flex;gap:8px">
                <div style="flex:1">
                    <label class="form-label">Current Amount ($)</label>
                    <input class="form-input" type="number" step="0.01" @bind="current" @bind:event="oninput" placeholder="0.00" />
                </div>
                <div style="flex:1">
                    <label class="form-label">Target Amount ($)</label>
                    <input class="form-input" type="number" step="0.01" @bind="target" @bind:event="oninput" placeholder="0.00" />
                </div>
            </div>
            <div>
                <label class="form-label">Target Date</label>
                <input class="form-input" type="date" @bind="targetDate" @bind:event="oninput" />
            </div>
        </div>

        @if (WeeklyPreview > 0)
        {
            <div style="padding:10px 16px 0;font-size:13px;color:var(--text2)">
                Weekly amount needed: <strong style="color:var(--text)">@WeeklyPreview.ToString("C")</strong>
            </div>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
        }

        <div style="padding:14px 16px;display:flex;gap:8px">
            @if (Goal?.Id != 0)
            {
                <button class="btn btn-danger" @onclick="Delete" disabled="@saving">Delete</button>
            }
            <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
            <button class="btn btn-primary" style="flex:1" @onclick="Save" disabled="@saving">
                @(saving ? "Saving…" : (Goal?.Id == 0 ? "Add Goal" : "Save"))
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public SavingsGoal? Goal { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string name = string.Empty;
    private decimal current;
    private decimal target;
    private DateTime? targetDate;
    private string error = string.Empty;
    private bool saving;

    private decimal WeeklyPreview => CalculateWeeklyRequired(target, current, targetDate);

    protected override void OnParametersSet()
    {
        if (Goal is null) return;
        name = Goal.Name;
        current = Goal.CurrentDollars;
        target = Goal.TargetDollars;
        targetDate = Goal.TargetDate;
    }

    // Mirrors WPF's SavingsGoalWindow.CalculateWeeklyRequired so the
    // recommendation updates live as target/current/date are edited.
    private static decimal CalculateWeeklyRequired(decimal target, decimal current, DateTime? targetDate)
    {
        if (targetDate is null) return 0;
        var remaining = Math.Max(target - current, 0);
        if (remaining <= 0) return 0;
        var days = Math.Max((targetDate.Value.Date - DateTime.Today).TotalDays, 1);
        var weeks = Math.Max((decimal)days / 7m, 1m);
        return Math.Ceiling((remaining / weeks) * 100m) / 100m;
    }

    private async Task Save()
    {
        error = string.Empty;
        if (Goal is null) return;
        if (string.IsNullOrWhiteSpace(name)) { error = "Name is required."; return; }
        if (target <= 0) { error = "Target must be greater than zero."; return; }
        if (current < 0) { error = "Current amount can't be negative."; return; }

        saving = true;
        var g = new SavingsGoal
        {
            Id = Goal.Id,
            Name = name.Trim(),
            CurrentDollars = current,
            TargetDollars = target,
            TargetDate = targetDate,
            WeeklyContributionDollars = WeeklyPreview
        };

        if (Goal.Id == 0)
            await State.AddSavingsGoalAsync(g);
        else
            await State.UpdateSavingsGoalAsync(g);

        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Delete()
    {
        if (Goal is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete \"{Goal.Name}\"? This can't be undone."))
            return;

        saving = true;
        await State.DeleteSavingsGoalAsync(Goal.Id);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
