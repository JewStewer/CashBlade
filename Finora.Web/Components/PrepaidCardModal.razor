@inject AppState State

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-sheet" @onclick:stopPropagation>
        <div class="modal-handle"></div>

        @if (Card is null)
        {
            <div class="modal-title">New Card</div>
            <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
                <div>
                    <label class="form-label">Card Name</label>
                    <input class="form-input" @bind="name" @bind:event="oninput" placeholder="e.g. Eating Out" autofocus />
                </div>
                <div>
                    <label class="form-label">Linked account</label>
                    <select class="form-input" @bind="selectedAccountId">
                        @foreach (var account in State.Accounts)
                        {
                            <option value="@account.Id">@account.Name (@State.GetAccountBalance(account.Id).ToString("C"))</option>
                        }
                    </select>
                    <div style="font-size:12px;color:var(--text2);margin-top:6px">
                        For a real decline at the register, link this to a dedicated account with its own card or Apple Pay (like an Up Saver) and only keep your cap's worth of money in it.
                    </div>
                </div>
                <div>
                    <label class="form-label">Card Colour</label>
                    <div style="display:flex;gap:8px;margin-top:4px">
                        @foreach (var swatch in Swatches)
                        {
                            <button class="card-swatch @(colorHex == swatch ? "is-selected" : "")" style="background:@swatch" @onclick="() => colorHex = swatch"></button>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
            }

            <div class="modal-actions">
                <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
                <button class="btn btn-primary" style="flex:1" @onclick="CreateCard" disabled="@saving">
                    @(saving ? "Creating…" : "Create Card")
                </button>
            </div>
        }
        else
        {
            <div class="modal-title">@Card.Name</div>

            <div style="padding:14px 16px 0">
                <div class="prepaid-card-visual" style="background:linear-gradient(135deg, @Card.ColorHex, color-mix(in srgb, @Card.ColorHex, black 45%))">
                    <div class="prepaid-card-top">
                        <span>Evergrove</span>
                        <span>@LinkedAccountName</span>
                    </div>
                    <div class="prepaid-card-balance">@State.GetCardBalance(Card).ToString("C")</div>
                    <div class="prepaid-card-bottom">@Card.Name</div>
                </div>
            </div>

            @if (!confirmingDelete)
            {
                <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:10px">
                    <div style="font-size:12px;color:var(--text2)">
                        This mirrors <strong style="color:var(--text)">@LinkedAccountName</strong>'s real balance. To get an actual decline once you hit your cap, give that account its own card or Apple Pay in the Up app and only transfer in what you want as your limit — Up declines real purchases there the moment it runs out, by design, no app required.
                    </div>

                    <div>
                        <label class="form-label">Linked account</label>
                        <select class="form-input" @bind="selectedAccountId" @bind:after="Relink">
                            @foreach (var account in State.Accounts)
                            {
                                <option value="@account.Id">@account.Name (@State.GetAccountBalance(account.Id).ToString("C"))</option>
                            }
                        </select>
                    </div>

                    @if (Activity.Any())
                    {
                        <div style="margin-top:4px">
                            <div class="stat-label" style="margin-bottom:6px">Recent activity</div>
                            @foreach (var t in Activity.Take(6))
                            {
                                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                                    <span style="color:var(--text2)">@t.Description · @t.Date.ToString("dd MMM")</span>
                                    <span style="font-weight:600;color:@(t.AmountCents >= 0 ? "var(--green)" : "var(--red)")">@t.AmountDollars.ToString("C")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (confirmingDelete)
            {
                <div style="margin:14px 16px 0;padding:10px;border:1px solid var(--red);border-radius:8px;background:rgba(248,113,113,0.08)">
                    <div style="font-size:13px;font-weight:700;color:var(--red);margin-bottom:4px">Remove this card?</div>
                    <div style="font-size:12px;color:var(--text2)">This only removes the card label — @LinkedAccountName and its money are unaffected.</div>
                </div>
                <div class="modal-actions">
                    <button class="btn btn-secondary" style="flex:1" @onclick="() => confirmingDelete = false" disabled="@saving">Keep</button>
                    <button class="btn btn-danger" style="flex:1" @onclick="ConfirmDelete" disabled="@saving">
                        @(saving ? "Removing…" : "Remove")
                    </button>
                </div>
            }
            else
            {
                <div class="modal-actions">
                    <button class="btn btn-danger" @onclick="() => confirmingDelete = true" disabled="@saving">Remove</button>
                    <button class="btn btn-secondary" style="flex:1" @onclick="Close">Close</button>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public PrepaidCard? Card { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private static readonly string[] Swatches = { "#14B8A6", "#3B82F6", "#7C3AED", "#F59E0B", "#F87171", "#34D399" };

    private string name = string.Empty;
    private string colorHex = Swatches[0];
    private int selectedAccountId;
    private string error = string.Empty;
    private bool saving;
    private bool confirmingDelete;

    private List<Transaction> Activity => Card is null ? new() : State.GetCardTransactions(Card);
    private string LinkedAccountName => Card is null ? "" : State.Accounts.FirstOrDefault(a => a.Id == Card.AccountId)?.Name ?? "No account linked";

    protected override void OnParametersSet()
    {
        name = string.Empty;
        colorHex = Swatches[0];
        selectedAccountId = Card?.AccountId ?? State.Accounts.FirstOrDefault()?.Id ?? 0;
        error = string.Empty;
        confirmingDelete = false;
    }

    private async Task CreateCard()
    {
        error = string.Empty;
        if (string.IsNullOrWhiteSpace(name)) { error = "Give the card a name."; return; }
        if (selectedAccountId <= 0) { error = "Choose an account to link."; return; }

        saving = true;
        await State.AddPrepaidCardAsync(name, colorHex, selectedAccountId);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Relink()
    {
        if (Card is null || selectedAccountId <= 0 || selectedAccountId == Card.AccountId) return;
        await State.RelinkPrepaidCardAccountAsync(Card.Id, selectedAccountId);
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (Card is null) return;
        saving = true;
        await State.DeletePrepaidCardAsync(Card.Id);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
