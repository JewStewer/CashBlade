@inject AppState State
@inject IJSRuntime JS

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-card" @onclick:stopPropagation>
    <div class="modal-sheet">
        <div class="modal-handle"></div>
        <div class="modal-title">@(IsNew ? "Add Bill" : "Edit Bill")</div>

        <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
            <div>
                <label class="form-label">Name</label>
                <input class="form-input" @bind="name" placeholder="e.g. Rent" />
            </div>
            <div>
                <label class="form-label">Amount ($)</label>
                <input class="form-input" type="number" step="0.01" @bind="amount" placeholder="0.00" />
            </div>
            <div style="display:flex;gap:8px">
                <div style="flex:1">
                    <label class="form-label">@(isInstallment ? "Final Payment Date" : "Next Due Date")</label>
                    <input class="form-input" type="date" @bind="dueDate" />
                </div>
                <div style="flex:1">
                    <label class="form-label">Frequency</label>
                    <select class="form-input" @bind="frequency">
                        <option value="@BillFrequency.Weekly">Weekly</option>
                        <option value="@BillFrequency.Fortnightly">Fortnightly</option>
                        <option value="@BillFrequency.Monthly">Monthly</option>
                        <option value="@BillFrequency.Quarterly">Quarterly</option>
                        <option value="@BillFrequency.Yearly">Yearly</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="form-label">Account</label>
                <select class="form-input" @bind="accountId">
                    <option value="0">Select account…</option>
                    @foreach (var a in State.Accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Budget Category</label>
                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px">
                    @foreach (var cat in State.GetAllBudgetCategories())
                    {
                        var isActive = string.Equals(cat, budgetCategory, StringComparison.OrdinalIgnoreCase);
                        var color = CategoryColor(cat);
                        <button type="button"
                                style="padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;border:@(isActive ? $"2px solid {color}" : "2px solid transparent");background:@(isActive ? $"{color}22" : "var(--surface2)");color:@(isActive ? color : "var(--text3)")"
                                @onclick="() => budgetCategory = cat">
                            @cat
                        </button>
                    }
                    @if (!_showNewCatInput)
                    {
                        <button type="button"
                                style="padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;border:2px dashed var(--border);background:transparent;color:var(--text3)"
                                @onclick="() => _showNewCatInput = true">
                            + New
                        </button>
                    }
                </div>
                @if (_showNewCatInput)
                {
                    <div style="display:flex;gap:6px;margin-top:8px;align-items:center">
                        <input class="form-input" style="flex:1;font-size:13px" placeholder="Category name"
                               @bind="_newCatName" @bind:event="oninput"
                               @onkeydown='async e => { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newCatName)) await CreateCategoryAsync(); }' />
                        <button class="btn btn-primary btn-sm" @onclick="CreateCategoryAsync" disabled="@string.IsNullOrWhiteSpace(_newCatName)">Create</button>
                        <button class="btn btn-secondary btn-sm" @onclick='() => { _showNewCatInput = false; _newCatName = ""; }'>✕</button>
                    </div>
                }
            </div>
            <div style="display:flex;align-items:center;gap:8px;padding:2px 0">
                <input type="checkbox" id="autoPay" @bind="isAutoPay" style="width:18px;height:18px;accent-color:var(--teal)" />
                <label for="autoPay" style="font-size:14px;color:var(--text2)">Auto-pay</label>
            </div>
            @if (IsNew)
            {
                <div style="display:flex;align-items:center;gap:8px;padding:2px 0">
                    <input type="checkbox" id="isInstallment" @bind="isInstallment" style="width:18px;height:18px;accent-color:var(--teal)" />
                    <label for="isInstallment" style="font-size:14px;color:var(--text2)">Track as installment debt</label>
                </div>
                @if (isInstallment)
                {
                    <div>
                        <label class="form-label">Total installment balance ($)</label>
                        <input class="form-input" type="number" step="0.01" @bind="installmentTotal" placeholder="0.00" />
                    </div>
                    <div>
                        <label class="form-label">Payments already made</label>
                        <input class="form-input" type="number" step="1" min="0" @bind="paymentsAlreadyMade" placeholder="0" />
                        <div style="font-size:11px;color:var(--text3);margin-top:3px">How many instalments have already auto-debited</div>
                    </div>
                }
            }
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
        }
    </div>

    <div class="modal-actions">
        @if (!IsNew)
        {
            <button class="btn btn-danger" @onclick="Delete" disabled="@saving">Delete</button>
        }
        <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
        <button class="btn btn-primary" style="flex:1" @onclick="Save" disabled="@saving">
            @(saving ? "Saving…" : (IsNew ? "Add" : "Save"))
        </button>
    </div>
    </div>
</div>

@code {
    [Parameter] public Bill? Bill { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public decimal? InstallmentTotalDollars { get; set; }

    private string name = string.Empty;
    private decimal amount;
    private decimal installmentTotal;
    private DateTime dueDate = DateTime.Today;
    private BillFrequency frequency = BillFrequency.Monthly;
    private int accountId;
    private bool isAutoPay;
    private bool isInstallment;
    private int paymentsAlreadyMade;
    private string budgetCategory = "Bills";
    private bool _showNewCatInput;
    private string _newCatName = "";
    private string error = string.Empty;
    private bool saving;

    private bool IsNew => Bill is null || Bill.Id == 0;

    protected override void OnParametersSet()
    {
        if (Bill is not null)
        {
            name = Bill.Name;
            amount = Bill.AmountDollars;
            dueDate = Bill.DueDate;
            frequency = Bill.Frequency;
            accountId = Bill.AccountId != 0 ? Bill.AccountId : (State.Accounts.FirstOrDefault()?.Id ?? 0);
            isAutoPay = Bill.IsAutoPay;
            budgetCategory = State.GetBillBudgetCategory(Bill);
        }
        if (IsNew)
        {
            isInstallment = InstallmentTotalDollars is > 0;
            installmentTotal = InstallmentTotalDollars ?? 0;
            paymentsAlreadyMade = 0;
            budgetCategory = "Bills";
        }
    }

    private async Task Save()
    {
        error = string.Empty;
        if (string.IsNullOrWhiteSpace(name)) { error = "Name is required."; return; }
        if (amount <= 0) { error = "Enter a positive amount."; return; }
        if (accountId == 0) { error = "Select an account."; return; }
        if (IsNew && isInstallment && installmentTotal <= 0) { error = "Enter the total installment balance."; return; }
        if (IsNew && isInstallment && installmentTotal < amount) { error = "Total balance should be at least the bill amount."; return; }

        saving = true;

        // For regular new bills, advance the date to the next upcoming occurrence
        // to avoid phantom unpaid past rows. For installment bills the user enters
        // the FINAL payment date, which AddInstallmentBillAsync walks back to the
        // first payment — advancing it here would produce a wrong final date.
        var anchorDate = dueDate;
        if (IsNew && !isInstallment)
        {
            while (anchorDate.Date < DateTime.Today)
                anchorDate = frequency switch
                {
                    BillFrequency.Weekly      => anchorDate.AddDays(7),
                    BillFrequency.Fortnightly => anchorDate.AddDays(14),
                    BillFrequency.Quarterly   => anchorDate.AddMonths(3),
                    BillFrequency.Yearly      => anchorDate.AddYears(1),
                    _                         => anchorDate.AddMonths(1)
                };
        }

        var b = new Bill
        {
            Id = Bill?.Id ?? 0,
            Name = name.Trim(),
            AmountDollars = amount,
            DueDate = anchorDate,
            Frequency = frequency,
            AccountId = accountId,
            IsAutoPay = isAutoPay
        };

        if (IsNew)
        {
            if (isInstallment)
                await State.AddInstallmentBillAsync(b, installmentTotal, paymentsAlreadyMade);
            else
                await State.AddBillAsync(b);
        }
        else
            await State.UpdateBillAsync(b);

        // Save per-item budget category (b.Id is set by AddBillAsync for new bills)
        if (!string.Equals(budgetCategory, "Bills", StringComparison.Ordinal))
            await State.SaveSettingAsync($"BillItemBudgetCategory:{b.Id}", budgetCategory);

        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Delete()
    {
        if (Bill is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete the entire \"{Bill.Name}\" bill series? This can't be undone."))
            return;

        saving = true;
        await State.DeleteBillAsync(Bill.Id);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task CreateCategoryAsync()
    {
        var name = _newCatName.Trim();
        if (string.IsNullOrEmpty(name)) return;
        await State.AddCustomBudgetCategoryAsync(name);
        budgetCategory = name;
        _newCatName = "";
        _showNewCatInput = false;
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private static string CategoryColor(string cat) => cat switch
    {
        "Bills"      => "#10B981",
        "Essentials" => "#F59E0B",
        "Savings"    => "#8B5CF6",
        "Unplanned"  => "#94A3B8",
        _ => "#3B82F6"
    };
}
