@inject AppState State

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-sheet" @onclick:stopPropagation>
        <div class="modal-handle"></div>
        <div class="modal-title">@(IsNew ? "Add Bill" : "Edit Bill")</div>

        <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
            <div>
                <label class="form-label">Name</label>
                <input class="form-input" @bind="name" placeholder="e.g. Rent" autofocus />
            </div>
            <div>
                <label class="form-label">Amount ($)</label>
                <input class="form-input" type="number" step="0.01" @bind="amount" placeholder="0.00" />
            </div>
            <div style="display:flex;gap:8px">
                <div style="flex:1">
                    <label class="form-label">Due Date</label>
                    <input class="form-input" type="date" @bind="dueDate" />
                </div>
                <div style="flex:1">
                    <label class="form-label">Frequency</label>
                    <select class="form-input" @bind="frequency">
                        <option value="@BillFrequency.Weekly">Weekly</option>
                        <option value="@BillFrequency.Fortnightly">Fortnightly</option>
                        <option value="@BillFrequency.Monthly">Monthly</option>
                        <option value="@BillFrequency.Quarterly">Quarterly</option>
                        <option value="@BillFrequency.Yearly">Yearly</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="form-label">Account</label>
                <select class="form-input" @bind="accountId">
                    <option value="0">Select account…</option>
                    @foreach (var a in State.Accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            </div>
            <div style="display:flex;align-items:center;gap:8px;padding:2px 0">
                <input type="checkbox" id="autoPay" @bind="isAutoPay" style="width:18px;height:18px;accent-color:var(--teal)" />
                <label for="autoPay" style="font-size:14px;color:var(--text2)">Auto-pay</label>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
        }

        <div style="padding:14px 16px;display:flex;gap:8px">
            <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
            <button class="btn btn-primary" style="flex:1" @onclick="Save" disabled="@saving">
                @(saving ? "Saving…" : (IsNew ? "Add" : "Save"))
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public Bill? Bill { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string name = string.Empty;
    private decimal amount;
    private DateTime dueDate = DateTime.Today;
    private BillFrequency frequency = BillFrequency.Monthly;
    private int accountId;
    private bool isAutoPay;
    private string error = string.Empty;
    private bool saving;

    private bool IsNew => Bill is null || Bill.Id == 0;

    protected override void OnParametersSet()
    {
        if (Bill is not null)
        {
            name = Bill.Name;
            amount = Bill.AmountDollars;
            dueDate = Bill.DueDate;
            frequency = Bill.Frequency;
            accountId = Bill.AccountId != 0 ? Bill.AccountId : (State.Accounts.FirstOrDefault()?.Id ?? 0);
            isAutoPay = Bill.IsAutoPay;
        }
        else
        {
            accountId = State.Accounts.FirstOrDefault()?.Id ?? 0;
        }
    }

    private async Task Save()
    {
        error = string.Empty;
        if (string.IsNullOrWhiteSpace(name)) { error = "Name is required."; return; }
        if (amount <= 0) { error = "Enter a positive amount."; return; }
        if (accountId == 0) { error = "Select an account."; return; }

        saving = true;
        var b = new Bill
        {
            Id = Bill?.Id ?? 0,
            Name = name.Trim(),
            AmountDollars = amount,
            DueDate = dueDate,
            Frequency = frequency,
            AccountId = accountId,
            IsAutoPay = isAutoPay
        };

        if (IsNew)
            await State.AddBillAsync(b);
        else
            await State.UpdateBillAsync(b);

        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
