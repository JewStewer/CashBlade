@inject AppState State

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-sheet" @onclick:stopPropagation>
        <div class="modal-handle"></div>
        <div class="modal-title">Load Money: @(Account?.Name)</div>

        <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
            @if (Account?.LoadedBalanceCents is not null)
            {
                <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--text2)">
                    <span>Remaining to spend</span>
                    <strong style="color:@(remaining <= 0 ? "var(--red)" : "var(--text)")">@remaining.ToString("C")</strong>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width:@progressPct%;background:@(remaining <= 0 ? "var(--red)" : "var(--green)")"></div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3)">
                    <span>@((Account.LoadedBalanceDollars ?? 0).ToString("C")) loaded total</span>
                </div>
            }
            <div>
                <label class="form-label">Load more money ($)</label>
                <input class="form-input" type="number" step="0.01" @bind="loadAmount" @bind:event="oninput" placeholder="0.00" />
            </div>
            <div style="display:flex;align-items:center;gap:8px;padding:2px 0">
                <input type="checkbox" id="lockSpending" @bind="lockEnabled" style="width:18px;height:18px;accent-color:var(--amber)" />
                <label for="lockSpending" style="font-size:14px;color:var(--text2)">Lock spending once it runs out</label>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
        }

        <div class="modal-actions">
            @if (Account?.LoadedBalanceCents is not null)
            {
                <button class="btn btn-danger" @onclick="ClearEnvelope" disabled="@saving">Stop Tracking</button>
            }
            <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
            <button class="btn btn-primary" style="flex:1" @onclick="Save" disabled="@saving">
                @(saving ? "Saving…" : "Load")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public Account? Account { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private decimal loadAmount;
    private bool lockEnabled;
    private decimal remaining;
    private int progressPct;
    private string error = string.Empty;
    private bool saving;

    protected override void OnParametersSet()
    {
        if (Account is null) return;
        loadAmount = 0;
        lockEnabled = Account.LockSpendingWhenEmpty;
        remaining = State.GetEnvelopeRemainingDollars(Account);
        var loaded = Account.LoadedBalanceDollars ?? 0;
        progressPct = loaded > 0 ? (int)Math.Clamp(remaining / loaded * 100, 0, 100) : 0;
        error = string.Empty;
    }

    private async Task Save()
    {
        error = string.Empty;
        if (Account is null) return;
        if (loadAmount <= 0 && Account.LoadedBalanceCents is null)
        {
            error = "Enter an amount to load.";
            return;
        }

        saving = true;
        if (loadAmount > 0)
        {
            await State.LoadMoneyIntoAccountAsync(Account.Id, loadAmount);
        }
        if (lockEnabled != Account.LockSpendingWhenEmpty)
        {
            await State.SetLockSpendingWhenEmptyAsync(Account.Id, lockEnabled);
        }
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task ClearEnvelope()
    {
        if (Account is null) return;
        saving = true;
        await State.ClearLoadedBalanceAsync(Account.Id);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
