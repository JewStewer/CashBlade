@inject AppState State

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-sheet" @onclick:stopPropagation>
        <div class="modal-handle"></div>
        <div class="modal-title">Add Transaction</div>

        <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
            <div>
                <label class="form-label">Description</label>
                <input class="form-input" @bind="desc" placeholder="e.g. Groceries" autofocus />
            </div>
            <div>
                <label class="form-label">Amount ($)</label>
                <input class="form-input" type="number" step="0.01" @bind="amount" placeholder="0.00" />
            </div>
            <div style="display:flex;gap:8px">
                <div style="flex:1">
                    <label class="form-label">Type</label>
                    <select class="form-input" @bind="isExpense">
                        <option value="true">Expense (−)</option>
                        <option value="false">Income (+)</option>
                    </select>
                </div>
                <div style="flex:1">
                    <label class="form-label">Date</label>
                    <input class="form-input" type="date" @bind="date" />
                </div>
            </div>
            <div>
                <label class="form-label">Account</label>
                <select class="form-input" @bind="accountId">
                    <option value="0">Select account…</option>
                    @foreach (var a in State.Accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Category</label>
                <select class="form-input" @bind="categoryId">
                    <option value="0">Select category…</option>
                    @foreach (var c in State.Categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div style="display:flex;align-items:center;gap:8px;padding:2px 0">
                <input type="checkbox" id="unnecessary" @bind="unnecessary" style="width:18px;height:18px;accent-color:var(--amber)" />
                <label for="unnecessary" style="font-size:14px;color:var(--text2)">Mark as unnecessary spending</label>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
        }

        <div style="padding:14px 16px;display:flex;gap:8px">
            <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
            <button class="btn btn-primary" style="flex:1" @onclick="Save" disabled="@saving">
                @(saving ? "Saving…" : "Add")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string desc = string.Empty;
    private decimal amount;
    private bool isExpense = true;
    private DateTime date = DateTime.Today;
    private int accountId;
    private int categoryId;
    private bool unnecessary;
    private string error = string.Empty;
    private bool saving;

    protected override void OnInitialized()
    {
        accountId = State.Accounts.FirstOrDefault()?.Id ?? 0;
        categoryId = State.Categories.FirstOrDefault(c => c.Name == "Misc")?.Id
            ?? State.Categories.FirstOrDefault()?.Id ?? 0;
    }

    private async Task Save()
    {
        error = string.Empty;
        if (string.IsNullOrWhiteSpace(desc)) { error = "Description is required."; return; }
        if (amount <= 0) { error = "Enter a positive amount."; return; }
        if (accountId == 0) { error = "Select an account."; return; }
        if (categoryId == 0) { error = "Select a category."; return; }

        saving = true;
        var t = new Transaction
        {
            Date = date,
            Description = desc.Trim(),
            AmountDollars = isExpense ? -amount : amount,
            AccountId = accountId,
            CategoryId = categoryId,
            IsUnnecessary = unnecessary
        };
        await State.AddTransactionAsync(t);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
