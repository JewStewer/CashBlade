@inject AppState State

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-sheet" @onclick:stopPropagation>
        <div class="modal-handle"></div>
        <div class="modal-title">Edit Goal: @(Account?.Name)</div>

        <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
            <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--text2)">
                <span>Current balance</span>
                <strong style="color:var(--text)">@current.ToString("C")</strong>
            </div>
            <div>
                <label class="form-label">Target Amount ($)</label>
                <input class="form-input" type="number" step="0.01" @bind="target" @bind:event="oninput" placeholder="0.00" />
            </div>
            <div>
                <label class="form-label">Target Date</label>
                <input class="form-input" type="date" @bind="targetDate" @bind:event="oninput" />
            </div>
        </div>

        @if (WeeklyPreview > 0)
        {
            <div style="padding:10px 16px 0;font-size:13px;color:var(--text2)">
                Weekly amount needed: <strong style="color:var(--text)">@WeeklyPreview.ToString("C")</strong>
            </div>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
        }

        @if (confirmingDelete)
        {
            <div style="margin:14px 16px 0;padding:10px;border:1px solid var(--red);border-radius:8px;background:rgba(248,113,113,0.08)">
                <div style="font-size:13px;font-weight:700;color:var(--red);margin-bottom:4px">Remove this account goal?</div>
                <div style="font-size:12px;color:var(--text2)">This can't be undone.</div>
            </div>
            <div style="padding:14px 16px;display:flex;gap:8px">
                <button class="btn btn-secondary" style="flex:1" @onclick="CancelDelete" disabled="@saving">Keep</button>
                <button class="btn btn-danger" style="flex:1" @onclick="ConfirmDelete" disabled="@saving">
                    @(saving ? "Removing..." : "Remove")
                </button>
            </div>
        }
        else
        {
            <div style="padding:14px 16px;display:flex;gap:8px">
                <button class="btn btn-danger" @onclick="StartDelete" disabled="@saving">Remove Goal</button>
                <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
                <button class="btn btn-primary" style="flex:1" @onclick="Save" disabled="@saving">
                    @(saving ? "Saving..." : "Save")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Account? Account { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private decimal current;
    private decimal target;
    private DateTime? targetDate;
    private string error = string.Empty;
    private bool saving;
    private bool confirmingDelete;

    private decimal WeeklyPreview => GoalMath.WeeklyRequired(target, current, targetDate);

    protected override void OnParametersSet()
    {
        if (Account is null) return;
        current = State.GetAccountBalance(Account.Id);
        target = Account.TargetDollars ?? 0;
        targetDate = Account.TargetDate;
        confirmingDelete = false;
    }

    private async Task Save()
    {
        error = string.Empty;
        if (Account is null) return;
        if (target <= 0) { error = "Target must be greater than zero."; return; }

        saving = true;
        await State.UpdateAccountGoalAsync(Account.Id, target, targetDate);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private void StartDelete()
    {
        confirmingDelete = true;
        error = string.Empty;
    }

    private void CancelDelete() => confirmingDelete = false;

    private async Task ConfirmDelete()
    {
        if (Account is null) return;

        saving = true;
        await State.ClearAccountGoalAsync(Account.Id);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
