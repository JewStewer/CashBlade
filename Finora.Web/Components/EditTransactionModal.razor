@inject AppState State

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-sheet" @onclick:stopPropagation>
        <div class="modal-handle"></div>
        <div class="modal-title">Edit Transaction</div>

        <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
            <div>
                <label class="form-label">Description</label>
                <input class="form-input" @bind="desc" @bind:after="SuggestCategoryFromDescription" placeholder="e.g. Groceries" />
            </div>
            <div>
                <label class="form-label">Amount ($)</label>
                <input class="form-input" type="number" step="0.01" @bind="amount" placeholder="0.00" />
            </div>
            <div style="display:flex;gap:8px">
                <div style="flex:1">
                    <label class="form-label">Type</label>
                    <select class="form-input" @bind="isExpense">
                        <option value="true">Expense (−)</option>
                        <option value="false">Income (+)</option>
                    </select>
                </div>
                <div style="flex:1">
                    <label class="form-label">Date</label>
                    <input class="form-input" type="date" @bind="date" />
                </div>
            </div>
            <div>
                <label class="form-label">Account</label>
                <select class="form-input" @bind="accountId">
                    @foreach (var a in State.Accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Category</label>
                <select class="form-input" @bind="categoryId" @bind:after="() => categoryTouchedByUser = true">
                    @foreach (var c in State.Categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div style="display:flex;align-items:center;gap:8px;padding:2px 0">
                <input type="checkbox" id="editUnnecessary" @bind="unnecessary" style="width:18px;height:18px;accent-color:var(--amber)" />
                <label for="editUnnecessary" style="font-size:14px;color:var(--text2)">Mark as unnecessary spending</label>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
        }

        <div class="modal-actions">
            <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
            <button class="btn btn-primary" style="flex:1" @onclick="Save" disabled="@saving">
                @(saving ? "Saving…" : "Save")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Transaction Transaction { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string desc = string.Empty;
    private decimal amount;
    private bool isExpense = true;
    private DateTime date = DateTime.Today;
    private int accountId;
    private int categoryId;
    private bool categoryTouchedByUser;
    private bool unnecessary;
    private string error = string.Empty;
    private bool saving;

    protected override void OnParametersSet()
    {
        desc = Transaction.Description;
        amount = Math.Abs(Transaction.AmountDollars);
        isExpense = Transaction.AmountCents < 0;
        date = Transaction.Date;
        accountId = Transaction.AccountId;
        categoryId = Transaction.CategoryId;
        unnecessary = Transaction.IsUnnecessary;
    }

    // Only re-suggest when the description is actually edited, and only if the
    // user hasn't manually picked a category during this edit session — opening
    // Edit must never silently change an existing, intentional category.
    private void SuggestCategoryFromDescription()
    {
        if (categoryTouchedByUser) return;
        if (desc == Transaction.Description) return;
        if (State.SuggestCategoryId(desc) is int suggestedId)
        {
            categoryId = suggestedId;
        }
    }

    private async Task Save()
    {
        error = string.Empty;
        if (string.IsNullOrWhiteSpace(desc)) { error = "Description is required."; return; }
        if (amount <= 0) { error = "Enter a positive amount."; return; }

        saving = true;
        var updated = new Transaction
        {
            Id = Transaction.Id,
            Date = date,
            Description = desc.Trim(),
            AmountDollars = isExpense ? -amount : amount,
            AccountId = accountId,
            CategoryId = categoryId,
            IsUnnecessary = unnecessary,
            TransferId = Transaction.TransferId,
            UpTransactionId = Transaction.UpTransactionId
        };
        await State.UpdateTransactionFullAsync(updated);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
