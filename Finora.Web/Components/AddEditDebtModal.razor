@inject AppState State
@inject IJSRuntime JS

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-card" @onclick:stopPropagation>
    <div class="modal-sheet">
        <div class="modal-handle"></div>
        <div class="modal-title">@(Debt?.Id == 0 ? "Add Debt" : "Edit Debt")</div>

        <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
            <div>
                <label class="form-label">Name</label>
                <input class="form-input" @bind="name" placeholder="e.g. Car Loan" />
            </div>
            <div style="display:flex;gap:8px">
                <div style="flex:1">
                    <label class="form-label">Current Balance ($)</label>
                    <input class="form-input" type="number" step="0.01" @bind="balance" placeholder="0.00" />
                </div>
                <div style="flex:1">
                    <label class="form-label">Started At ($)</label>
                    <input class="form-input" type="number" step="0.01" @bind="originalBalance" placeholder="0.00" />
                </div>
            </div>
            <div style="display:flex;gap:8px">
                <div style="flex:1">
                    <label class="form-label">Minimum Payment ($)</label>
                    <input class="form-input" type="number" step="0.01" @bind="minimumPayment" placeholder="0.00" />
                </div>
                <div style="flex:1">
                    <label class="form-label">Period</label>
                    <select class="form-input" @bind="paymentPeriod">
                        <option value="Weekly">Weekly</option>
                        <option value="Fortnightly">Fortnightly</option>
                        <option value="Monthly">Monthly</option>
                        <option value="Quarterly">Quarterly</option>
                        <option value="Yearly">Yearly</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="form-label">Interest Rate (% APR)</label>
                <input class="form-input" type="number" step="0.01" @bind="interestRate" placeholder="0.00" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
        }
    </div>

    <div class="modal-actions">
        @if (Debt?.Id != 0)
        {
            <button class="btn btn-danger" @onclick="Delete" disabled="@saving">Delete</button>
        }
        <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
        <button class="btn btn-primary" style="flex:1" @onclick="Save" disabled="@saving">
            @(saving ? "Saving…" : (Debt?.Id == 0 ? "Add Debt" : "Save"))
        </button>
    </div>
    </div>
</div>

@code {
    [Parameter] public Debt? Debt { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string name = string.Empty;
    private decimal balance;
    private decimal originalBalance;
    private decimal minimumPayment;
    private string paymentPeriod = "Weekly";
    private decimal interestRate;
    private string error = string.Empty;
    private bool saving;

    protected override void OnParametersSet()
    {
        if (Debt is null) return;
        name = Debt.Name;
        balance = Debt.BalanceDollars;
        originalBalance = Debt.OriginalBalanceDollars;
        minimumPayment = Debt.MinimumPaymentDollars;
        paymentPeriod = Debt.PaymentPeriod;
        interestRate = (Debt.InterestRate ?? 0) * 100m;
    }

    private async Task Save()
    {
        error = string.Empty;
        if (Debt is null) return;
        if (string.IsNullOrWhiteSpace(name)) { error = "Name is required."; return; }
        if (balance < 0) { error = "Balance can't be negative."; return; }

        saving = true;
        var d = new Debt
        {
            Id = Debt.Id,
            Name = name.Trim(),
            BalanceDollars = balance,
            OriginalBalanceDollars = originalBalance,
            MinimumPaymentDollars = minimumPayment,
            PaymentPeriod = paymentPeriod,
            InterestRate = interestRate > 0 ? interestRate / 100m : null
        };

        if (Debt.Id == 0)
            await State.AddDebtAsync(d);
        else
            await State.UpdateDebtAsync(d);

        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Delete()
    {
        if (Debt is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete \"{Debt.Name}\"? This removes its payment history and unlinks any linked bill. This can't be undone."))
            return;

        saving = true;
        await State.DeleteDebtAsync(Debt.Id);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
