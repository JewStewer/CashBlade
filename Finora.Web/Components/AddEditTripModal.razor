@inject AppState State
@inject NavigationManager Nav

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-sheet" @onclick:stopPropagation>
        <div class="modal-handle"></div>
        <div class="modal-title">@(Trip?.Id == 0 ? "Add Trip" : "Edit Trip")</div>

        <div style="padding:14px 16px 0;display:flex;flex-direction:column;gap:12px">
            <div>
                <label class="form-label">Name</label>
                <input class="form-input" @bind="name" placeholder="e.g. Summer in Japan" autofocus />
            </div>
            <div>
                <label class="form-label">Destination</label>
                <input class="form-input" @bind="destination" placeholder="e.g. Tokyo, Japan" />
            </div>
            <div>
                <label class="form-label">Notes</label>
                <textarea class="form-input" rows="3" @bind="notes" placeholder="Flight numbers, hotel ideas, links, rough plan"></textarea>
            </div>
            <div style="display:flex;gap:8px">
                <div style="flex:1">
                    <label class="form-label">Start Date</label>
                    <input class="form-input" type="date" @bind="startDate" @bind:event="oninput" />
                </div>
                <div style="flex:1">
                    <label class="form-label">End Date</label>
                    <input class="form-input" type="date" @bind="endDate" @bind:event="oninput" />
                </div>
            </div>
            <div style="display:flex;gap:8px">
                <div style="flex:1">
                    <label class="form-label">Saving Account</label>
                    <select class="form-input" @bind="savingsAccountId">
                        <option value="">No account</option>
                        @foreach (var account in State.Accounts.Where(a => a.Type is AccountType.Savings or AccountType.Spending or AccountType.Cash))
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </select>
                </div>
                <div style="flex:1">
                    <label class="form-label">Weekly Transfer</label>
                    <input class="form-input" type="number" min="0" step="0.01" @bind="weeklyContribution" placeholder="0.00" />
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding:6px 16px;color:var(--red);font-size:13px">@error</div>
        }

        @if (confirmingDelete)
        {
            <div style="margin:14px 16px 0;padding:10px;border:1px solid var(--red);border-radius:8px;background:rgba(248,113,113,0.08)">
                <div style="font-size:13px;font-weight:700;color:var(--red);margin-bottom:4px">Delete this trip?</div>
                <div style="font-size:12px;color:var(--text2)">This removes the itinerary, checklist, and budget too. This can't be undone.</div>
            </div>
            <div style="padding:14px 16px;display:flex;gap:8px">
                <button class="btn btn-secondary" style="flex:1" @onclick="CancelDelete" disabled="@saving">Keep</button>
                <button class="btn btn-danger" style="flex:1" @onclick="ConfirmDelete" disabled="@saving">
                    @(saving ? "Deleting..." : "Delete")
                </button>
            </div>
        }
        else
        {
            <div style="padding:14px 16px;display:flex;gap:8px">
                @if (Trip?.Id != 0)
                {
                    <button class="btn btn-danger" @onclick="StartDelete" disabled="@saving">Delete</button>
                }
                <button class="btn btn-secondary" style="flex:1" @onclick="Close">Cancel</button>
                <button class="btn btn-primary" style="flex:1" @onclick="Save" disabled="@saving">
                    @(saving ? "Saving..." : (Trip?.Id == 0 ? "Add Trip" : "Save"))
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Trip? Trip { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string name = string.Empty;
    private string destination = string.Empty;
    private string notes = string.Empty;
    private DateTime? startDate;
    private DateTime? endDate;
    private int? savingsAccountId;
    private decimal weeklyContribution;
    private string error = string.Empty;
    private bool saving;
    private bool confirmingDelete;

    protected override void OnParametersSet()
    {
        if (Trip is null) return;
        name = Trip.Name;
        destination = Trip.Destination ?? string.Empty;
        notes = Trip.Notes ?? string.Empty;
        startDate = Trip.StartDate;
        endDate = Trip.EndDate;
        savingsAccountId = Trip.SavingsAccountId;
        weeklyContribution = Trip.WeeklyContributionDollars;
        confirmingDelete = false;
    }

    private async Task Save()
    {
        error = string.Empty;
        if (Trip is null) return;
        if (string.IsNullOrWhiteSpace(name)) { error = "Name is required."; return; }

        saving = true;

        if (Trip.Id == 0)
        {
            var t = new Trip
            {
                Name = name.Trim(),
                Destination = string.IsNullOrWhiteSpace(destination) ? null : destination.Trim(),
                Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim(),
                StartDate = startDate,
                EndDate = endDate,
                SavingsAccountId = savingsAccountId,
                WeeklyContributionDollars = weeklyContribution
            };
            var created = await State.AddTripAsync(t);
            saving = false;
            await OnSaved.InvokeAsync();
            Nav.NavigateTo($"trips/{created.Id}");
        }
        else
        {
            Trip.Name = name.Trim();
            Trip.Destination = string.IsNullOrWhiteSpace(destination) ? null : destination.Trim();
            Trip.Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim();
            Trip.StartDate = startDate;
            Trip.EndDate = endDate;
            Trip.SavingsAccountId = savingsAccountId;
            Trip.WeeklyContributionDollars = weeklyContribution;
            await State.UpdateTripAsync(Trip);
            saving = false;
            await OnSaved.InvokeAsync();
        }
    }

    private void StartDelete()
    {
        confirmingDelete = true;
        error = string.Empty;
    }

    private void CancelDelete() => confirmingDelete = false;

    private async Task ConfirmDelete()
    {
        if (Trip is null) return;

        saving = true;
        await State.DeleteTripAsync(Trip.Id);
        saving = false;
        await OnSaved.InvokeAsync();
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
