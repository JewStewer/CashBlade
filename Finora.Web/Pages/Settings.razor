    private async Task AddCategory()
    {
        var result = await State.AddCategoryAsync(_newCategoryName, _newCategoryType);
        _categoryStatus = result.Message;
        _categoryStatusColor = result.Ok ? "var(--green)" : "var(--red)";
        if (result.Ok)
        {
            _newCategoryName = string.Empty;
            _replacementCategoryIds.Clear();
        }
    }

    private int GetReplacementCategoryId(Category category, IReadOnlyList<Category> replacements)
    {
        if (_replacementCategoryIds.TryGetValue(category.Id, out var selected) &&
            replacements.Any(c => c.Id == selected))
        {
            return selected;
        }

        var fallback = replacements.FirstOrDefault(c => string.Equals(c.Name, "Misc", StringComparison.OrdinalIgnoreCase))
            ?? replacements.FirstOrDefault();
        if (fallback is null) return 0;
        _replacementCategoryIds[category.Id] = fallback.Id;
        return fallback.Id;
    }

    private void SetReplacementCategory(int categoryId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var replacementId))
            _replacementCategoryIds[categoryId] = replacementId;
    }

    private async Task DeleteCategory(int categoryId)
    {
        var category = State.Categories.FirstOrDefault(c => c.Id == categoryId);
        if (category is null) return;
        var replacements = State.Categories.Where(c => c.Type == category.Type && c.Id != category.Id).ToList();
        var replacementId = GetReplacementCategoryId(category, replacements);
        var result = await State.DeleteCategoryAsync(categoryId, replacementId);
        _categoryStatus = result.Message;
        _categoryStatusColor = result.Ok ? "var(--green)" : "var(--red)";
        if (result.Ok)
        {
            _replacementCategoryIds.Remove(categoryId);
        }
    }

