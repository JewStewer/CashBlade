@page "/settings"
@inject AppState State
@inject SyncService Sync
@inject UpBankWebSyncService UpSync
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Settings — Evergrove</PageTitle>

<BackHeader To="more" Label="More" />

<div style="padding:16px;display:flex;flex-direction:column;gap:14px">

    <!-- App version / force update -->
    <div class="card" style="border-color:rgba(99,102,241,0.4)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
            <div>
                <div style="font-size:14px;font-weight:600">App Update</div>
                <div style="font-size:12px;color:var(--text3);margin-top:2px">@AppInfo.DisplayVersion</div>
            </div>
            @if (_updateDone)
            {
                <span class="badge badge-green">✓ Reloading…</span>
            }
        </div>
        <div style="font-size:13px;color:var(--text3);margin-bottom:10px">
            If the app looks out of date, tap below to clear the cache and reload the latest version.
        </div>
        <button class="btn btn-primary btn-full" @onclick="ForceUpdate">
            🔄 Clear cache &amp; reload
        </button>
    </div>

    <!-- Last synced / sync now -->
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:10px">Data Sync</div>

        @if (Sync.LastSyncedAt is not null)
        {
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:10px">
                <span class="badge badge-green">✓ Synced</span>
                <span style="font-size:13px;color:var(--text3)">@Sync.LastSyncedAt.Value.ToLocalTime().ToString("dd MMM HH:mm")</span>
            </div>
        }
        else
        {
            <div style="font-size:13px;color:var(--text3);margin-bottom:10px">Not synced yet.</div>
        }

        @if (State.HasPendingChanges)
        {
            <div style="font-size:13px;color:var(--amber);margin-bottom:8px">⚠ You have unsaved local changes.</div>
        }

        @if (localEditIntents > 0 || localDeleteIntents > 0)
        {
            <div style="font-size:12px;color:var(--text3);margin-bottom:8px">
                Local sync protection: @localEditIntents edit@(localEditIntents == 1 ? "" : "s"), @localDeleteIntents delete@(localDeleteIntents == 1 ? "" : "s").
            </div>
        }

        <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px;margin-bottom:10px">
            <div style="font-size:11px;color:var(--text3);text-transform:uppercase;font-weight:700;margin-bottom:4px">What changed since Windows sync</div>
            <div style="font-size:13px;color:var(--text2)">@State.LastSyncChangeSummary</div>
        </div>

        <button class="btn btn-primary btn-full" @onclick="DoAutoSync" disabled="@(Sync.IsSyncing || UpSync.IsSyncing)">
            @((Sync.IsSyncing || UpSync.IsSyncing) ? "Syncing..." : "Sync Now")
        </button>

        <button class="btn btn-secondary btn-full" style="margin-top:8px" @onclick="RepairPendingSync" disabled="@(Sync.IsSyncing || UpSync.IsSyncing)">
            Repair stuck pending sync
        </button>

        @if (manualSyncActive)
        {
            <div style="margin-top:10px;display:flex;align-items:center;gap:10px">
                <LoadingRings Size="28" />
                <div style="font-size:12px;color:var(--text3)">@manualSyncStep</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(syncStatus))
        {
            <div style="margin-top:8px;font-size:13px;color:@syncStatusColor">@syncStatus</div>
        }
        @if (!string.IsNullOrEmpty(repairStatus))
        {
            <div style="margin-top:8px;font-size:13px;color:@repairStatusColor">@repairStatus</div>
        }

        @if (!string.IsNullOrEmpty(Sync.LastError))
        {
            <div style="margin-top:8px;font-size:13px;color:var(--red)">@Sync.LastError</div>
        }
    </div>

    <!-- Supabase cloud sync (recommended) -->
    <div class="card" style="border-color:@(Sync.HasCloudSync?"var(--teal)":"var(--border)")">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px">
            <div style="font-size:14px;font-weight:600">☁ Cloud Sync (Supabase)</div>
            @if (Sync.HasCloudSync)
            {
                <span class="badge badge-teal">Active</span>
            }
        </div>
        <div style="font-size:12px;color:var(--text3);margin-bottom:12px">
            Works without your PC being on. Free forever.
        </div>

        <div style="display:flex;flex-direction:column;gap:10px">
            <div>
                <label class="form-label">Project URL</label>
                <input class="form-input" @bind="supabaseUrl" placeholder="xxxx.supabase.co (https:// added automatically)" />
            </div>
            <div>
                <label class="form-label">Anon Key</label>
                <input class="form-input" @bind="supabaseKey" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9…" type="password" />
            </div>
        </div>

        <div style="display:flex;gap:8px;margin-top:10px">
            <button class="btn btn-secondary btn-sm" @onclick="TestSupabase" disabled="@testingSupabase">
                @(testingSupabase ? "Testing…" : "Test")
            </button>
            <button class="btn btn-primary btn-sm" style="flex:1" @onclick="SaveSupabase">Save</button>
        </div>

        @if (!string.IsNullOrEmpty(supabaseStatus))
        {
            <div style="margin-top:8px;font-size:13px;color:@supabaseStatusColor">@supabaseStatus</div>
        }
        @if (!string.IsNullOrEmpty(Sync.LastTestDetail))
        {
            <div style="margin-top:4px;font-size:11px;color:var(--text3);word-break:break-all;font-family:monospace">@Sync.LastTestDetail</div>
        }

        <div style="margin-top:12px;padding:10px;background:var(--bg);border-radius:8px;font-size:12px;color:var(--text3);line-height:1.6">
            <strong style="color:var(--text2)">One-time setup:</strong><br/>
            1. Create a free account at <strong>supabase.com</strong><br/>
            2. New project → Settings → API → copy URL and anon key<br/>
            3. In SQL Editor, run:<br/>
            <code style="display:block;background:var(--surface2);padding:6px;border-radius:4px;margin-top:4px;font-size:11px;word-break:break-all">
                CREATE TABLE finance_sync (id TEXT PRIMARY KEY, payload JSONB NOT NULL, synced_at TIMESTAMPTZ DEFAULT NOW()); ALTER TABLE finance_sync DISABLE ROW LEVEL SECURITY;
            </code>
            4. On your PC, create a file <strong>supabase.json</strong> next to Cashglade.exe with:
            <code style="display:block;background:var(--surface2);padding:6px;border-radius:4px;margin-top:4px;font-size:11px">
                @("{")@("{\"url\":\"https://xxxx.supabase.co\",")@("\"anonKey\":\"eyJ...\"}")
            </code>
            <a class="btn btn-secondary btn-sm btn-full" style="margin-top:10px;text-decoration:none" href="https://supabase.com/dashboard/projects" target="_blank" rel="noopener">Open Supabase</a>
        </div>
    </div>


    <!-- Up Bank direct sync -->
    <div class="card" style="border-color:@(!string.IsNullOrWhiteSpace(upBankToken)?"var(--teal)":"var(--border)")">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px">
            <div style="font-size:14px;font-weight:600">Up Bank Sync</div>
            @if (!string.IsNullOrWhiteSpace(upBankToken))
            {
                <span class="badge badge-teal">On iPhone</span>
            }
        </div>
        <div style="font-size:12px;color:var(--text3);margin-bottom:12px">
            Imports Up Bank accounts and settled transactions directly into this app.
        </div>

        <div>
            <label class="form-label">Personal Access Token</label>
            <input class="form-input" @bind="upBankToken" placeholder="up:yeah:..." type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" />
        </div>

        <div style="display:flex;gap:8px;margin-top:10px">
            <button class="btn btn-secondary btn-sm" @onclick="SaveUpToken">Save Token</button>
            <button class="btn btn-primary btn-sm" style="flex:1" @onclick="SyncUpBank" disabled="@UpSync.IsSyncing">
                @(UpSync.IsSyncing ? "Syncing..." : "Sync Up Bank")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(upBankStatus))
        {
            <div style="margin-top:8px;font-size:13px;color:@upBankStatusColor">@upBankStatus</div>
        }
        @if (!string.IsNullOrEmpty(UpSync.LastError))
        {
            <div style="margin-top:8px;font-size:13px;color:var(--red)">@UpSync.LastError</div>
        }
    </div>


    <!-- Payday -->
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:12px">Payday</div>
        <div>
            <label class="form-label">Next Pay Date</label>
            <input class="form-input" type="date" @bind="nextPayDate" />
        </div>
        <button class="btn btn-primary btn-sm" style="margin-top:10px" @onclick="SavePayDate">Save</button>
    </div>

    <!-- Summary period -->
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:12px">Summary Period</div>
        <div style="display:flex;gap:8px">
            @foreach (var p in new[]{"Weekly","Monthly"})
            {
                <button class="pill @(State.SummaryPeriod==p?"pill-active":"pill-inactive")" @onclick="() => SetPeriod(p)">@p</button>
            }
        </div>
    </div>

    <!-- Push notifications -->
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:4px">🔔 Push Notifications</div>
        <div style="font-size:12px;color:var(--text3);margin-bottom:12px">Bill and insight reminders while the app is open. Subscribe below too if you want them even when the app is closed.</div>

        @if (!_pushSupported)
        {
            <div style="font-size:13px;color:var(--text3)">Push notifications are not supported on this device/browser.</div>
        }
        else if (_pushPermission == "denied")
        {
            <div style="font-size:13px;color:var(--red)">Notifications blocked. Enable them in your browser/phone settings, then return here.</div>
        }
        else
        {
            <div style="display:flex;gap:8px;margin-bottom:12px">
                <button class="btn btn-primary btn-sm" style="flex:1" @onclick="EnableLocalNotifications" disabled="@_pushBusy">
                    @(_pushPermission == "granted" ? "Notifications Enabled" : "Enable Alerts")
                </button>
                <button class="btn btn-secondary btn-sm" @onclick="SendTestNotification" disabled="@(_pushBusy || _pushPermission != "granted")">Test</button>
            </div>
            @if (!string.IsNullOrEmpty(_localNotificationStatus))
            {
                <div style="margin-bottom:10px;font-size:13px;color:@_localNotificationStatusColor">@_localNotificationStatus</div>
            }

            <div style="font-size:12px;color:var(--text3);margin-bottom:8px">For reminders even when the app is closed, subscribe to cloud push too:</div>
            <div>
                <label class="form-label">VAPID Public Key</label>
                <input class="form-input" @bind="vapidPublicKey" placeholder="BHxk… (from npx web-push generate-vapid-keys)" style="font-family:monospace;font-size:12px" />
                <div style="font-size:11px;color:var(--text3);margin-top:4px">Generate keys once: <code>npx web-push generate-vapid-keys</code><br/>Add VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY as GitHub Actions secrets.</div>
            </div>
            <div style="display:flex;gap:8px;margin-top:10px">
                @if (_pushSubscribed)
                {
                    <span class="badge badge-teal" style="align-self:center">✓ Subscribed</span>
                    <button class="btn btn-secondary btn-sm" style="flex:1" @onclick="UnsubscribePush" disabled="@_pushBusy">
                        @(_pushBusy ? "…" : "Disable")
                    </button>
                }
                else
                {
                    <button class="btn btn-primary btn-full" @onclick="SubscribePush" disabled="@(_pushBusy || string.IsNullOrWhiteSpace(vapidPublicKey))">
                        @(_pushBusy ? "Subscribing…" : "Enable Notifications")
                    </button>
                }
            </div>
            @if (!string.IsNullOrEmpty(_pushStatus))
            {
                <div style="margin-top:8px;font-size:13px;color:@_pushStatusColor">@_pushStatus</div>
            }
        }
    </div>

    <!-- Data export -->
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:4px">Data</div>
        <div style="font-size:12px;color:var(--text3);margin-bottom:12px">Export your full transaction history as a CSV file.</div>
        <button class="btn btn-secondary btn-full" @onclick="ExportTransactionsCsv">Export Transactions (CSV)</button>
    </div>

    <!-- App lock -->
    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:4px">🔒 App Lock</div>
        <div style="font-size:12px;color:var(--text3);margin-bottom:12px">
            @(State.AppLockEnabled ? "A PIN is required to open the app." : "Set a PIN to lock the app when it's reopened.")
        </div>

        <div style="display:flex;flex-direction:column;gap:10px">
            <div>
                <label class="form-label">@(State.AppLockEnabled ? "New PIN" : "PIN") (4-6 digits)</label>
                <input class="form-input" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="6" @bind="_newPin" placeholder="••••" />
            </div>
            <div>
                <label class="form-label">Confirm PIN</label>
                <input class="form-input" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="6" @bind="_confirmPin" placeholder="••••" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_pinStatus))
        {
            <div style="margin-top:8px;font-size:13px;color:@_pinStatusColor">@_pinStatus</div>
        }

        <div style="display:flex;gap:8px;margin-top:10px">
            <button class="btn btn-primary" style="flex:1" @onclick="SetPin">@(State.AppLockEnabled ? "Update PIN" : "Set PIN")</button>
            @if (State.AppLockEnabled)
            {
                <button class="btn btn-secondary" @onclick="RemovePin">Remove PIN</button>
            }
        </div>
    </div>

    <div class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:6px">About</div>
        <div style="font-size:13px;color:var(--text3)">Evergrove Mobile — offline-first, syncs via Supabase</div>
        <div style="font-size:11px;color:var(--text3);margin-top:4px">@AppInfo.DisplayVersion</div>
    </div>
</div>

@code {
    private string supabaseUrl = string.Empty;
    private string supabaseKey = string.Empty;
    private string upBankToken = string.Empty;
    private string upBankStatus = string.Empty, upBankStatusColor = "var(--text3)";
    private string syncStatus = string.Empty, syncStatusColor = "var(--text3)";
    private string repairStatus = string.Empty, repairStatusColor = "var(--text3)";
    private DateTime nextPayDate = DateTime.Today;
    private bool testingSupabase;
    private string supabaseStatus = string.Empty, supabaseStatusColor = "var(--text3)";
    private int localEditIntents;
    private int localDeleteIntents;

    // Push notifications
    private bool _updateDone;
    private bool _pushSupported;
    private string _pushPermission = "default";
    private bool _pushSubscribed;
    private bool _pushBusy;
    private string _pushStatus = string.Empty, _pushStatusColor = "var(--text3)";
    private string _localNotificationStatus = string.Empty, _localNotificationStatusColor = "var(--text3)";
    private string vapidPublicKey = string.Empty;
    private bool manualSyncActive;
    private string manualSyncStep = string.Empty;

    // App lock
    private string _newPin = string.Empty;
    private string _confirmPin = string.Empty;
    private string _pinStatus = string.Empty, _pinStatusColor = "var(--text3)";

    protected override async Task OnInitializedAsync()
    {
        supabaseUrl = Sync.SupabaseUrl ?? string.Empty;
        supabaseKey = Sync.SupabaseKey ?? string.Empty;
        upBankToken = await UpSync.GetAccessTokenAsync();
        nextPayDate = State.NextPayDate;
        vapidPublicKey = State.VapidPublicKey;
        await RefreshLocalIntentCountsAsync();
        Sync.OnSyncStateChanged += StateHasChanged;
        UpSync.OnStateChanged += StateHasChanged;
        State.OnChange += OnAppStateChanged;
    }

    // localEditIntents/localDeleteIntents are a one-time snapshot taken at page load —
    // without this, a background sync (e.g. MainLayout's on-load/periodic sync) that
    // clears the underlying IndexedDB overrides wouldn't be reflected here until the
    // user manually left and re-entered Settings, making the badge look permanently stuck.
    private async void OnAppStateChanged()
    {
        await RefreshLocalIntentCountsAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await JS.InvokeVoidAsync("financeBlade.scrollPageToTop");
        try
        {
            _pushSupported = await JS.InvokeAsync<bool>("pushNotifications.isSupported");
            _pushPermission = await JS.InvokeAsync<string>("pushNotifications.getPermission");
            var existingSub = await JS.InvokeAsync<string?>("pushNotifications.getSubscription");
            _pushSubscribed = !string.IsNullOrEmpty(existingSub);
            StateHasChanged();
        }
        catch { _pushSupported = false; }
    }

    private async Task DoAutoSync()
    {
        StartManualSyncProgress("Preparing sync...");
        syncStatus = string.Empty;
        syncStatusColor = "var(--text3)";
        await RefreshLocalIntentCountsAsync();
        StateHasChanged();

        var token = await UpSync.GetAccessTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            SetManualSyncProgress("Importing from Up Bank...");
            var result = await UpSync.SyncAsync();
            SetManualSyncProgress("Reloading local data...");
            await State.LoadAsync();
            if (result is not null)
            {
                if (result.CloudSnapshotPushed)
                {
                    SetManualSyncProgress("Marking changes synced...");
                    await State.MarkPendingChangesSyncedAsync();
                }
                syncStatus = result.CloudSnapshotPushed
                    ? $"Synced Up Bank: imported {result.ImportedTransactions}, balanced accounts {result.BalanceAdjustments}, matched bills {result.MatchedBills}."
                    : $"Imported from Up Bank, but cloud push did not complete: {UpSync.LastError ?? Sync.LastError ?? "open Windows and sync the planning data first"}.";
                syncStatusColor = result.CloudSnapshotPushed ? "var(--green)" : "var(--amber)";
                upBankStatus = $"Imported {result.ImportedTransactions} transaction{(result.ImportedTransactions == 1 ? "" : "s")}, balanced {result.BalanceAdjustments} account{(result.BalanceAdjustments == 1 ? "" : "s")}, matched {result.MatchedBills} bill{(result.MatchedBills == 1 ? "" : "s")}.";
                upBankStatusColor = result.CloudSnapshotPushed ? "var(--green)" : "var(--amber)";
            }
            else
            {
                syncStatus = "Sync failed. Check the Up Bank message below.";
                syncStatusColor = "var(--red)";
            }
        }
        else
        {
            SetManualSyncProgress("Pushing and pulling changes...");
            await State.SyncAndReloadAsync();
            syncStatus = string.IsNullOrEmpty(Sync.LastError)
                ? $"Synced at {DateTime.Now:HH:mm}."
                : "Sync failed.";
            syncStatusColor = string.IsNullOrEmpty(Sync.LastError) ? "var(--green)" : "var(--red)";
        }
        CompleteManualSyncProgress(string.IsNullOrEmpty(Sync.LastError) && string.IsNullOrEmpty(UpSync.LastError) ? "Done" : "Finished with an issue");
        await RefreshLocalIntentCountsAsync();
        StateHasChanged();
    }

    private void StartManualSyncProgress(string step)
    {
        manualSyncActive = true;
        manualSyncStep = step;
    }

    private void SetManualSyncProgress(string step)
    {
        manualSyncStep = step;
        StateHasChanged();
    }

    private void CompleteManualSyncProgress(string step)
    {
        manualSyncStep = step;
    }

    private async Task TestSupabase()
    {
        if (string.IsNullOrWhiteSpace(supabaseUrl) || string.IsNullOrWhiteSpace(supabaseKey)) return;
        testingSupabase = true; supabaseStatus = string.Empty; StateHasChanged();
        var ok = await Sync.TestSupabaseAsync(supabaseUrl, supabaseKey);
        supabaseStatus = ok ? "✓ Supabase connection works" : "✕ Could not connect — check URL and key, and that the table exists";
        supabaseStatusColor = ok ? "var(--green)" : "var(--red)";
        testingSupabase = false; StateHasChanged();
    }

    private async Task SaveSupabase()
    {
        await Sync.SetSupabaseAsync(supabaseUrl, supabaseKey);
        supabaseStatus = "Saved. Tap Sync Now to load data.";
        supabaseStatusColor = "var(--green)";
        StateHasChanged();
    }

    private async Task SaveUpToken()
    {
        var token = upBankToken.Trim();
        await UpSync.SaveAccessTokenAsync(token);
        if (!string.IsNullOrEmpty(token) && !token.StartsWith("up:yeah:", StringComparison.Ordinal))
        {
            upBankStatus = "Saved, but that doesn't look like an Up Bank token — it should start with \"up:yeah:\". Double-check what you pasted.";
            upBankStatusColor = "var(--amber)";
        }
        else
        {
            upBankStatus = "Saved. Tap Sync Up Bank to import transactions.";
            upBankStatusColor = "var(--green)";
        }
    }

    private async Task SyncUpBank()
    {
        upBankStatus = string.Empty;
        StateHasChanged();
        var result = await UpSync.SyncAsync();
        if (result is null)
        {
            upBankStatus = "Could not sync Up Bank.";
            upBankStatusColor = "var(--red)";
            return;
        }

        await State.LoadAsync();
        if (result.CloudSnapshotPushed)
            await State.MarkPendingChangesSyncedAsync();
        await RefreshLocalIntentCountsAsync();
        upBankStatus = result.CloudSnapshotPushed
            ? $"Imported {result.ImportedTransactions} transaction{(result.ImportedTransactions == 1 ? "" : "s")}, balanced {result.BalanceAdjustments} account{(result.BalanceAdjustments == 1 ? "" : "s")}, matched {result.MatchedBills} bill{(result.MatchedBills == 1 ? "" : "s")}."
            : $"Imported {result.ImportedTransactions} transaction{(result.ImportedTransactions == 1 ? "" : "s")}, but cloud push did not complete: {UpSync.LastError ?? Sync.LastError ?? "open Windows and sync the planning data first"}.";
        upBankStatusColor = result.CloudSnapshotPushed ? "var(--green)" : "var(--amber)";
        StateHasChanged();
    }

    private async Task RefreshLocalIntentCountsAsync()
    {
        var counts = await State.GetPersistedTransactionIntentCountsAsync();
        localEditIntents = counts.Edits;
        localDeleteIntents = counts.Deletes;
    }

    private async Task RepairPendingSync()
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Clear stuck pending phone sync intents? Existing accounts, transactions, debts, and bills stay on this device.");
        if (!ok) return;

        await State.RepairPendingSyncAsync();
        await RefreshLocalIntentCountsAsync();
        repairStatus = "Pending sync intents cleared. Tap Sync Now to pull the latest cloud/Windows data.";
        repairStatusColor = "var(--green)";
        StateHasChanged();
    }

    private async Task EnableLocalNotifications()
    {
        _pushBusy = true;
        _localNotificationStatus = string.Empty;
        StateHasChanged();
        try
        {
            _pushPermission = await JS.InvokeAsync<string>("pushNotifications.requestPermission");
            _localNotificationStatus = _pushPermission == "granted"
                ? "Alerts enabled. The app will notify you about bills due soon when it opens."
                : "Permission was not granted.";
            _localNotificationStatusColor = _pushPermission == "granted" ? "var(--green)" : "var(--red)";
        }
        finally
        {
            _pushBusy = false;
            StateHasChanged();
        }
    }

    private async Task SendTestNotification()
    {
        var ok = await JS.InvokeAsync<bool>("pushNotifications.showLocal",
            "Evergrove", "Notifications are working.", "finora-test");
        _localNotificationStatus = ok ? "Test notification sent." : "Could not show a notification on this device.";
        _localNotificationStatusColor = ok ? "var(--green)" : "var(--red)";
    }

    private async Task SubscribePush()
    {
        if (string.IsNullOrWhiteSpace(vapidPublicKey)) return;
        _pushBusy = true; _pushStatus = string.Empty; StateHasChanged();
        try
        {
            // Save VAPID key so it persists across sessions
            await State.SaveSettingAsync("VapidPublicKey", vapidPublicKey.Trim());

            _pushPermission = await JS.InvokeAsync<string>("pushNotifications.requestPermission");
            if (_pushPermission != "granted")
            {
                _pushStatus = "Permission denied. Enable notifications in your browser/phone settings.";
                _pushStatusColor = "var(--red)";
                return;
            }

            var subJson = await JS.InvokeAsync<string?>("pushNotifications.subscribe", vapidPublicKey.Trim());
            if (string.IsNullOrEmpty(subJson))
            {
                _pushStatus = "Failed to subscribe. Check the VAPID key and try again.";
                _pushStatusColor = "var(--red)";
                return;
            }

            var saved = await Sync.SavePushSubscriptionAsync(subJson);
            _pushSubscribed = true;
            _pushStatus = saved
                ? "✓ Notifications enabled! You'll receive bill reminders."
                : "✓ Subscribed locally (Supabase save failed — check connection).";
            _pushStatusColor = "var(--green)";
        }
        catch (Exception ex)
        {
            _pushStatus = $"Error: {ex.Message[..Math.Min(ex.Message.Length, 100)]}";
            _pushStatusColor = "var(--red)";
        }
        finally { _pushBusy = false; StateHasChanged(); }
    }

    private async Task UnsubscribePush()
    {
        _pushBusy = true; StateHasChanged();
        await JS.InvokeAsync<bool>("pushNotifications.unsubscribe");
        _pushSubscribed = false;
        _pushStatus = "Notifications disabled.";
        _pushStatusColor = "var(--text3)";
        _pushBusy = false; StateHasChanged();
    }

    private async Task ForceUpdate()
    {
        _updateDone = true;
        StateHasChanged();
        // Unregister the service worker so the next load fetches everything fresh from network
        await JS.InvokeVoidAsync("eval", @"
            (async () => {
                if ('serviceWorker' in navigator) {
                    const regs = await navigator.serviceWorker.getRegistrations();
                    for (const r of regs) await r.unregister();
                }
                const cacheKeys = await caches.keys();
                for (const k of cacheKeys) await caches.delete(k);
                const appRoot = new URL('.', document.baseURI).href;
                window.location.replace(appRoot + '?refresh=' + Date.now());
            })()
        ");
    }

    private async Task SavePayDate()
    {
        await State.SaveSettingAsync("NextPayDate", nextPayDate.ToString("O"));
    }

    private async Task SetPeriod(string period)
    {
        await State.SaveSettingAsync("SummaryPeriod", period);
    }

    private async Task ExportTransactionsCsv()
    {
        var csv = State.BuildTransactionsCsv();
        await JS.InvokeVoidAsync("financeBlade.downloadFile", $"transactions-{DateTime.Today:yyyy-MM-dd}.csv", csv, "text/csv");
    }

    private async Task SetPin()
    {
        if (_newPin.Length < 4 || _newPin.Length > 6 || !_newPin.All(char.IsDigit))
        {
            _pinStatus = "PIN must be 4-6 digits.";
            _pinStatusColor = "var(--red)";
            return;
        }
        if (_newPin != _confirmPin)
        {
            _pinStatus = "PINs do not match.";
            _pinStatusColor = "var(--red)";
            return;
        }

        await State.SetPinAsync(_newPin);
        _newPin = string.Empty;
        _confirmPin = string.Empty;
        _pinStatus = "PIN set. The app will lock next time it's opened.";
        _pinStatusColor = "var(--green)";
    }

    private async Task RemovePin()
    {
        await State.DisablePinAsync();
        _newPin = string.Empty;
        _confirmPin = string.Empty;
        _pinStatus = "PIN removed.";
        _pinStatusColor = "var(--text3)";
    }

    public void Dispose()
    {
        Sync.OnSyncStateChanged -= StateHasChanged;
        UpSync.OnStateChanged -= StateHasChanged;
        State.OnChange -= OnAppStateChanged;
    }
}
