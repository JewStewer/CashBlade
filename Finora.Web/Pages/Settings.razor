            _pushBusy = false;
            StateHasChanged();
        }
    }

    private async Task SendTestNotification()
    {
        var ok = await JS.InvokeAsync<bool>("pushNotifications.showLocal",
            "Evergrove", "Notifications are working.", "finora-test");
        _localNotificationStatus = ok ? "Test notification sent." : "Could not show a notification on this device.";
        _localNotificationStatusColor = ok ? "var(--green)" : "var(--red)";
    }

    private async Task SubscribePush()
    {
        if (string.IsNullOrWhiteSpace(vapidPublicKey)) return;
        _pushBusy = true; _pushStatus = string.Empty; StateHasChanged();
        try
        {
            // Save VAPID key so it persists across sessions
            await State.SaveSettingAsync("VapidPublicKey", vapidPublicKey.Trim());

            _pushPermission = await JS.InvokeAsync<string>("pushNotifications.requestPermission");
            if (_pushPermission != "granted")
            {
                _pushStatus = "Permission denied. Enable notifications in your browser/phone settings.";
                _pushStatusColor = "var(--red)";
                return;
            }

            var subJson = await JS.InvokeAsync<string?>("pushNotifications.subscribe", vapidPublicKey.Trim());
            if (string.IsNullOrEmpty(subJson))
            {
                _pushStatus = "Failed to subscribe. Check the VAPID key and try again.";
                _pushStatusColor = "var(--red)";
                return;
            }

            var saved = await Sync.SavePushSubscriptionAsync(subJson);
            _pushSubscribed = true;
            _pushStatus = saved
                ? "Notifications enabled! You'll receive bill reminders."
                : "Subscribed locally (Supabase save failed — check connection).";
            _pushStatusColor = "var(--green)";
        }
        catch (Exception ex)
        {
            _pushStatus = $"Error: {ex.Message[..Math.Min(ex.Message.Length, 100)]}";
            _pushStatusColor = "var(--red)";
        }
        finally { _pushBusy = false; StateHasChanged(); }
    }

    private async Task UnsubscribePush()
    {
        _pushBusy = true; StateHasChanged();
        await JS.InvokeAsync<bool>("pushNotifications.unsubscribe");
        _pushSubscribed = false;
        _pushStatus = "Notifications disabled.";
        _pushStatusColor = "var(--text3)";
        _pushBusy = false; StateHasChanged();
    }

    private async Task ForceUpdate()
    {
        _updateDone = true;
        StateHasChanged();
        // Unregister the service worker so the next load fetches everything fresh from network
        await JS.InvokeVoidAsync("eval", @"
            (async () => {
                if ('serviceWorker' in navigator) {
                    const regs = await navigator.serviceWorker.getRegistrations();
                    for (const r of regs) await r.unregister();
                }
                const cacheKeys = await caches.keys();
                for (const k of cacheKeys) await caches.delete(k);
                const appRoot = new URL('.', document.baseURI).href;
                window.location.replace(appRoot + '?refresh=' + Date.now());
            })()
        ");
    }

