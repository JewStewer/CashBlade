@page "/more"
@inject NavigationManager Nav

<PageTitle>More — Evergrove</PageTitle>

<div style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin-top:8px">
    <div class="list-row" style="cursor:pointer" @onclick='() => Nav.NavigateTo("trips")'>
        <div class="row-icon" style="background:var(--surface2)">🏖️</div>
        <div class="row-main">
            <div class="row-title">Holiday</div>
            <div class="row-sub">Trip savings and budgets</div>
        </div>
        <span style="color:var(--text3)">›</span>
    </div>
    <div class="list-row" style="cursor:pointer" @onclick='() => Nav.NavigateTo("daily")'>
        <div class="row-icon" style="background:var(--surface2)">📅</div>
        <div class="row-main">
            <div class="row-title">Daily</div>
            <div class="row-sub">Day-by-day spending heatmap</div>
        </div>
        <span style="color:var(--text3)">›</span>
    </div>
    <div class="list-row" style="cursor:pointer" @onclick='() => Nav.NavigateTo("settings")'>
        <div class="row-icon" style="background:var(--surface2)">⚙️</div>
        <div class="row-main">
            <div class="row-title">Settings</div>
            <div class="row-sub">Sync, app lock, categories &amp; more</div>
        </div>
        <span style="color:var(--text3)">›</span>
    </div>
</div>

<div style="height:16px"></div>
