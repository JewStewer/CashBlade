@page "/"
@using System.Globalization
@inject AppState State
@inject NavigationManager Nav
@inject UiState Ui

<PageTitle>Dashboard - Evergrove</PageTitle>

@if (!State.IsLoaded)
{
    <div class="empty-state"><LoadingRings /><span>Loading...</span></div>
}
else
{
    <div class="dashboard-shell">
        <section class="hero-summary @MobileStatusTone">
            <div class="hero-copy">
                <div class="hero-kicker">Today's Brief</div>
                <div class="hero-title">@MobileStatusTitle</div>
                <div class="hero-message">@MobileStatusMessage</div>
            </div>
            <button class="btn btn-sm btn-secondary" @onclick="() => Nav.NavigateTo(MobileStatusRoute)">@MobileStatusAction</button>
        </section>

        <section class="home-money-card">
            <div>
                <span>Total Balance</span>
                <strong class="@(State.TotalBalance < 0 ? "negative" : "")">@State.TotalBalance.ToString("C")</strong>
            </div>
            <div>
                <span>Safe To Spend</span>
                <strong class="@(State.SafeToSpendAmount > 0 ? "positive" : "negative")">@State.SafeToSpendAmount.ToString("C")</strong>
            </div>
            <button class="sync-pill" @onclick="QuickSyncAsync" disabled="@_quickSyncing">
                @(_quickSyncing ? "Syncing" : "Sync")
            </button>
        </section>

        <section class="budget-pulse">
            <div class="pulse-head">
                <div>
                    <span>Pay Cycle</span>
                    <strong>@PayCycle.From.ToString("dd MMM") - @PayCycle.To.ToString("dd MMM")</strong>
                </div>
                <b>@DaysToPaydayLabel</b>
            </div>
            <div class="pulse-track"><div style="width:@SafeSpendPercentCss"></div></div>
            <div class="pulse-metrics">
                <div>
                    <span>Spent Since Payday</span>
                    <strong class="negative">@PayCycleSpend.ToString("C")</strong>
                </div>
                <div>
                    <span>Made Since Payday</span>
                    <strong class="positive">@PayCycleIncome.ToString("C")</strong>
                </div>
                <div>
                    <span>Cycle Net</span>
                    <strong class="@(PayCycleNet < 0 ? "negative" : "positive")">@PayCycleNet.ToString("C")</strong>
                </div>
            </div>
            <p style="margin-top:8px">@State.NextPayDate.ToString("dd MMM yyyy") &middot; @State.TotalBillsDue.ToString("C") in bills due before then.</p>
            @if (State.TotalBillShortfall > 0)
            {
                <p class="negative">Transfer @State.TotalBillShortfall.ToString("C") now to cover bills before payday.</p>
            }
        </section>

        @if (State.BillAccountShortfalls.Count > 0)
        {
            <section class="dashboard-module shortfall-module">
                <div class="module-head">
                    <span>Short For Upcoming Bills</span>
                    <strong class="negative">@State.TotalBillShortfall.ToString("C")</strong>
                </div>
                <div class="card-list dashboard-list">
                    @foreach (var s in State.BillAccountShortfalls)
                    {
                        <div class="list-row">
                            <div class="row-icon" style="background:rgba(248,113,113,0.15)">!</div>
                            <div class="row-main">
                                <div class="row-title">@s.AccountName</div>
                                <div class="row-sub">@s.BillCount bill@(s.BillCount == 1 ? "" : "s") due before payday &middot; has @s.CurrentBalance.ToString("C")</div>
                            </div>
                            <span class="row-amount neg">Short @s.Needed.ToString("C")</span>
                        </div>
                    }
                </div>
            </section>
        }

        <div class="quick-actions quick-actions-ultimate">
            <button class="quick-action tone-spend" @onclick="() => Ui.OpenAddTransaction()">
                <span><Icon Name="plus" Size="14" /></span>
                <strong>Spend</strong>
                <small>Record transaction</small>
            </button>
            <button class="quick-action tone-budget" @onclick='() => Nav.NavigateTo("budget")'>
                <span><Icon Name="dollar-sign" Size="14" /></span>
                <strong>Budget</strong>
                <small>Plan &amp; track</small>
            </button>
            <button class="quick-action tone-bill" @onclick="() => Ui.OpenAddBill()">
                <span><Icon Name="clipboard" Size="14" /></span>
                <strong>Bill</strong>
                <small>Add payment</small>
            </button>
            <button class="quick-action tone-tools" @onclick='() => Nav.NavigateTo("tools")'>
                <span><Icon Name="sparkles" Size="14" /></span>
                <strong>Tools</strong>
                <small>Smart mode</small>
            </button>
        </div>

        @if (ActionPrompts.Any())
        {
            <div class="action-stack action-stack-compact">
                @foreach (var prompt in ActionPrompts)
                {
                    <button class="action-card @prompt.Tone" @onclick="() => Nav.NavigateTo(prompt.Route)">
                        <span class="status-dot"></span>
                        <span>
                            <strong>@prompt.Title</strong>
                            <small>@prompt.Message</small>
                        </span>
                        <b>@prompt.Action</b>
                    </button>
                }
            </div>
        }

        <div class="section-header dashboard-section-head">
            <span class="section-title">Recent Activity</span>
            <button class="btn btn-sm btn-secondary" @onclick='() => Nav.NavigateTo("transactions")' style="padding:4px 10px;font-size:12px">See all</button>
        </div>
        <div class="card-list dashboard-list">
            @if (State.RecentTransactions.Count == 0)
            {
                <div class="empty-state" style="padding:24px">
                    <span>No transactions yet. Sync from your PC to load data.</span>
                    <button class="btn btn-sm btn-primary" @onclick='() => Nav.NavigateTo("settings")'>Open Sync Settings</button>
                </div>
            }
            else
            {
                @foreach (var t in State.RecentTransactions.Take(5))
                {
                    var visual = CategoryIcon.Get(t.CategoryName);
                    <div class="list-row">
                        <div class="row-icon" style="background:@visual.Bg;color:@visual.Fg">
                            <Icon Name="@visual.Icon" />
                        </div>
                        <div class="row-main">
                            <div class="row-title">@t.Description</div>
                            <div class="row-sub">@t.AccountName - @t.Date.ToString("dd MMM")</div>
                        </div>
                        <span class="row-amount @(t.AmountCents >= 0 ? "pos" : "neg")">
                            @t.AmountDollars.ToString("C")
                        </span>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private bool _quickSyncing;
    private string _quickSyncStatus = string.Empty;

    private (decimal Now, decimal AfterBills, decimal AfterPay) Forecast => State.GetForecastTotals();
    private (DateTime From, DateTime To) PayCycle => State.GetCurrentPayCycle();
    private (decimal Amount, DateTime WeekStart) BestWeekEver => State.GetBestWeekEver();
    private int DaysToPayday => Math.Max((State.NextPayDate.Date - DateTime.Today).Days, 0);
    private string DaysToPaydayLabel => DaysToPayday == 0 ? "Payday today" : $"{DaysToPayday}d to payday";
    private decimal PayCycleSpend => State.GetDiscretionarySpendingForPeriod(PayCycle.From, PayCycle.To);
    private decimal PayCycleIncome => State.Transactions
        .Where(t => t.Date.Date >= PayCycle.From.Date
            && t.Date.Date <= PayCycle.To.Date
            && t.AmountCents > 0
            && string.Equals(t.CategoryName, "Income", StringComparison.OrdinalIgnoreCase)
            && !t.IsReimbursement)
        .Sum(t => t.AmountDollars);
    private decimal PayCycleNet => PayCycleIncome - PayCycleSpend;
    private decimal ThisWeek => State.GetWeekSpending(0);
    private decimal LastWeek => State.GetWeekSpending(1);

    private string SafeSpendPercentCss
    {
        get
        {
            var denominator = Math.Max(State.BudgetSafeToSpendAmount + PayCycleSpend, 1m);
            var percent = Math.Clamp(State.BudgetSafeToSpendAmount / denominator * 100m, 0m, 100m);
            return $"{percent.ToString("0", CultureInfo.InvariantCulture)}%";
        }
    }

    private IEnumerable<(LentTransaction Lent, Transaction Transaction)> OutstandingLentItems =>
        State.LentTransactions
            .Where(l => State.IsUnrepaid(l.Id))
            .Select(l => (Lent: l, Transaction: State.Transactions.FirstOrDefault(t => t.Id == l.Id)))
            .Where(x => x.Transaction is not null)
            .Select(x => (x.Lent, x.Transaction!));

    private string NoSpendSuggestion =>
        State.BudgetSafeToSpendAmount <= 0 || State.GetDiscretionarySpendingForPeriod(DateTime.Today, DateTime.Today) > 0
            ? "Recommended"
            : "Ready";

    private string NoSpendMessage
    {
        get
        {
            if (State.NoSpendMode) return $"Discretionary forecast paused. Today's spend: {State.GetTodaySpending():C}.";
            if (State.BudgetSafeToSpendAmount <= 0) return "Switch on to hold safe-to-spend at $0.";
            return $"{(State.SafeToSpendAmount / Math.Max(DaysToPayday, 1)):C}/day keeps this cycle steady.";
        }
    }

    private string SafeSpendMessage =>
        State.OutstandingLentDollars > 0
            ? $"{State.OutstandingLentDollars:C} owed back is tracked separately."
            : "After bills, savings and essentials.";


    private string MobileStatusTitle
    {
        get
        {
            if (State.BillsDueBeforePayday.Any(b => b.EffectiveDueDate.Date <= DateTime.Today.AddDays(1))) return "Bill check needed";
            if (Forecast.AfterBills < 0) return "Forecast shortfall";
            if (State.NoSpendMode) return "No-spend mode";
            if (State.SafeToSpendAmount <= 0) return "Budget is tight";
            return "You are set for today";
        }
    }

    private string MobileStatusMessage
    {
        get
        {
            var urgent = State.BillsDueBeforePayday.FirstOrDefault(b => b.EffectiveDueDate.Date <= DateTime.Today.AddDays(1));
            if (urgent is not null) return $"{urgent.Name} is due {DueLabel(urgent.EffectiveDueDate)}. Check it off or move money before it lands.";
            if (Forecast.AfterBills < 0) return $"You are forecast to be {Math.Abs(Forecast.AfterBills):C} short before payday.";
            if (State.NoSpendMode) return "Bills and essentials only — discretionary spending is paused.";
            if (State.SafeToSpendAmount <= 0) return "Your safe-to-spend buffer is gone for this pay cycle.";
            var days = Math.Max(DaysToPayday, 1);
            return $"{(State.SafeToSpendAmount / days):C} per day keeps you steady until payday.";
        }
    }

    private string MobileStatusRoute => MobileStatusTitle switch
    {
        "Bill check needed" => "bills",
        "Forecast shortfall" => "accounts",
        "No-spend mode" => "tools",
        "Budget is tight" => "budget",
        _ => "transactions"
    };

    private string MobileStatusAction => MobileStatusTitle switch
    {
        "Bill check needed" => "Open Bills",
        "Forecast shortfall" => "Open Accounts",
        "No-spend mode" => "Manage",
        "Budget is tight" => "Open Budget",
        _ => "Add Spend"
    };

    private string MobileStatusTone => MobileStatusTitle switch
    {
        "Bill check needed" => "tone-amber",
        "Forecast shortfall" => "tone-red",
        "No-spend mode" => "tone-amber",
        "Budget is tight" => "tone-blue",
        _ => "tone-green"
    };

    private List<ActionPrompt> ActionPrompts
    {
        get
        {
            var prompts = new List<ActionPrompt>();
            var tomorrowBills = State.BillsDueBeforePayday.Where(b => b.EffectiveDueDate.Date <= DateTime.Today.AddDays(1)).ToList();
            if (tomorrowBills.Any())
            {
                var names = string.Join(", ", tomorrowBills.Take(2).Select(b => b.Name));
                var more = tomorrowBills.Count > 2 ? $" +{tomorrowBills.Count - 2} more" : "";
                prompts.Add(new("Bills due now", $"{names}{more}: mark paid, confirm autopay, or move money.", "bills", "Decide", "tone-amber"));
            }
            if (Forecast.AfterBills < 0)
            {
                prompts.Add(new("Move money", $"{Math.Abs(Forecast.AfterBills):C} short after scheduled bills.", "accounts", "Fix", "tone-red"));
            }
            if (State.OutstandingLentDollars > 0)
            {
                prompts.Add(new("Collect reimbursements", $"{State.OutstandingLentDollars:C} is still owed back and excluded from spending.", "transactions", "Open", "tone-blue"));
            }
            var todayDiscretionary = State.GetDiscretionarySpendingForPeriod(DateTime.Today, DateTime.Today);
            if (State.NoSpendMode && todayDiscretionary > 0)
            {
                prompts.Add(new("No-spend check", $"{todayDiscretionary:C} discretionary spend landed today.", "transactions", "Review", "tone-amber"));
            }
            if (ThisWeek > LastWeek && LastWeek > 0)
            {
                prompts.Add(new("Spending up", $"{(ThisWeek - LastWeek):C} higher than last week.", "transactions", "Inspect", "tone-blue"));
            }
            if (State.RecentTransactions.Count == 0)
            {
                prompts.Add(new("Sync needed", "No recent transactions are loaded on this device.", "settings", "Sync", "tone-blue"));
            }
            return prompts.Take(4).ToList();
        }
    }

    private List<ProactiveInsight> SmartSignals =>
        State.SmartSignals
            .Where(i => !i.Key.StartsWith("bills-due:", StringComparison.Ordinal))
            .Take(3)
            .ToList();

    private void OpenInsight(ProactiveInsight insight)
    {
        if (!string.IsNullOrWhiteSpace(insight.ActionUrl))
        {
            Nav.NavigateTo(insight.ActionUrl);
        }
    }

    private static string InsightTone(ProactiveInsight insight) => insight.Severity switch
    {
        ProactiveInsightSeverity.Critical => "tone-red",
        ProactiveInsightSeverity.Warning => "tone-amber",
        _ => "tone-blue"
    };

    private static string DueLabel(DateTime date)
    {
        var days = (date.Date - DateTime.Today).Days;
        if (days < 0) return "overdue";
        if (days == 0) return "today";
        if (days == 1) return "tomorrow";
        return $"in {days} days";
    }

    private record ActionPrompt(string Title, string Message, string Route, string Action, string Tone);

    private async Task QuickSyncAsync()
    {
        if (_quickSyncing) return;
        _quickSyncing = true;
        _quickSyncStatus = "Working...";
        try
        {
            await State.SyncAndReloadAsync();
            _quickSyncStatus = State.HasPendingChanges ? "Still pending" : "Synced";
        }
        catch
        {
            _quickSyncStatus = "Try Settings";
        }
        finally
        {
            _quickSyncing = false;
            StateHasChanged();
        }
    }

    private async Task ToggleNoSpendModeAsync()
    {
        await State.SetNoSpendModeAsync(!State.NoSpendMode);
    }

}
