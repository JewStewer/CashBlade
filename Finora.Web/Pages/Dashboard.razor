@page "/"
@inject AppState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Dashboard — Evergrove</PageTitle>

@if (!State.IsLoaded)
{
    <div class="empty-state"><LoadingRings /><span>Loading…</span></div>
}
else
{
    <!-- Balance overview -->
    <div style="padding:16px 16px 0">
        <div class="card" style="text-align:center;padding:20px 14px">
            <div style="font-size:12px;color:var(--text3);margin-bottom:4px">Total Balance</div>
            <div style="font-size:32px;font-weight:700;color:@(State.TotalBalance>=0?"var(--text)":"var(--red)")">
                @State.TotalBalance.ToString("C")
            </div>
            <div style="display:flex;justify-content:center;gap:24px;margin-top:12px">
                <div>
                    <div style="font-size:11px;color:var(--text3)">Net Worth</div>
                    <div style="font-size:15px;font-weight:600;color:@(State.NetWorth>=0?"var(--green)":"var(--red)")">
                        @State.NetWorth.ToString("C")
                    </div>
                </div>
                <div>
                    <div style="font-size:11px;color:var(--text3)">Savings</div>
                    <div style="font-size:15px;font-weight:600;color:var(--teal-light)">
                        @State.SavingsTotal.ToString("C")
                    </div>
                </div>
                @if (State.DebtTotal > 0)
                {
                    <div>
                        <div style="font-size:11px;color:var(--text3)">Debt</div>
                        <div style="font-size:15px;font-weight:600;color:var(--red)">
                            @State.DebtTotal.ToString("C")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div style="padding:12px 16px 0">
        <div class="hero-summary @MobileStatusTone">
            <div class="hero-copy">
                <div class="hero-kicker">Today's Brief</div>
                <div class="hero-title">@MobileStatusTitle</div>
                <div class="hero-message">@MobileStatusMessage</div>
            </div>
            <button class="btn btn-sm btn-secondary" @onclick="() => Nav.NavigateTo(MobileStatusRoute)">@MobileStatusAction</button>
        </div>
    </div>

    <div class="quick-actions">
        <button class="quick-action" @onclick="() => showAddTxn = true">
            <span>+</span>
            <strong>Add Spend</strong>
            <small>Record a transaction</small>
        </button>
        <button class="quick-action" @onclick="QuickSyncAsync" disabled="@_quickSyncing">
            <span>🔄</span>
            <strong>@(_quickSyncing ? "Syncing" : "Sync Now")</strong>
            <small>@(string.IsNullOrWhiteSpace(_quickSyncStatus) ? "Push and pull" : _quickSyncStatus)</small>
        </button>
        <button class="quick-action" @onclick='() => Nav.NavigateTo("budget")'>
            <span>$</span>
            <strong>Budget</strong>
            <small>Check safe spend</small>
        </button>
        <button class="quick-action" @onclick="() => showAddBill = true">
            <span>🧾</span>
            <strong>Add Bill</strong>
            <small>Track a payment</small>
        </button>
        <button class="quick-action" @onclick='() => Nav.NavigateTo("tools")'>
            <span>🧰</span>
            <strong>Tools</strong>
            <small>What-if and cleanup</small>
        </button>
    </div>

    @if (ActionPrompts.Any())
    {
        <div class="action-stack">
            @foreach (var prompt in ActionPrompts)
            {
                <button class="action-card @prompt.Tone" @onclick="() => Nav.NavigateTo(prompt.Route)">
                    <span class="status-dot"></span>
                    <span>
                        <strong>@prompt.Title</strong>
                        <small>@prompt.Message</small>
                    </span>
                    <b>@prompt.Action</b>
                </button>
            }
        </div>
    }

    @if (SmartSignals.Any())
    {
        <div class="section-header" style="margin-top:8px">
            <span class="section-title">Smart Signals</span>
        </div>
        <div class="action-stack" style="margin-top:0">
            @foreach (var signal in SmartSignals)
            {
                <button class="action-card @InsightTone(signal)" @onclick="() => OpenInsight(signal)">
                    <span class="status-dot"></span>
                    <span>
                        <strong>@signal.Title</strong>
                        <small>@signal.Message</small>
                    </span>
                    <b>Open</b>
                </button>
            }
        </div>
    }

    <!-- Bills due -->
    @if (State.BillsDueBeforePayday.Count > 0)
    {
        <div class="section-header" style="margin-top:8px">
            <span class="section-title">Bills Due</span>
            <span style="font-size:13px;color:var(--red);font-weight:600">@State.TotalBillsDue.ToString("C")</span>
        </div>
        <div style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
            @foreach (var bill in State.BillsDueBeforePayday.Take(5))
            {
                <div class="list-row">
                    <div class="row-icon" style="background:rgba(248,113,113,0.15)">📋</div>
                    <div class="row-main">
                        <div class="row-title">@bill.Name</div>
                        <div class="row-sub">@bill.AccountName · @bill.EffectiveDueDate.ToString("dd MMM")</div>
                    </div>
                    <span class="row-amount neg">@bill.AmountDollars.ToString("C")</span>
                </div>
            }
            @if (State.BillsDueBeforePayday.Count > 5)
            {
                <div style="padding:10px 16px;color:var(--text3);font-size:13px">
                    +@(State.BillsDueBeforePayday.Count - 5) more
                </div>
            }
            <div style="padding:10px 16px;border-top:1px solid var(--border)">
                <button class="btn btn-sm btn-secondary btn-full" @onclick='() => Nav.NavigateTo("bills")'>Open Bills</button>
            </div>
        </div>
    }

    <!-- Recent transactions -->
    <div class="section-header" style="margin-top:8px">
        <span class="section-title">Recent</span>
        <button class="btn btn-sm btn-secondary" @onclick='() => Nav.NavigateTo("transactions")' style="padding:4px 10px;font-size:12px">See all</button>
    </div>
    <div style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
        @if (State.RecentTransactions.Count == 0)
        {
            <div class="empty-state" style="padding:24px">
                <span>No transactions yet. Sync from your PC to load data.</span>
                <button class="btn btn-sm btn-primary" @onclick='() => Nav.NavigateTo("settings")'>Open Sync Settings</button>
            </div>
        }
        else
        {
            @foreach (var t in State.RecentTransactions.Take(8))
            {
                <div class="list-row">
                    <div class="row-icon" style="background:var(--surface2)">
                        @GetCategoryEmoji(t.CategoryName)
                    </div>
                    <div class="row-main">
                        <div class="row-title">@t.Description</div>
                        <div class="row-sub">@t.AccountName · @t.Date.ToString("dd MMM")</div>
                    </div>
                    <span class="row-amount @(t.AmountCents>=0?"pos":"neg")">
                        @t.AmountDollars.ToString("C")
                    </span>
                </div>
            }
        }
    </div>

    <div style="height:16px"></div>
}

@if (showAddTxn)
{
    <AddTransactionModal OnClose="() => showAddTxn = false" OnSaved="OnTxnSaved" />
}

@if (showAddBill)
{
    <AddEditBillModal Bill="@((Bill?)null)" OnClose="() => showAddBill = false" OnSaved="OnBillSaved" />
}

@code {
    private bool showAddTxn;
    private bool showAddBill;
    private bool _quickSyncing;
    private string _quickSyncStatus = string.Empty;

    private (decimal Now, decimal AfterBills, decimal AfterPay) Forecast => State.GetForecastTotals();

    private decimal ThisWeek => State.GetWeekSpending(0);
    private decimal LastWeek => State.GetWeekSpending(1);

    private string MobileStatusTitle
    {
        get
        {
            if (State.BillsDueBeforePayday.Any(b => b.EffectiveDueDate.Date <= DateTime.Today.AddDays(1))) return "Bill check needed";
            if (Forecast.AfterBills < 0) return "Forecast shortfall";
            if (State.NoSpendMode) return "No-spend mode";
            if (State.SafeToSpendAmount <= 0) return "Budget is tight";
            return "You are set for today";
        }
    }

    private string MobileStatusMessage
    {
        get
        {
            var urgent = State.BillsDueBeforePayday.FirstOrDefault(b => b.EffectiveDueDate.Date <= DateTime.Today.AddDays(1));
            if (urgent is not null) return $"{urgent.Name} is due {DueLabel(urgent.EffectiveDueDate)}. Check it off or move money before it lands.";
            if (Forecast.AfterBills < 0) return $"You are forecast to be {Math.Abs(Forecast.AfterBills):C} short before payday.";
            if (State.NoSpendMode) return "Stick to bills and essentials today. Tools can turn this off when you are ready.";
            if (State.SafeToSpendAmount <= 0) return "Your safe-to-spend buffer is gone for this pay cycle.";
            var days = Math.Max((State.NextPayDate.Date - DateTime.Today).Days, 1);
            return $"{(State.SafeToSpendAmount / days):C} per day keeps you steady until payday.";
        }
    }

    private string MobileStatusRoute => MobileStatusTitle switch
    {
        "Bill check needed" => "bills",
        "Forecast shortfall" => "accounts",
        "No-spend mode" => "tools",
        "Budget is tight" => "budget",
        _ => "transactions"
    };

    private string MobileStatusAction => MobileStatusTitle switch
    {
        "Bill check needed" => "Open Bills",
        "Forecast shortfall" => "Open Accounts",
        "No-spend mode" => "Manage",
        "Budget is tight" => "Open Budget",
        _ => "Add Spend"
    };

    private string MobileStatusTone => MobileStatusTitle switch
    {
        "Bill check needed" => "tone-amber",
        "Forecast shortfall" => "tone-red",
        "No-spend mode" => "tone-amber",
        "Budget is tight" => "tone-blue",
        _ => "tone-green"
    };

    private List<ActionPrompt> ActionPrompts
    {
        get
        {
            var prompts = new List<ActionPrompt>();
            var tomorrowBills = State.BillsDueBeforePayday.Where(b => b.EffectiveDueDate.Date <= DateTime.Today.AddDays(1)).ToList();
            if (tomorrowBills.Any())
            {
                var names = string.Join(", ", tomorrowBills.Take(2).Select(b => b.Name));
                var more = tomorrowBills.Count > 2 ? $" +{tomorrowBills.Count - 2} more" : "";
                prompts.Add(new("Bills due now", $"{names}{more}: mark paid, confirm autopay, or move money.", "bills", "Decide", "tone-amber"));
            }
            if (Forecast.AfterBills < 0)
            {
                prompts.Add(new("Move money", $"{Math.Abs(Forecast.AfterBills):C} short after scheduled bills.", "accounts", "Fix", "tone-red"));
            }
            if (ThisWeek > LastWeek && LastWeek > 0)
            {
                prompts.Add(new("Spending up", $"{(ThisWeek - LastWeek):C} higher than last week.", "transactions", "Inspect", "tone-blue"));
            }
            if (State.RecentTransactions.Count == 0)
            {
                prompts.Add(new("Sync needed", "No recent transactions are loaded on this device.", "settings", "Sync", "tone-blue"));
            }
            return prompts.Take(3).ToList();
        }
    }

    private List<ProactiveInsight> SmartSignals =>
        State.SmartSignals
            .Where(i => !i.Key.StartsWith("bills-due:", StringComparison.Ordinal))
            .Take(3)
            .ToList();

    private void OpenInsight(ProactiveInsight insight)
    {
        if (!string.IsNullOrWhiteSpace(insight.ActionUrl))
        {
            Nav.NavigateTo(insight.ActionUrl);
        }
    }

    private static string InsightTone(ProactiveInsight insight) => insight.Severity switch
    {
        ProactiveInsightSeverity.Critical => "tone-red",
        ProactiveInsightSeverity.Warning => "tone-amber",
        _ => "tone-blue"
    };

    private static string DueLabel(DateTime date)
    {
        var days = (date.Date - DateTime.Today).Days;
        if (days < 0) return "overdue";
        if (days == 0) return "today";
        if (days == 1) return "tomorrow";
        return $"in {days} days";
    }

    private record ActionPrompt(string Title, string Message, string Route, string Action, string Tone);

    private async Task QuickSyncAsync()
    {
        if (_quickSyncing) return;
        _quickSyncing = true;
        _quickSyncStatus = "Working...";
        try
        {
            await State.SyncAndReloadAsync();
            _quickSyncStatus = State.HasPendingChanges ? "Still pending" : "Synced";
        }
        catch
        {
            _quickSyncStatus = "Try Settings";
        }
        finally
        {
            _quickSyncing = false;
            StateHasChanged();
        }
    }

    private async Task ExportTransactionsCsv()
    {
        var csv = State.BuildTransactionsCsv();
        await JS.InvokeVoidAsync("financeBlade.downloadFile", $"transactions-{DateTime.Today:yyyy-MM-dd}.csv", csv, "text/csv");
    }

    private Task OnTxnSaved()
    {
        showAddTxn = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnBillSaved()
    {
        showAddBill = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static string GetCategoryEmoji(string cat) => cat switch
    {
        "Income" => "💰", "Groceries" => "🛒", "Fuel" => "⛽", "Rent" => "🏠",
        "Phone" => "📱", "Internet" => "📡", "Medical" => "💊", "Transfer" => "↔️",
        "Insurance" => "🛡️", "Debt" => "💳", "Study" => "📚",
        _ => "💸"
    };
}
