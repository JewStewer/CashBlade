@page "/bills"
@inject AppState State
@inject NavigationManager Nav

<PageTitle>Bills — Evergrove</PageTitle>

<div style="padding:10px 16px 0;display:flex;gap:8px;align-items:center">
    <div style="position:relative;flex:1">
        <input class="form-input" style="padding-left:32px;height:38px;font-size:14px"
               @bind="_search" @bind:event="oninput" placeholder="Search bills…" />
        <svg style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--text3)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        @if (!string.IsNullOrEmpty(_search))
        {
            <button @onclick="() => _search = string.Empty"
                    style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:transparent;border:none;color:var(--text3);cursor:pointer;padding:0 4px;display:flex"><Icon Name="x" Size="14" /></button>
        }
    </div>
</div>
<div class="pill-tabs">
    @foreach (var f in new[]{"Unpaid","All","Paid","List"})
    {
        <button class="pill @(filter==f?"pill-active":"pill-inactive")" @onclick="() => filter = f">@f</button>
    }
</div>

@{
    var outstanding = State.GetOutstandingBillOccurrences();
    var dueNowBills = outstanding.Where(o => o.DueDate.Date <= DateTime.Today).ToList();
    var next7Bills = AllUnpaidOccurrences(outstanding, 7).Where(o => o.DueDate.Date <= DateTime.Today.AddDays(7)).ToList();
    var next30Bills = AllUnpaidOccurrences(outstanding, 30).Where(o => o.DueDate.Date <= DateTime.Today.AddDays(30)).ToList();
    var listBills = GetBillsForList();
    var listGroups = listBills
        .GroupBy(b => string.IsNullOrWhiteSpace(b.AccountName) ? "Other" : b.AccountName)
        .OrderBy(g => g.Key)
        .Select(g => (Account: g.Key, Bills: g.OrderBy(b => b.Name).ToList()))
        .ToList();
    var listTotal = listBills.Sum(b => BillWeekly(b));
}

@if (filter != "List")
{
<!-- Summary bar -->
<div style="padding:0 16px 12px;display:flex;gap:8px">
    <div class="card-sm" style="flex:1;text-align:center">
        <div class="stat-label">Owed before @State.NextPayDate.ToString("dd MMM")</div>
        <div style="font-size:18px;font-weight:700;color:var(--red)">@State.TotalBillsDue.ToString("C")</div>
        <div style="font-size:11px;color:var(--text3);margin-top:2px">@State.BillsDueBeforePayday.Count bill@(State.BillsDueBeforePayday.Count == 1 ? "" : "s") unpaid</div>
    </div>
    <div class="card-sm" style="flex:1;text-align:center">
        <div class="stat-label">Payday</div>
        <div style="font-size:15px;font-weight:600;color:var(--text)">@State.NextPayDate.ToString("dd MMM")</div>
        <div style="font-size:11px;color:var(--text3);margin-top:2px">in @(Math.Max((State.NextPayDate.Date - DateTime.Today).Days, 0))d</div>
    </div>
</div>

<div style="padding:0 16px 10px;display:flex;gap:8px">
    <div class="card-sm" style="flex:1;text-align:center">
        <div class="stat-label">Due now</div>
        <div style="font-size:17px;font-weight:700;color:var(--red)">@dueNowBills.Sum(o => o.Bill.AmountDollars).ToString("C")</div>
    </div>
    <div class="card-sm" style="flex:1;text-align:center">
        <div class="stat-label">Next 7d</div>
        <div style="font-size:17px;font-weight:700;color:var(--text)">@next7Bills.Sum(o => o.Bill.AmountDollars).ToString("C")</div>
    </div>
    <div class="card-sm" style="flex:1;text-align:center">
        <div class="stat-label">Next 30d</div>
        <div style="font-size:17px;font-weight:700;color:var(--text)">@next30Bills.Sum(o => o.Bill.AmountDollars).ToString("C")</div>
    </div>
</div>
<div style="padding:0 16px 12px;display:flex;gap:8px;flex-wrap:wrap">
    <button class="btn btn-secondary btn-sm" disabled="@(!dueNowBills.Any())" @onclick="MarkDuePaidAsync">Mark due paid</button>
    <button class="btn btn-primary btn-sm" @onclick="() => editingBill = new Bill()">Add Bill</button>
</div>

@if (DueSoonBills.Any())
{
    <div class="mini-timeline-wrap">
        <div class="mini-timeline-head">
            <span>Due Soon</span>
        </div>
        <div class="mini-timeline">
            @foreach (var occ in DueSoonBills)
            {
                var (occCovered, _) = State.GetBillCoverage(occ.Bill);
                <button class="timeline-chip @(occCovered ? "is-ready" : "is-danger")" @onclick="() => StartEdit(occ.Bill)">
                    <span>@DueLabel(occ.DueDate)</span>
                    <strong>@occ.Bill.Name</strong>
                    <small>@occ.Bill.AmountDollars.ToString("C")</small>
                </button>
            }
        </div>
    </div>
}
else
{
    <div class="ios-section-note">
        No bills are due in the next 14 days.
        <button class="btn btn-sm btn-secondary" @onclick="() => editingBill = new Bill()">Add Bill</button>
    </div>
}

<div class="scroll-handoff-gap"></div>
}

@if (filter == "List")
{
    @if (!listBills.Any())
    {
        <div class="empty-state">
            <span>No bills found.</span>
            <button class="btn btn-primary btn-sm" @onclick="() => editingBill = new Bill()">Add Bill</button>
        </div>
    }
    else
    {
        <div class="card-list" style="margin-top:0">
            @foreach (var (account, bills) in listGroups)
            {
                <div style="padding:8px 16px 4px;font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text3);letter-spacing:0.05em">@account</div>
                @foreach (var bill in bills)
                {
                    <div class="list-row" style="gap:10px;cursor:pointer" @onclick="() => StartEdit(bill)">
                        <div class="row-main">
                            <div class="row-title">@bill.Name</div>
                            <div class="row-sub">@FreqAbbr(bill.Frequency) · @BillWeekly(bill).ToString("C")/wk</div>
                        </div>
                        <span class="row-amount neg">@bill.AmountDollars.ToString("C")</span>
                    </div>
                }
            }
            <div style="padding:10px 16px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border)">
                <span style="font-size:13px;color:var(--text3)">@listBills.Count bill@(listBills.Count == 1 ? "" : "s") · @listTotal.ToString("C")/wk</span>
                <button class="btn btn-primary btn-sm" @onclick="() => editingBill = new Bill()">+ Add</button>
            </div>
        </div>
    }
}
else
{
<div class="card-list" style="margin-top:0">
    @{var occurrences = GetFiltered();}
    @if (!occurrences.Any())
    {
        <div class="empty-state">
            <span>No bills here.</span>
            <div style="display:flex;gap:8px">
                <button class="btn btn-primary btn-sm" @onclick="() => editingBill = new Bill()">Add Bill</button>
                <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("settings")'>Sync Settings</button>
            </div>
        </div>
    }
    else
    {
        @foreach (var occ in occurrences)
        {
            var bill = occ.Bill;
            var isPaid = State.IsBillOccurrencePaid(bill, occ.DueDate);
            var (covered, shortfall) = State.GetBillCoverage(bill);
            <div class="list-row" style="align-items:flex-start;gap:10px">
                <div style="padding-top:2px">
                    <button @onclick="() => TogglePaid(occ)" class="@(_celebratedBillIds.Contains(bill.Id) ? "celebrate" : "")" style="width:22px;height:22px;border-radius:50%;border:2px solid @(isPaid?"var(--green)":"var(--border)");background:@(isPaid?"var(--green)":"transparent");cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        @if (isPaid) { <span style="color:#fff;display:flex"><Icon Name="check" Size="13" /></span> }
                    </button>
                </div>
                <div class="row-main" style="cursor:pointer" @onclick="() => StartEdit(bill)">
                    <div class="row-title" style="@(isPaid?"opacity:0.5;text-decoration:line-through":"")">@bill.Name</div>
                    <div class="row-sub">@bill.AccountName · @bill.Frequency · @occ.DueDate.ToString("dd MMM")@(occ.DueDate.Date < DateTime.Today && !isPaid ? " · Overdue" : "")</div>
                    @if (!isPaid)
                    {
                        <div style="margin-top:4px">
                            @if (covered)
                            {
                                <span class="badge badge-teal">Covered</span>
                            }
                            else
                            {
                                <span class="badge badge-red">Short @shortfall.ToString("C")</span>
                            }
                            @if (bill.IsAutoPay)
                            {
                                <span class="badge badge-gray" style="margin-left:4px">Auto</span>
                            }
                            @if (bill.DebtId is not null && occ.DueDate.Date > DateTime.Today)
                            {
                                <span class="badge badge-teal" style="margin-left:4px">Pay early</span>
                            }
                            @{var danger = GetDangerBadge(bill, occ.DueDate);}
                            @if (!string.IsNullOrEmpty(danger))
                            {
                                <span class="badge @(danger=="Danger"?"badge-red":"badge-amber")" style="margin-left:4px">@danger</span>
                            }
                        </div>
                    }
                </div>
                <span class="row-amount neg" style="@(isPaid?"opacity:0.5":"")">@bill.AmountDollars.ToString("C")</span>
            </div>
        }
    }
</div>
}

<div style="height:16px"></div>

@if (editingBill is not null)
{
    <AddEditBillModal Bill="@(editingBill.Id == 0 ? null : editingBill)"
        OnClose="() => editingBill = null"
        OnSaved="OnBillSaved" />
}

@code {
    private string filter = "Unpaid";
    private string _search = string.Empty;
    private Bill? editingBill;
    private List<BillOccurrencePreview> DueSoonBills =>
        State.GetUpcomingBillOccurrences(DateTime.Today, DateTime.Today.AddDays(14))
            .Take(12)
            .ToList();

    private void StartEdit(Bill bill) => editingBill = bill;

    private Task OnBillSaved()
    {
        editingBill = null;
        return Task.CompletedTask;
    }

    // Combines whatever's currently due-or-overdue with future occurrences out
    // to `aheadDays`, so weekly/fortnightly bills count every cycle in the
    // window instead of just their single next occurrence. Deduped since the
    // current cycle can appear in both source lists.
    private List<BillOccurrencePreview> AllUnpaidOccurrences(List<BillOccurrencePreview> outstanding, int aheadDays)
    {
        return outstanding
            .Concat(State.GetUpcomingBillOccurrences(DateTime.Today, DateTime.Today.AddDays(aheadDays)))
            .GroupBy(o => (o.Bill.Id, o.DueDate.Date))
            .Select(g => g.First())
            .ToList();
    }

    // Installment-debt bills (Bill.DebtId set) support paying the next cycle
    // early — e.g. settling next fortnight's Afterpay installment before it's
    // due. "Pay early" only makes sense when the current occurrence is already
    // at hand (due today or overdue); for future-dated debt bills the single
    // outstanding occurrence is shown and no additional preview is needed.
    private List<BillOccurrencePreview> UnpaidWithEarlyInstallments()
    {
        var outstanding = State.GetOutstandingBillOccurrences();
        // Debt bills that are already due today or overdue — only these get the
        // "next occurrence" surfaced so the user can pay it early.
        var currentDebtBillIds = outstanding
            .Where(o => o.Bill.DebtId is not null && o.DueDate.Date <= DateTime.Today)
            .Select(o => o.Bill.Id)
            .ToHashSet();
        var futureInstallments = State.GetUpcomingBillOccurrences(DateTime.Today.AddDays(1), DateTime.Today.AddDays(90))
            .Where(o => o.Bill.DebtId is not null && currentDebtBillIds.Contains(o.Bill.Id))
            .GroupBy(o => o.Bill.Id)
            .Select(g => g.OrderBy(o => o.DueDate).First());
        return outstanding
            .Concat(futureInstallments)
            .GroupBy(o => (o.Bill.Id, o.DueDate.Date))
            .Select(g => g.First())
            .OrderBy(o => o.DueDate)
            .ToList();
    }

    private List<BillOccurrencePreview> GetFiltered()
    {
        IEnumerable<BillOccurrencePreview> q = filter switch
        {
            "Unpaid" => UnpaidWithEarlyInstallments(),
            "Paid"   => State.GetPaidBillOccurrences(),
            _        => UnpaidWithEarlyInstallments()
                            .Concat(State.GetPaidBillOccurrences())
                            .OrderBy(o => o.DueDate)
        };
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(o => o.Bill.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));
        return q.ToList();
    }

    private string GetDangerBadge(Bill bill, DateTime dueDate)
    {
        var (covered, _) = State.GetBillCoverage(bill);
        if (!covered && dueDate.Date <= State.NextPayDate.Date) return "Danger";
        if (covered && dueDate.Date <= State.NextPayDate.Date) return "Ready";
        // Not covered + future: "Short $X" main badge already communicates this.
        // Covered + future: no additional badge needed.
        return string.Empty;
    }

    private readonly HashSet<int> _celebratedBillIds = new();

    private async Task TogglePaid(BillOccurrencePreview occ)
    {
        var markingPaid = !State.IsBillOccurrencePaid(occ.Bill, occ.DueDate);
        if (markingPaid && DateTime.Today < occ.DueDate.Date)
            _celebratedBillIds.Add(occ.Bill.Id);
        await State.MarkBillOccurrencePaidAsync(occ.Bill.Id, occ.DueDate, markingPaid);
    }

    private async Task MarkDuePaidAsync()
    {
        var dueNow = State.GetOutstandingBillOccurrences()
            .Where(o => o.DueDate.Date <= DateTime.Today)
            .ToList();

        foreach (var occ in dueNow)
            await State.MarkBillOccurrencePaidAsync(occ.Bill.Id, occ.DueDate, true);
    }

    private static string DueLabel(DateTime date)
    {
        var days = (date.Date - DateTime.Today).Days;
        if (days < 0) return "Overdue";
        if (days == 0) return "Today";
        if (days == 1) return "Tomorrow";
        return $"{days} days";
    }

    private List<Bill> GetBillsForList()
    {
        var q = State.Bills.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(b => b.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));
        return q.OrderBy(b => string.IsNullOrWhiteSpace(b.AccountName) ? "zzz" : b.AccountName)
                .ThenBy(b => b.Name)
                .ToList();
    }

    private static decimal BillWeekly(Bill b) => Math.Round(b.Frequency switch
    {
        BillFrequency.Weekly      => b.AmountDollars,
        BillFrequency.Fortnightly => b.AmountDollars / 2m,
        BillFrequency.Monthly     => b.AmountDollars / 4m,
        BillFrequency.Quarterly   => b.AmountDollars / 12m,
        BillFrequency.Yearly      => b.AmountDollars / 48m,
        _                         => 0m
    }, 2);

    private static string FreqAbbr(BillFrequency freq) => freq switch
    {
        BillFrequency.Weekly      => "Weekly",
        BillFrequency.Fortnightly => "Fortnightly",
        BillFrequency.Monthly     => "Monthly",
        BillFrequency.Quarterly   => "Quarterly",
        BillFrequency.Yearly      => "Yearly",
        _                         => "Monthly"
    };
}
