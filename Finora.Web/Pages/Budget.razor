            (goal.TargetStartingBalanceCents ?? 0) / 100m,
            goal.TargetStartDate,
            goal.TargetDate);

        return status switch
        {
            GoalMath.PaceStatus.AheadOfPace => ("Ahead of pace", "badge-green"),
            GoalMath.PaceStatus.OnPace => ("On pace", "badge-teal"),
            GoalMath.PaceStatus.BehindPace => ("Behind pace", "badge-amber"),
