@page "/budget"
@inject AppState State
@inject NavigationManager Nav
@inject UiState Ui

<PageTitle>Budget - Evergrove</PageTitle>

<div class="pill-tabs budget-tabs">
    @foreach (var t in new[]{"Overview","Spending","History","Forecast","Daily","Holiday"})
    {
        <button class="pill @(_tab==t?"pill-active":"pill-inactive")" @onclick="() => SelectTopPill(t)">@t</button>
    }
</div>

<div class="budget-page">

@if (_tab == "Overview")
{
    <div>
    @{
        var transferPlan = GetFullTransferPlan();
        var allDone = transferPlan.Any() && transferPlan.All(x => x.IsDone);
        var payBalance = State.GetAccountBalance(State.PayAccountId);
        var totalStillNeeded = transferPlan.Where(x => !x.IsDone).Sum(x => x.Remaining);
        var afterTransfers = payBalance - totalStillNeeded;
        var unrepaid = State.LentTransactions.Where(l => State.IsUnrepaid(l.Id))
            .Select(l => (Lent: l, Txn: State.Transactions.FirstOrDefault(t => t.Id == l.Id)))
            .Where(x => x.Txn is not null)
            .OrderByDescending(x => x.Txn!.Date)
            .ToList();
        var trulyOverBudget = State.BudgetSafeToSpendAmount <= 0 && State.WeeklyIncome > 0;
        var committedThisCycle = WhatIfAllocated * PayCycleWeeks;
        var spendRoom = Math.Max(State.BudgetSafeToSpendAmount, 0m);
        var dailyRoomTop = spendRoom / Math.Max((State.NextPayDate.Date - DateTime.Today).Days, 1);
    }
    <section class="budget-hero-card @(trulyOverBudget ? "is-tight" : totalStillNeeded > 0 ? "is-warning" : "is-ok")">
        <div class="budget-hero-main">
            <span>Budget today</span>
            <strong>@(trulyOverBudget ? "Hold spending" : spendRoom.ToString("C"))</strong>
            <small>
                @(trulyOverBudget
                    ? "Your planned money is fully allocated for this cycle."
                    : $"{dailyRoomTop:C}/day until {State.NextPayDate:dd MMM}.")
            </small>
        </div>
        <div class="budget-hero-side">
            <div>
                <span>To fund</span>
                <strong>@totalStillNeeded.ToString("C")</strong>
            </div>
            <div>
                <span>Committed</span>
                <strong>@committedThisCycle.ToString("C")</strong>
            </div>
        </div>
    </section>
    <!-- Budget overview card -->
    <div class="card" style="margin-top:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
            <div class="section-title">Planned Weekly Budget</div>
            <div style="display:flex;gap:6px;align-items:center">
                @if (!_editingBudget)
                {
                    <button class="btn btn-sm btn-secondary" @onclick="() => { _showBudgetAddPicker = !_showBudgetAddPicker; _showBudgetEnvelopeForm = false; }">+ Add</button>
                }
                @if (State.WeeklyIncome > 0 || _editingBudget)
                {
                    <button class="btn btn-sm btn-secondary" @onclick="() => { _editingBudget = !_editingBudget; _showBudgetAddPicker = false; _showBudgetEnvelopeForm = false; }">@(_editingBudget ? "Done" : "Edit")</button>
                }
            </div>
        </div>
        @if (_showBudgetAddPicker && !_editingBudget)
        {
            <div style="margin-bottom:10px;padding:10px;background:var(--surface2);border-radius:10px">
                @if (!_showBudgetEnvelopeForm)
                {
                    <div style="font-size:12px;color:var(--text3);margin-bottom:8px;font-weight:600">What would you like to add?</div>
                    <div style="display:flex;flex-direction:column;gap:6px">
                        <button class="btn btn-secondary btn-sm" style="text-align:left;justify-content:flex-start" @onclick="() => { Ui.OpenAddBill(); _showBudgetAddPicker = false; }">
                            A recurring bill
                        </button>
                        <button class="btn btn-secondary btn-sm" style="text-align:left;justify-content:flex-start" @onclick="() => { _goalDraft = new SavingsGoal(); _showBudgetAddPicker = false; }">
                            Something I'm saving for
                        </button>
                        <button class="btn btn-secondary btn-sm" style="text-align:left;justify-content:flex-start" @onclick="() => _showBudgetEnvelopeForm = true">
                            A budget envelope (custom weekly amount)
                        </button>
                    </div>
                }
                else
                {
                    <div style="font-size:12px;color:var(--text3);margin-bottom:8px;font-weight:600">New budget envelope</div>
                    <div style="display:flex;flex-direction:column;gap:8px">
                        <input class="form-input" placeholder="Name (e.g. Petrol, Date nights)" style="font-size:14px"
                               @bind="_newEnvelopeName" @bind:event="oninput" />
                        <input class="form-input" type="number" min="1" step="1" placeholder="Weekly amount"
                               style="font-size:14px" @bind="_newEnvelopeAmount" @bind:event="oninput" />
                        <div style="display:flex;gap:6px">
                            <button class="btn btn-primary btn-sm" style="flex:1" @onclick="SaveBudgetEnvelopeAsync"
                                    disabled="@(string.IsNullOrWhiteSpace(_newEnvelopeName) || string.IsNullOrWhiteSpace(_newEnvelopeAmount))">Save</button>
                            <button class="btn btn-secondary btn-sm" @onclick="() => { _showBudgetEnvelopeForm = false; _newEnvelopeName = string.Empty; _newEnvelopeAmount = string.Empty; }">Cancel</button>
                        </div>
                    </div>
                }
            </div>
        }
        <div style="font-size:11px;color:var(--text3);margin-bottom:12px;opacity:0.7">
            @(_editingBudget ? "Set your own weekly targets from your phone - overrides the PC budget until changed again." : "How you've told PC to split your income each week")
            @if (!_editingBudget && State.WeeklyIncome > 0)
            {
                var _uColor = State.BudgetLeftover >= 0 ? "#92400E" : "#B91C1C";
                <span style="font-weight:700;color:@_uColor;opacity:1"> · @State.BudgetLeftover.ToString("C") unallocated</span>
            }
        </div>
        @if (!_editingBudget && transferPlan.Any())
        {
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:12px">
                <div style="background:var(--surface2);border-radius:8px;padding:8px">
                    <div class="stat-label">Pay account</div>
                    <div style="font-size:14px;font-weight:700">@payBalance.ToString("C")</div>
                </div>
                <div style="background:var(--surface2);border-radius:8px;padding:8px">
                    <div class="stat-label">After moves</div>
                    <div style="font-size:14px;font-weight:700;color:@(afterTransfers >= 0 ? "var(--green)" : "var(--red)")">@afterTransfers.ToString("C")</div>
                </div>
            </div>
        }
        @if (_editingBudget)
        {
            <div style="display:flex;flex-direction:column;gap:10px">
                @if (_smartSuggestion is null)
                {
                    <button class="btn btn-secondary btn-sm" style="align-self:flex-start;display:inline-flex;align-items:center;gap:5px" @onclick="PreviewSmartBudget"><Icon Name="sparkles" Size="13" /> Suggest a smart budget</button>
                }
                else
                {
                    <div style="background:var(--surface2);border-radius:10px;padding:10px;font-size:12px">
                        <div style="font-weight:600;margin-bottom:6px">Based on your last 8 weeks of activity</div>
                        <div style="display:flex;justify-content:space-between;margin-bottom:3px"><span>Income</span><strong>@_smartSuggestion.Income.ToString("C")</strong></div>
                        <div style="display:flex;justify-content:space-between;margin-bottom:3px"><span>Bills</span><strong>@_smartSuggestion.Bills.ToString("C")</strong></div>
                        <div style="display:flex;justify-content:space-between;margin-bottom:3px"><span>Essentials</span><strong>@_smartSuggestion.Essentials.ToString("C")</strong></div>
                        <div style="display:flex;justify-content:space-between;margin-bottom:3px"><span>Savings</span><strong>@_smartSuggestion.Savings.ToString("C")</strong></div>
                        <div style="display:flex;justify-content:space-between"><span>Unplanned</span><strong>@_smartSuggestion.Unplanned.ToString("C")</strong></div>
                        <div style="display:flex;gap:8px;margin-top:8px">
                            <button class="btn btn-primary btn-sm" style="flex:1" @onclick="ApplySmartBudgetAsync">Apply</button>
                            <button class="btn btn-secondary btn-sm" style="flex:1" @onclick="() => _smartSuggestion = null">Dismiss</button>
                        </div>
                    </div>
                }
                <div style="display:flex;align-items:center;gap:8px">
                    <span style="flex:1;font-size:14px;font-weight:600">Weekly Income</span>
                    <input class="form-input" style="width:110px;text-align:right;padding:6px 10px;font-size:14px"
                           type="number" min="0" step="1" value="@State.WeeklyIncome"
                           @onchange='e => SetBudgetFieldAsync("Income", e)' />
                </div>
                @foreach (var (label, field, amount, color) in EditableBudgetRows())
                {
                    <div style="display:flex;align-items:center;gap:8px">
                        <div class="dot" style="background:@color"></div>
                        <span style="flex:1;font-size:14px">@label</span>
                        <input class="form-input" style="width:110px;text-align:right;padding:6px 10px;font-size:14px"
                               type="number" min="0" step="1" value="@amount"
                               @onchange="e => SetBudgetFieldAsync(field, e)" />
                    </div>
                }
                <div style="font-size:11px;color:var(--text3);margin-top:2px">Unallocated (spending budget): <strong>@State.BudgetLeftover.ToString("C")</strong>/wk</div>
            </div>
        }
        else if (State.WeeklyIncome <= 0)
        {
            <div style="color:var(--text3);font-size:14px">No budget set up yet. Sync from your PC, or tap Edit to set one up here.</div>
            <button class="btn btn-primary btn-sm" style="margin-top:10px" @onclick='() => Nav.NavigateTo("settings")'>Open Sync Settings</button>
        }
        else
        {
            var usedPct = State.WeeklyIncome > 0 ? Math.Min(WhatIfAllocated / State.WeeklyIncome, 1) : 0;
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
                <span style="font-size:26px;font-weight:700">@State.WeeklyIncome.ToString("C")</span>
                <span style="font-size:13px;color:var(--text3)">per week</span>
            </div>
            <div class="progress-bar" style="height:8px;margin-bottom:12px">
                <div class="progress-fill" style="width:@((int)(usedPct*100))%;background:@(WhatIfUnallocated>=0?"var(--teal)":"var(--red)")"></div>
            </div>

            @foreach (var (label, amount, color) in BudgetRows().Where(r => r.Amount > 0))
            {
                var isExcluded = _excludedBudgetLabels.Contains(label);
                var subBills = BillsForBudgetCategory(label);
                var hasSubItems = subBills.Count > 0;
                var isExpanded = _expandedBudgetCategories.Contains(label);
                var excludedSubWeekly = subBills.Where(x => _excludedBillIds.Contains(x.Bill.Id)).Sum(x => x.Weekly);
                var effectiveAmount = isExcluded ? 0m : Math.Max(amount - excludedSubWeekly, 0m);
                var effectivePct = State.WeeklyIncome > 0 ? effectiveAmount / State.WeeklyIncome : 0;
                var (transferDone, transferNeeded, transferRequired) = GetBudgetCategoryTransferInfo(label);
                var transferCovered = transferRequired - transferNeeded;

                <div style="margin-bottom:10px">
                    <div style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;opacity:@(isExcluded ? "0.35" : "1")"
                         @onclick="@(() => { if (hasSubItems) ToggleExpandCategory(label); else ToggleBudgetRow(label); })">
                        <div class="dot" style="background:@color;margin-top:4px;flex-shrink:0"></div>
                        <div style="flex:1">
                            <div style="display:flex;justify-content:space-between;align-items:center">
                                <span style="font-size:14px;text-decoration:@(isExcluded ? "line-through" : "none")">@label</span>
                                <div style="display:flex;align-items:center;gap:5px">
                                    @if (transferDone == true)
                                    {
                                        <span style="font-size:11px;color:var(--green);font-weight:700;background:rgba(52,211,153,0.12);border:1px solid rgba(52,211,153,0.28);border-radius:999px;padding:2px 7px;white-space:nowrap" title="Enough has been transferred">Funded</span>
                                    }
                                    else if (transferDone == false)
                                    {
                                        <span style="font-size:11px;color:var(--amber);font-weight:700;background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.28);border-radius:999px;padding:2px 7px;white-space:nowrap" title="How much more to move to be caught up">Move@(transferNeeded > 0 ? " " + transferNeeded.ToString("C") : "")</span>
                                    }
                                    @if (excludedSubWeekly > 0 && !isExcluded)
                                    {
                                        <span style="font-size:11px;color:var(--green)">-@excludedSubWeekly.ToString("C")</span>
                                    }
                                    <span style="font-size:14px;font-weight:600;text-decoration:@(isExcluded ? "line-through" : "none")">@amount.ToString("C")</span>
                                    @if (hasSubItems)
                                    {
                                        <span style="font-size:10px;color:var(--text3);margin-left:2px">@(isExpanded ? "Hide" : "Show")</span>
                                    }
                                </div>
                            </div>
                            <div class="progress-bar" style="margin-top:4px;opacity:@(isExcluded ? "0.25" : "1")">
                                <div class="progress-fill" style="width:@((int)(Math.Clamp(effectivePct,0,1)*100))%;background:@color"></div>
                            </div>
                            @{
                                var paidBillCount = hasSubItems ? subBills.Count(x => State.IsBillPaid(x.Bill)) : 0;
                            }
                            <div style="display:flex;gap:6px;align-items:center;margin-top:2px;opacity:@(isExcluded ? "0.4" : "1")">
                                <span style="font-size:11px;color:var(--text3)">@effectivePct.ToString("P0") of income</span>
                                @if (hasSubItems && subBills.Count > 0)
                                {
                                    var allBillsPaid = paidBillCount == subBills.Count;
                                    <span style="font-size:10px;color:@(allBillsPaid ? "var(--teal)" : paidBillCount > 0 ? "var(--amber)" : "var(--text3)")">
                                        - @paidBillCount/@subBills.Count paid
                                    </span>
                                }
                            </div>
                            @if (transferDone == false && transferRequired > 0)
                            {
                                var coveredPct = (double)Math.Clamp(transferCovered / transferRequired, 0, 1);
                                <div style="margin-top:5px;opacity:@(isExcluded ? "0.4" : "1")">
                                    <div class="progress-bar" style="height:4px">
                                        <div class="progress-fill" style="width:@((int)(coveredPct*100))%;background:var(--amber)"></div>
                                    </div>
                                    <span style="font-size:10px;color:var(--text3);margin-top:2px;display:inline-block">
                                        @transferCovered.ToString("C") of @transferRequired.ToString("C") transferred this cycle
                                    </span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (hasSubItems && isExpanded && !isExcluded)
                    {
                        <div style="margin-left:22px;margin-top:5px;border:1px solid var(--border);border-radius:8px;overflow:hidden"
                             @onclick:stopPropagation="true">
                            @foreach (var (bill, weekly) in subBills)
                            {
                                var isBillExcluded = _excludedBillIds.Contains(bill.Id);
                                <div style="display:flex;align-items:center;gap:10px;padding:7px 10px;background:@(isBillExcluded ? "var(--surface3)" : "var(--surface)");border-bottom:1px solid var(--border);cursor:pointer;user-select:none"
                                     @onclick="@(() => ToggleBill(bill.Id))" @onclick:stopPropagation="true">
                                    <!-- Checkbox indicator -->
                                    <div style="width:18px;height:18px;border-radius:4px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:@(isBillExcluded ? "var(--surface2)" : color);border:@(isBillExcluded ? "1.5px solid var(--border)" : "none");transition:background 0.15s">
                                        @if (!isBillExcluded)
                                        {
                                            <svg width="11" height="9" viewBox="0 0 11 9" fill="none"><path d="M1 4l3 3 6-6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                        }
                                    </div>
                                    <div style="flex:1;min-width:0;opacity:@(isBillExcluded ? "0.45" : "1")">
                                        <div style="font-size:13px;text-decoration:@(isBillExcluded ? "line-through" : "none");overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@bill.Name</div>
                                        <div style="font-size:10px;color:var(--text3)">@FreqAbbr(bill.Frequency) - @bill.AmountDollars.ToString("C")</div>
                                    </div>
                                    <span style="font-size:12px;font-weight:600;flex-shrink:0;min-width:52px;text-align:right;opacity:@(isBillExcluded ? "0.45" : "1");text-decoration:@(isBillExcluded ? "line-through" : "none")">@weekly.ToString("C")/wk</span>
                                </div>
                            }
                            <div style="display:flex;justify-content:space-between;align-items:center;padding:5px 10px;background:var(--surface2)">
                                <span style="font-size:10px;color:var(--text3)">Tap to include / exclude from what-if</span>
                                @if (subBills.Any(x => _excludedBillIds.Contains(x.Bill.Id)))
                                {
                                    <button @onclick="@(() => RestoreAllBillsInCategory(label))" @onclick:stopPropagation="true"
                                            style="background:none;border:none;color:var(--teal);font-size:11px;cursor:pointer;padding:0;text-decoration:underline">
                                        Restore all
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            @if (_excludedBudgetLabels.Count > 0 || _excludedBillIds.Count > 0)
            {
                <div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0 2px;border-top:1px solid var(--border);margin-top:2px">
                    <span style="font-size:12px;color:var(--text3)">@(_excludedBudgetLabels.Count + _excludedBillIds.Count) excluded - tap to restore</span>
                    <button @onclick="@(() => { _excludedBudgetLabels.Clear(); _excludedBillIds.Clear(); })" style="background:none;border:none;color:var(--teal);font-size:12px;cursor:pointer;padding:0;text-decoration:underline">Reset all</button>
                </div>
            }

            @if (State.PlannedSavingsTransfers > 0)
            {
                <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:8px">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                        <span style="font-size:13px;color:var(--text3)">Weekly savings transfers</span>
                        <span style="font-size:14px;font-weight:700;color:var(--teal)">@State.PlannedSavingsTransfers.ToString("C")/wk</span>
                    </div>
                    @foreach (var goal in State.SavingsGoals.Where(g => g.WeeklyContributionDollars > 0))
                    {
                        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
                            <span style="color:var(--text2)">@goal.Name</span>
                            <span style="font-weight:600">@goal.WeeklyContributionDollars.ToString("C")/wk</span>
                        </div>
                    }
                    @foreach (var trip in State.Trips.Where(t => t.WeeklyContributionDollars > 0))
                    {
                        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
                            <span style="color:var(--text2)">@trip.Name holiday</span>
                            <span style="font-weight:600">@trip.WeeklyContributionDollars.ToString("C")/wk</span>
                        </div>
                    }
                </div>
            }

            @if (AllocatedTotal > 0)
            {
                <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:8px;display:flex;justify-content:space-between;align-items:center">
                    <span style="font-size:13px;color:var(--text3)">Weekly transfers total</span>
                    <span style="font-size:15px;font-weight:700;color:var(--green)">@WhatIfAllocated.ToString("C")/wk</span>
                </div>
            }

            <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:4px">
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <span style="font-size:14px;color:var(--text3)">Unallocated (your spending budget)</span>
                    <span style="font-size:16px;font-weight:700;color:@(WhatIfUnallocated>=0?"var(--green)":"var(--red)")">
                        @WhatIfUnallocated.ToString("C")
                    </span>
                </div>
                @if (_excludedBudgetLabels.Count > 0 || _excludedBillIds.Count > 0)
                {
                    var freed = WhatIfUnallocated - State.BudgetLeftover;
                    <div style="font-size:12px;color:var(--green);text-align:right;margin-top:2px">+@freed.ToString("C") if those items were removed</div>
                }
            </div>
        }
    </div>

    <!-- Weekly Commitments breakdown: bills grouped by account + savings/trips -->
    @if (State.WeeklyIncome > 0 && (State.Bills.Any() || State.SavingsGoals.Any(g => g.WeeklyContributionDollars > 0) || State.Trips.Any(t => t.WeeklyContributionDollars > 0)))
    {
        // Bills grouped by account name, sorted by account name then bill name
        var wkBillGroups = State.Bills
            .Select(b => (Bill: b, Weekly: BillWeekly(b)))
            .Where(x => x.Weekly > 0)
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Bill.AccountName) ? "Other" : x.Bill.AccountName)
            .OrderBy(g => g.Key)
            .Select(g => (Account: g.Key, Total: g.Sum(x => x.Weekly), Bills: g.OrderBy(x => x.Bill.Name).ToList()))
            .ToList();
        var wkGoalRows = State.SavingsGoals
            .Where(g => g.WeeklyContributionDollars > 0)
            .OrderBy(g => g.TargetDate ?? DateTime.MaxValue)
            .ThenBy(g => g.Name)
            .ToList();
        var wkTripRows = State.Trips
            .Where(t => t.WeeklyContributionDollars > 0)
            .OrderBy(t => t.Name)
            .ToList();
        var totalBillsWk = wkBillGroups.Sum(g => g.Total);
        var totalSavingsWk = wkGoalRows.Sum(g => g.WeeklyContributionDollars) + wkTripRows.Sum(t => t.WeeklyContributionDollars);
        var grandTotal = totalBillsWk + totalSavingsWk;

        <div class="card" style="margin-top:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;cursor:pointer;user-select:none" @onclick="() => _showWeeklyBreakdown = !_showWeeklyBreakdown">
                <div>
                    <div class="section-title">Weekly Commitments</div>
                    <div style="font-size:11px;color:var(--text3);opacity:0.7;margin-top:2px">What takes money each week</div>
                </div>
                <div style="text-align:right;flex-shrink:0">
                    <div style="font-size:15px;font-weight:700;color:var(--red)">@grandTotal.ToString("C")<span style="font-size:10px;font-weight:400;color:var(--text3)">/wk</span></div>
                    <div style="font-size:10px;color:var(--text3);margin-top:2px">@(_showWeeklyBreakdown ? "hide" : "show")</div>
                </div>
            </div>

            @if (_showWeeklyBreakdown)
            {
                @if (wkBillGroups.Any())
                {
                    <div style="margin-top:12px;border-top:1px solid var(--border);padding-top:10px">
                        <div style="display:flex;justify-content:space-between;font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text3);margin-bottom:10px">
                            <span>Bills by account</span>
                            <span>@totalBillsWk.ToString("C")/wk</span>
                        </div>
                        @foreach (var (account, accountTotal, bills) in wkBillGroups)
                        {
                            var grpCat = State.GetBillAccountBudgetCategory(account);
                            var (grpColor, grpBg) = CatColors(grpCat);
                            <!-- Account header â€” pill sets the default for all unoverridden bills in this group -->
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;padding:5px 8px;background:var(--surface2);border-radius:7px">
                                <div style="display:flex;align-items:center;gap:6px;flex:1;min-width:0">
                                    <span style="font-size:12px;font-weight:700;color:var(--text2)">@account</span>
                                    <span style="font-size:10px;padding:2px 7px;border-radius:10px;cursor:pointer;background:@grpBg;color:@grpColor;font-weight:600;flex-shrink:0"
                                          @onclick='() => OpenCategoryPicker($"BillAccountBudgetCategory:{account}", grpCat)'
                                          @onclick:stopPropagation="true">
                                        @grpCat
                                    </span>
                                </div>
                                <span style="font-size:13px;font-weight:700;color:var(--teal);flex-shrink:0">@accountTotal.ToString("C")/wk</span>
                            </div>
                            @foreach (var (bill, weekly) in bills)
                            {
                                var itemCat = State.GetBillBudgetCategory(bill);
                                var (iColor, iBg) = CatColors(itemCat);
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;padding-left:8px;cursor:pointer" @onclick="() => _billDraft = bill">
                                    <span style="flex:1;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@bill.Name</span>
                                    <span style="font-size:9px;padding:1px 5px;border-radius:8px;cursor:pointer;background:@iBg;color:@iColor;font-weight:600;flex-shrink:0;line-height:1.6"
                                          @onclick='() => OpenCategoryPicker($"BillItemBudgetCategory:{bill.Id}", itemCat)'
                                          @onclick:stopPropagation="true">
                                        @itemCat
                                    </span>
                                    <span style="font-size:11px;color:var(--text3);flex-shrink:0">@FreqAbbr(bill.Frequency) @bill.AmountDollars.ToString("C")</span>
                                    <span style="font-size:13px;font-weight:600;flex-shrink:0;min-width:56px;text-align:right">@weekly.ToString("C")/wk</span>
                                </div>
                            }
                            <div style="height:6px"></div>
                        }
                    </div>
                }

                @if (wkGoalRows.Any() || wkTripRows.Any())
                {
                    <div style="margin-top:4px;border-top:1px solid var(--border);padding-top:10px">
                        <div style="display:flex;justify-content:space-between;font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text3);margin-bottom:8px">
                            <span>Savings & Holidays</span>
                            <span>@totalSavingsWk.ToString("C")/wk</span>
                        </div>
                        @foreach (var g in wkGoalRows)
                        {
                            var gCat = State.GetGoalBudgetCategory(g.Id);
                            var (gColor, gBg) = CatColors(gCat);
                            <div style="display:flex;align-items:center;gap:8px;margin-bottom:7px;cursor:pointer" @onclick="() => _goalDraft = g">
                                <span style="flex:1;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                    @if (!string.IsNullOrEmpty(g.Emoji)) { <span>@g.Emoji </span> }
                                    @g.Name
                                </span>
                                <span style="font-size:9px;padding:1px 5px;border-radius:8px;cursor:pointer;background:@gBg;color:@gColor;font-weight:600;flex-shrink:0;line-height:1.6"
                                      @onclick='() => OpenCategoryPicker($"GoalBudgetCategory:{g.Id}", gCat)'
                                      @onclick:stopPropagation="true">
                                    @gCat
                                </span>
                                <span style="font-size:13px;font-weight:600;flex-shrink:0;min-width:56px;text-align:right">@g.WeeklyContributionDollars.ToString("C")/wk</span>
                            </div>
                        }
                        @foreach (var t in wkTripRows)
                        {
                            var tCat = State.GetTripBudgetCategory(t.Id);
                            var (tColor, tBg) = CatColors(tCat);
                            <div style="display:flex;align-items:center;gap:8px;margin-bottom:7px;cursor:pointer" @onclick='() => SelectTopPill("Holiday")'>
                                <span style="flex:1;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@t.Name holiday</span>
                                <span style="font-size:9px;padding:1px 5px;border-radius:8px;cursor:pointer;background:@tBg;color:@tColor;font-weight:600;flex-shrink:0;line-height:1.6"
                                      @onclick='() => OpenCategoryPicker($"TripBudgetCategory:{t.Id}", tCat)'
                                      @onclick:stopPropagation="true">
                                    @tCat
                                </span>
                                <span style="font-size:13px;font-weight:600;flex-shrink:0;min-width:56px;text-align:right">@t.WeeklyContributionDollars.ToString("C")/wk</span>
                            </div>
                        }
                    </div>
                }

                <div style="border-top:1px solid var(--border);margin-top:4px;padding-top:8px;display:flex;justify-content:space-between;align-items:baseline">
                    <span style="font-size:13px;color:var(--text3)">Total committed</span>
                    <div style="text-align:right">
                        <span style="font-size:15px;font-weight:700;color:var(--red)">@grandTotal.ToString("C")/wk</span>
                        <div style="font-size:11px;color:var(--text3)">@((grandTotal / State.WeeklyIncome).ToString("P0")) of @State.WeeklyIncome.ToString("C") income</div>
                    </div>
                </div>
            }
        </div>
    }

    @if (State.WeeklyIncome > 0)
    {
        var todayInPeriod = DateTime.Today.Date < PeriodRange.From.Date
            ? PeriodRange.From.Date
            : DateTime.Today.Date > PeriodRange.To.Date ? PeriodRange.To.Date : DateTime.Today.Date;
        var elapsedDays = Math.Clamp((todayInPeriod - PeriodRange.From.Date).Days + 1, 1, PeriodDays);
        var daysRemaining = Math.Max((PeriodRange.To.Date - todayInPeriod).Days + 1, 1);
        var spendToDate = State.GetDiscretionarySpendingForPeriod(PeriodRange.From, todayInPeriod);
        var planRemainingBudget = PeriodBudget - spendToDate;
        var spendingCash = State.SpendingCashBalance;
        var remainingBudget = planRemainingBudget > 0 ? Math.Min(planRemainingBudget, spendingCash) : planRemainingBudget;
        var dailyRoom = Math.Max(remainingBudget / daysRemaining, 0);
        var planDailyRoom = Math.Max(planRemainingBudget / daysRemaining, 0);
        var currentDailyAverage = spendToDate / elapsedDays;

        // Recent 3-day trend for smarter projection
        var recentDays = Math.Min(3, elapsedDays);
        var recentFrom = todayInPeriod.AddDays(-(recentDays - 1));
        var recentSpend = State.GetDiscretionarySpendingForPeriod(recentFrom, todayInPeriod);
        var recentDailyRate = recentDays > 0 ? recentSpend / recentDays : currentDailyAverage;
        // Blend: 60% recent rate + 40% period average once we have â‰¥4 days of data
        var projectionRate = elapsedDays >= 4
            ? recentDailyRate * 0.6m + currentDailyAverage * 0.4m
            : currentDailyAverage;
        // Today's spend â€” needed before projectedSpend so we can exclude it from the
        // projection base (today is already counted in daysRemaining, so projecting
        // from "spend excluding today" Ã— daysRemaining avoids a double-count).
        var todaySpend = State.GetDiscretionarySpendingForPeriod(DateTime.Today, DateTime.Today);
        var projectedSpend = Math.Round((spendToDate - todaySpend) + projectionRate * daysRemaining, 2);
        var projectedDelta = projectedSpend - PeriodBudget;

        var isOverBudget = planRemainingBudget < 0;
        var isTrendingOver = !isOverBudget && projectedDelta > 0;
        var paceColor = isOverBudget ? "var(--red)" : isTrendingOver ? "var(--amber)" : "var(--green)";
        var paceTitle = isOverBudget ? "Over budget" : isTrendingOver ? "Slow down" : "On track";
        var todayRemaining = Math.Max(dailyRoom - todaySpend, 0);
        var todayPct = dailyRoom > 0 ? (double)Math.Min(todaySpend / dailyRoom, 1.5m) : 0;

        // Upcoming unpaid bills due before the end of this pay period
        var upcomingBills = State.GetUpcomingBillOccurrences(DateTime.Today.AddDays(1), PeriodRange.To);
        var upcomingBillsTotal = upcomingBills.Sum(o => o.Bill.AmountDollars);

        var paceSummary = BuildSpendingPaceSummary(spendToDate, PeriodBudget, remainingBudget, dailyRoom, daysRemaining, projectedDelta, PeriodNounLower);
        var paceCategoryOptions = PaceCategoryOptions();
        var paceNameOptions = PaceRecurringNameOptions();
        var paceExcludedCount = State.PaceExcludedCategories.Count + State.PaceExcludedTransactionNames.Count;
        var paceRecommendations = BuildSpendingPaceRecommendations(planRemainingBudget, dailyRoom, daysRemaining, projectedDelta, paceExcludedCount, paceNameOptions.Count);
        <div class="card" style="margin-top:12px;border-color:@(isOverBudget ? "rgba(248,113,113,0.35)" : isTrendingOver ? "rgba(251,191,36,0.35)" : "rgba(52,211,153,0.35)")">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px">
                <div>
                    <div class="section-title">Spending Pace</div>
                    <div style="font-size:18px;font-weight:700;color:@paceColor">
                        @paceTitle
                    </div>
                </div>
                <div style="text-align:right">
                    <div style="font-size:11px;color:var(--text3)">Budget left</div>
                    <div style="font-size:16px;font-weight:700;color:@(remainingBudget >= 0 ? "var(--green)" : "var(--red)")">
                        @(remainingBudget >= 0 ? remainingBudget.ToString("C") : $"{Math.Abs(remainingBudget):C} over")
                    </div>
                </div>
            </div>
            @{
                var _spendRatioPct = PeriodBudget > 0 ? (int)(Math.Min((double)(spendToDate / PeriodBudget), 1.0) * 100) : 0;
            }
            <div style="margin-top:8px;height:3px;border-radius:2px;background:var(--surface3);overflow:hidden">
                <div style="height:100%;width:@_spendRatioPct%;background:@paceColor;border-radius:2px;transition:width 0.4s ease"></div>
            </div>
            <div style="font-size:12px;color:var(--text2);margin-top:6px;line-height:1.35">@paceSummary</div>
            <div style="font-size:11px;color:var(--text3);margin-top:5px;opacity:0.8">Discretionary only - @PeriodRange.From.ToString("d MMM")-@todayInPeriod.ToString("d MMM") - bills, transfers and exclusions ignored</div>

            <!-- Time-vs-budget bar: shows how far into the period you are vs how much budget you've used -->
            @{
                var timeFracD = PeriodDays > 0 ? (double)elapsedDays / PeriodDays : 0.0;
                var budgetFracD = PeriodBudget > 0 ? Math.Min((double)(spendToDate / PeriodBudget), 1.5) : 0.0;
                var aheadOfPace = !isOverBudget && budgetFracD < timeFracD - 0.05;
                var behindPace  = !isOverBudget && budgetFracD > timeFracD + 0.05;
                var paceBarColor = isOverBudget ? "var(--red)" : behindPace ? "var(--amber)" : "var(--teal)";
            }
            <div style="margin-top:10px">
                <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px">
                    <span style="font-size:10px;color:var(--text3)">Day @elapsedDays of @PeriodDays</span>
                    <span style="font-size:10px;color:@paceBarColor">@($"{budgetFracD * 100:F0}")% of budget used</span>
                </div>
                <div style="position:relative;height:6px;border-radius:4px;overflow:hidden;background:var(--surface3)">
                    <div style="position:absolute;top:0;left:0;height:100%;width:@($"{timeFracD * 100:F0}")%;background:var(--text3);opacity:0.2;border-radius:4px"></div>
                    <div style="position:absolute;top:0;left:0;height:100%;width:@($"{Math.Min(budgetFracD, 1.0) * 100:F0}")%;background:@paceBarColor;border-radius:4px"></div>
                </div>
                <div style="font-size:10px;color:var(--text3);margin-top:3px">
                    @if (isOverBudget) { <span style="color:var(--red)">Over budget</span> }
                    else if (aheadOfPace) { <span style="color:var(--teal)">Ahead - spending less than time elapsed</span> }
                    else if (behindPace) { <span style="color:var(--amber)">Spending faster than time elapsed</span> }
                    else { <span>Spending in step with time</span> }
                </div>
            </div>

            <!-- Today mini-bar -->
            <div style="margin-top:10px;padding:8px 10px;background:var(--surface2);border-radius:8px">
                <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:5px">
                    <span style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text3)">Today</span>
                    <span style="font-size:13px;font-weight:600;color:@(todaySpend>dailyRoom?"var(--red)":"var(--text)")">
                        @todaySpend.ToString("C") spent
                        @if (dailyRoom > 0) { <span style="font-weight:400;color:var(--text3)"> - @todayRemaining.ToString("C") left</span> }
                    </span>
                </div>
                <div style="background:var(--border);border-radius:4px;height:5px;overflow:hidden">
                    <div style="height:100%;border-radius:4px;background:@(todaySpend>dailyRoom?"var(--red)":"var(--teal)");width:@((int)(todayPct*100))%;transition:width 0.3s ease"></div>
                </div>
                @if (dailyRoom > 0)
                {
                    <div style="font-size:10px;color:var(--text3);margin-top:3px">Daily room: @dailyRoom.ToString("C")</div>
                }
            </div>

            <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:10px">
                <div style="background:var(--surface2);border-radius:8px;padding:8px;text-align:center">
                    <div class="stat-label">Spent</div>
                    <div style="font-size:14px;font-weight:700;color:@(isOverBudget ? "var(--red)" : "var(--text)")">@spendToDate.ToString("C")</div>
                </div>
                <div style="background:var(--surface2);border-radius:8px;padding:8px;text-align:center">
                    <div class="stat-label">Budget</div>
                    <div style="font-size:14px;font-weight:700">@PeriodBudget.ToString("C")</div>
                </div>
                <div style="background:var(--surface2);border-radius:8px;padding:8px;text-align:center">
                    <div class="stat-label">Forecast</div>
                    <div style="font-size:14px;font-weight:700;color:@paceColor">@projectedSpend.ToString("C")</div>
                    @if (elapsedDays >= 4 && Math.Abs(recentDailyRate - currentDailyAverage) > 1m)
                    {
                        <div style="font-size:9px;color:var(--text3);margin-top:1px">@(recentDailyRate > currentDailyAverage ? "accelerating" : "slowing")</div>
                    }
                </div>
            </div>

            <!-- Upcoming bills in this period -->
            @if (upcomingBills.Any())
            {
                <div style="margin-top:10px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.2);border-radius:8px;padding:9px 10px">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">
                        <span style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--amber)">Bills due before payday</span>
                        <span style="font-size:13px;font-weight:700;color:var(--amber)">@upcomingBillsTotal.ToString("C")</span>
                    </div>
                    @foreach (var occ in upcomingBills.Take(4))
                    {
                        <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text2);margin-top:3px">
                            <span>@occ.Bill.Name <span style="color:var(--text3)">- @occ.DueDate.ToString("d MMM")</span></span>
                            <span style="font-weight:600">@occ.Bill.AmountDollars.ToString("C")</span>
                        </div>
                    }
                    @if (upcomingBills.Count > 4)
                    {
                        <div style="font-size:11px;color:var(--text3);margin-top:3px">+@(upcomingBills.Count - 4) more</div>
                    }
                </div>
            }

            @if (paceRecommendations.Count > 0)
            {
                <div style="margin-top:10px;padding:9px 10px;background:var(--surface2);border-radius:8px">
                    <div style="font-size:11px;color:var(--text3);text-transform:uppercase;font-weight:700;margin-bottom:5px">Recommendations</div>
                    @foreach (var recommendation in paceRecommendations)
                    {
                        <div style="font-size:12px;color:var(--text2);line-height:1.35;margin-top:3px">@recommendation</div>
                    }
                </div>
            }
            <button class="btn btn-secondary btn-sm btn-full" style="margin-top:10px" @onclick="() => _showPaceExclusions = !_showPaceExclusions">
                @(_showPaceExclusions ? "Hide pace exclusions" : $"Manage pace exclusions ({paceExcludedCount})")
            </button>
            @if (_showPaceExclusions)
            {
                <div style="margin-top:10px;padding:9px 10px;background:var(--surface2);border-radius:8px">
                    <div style="font-size:11px;color:var(--text3);text-transform:uppercase;font-weight:700;margin-bottom:6px">Exclude categories</div>
                    @foreach (var category in paceCategoryOptions)
                    {
                        <label style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text2);margin-top:6px">
                            <input type="checkbox" checked="@State.IsPaceCategoryExcluded(category)" @onchange="(ChangeEventArgs e) => SetPaceCategoryExcludedAsync(category, e)" style="width:16px;height:16px;accent-color:var(--teal)" />
                            <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@category</span>
                        </label>
                    }
                    <div style="font-size:11px;color:var(--text3);text-transform:uppercase;font-weight:700;margin:10px 0 6px">Exclude repeating names</div>
                    @if (!paceNameOptions.Any())
                    {
                        <div style="font-size:12px;color:var(--text3)">No repeating transaction names found yet.</div>
                    }
                    @foreach (var name in paceNameOptions)
                    {
                        <label style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text2);margin-top:6px">
                            <input type="checkbox" checked="@State.IsPaceTransactionNameExcluded(name)" @onchange="(ChangeEventArgs e) => SetPaceTransactionNameExcludedAsync(name, e)" style="width:16px;height:16px;accent-color:var(--teal)" />
                            <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@name</span>
                        </label>
                    }
                </div>
            }
        </div>
    }

    <!-- Pending reimbursements -->
    @if (unrepaid.Any())
    {
        var totalOwed = unrepaid.Sum(x => State.GetLentOutstandingDollars(x.Txn!));
        var groups = unrepaid
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Lent.Note) ? "Other" : x.Lent.Note.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Sum(x => State.GetLentOutstandingDollars(x.Txn!)));
        <div class="card" style="margin-top:12px;border-color:rgba(99,102,241,0.4)">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <div>
                    <div class="section-title" style="display:flex;align-items:center;gap:6px"><Icon Name="users" Size="14" /> Pending Reimbursements</div>
                    <div style="font-size:11px;color:var(--text3);opacity:0.7;margin-top:2px">Excluded from your spending until marked repaid</div>
                </div>
                <span style="font-size:14px;font-weight:700;color:#818CF8">@totalOwed.ToString("C")</span>
            </div>
            @foreach (var group in groups)
            {
                var groupTotal = group.Sum(x => State.GetLentOutstandingDollars(x.Txn!));
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                    <span style="font-size:12px;font-weight:700;color:var(--text3);text-transform:uppercase">@group.Key</span>
                    <span style="font-size:12px;font-weight:600;color:#818CF8">@groupTotal.ToString("C")</span>
                </div>
                @foreach (var (lent, txn) in group)
                {
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--border)">
                        <div style="flex:1;min-width:0">
                            <div style="font-size:14px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@txn!.Description</div>
                            <div style="font-size:11px;color:var(--text3)">@txn.Date.ToString("d MMM")</div>
                        </div>
                        <span style="font-size:14px;font-weight:600;color:#818CF8;flex-shrink:0">@State.GetLentOutstandingDollars(txn).ToString("C") owed</span>
                        <button @onclick="() => State.MarkRepaidAsync(lent.Id)" style="background:rgba(52,211,153,0.1);border:1px solid rgba(52,211,153,0.4);color:var(--green);border-radius:8px;padding:4px 10px;font-size:12px;cursor:pointer;flex-shrink:0;display:inline-flex;align-items:center;gap:4px">
                            Got paid back <Icon Name="check" Size="12" />
                        </button>
                    </div>
                }
            }
        </div>
    }

    @if (true)
    {
    <!-- Debts -->
    @if (State.Debts.Any())
    {
        <div class="card" style="margin-top:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
                <div class="section-title">Debts</div>
                <span style="font-size:13px;font-weight:700;color:var(--red)">@State.Debts.Sum(d => d.BalanceDollars).ToString("C") total</span>
            </div>
            @foreach (var debt in State.Debts)
            {
                var paidOff = debt.OriginalBalanceDollars > 0
                    ? Math.Clamp(1m - debt.BalanceDollars / debt.OriginalBalanceDollars, 0m, 1m)
                    : 0m;
                var isFullyPaid = debt.BalanceDollars <= 0;
                <div style="margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border);cursor:pointer;opacity:@(isFullyPaid ? "0.8" : "1")" @onclick="() => _debtDraft = debt">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
                        <div style="display:flex;align-items:center;gap:8px">
                            <span style="font-size:14px;font-weight:600">@debt.Name</span>
                            @if (isFullyPaid)
                            {
                                <span style="font-size:11px;font-weight:700;color:#16A34A;background:#16A34A22;border-radius:20px;padding:2px 8px;line-height:1.4">Paid off</span>
                            }
                        </div>
                        <span style="font-size:15px;font-weight:700;color:@(isFullyPaid ? "#16A34A" : "var(--red)")">@debt.BalanceDollars.ToString("C")</span>
                    </div>
                    @if (!isFullyPaid && debt.InterestRate.HasValue && debt.InterestRate.Value > 0)
                    {
                        <div style="font-size:11px;color:var(--text3);margin-bottom:5px">
                            @debt.InterestRate.Value.ToString("P1") APR
                            @if (debt.MinimumPaymentDollars > 0)
                            { <span> - Min @debt.MinimumPaymentDollars.ToString("C")/@debt.PaymentPeriod.ToLower()</span> }
                        </div>
                    }
                    @if (debt.OriginalBalanceDollars > 0)
                    {
                        <div class="progress-bar" style="height:6px">
                            <div class="progress-fill" style="width:@((int)(paidOff*100))%;background:#16A34A"></div>
                        </div>
                        @if (!isFullyPaid)
                        {
                            <div style="font-size:11px;color:var(--text3);margin-top:3px">@paidOff.ToString("P0") paid off - started @debt.OriginalBalanceDollars.ToString("C")</div>
                        }
                        else
                        {
                            <div style="font-size:11px;color:#16A34A;margin-top:3px;font-weight:600">Fully paid off - started @debt.OriginalBalanceDollars.ToString("C")</div>
                        }
                    }
                </div>
            }
        </div>
    }

    <!-- Savings goals -->
    <div class="card" style="margin-top:12px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
            <span style="font-size:12px;color:var(--text3)">Savings Goals</span>
            <button class="btn btn-secondary btn-sm" @onclick='() => _goalDraft = new SavingsGoal()'>+ Add</button>
        </div>
        @if (!State.SavingsGoals.Any())
        {
            <div style="font-size:13px;color:var(--text3);text-align:center;padding:10px 0">No savings goals yet - tap "+ Add" to create one.</div>
        }
        else
        {
            @foreach (var group in State.GetSavingsGoalGroups())
            {
                var isGroupExpanded = string.Equals(_expandedGoalGroupName, group.Name, StringComparison.OrdinalIgnoreCase);
                var groupReached = group.TotalRemainingDollars <= 0;
                var groupWhatIfWeekly = _groupWhatIfWeekly.TryGetValue(group.Name, out var groupWeekly) && groupWeekly > 0
                    ? groupWeekly
                    : Math.Max(group.TotalWeeklyContributionDollars, 10m);
                var groupWhatIfWeeks = GoalMath.WeeksToTarget(group.TotalTargetDollars, group.TotalCurrentDollars, groupWhatIfWeekly);
                <div style="margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--border)">
                    <div style="cursor:pointer" @onclick="() => ToggleGoalGroup(group.Name)">
                        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px">
                            <span style="font-size:14px;font-weight:600">@group.Name <span style="font-size:11px;color:var(--text3);font-weight:400">(@group.Goals.Count goals)</span></span>
                            <span style="font-size:13px;color:var(--purple)">@group.TotalCurrentDollars.ToString("C") / @group.TotalTargetDollars.ToString("C")</span>
                        </div>
                        <div class="progress-bar" style="height:8px">
                            <div class="progress-fill" style="width:@((int)(group.Progress*100))%;background:var(--purple)"></div>
                        </div>
                        <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:4px">
                            <span>@group.Progress.ToString("P0") saved</span>
                            <span>@(isGroupExpanded ? "Tap to collapse" : "Tap to expand")</span>
                        </div>
                    </div>
                    @if (!groupReached)
                    {
                        <div style="margin-top:8px;padding:8px;background:var(--surface2);border-radius:8px" @onclick:stopPropagation="true">
                            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:4px">
                                <span style="font-size:11px;color:var(--text3)">What if I saved more?</span>
                                <span style="font-size:12px;font-weight:700;color:var(--purple)">@groupWhatIfWeekly.ToString("C")/wk</span>
                            </div>
                            <input type="range" min="10" max="@(Math.Max((double)group.TotalTargetDollars / 4, 100))" step="10"
                                   value="@groupWhatIfWeekly" style="width:100%"
                                   @oninput="@((ChangeEventArgs e) => OnGroupWhatIfSliderChangedAsync(group.Name, e))" />
                            <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text2);margin-top:2px">
                                <span>@(groupWhatIfWeeks < 0 ? "Choose a weekly amount" : $"All done in ~{groupWhatIfWeeks} week{(groupWhatIfWeeks == 1 ? "" : "s")}")</span>
                                <span>@group.TotalRemainingDollars.ToString("C") left</span>
                            </div>
                        </div>
                    }
                    @if (isGroupExpanded)
                    {
                        <div style="margin-top:10px;display:flex;flex-direction:column;gap:10px" @onclick:stopPropagation="true">
                            @foreach (var goal in group.Goals)
                            {
                                @GoalCardTemplate(goal)
                            }
                        </div>
                    }
                </div>
            }
            @foreach (var goal in State.SavingsGoals.Where(g => string.IsNullOrWhiteSpace(g.GroupName)))
            {
                <div style="margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border)">
                    @GoalCardTemplate(goal)
                </div>
            }
        }
    </div>

    <!-- Can I afford it? -->
    <div class="card" style="margin-top:12px">
        <div style="font-size:12px;color:var(--text3);margin-bottom:8px">Can I Afford It?</div>
        <div style="display:flex;gap:6px;margin-bottom:10px">
            <button class="pill @(_affordMode=="OneOff"?"pill-active":"pill-inactive")" style="flex:1;text-align:center" @onclick='() => SetAffordModeAsync("OneOff")'>One-off</button>
            <button class="pill @(_affordMode=="Savings"?"pill-active":"pill-inactive")" style="flex:1;text-align:center" @onclick='() => SetAffordModeAsync("Savings")'>Saving up</button>
            <button class="pill @(_affordMode=="Installments"?"pill-active":"pill-inactive")" style="flex:1;text-align:center" @onclick='() => SetAffordModeAsync("Installments")'>Installments</button>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
            <span style="font-size:18px;color:var(--text3);font-weight:300">$</span>
            <input class="form-input" type="number" min="0" step="1"
                   @bind="_affordAmount" @bind:event="oninput" @onchange="OnAffordAmountChanged"
                   placeholder="Enter amount..." style="flex:1;font-size:18px;font-weight:600" />
        </div>

        @if (_affordMode == "Savings")
        {
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
                <div style="flex:1;min-width:120px">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Over how many pay cycles?</label>
                    <input class="form-input" type="number" min="1" step="1" @bind="_goalWeeks" @bind:event="oninput" @onchange="OnGoalWeeksChanged" style="font-size:14px" />
                </div>
                <div style="flex:1;min-width:120px">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Or by date</label>
                    <input class="form-input" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@GoalTargetDate.ToString("yyyy-MM-dd")" @onchange="OnGoalTargetDateChanged" style="font-size:14px" />
                </div>
                <div style="flex:1;min-width:160px">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Saving into</label>
                    <select class="form-input" value="@_goalAccountName" @onchange="OnGoalAccountChanged" style="font-size:14px">
                        <option value="">No specific account</option>
                        @foreach (var acc in State.Accounts)
                        {
                            <option value="@acc.Name">@acc.Name</option>
                        }
                    </select>
                </div>
            </div>
            @if (State.AffordabilityGoalAccount is not null && State.GetAccountBalance(State.AffordabilityGoalAccount.Id) > 0)
            {
                <div style="font-size:11px;color:var(--text3);margin-top:6px">
                    The amount above is the total you want in @State.AffordabilityGoalAccount.Name - it already has @State.GetAccountBalance(State.AffordabilityGoalAccount.Id).ToString("C"), so only the rest counts toward what's still needed.
                </div>
            }

            @if (_affordAmount > 0)
            {
                var cycles = Math.Max(_goalWeeks, 1);
                var selectedTargetDate = GoalTargetDate;
                var cycleSpare = State.BudgetLeftover * (decimal)State.PayIntervalDays / 7m;
                var account = State.AffordabilityGoalAccount;
                var currentBalance = account is not null ? State.GetAccountBalance(account.Id) : 0m;
                // The entered amount is the TOTAL you want sitting in the account, not
                // extra on top of what's already there â€” if it already has $350 and you
                // enter $700, only the remaining $350 needs to be saved.
                var amountStillNeeded = account is not null ? Math.Max(_affordAmount - currentBalance, 0m) : _affordAmount;
                var cycleNeeded = Math.Round(amountStillNeeded / cycles, 2);
                var leftOver = cycleSpare - cycleNeeded;
                var ratio = cycleSpare > 0 ? cycleNeeded / cycleSpare : 999m;
                var (verdictIcon, verdict, verdictColor) =
                    amountStillNeeded <= 0 ? ("check", "Already there - no more saving needed", "var(--green)") :
                    ratio < 0.5m ? ("check", "Comfortable - easily on track", "var(--green)") :
                    ratio <= 1m  ? ("alert-triangle", "Tight - uses most of your spare budget", "var(--amber)") :
                                   ("x", "Short - not enough spare to hit this goal", "var(--red)");
                var cycleLabel = CycleLabel;
                var recommendedCycles = RecommendedGoalCycles(amountStillNeeded, cycleSpare);

                @if (recommendedCycles.HasValue && recommendedCycles.Value != cycles)
                {
                    var recDate = State.NthPaydayFromNow(recommendedCycles.Value + 1);
                    <div style="margin-top:10px;background:rgba(52,211,153,0.08);border:1px solid rgba(52,211,153,0.25);border-radius:10px;padding:10px 12px;display:flex;align-items:center;justify-content:space-between;gap:10px">
                        <div>
                            <div style="font-size:12px;color:var(--green);font-weight:600">Recommended: @recommendedCycles.Value pay@(recommendedCycles.Value == 1 ? "" : "s")</div>
                            <div style="font-size:11px;color:var(--text3)">Fastest pace that's still comfortable - by @recDate.ToString("dd MMM yy")</div>
                        </div>
                        <button class="btn btn-sm btn-secondary" @onclick="() => SelectPaceAsync(recommendedCycles.Value)">Use this</button>
                    </div>
                }

                @if (cycleSpare > 0)
                {
                    @if (!_showPaceOptions)
                    {
                        <button style="background:none;border:none;color:var(--text3);font-size:11px;cursor:pointer;padding:0;margin-top:10px;text-decoration:underline"
                                @onclick="() => _showPaceOptions = true">
                            Compare faster/slower paces
                        </button>
                    }
                    else
                    {
                        <div style="margin-top:12px;background:var(--surface2);border-radius:10px;padding:12px">
                            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px">
                                <span style="font-size:12px;color:var(--text3);font-weight:600">Savings pace for @amountStillNeeded.ToString("C")</span>
                                <button style="background:none;border:none;color:var(--text3);font-size:11px;cursor:pointer;padding:0;text-decoration:underline" @onclick="() => _showPaceOptions = false">Hide</button>
                            </div>
                            @foreach (var (label, multiplier, color) in PaceOptions)
                            {
                                var paceWeeks = Math.Max((int)Math.Ceiling(cycles * multiplier), 1);
                                var cycleAmount = Math.Round(amountStillNeeded / paceWeeks, 2);
                                var paceLeftOver = cycleSpare - cycleAmount;
                                var paceDate = State.NthPaydayFromNow(paceWeeks + 1);
                                var isSelected = paceWeeks == cycles;
                                <div @onclick="() => SelectPaceAsync(paceWeeks)" style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;border-radius:8px;cursor:pointer;margin-bottom:4px;background:var(--surface);border:1px solid @(isSelected ? color : "transparent")">
                                    <div>
                                        <div style="font-size:13px;font-weight:700;color:@color">@label</div>
                                        <div style="font-size:11px;color:var(--text3)">@cycleAmount.ToString("C")/@cycleLabel</div>
                                        <div style="font-size:11px;color:@(paceLeftOver>=0?"var(--green)":"var(--red)")">@paceLeftOver.ToString("C")/@cycleLabel left</div>
                                    </div>
                                    <div style="text-align:right">
                                        <div style="font-size:13px;font-weight:600">@paceWeeks pay@(paceWeeks == 1 ? "" : "s")</div>
                                        <div style="font-size:11px;color:var(--text3)">by @paceDate.ToString("dd MMM yy")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                <div style="margin-top:12px;background:var(--surface2);border-radius:10px;padding:12px">
                    <div style="font-size:14px;font-weight:700;color:@verdictColor;margin-bottom:10px;display:flex;align-items:center;gap:6px"><Icon Name="@verdictIcon" Size="16" /> @verdict</div>
                    <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                        <span style="color:var(--text3)">Need to save</span>
                        <span style="font-weight:600">@cycleNeeded.ToString("C")/@cycleLabel for @cycles pay@(cycles == 1 ? "" : "s")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:13px">
                        <span style="color:var(--text3)">Your spare budget</span>
                        <span style="font-weight:600;color:@(cycleSpare>=cycleNeeded?"var(--green)":"var(--red)")">@cycleSpare.ToString("C")/@cycleLabel</span>
                    </div>
                    <div style="border-top:1px solid var(--border);margin-top:5px;padding-top:8px;display:flex;justify-content:space-between;font-size:14px">
                        <span style="color:var(--text3)">Left over after saving</span>
                        <span style="font-weight:700;color:@(leftOver>=0?"var(--green)":"var(--red)")">@leftOver.ToString("C")/@cycleLabel</span>
                    </div>
                    @if (account is not null)
                    {
                        var projected = currentBalance + amountStillNeeded;
                        var alreadyTracking = account.TargetCents is not null;
                        <div style="border-top:1px solid var(--border);margin-top:5px;padding-top:8px">
                            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                                <span style="color:var(--text3)">@account.Name now</span>
                                <span style="font-weight:600">@currentBalance.ToString("C")</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;font-size:14px">
                                <span style="color:var(--text3)">Projected in @cycles pay@(cycles == 1 ? "" : "s")</span>
                                <span style="font-weight:700;color:@(cycleSpare>=cycleNeeded?"var(--green)":"var(--red)")">@projected.ToString("C")</span>
                            </div>
                        </div>
                        <button class="btn btn-primary btn-sm btn-full" style="margin-top:10px" @onclick="() => SetSavingsGoalAsync(account.Id, projected, selectedTargetDate)">
                            @(alreadyTracking ? "Update Account Goal" : "Track as Account Goal")
                        </button>
                        @if (alreadyTracking)
                        {
                            <div style="font-size:11px;color:var(--text3);margin-top:6px;text-align:center">@account.Name already has a tracked goal - this will replace it.</div>
                        }
                    }
                    <button class="btn btn-outline btn-sm btn-full" style="margin-top:8px" @onclick="() => StartAddGoalAsBill(cycleNeeded)">
                        Add @cycleNeeded.ToString("C")/@cycleLabel/pay to Budget as Bill
                    </button>
                </div>
            }
        }
        else if (_affordMode == "Installments")
        {
            <div style="display:flex;gap:8px;margin-top:10px">
                <div style="flex:1">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Number of payments</label>
                    <input class="form-input" type="number" min="2" step="1" @bind="_installmentCount" @bind:event="oninput" @onchange="OnInstallmentCountChanged" style="font-size:14px" />
                </div>
                <div style="flex:1">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Every (weeks)</label>
                    <input class="form-input" type="number" min="1" step="1" @bind="_installmentFrequencyWeeks" @bind:event="oninput" @onchange="OnInstallmentFrequencyChanged" style="font-size:14px" />
                </div>
            </div>

            @if (_affordAmount > 0)
            {
                var count = Math.Max(_installmentCount, 2);
                var freq = Math.Max(_installmentFrequencyWeeks, 1);
                var perInstallment = Math.Round(_affordAmount / count, 2);
                var weeklyImpact = Math.Round(perInstallment / freq, 2);
                var totalWeeks = (count - 1) * freq;
                var weeklySpare = State.BudgetLeftover;
                var remainingSpare = weeklySpare - weeklyImpact;
                var ratio = weeklySpare > 0 ? weeklyImpact / weeklySpare : 999m;
                var (verdictIcon, verdict, verdictColor) =
                    ratio < 0.5m ? ("check", "Comfortable - easily on track", "var(--green)") :
                    ratio <= 1m  ? ("alert-triangle", "Tight - uses most of your spare budget", "var(--amber)") :
                                   ("x", "Short - not enough spare for these repayments", "var(--red)");

                <div style="margin-top:12px;background:var(--surface2);border-radius:10px;padding:12px">
                    <div style="font-size:14px;font-weight:700;color:@verdictColor;margin-bottom:10px;display:flex;align-items:center;gap:6px"><Icon Name="@verdictIcon" Size="16" /> @verdict</div>
                    <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                        <span style="color:var(--text3)">Repayments</span>
                        <span style="font-weight:600">@count Ã— @perInstallment.ToString("C") / @freq wk@(freq == 1 ? "" : "s")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:13px">
                        <span style="color:var(--text3)">Adds to your spending</span>
                        <span style="font-weight:600;color:@(weeklySpare>=weeklyImpact?"var(--green)":"var(--red)")">+@weeklyImpact.ToString("C")/wk</span>
                    </div>
                    <div style="border-top:1px solid var(--border);margin-top:5px;padding-top:8px;display:flex;justify-content:space-between;font-size:14px">
                        <span style="color:var(--text3)">Spare budget after</span>
                        <span style="font-weight:700;color:@(remainingSpare>=0?"var(--green)":"var(--red)")">@remainingSpare.ToString("C")/wk</span>
                    </div>
                    <div style="font-size:11px;color:var(--text3);margin-top:6px">
                        First payment today, then @(count-1) more every @freq wk@(freq == 1 ? "" : "s") - paid off in @totalWeeks wk@(totalWeeks == 1 ? "" : "s")
                    </div>
                    <button class="btn btn-primary btn-sm btn-full" style="margin-top:10px" @onclick="() => StartAddInstallmentBill(perInstallment, freq)">
                        + Add to Budget as a Bill
                    </button>
                </div>
            }
        }
        else if (_affordAmount > 0 && State.WeeklyIncome > 0)
        {
            var safe = State.SafeToSpendAmount;
            var remaining = safe - _affordAmount;
            var pct = safe > 0 ? _affordAmount / safe : (_affordAmount > 0 ? 1.5m : 0m);
            var (verdictIcon, verdict, verdictColor) =
                remaining >= 0 && pct < 0.4m ? ("check", "Comfortably affordable", "var(--green)") :
                remaining >= 0 && pct < 0.8m ? ("alert-triangle", "Affordable - watch your budget", "var(--amber)") :
                remaining >= 0             ? ("alert-triangle", "Very tight - barely affordable", "var(--amber)") :
                                             ("x", "Over budget", "var(--red)");
            <div style="margin-top:12px;background:var(--surface2);border-radius:10px;padding:12px">
                <div style="font-size:14px;font-weight:700;color:@verdictColor;margin-bottom:10px;display:flex;align-items:center;gap:6px"><Icon Name="@verdictIcon" Size="16" /> @verdict</div>
                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                    <span style="color:var(--text3)">Safe to spend now</span>
                    <span style="font-weight:600">@safe.ToString("C")</span>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                    <span style="color:var(--text3)">This purchase</span>
                    <span style="font-weight:600;color:var(--red)">âˆ’@_affordAmount.ToString("C")</span>
                </div>
                <div style="border-top:1px solid var(--border);padding-top:8px;display:flex;justify-content:space-between;font-size:14px">
                    <span style="color:var(--text3)">Remaining after</span>
                    <span style="font-weight:700;color:@verdictColor">@remaining.ToString("C")</span>
                </div>
                @if (State.WeeklyIncome > 0)
                {
                    var weeklyImpact = pct * 100m;
                    <div style="font-size:11px;color:var(--text3);margin-top:6px">
                        That's @weeklyImpact.ToString("0.0")% of your safe-to-spend budget
                    </div>
                }
            </div>
        }
    </div>

    }
    </div>
}
else if (_tab == "Spending")
{
    <div>
    <!-- Unified spending breakdown: all categories with bills/everyday grouping -->
    @{
        var allCats    = State.GetTopCategoriesForPeriod(PayCycle.From, PayCycle.To, 12, excludeBills: false);
        var billCats   = allCats.Where(c => AppState.IsBillCategory(c.Category)).ToList();
        var discCats   = allCats.Where(c => !AppState.IsBillCategory(c.Category)).ToList();
        var breakdownMax = allCats.Any() ? allCats.Max(c => c.Amount) : 1m;
        var palette = new[]{"#2563EB","#16A34A","#D97706","#DC2626","#7C3AED","#0891B2","#BE185D","#65A30D","#B45309","#0F766E","#9333EA","#C2410C"};
    }
    @if (allCats.Any())
    {
        <div class="card">
            <div class="section-title" style="margin-bottom:2px">Spending Breakdown</div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:14px;opacity:0.7">All categories this pay cycle - @PayCycleDateRange - bar = % of largest category</div>

            @if (billCats.Any())
            {
                <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--text3);margin-bottom:8px">Bills &amp; Debt</div>
                @for (var i = 0; i < billCats.Count; i++)
                {
                    var (cat, amt) = billCats[i];
                    var ofInc = PeriodIncome > 0 ? amt / PeriodIncome : 0m;
                    var limitDollars = GetLimitDisplay(cat);
                    var hasLimit = limitDollars > 0;
                    var limitPct = hasLimit ? amt / limitDollars : 0m;
                    var barW  = hasLimit ? (double)Math.Clamp(limitPct, 0m, 1m) * 100.0 : (breakdownMax > 0 ? (double)(amt / breakdownMax) * 100.0 : 0);
                    var barColor = hasLimit && limitPct >= 1m ? "var(--red)" : hasLimit && limitPct >= 0.8m ? "var(--amber)" : "#2563EB";
                    <div style="margin-bottom:9px">
                        <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:3px">
                            <span style="color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:55%">
                                @cat
                                @if (hasLimit && limitPct >= 0.8m)
                                {
                                    <span style="font-size:9px;margin-left:4px;padding:1px 4px;border-radius:6px;background:@(limitPct>=1?"rgba(248,113,113,0.15)":"rgba(245,158,11,0.15)");color:@(limitPct>=1?"var(--red)":"var(--amber)")">@(limitPct>=1?"over":"near")</span>
                                }
                            </span>
                            <span style="flex-shrink:0;font-weight:600">
                                @amt.ToString("C")
                                <span style="font-size:10px;color:var(--text3);font-weight:400"> @ofInc.ToString("P0")</span>
                            </span>
                        </div>
                        <div style="background:var(--surface2);border-radius:4px;height:8px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:@barColor;width:@($"{barW:F1}")%;transition:width 0.4s ease"></div>
                        </div>
                        @if (hasLimit)
                        {
                            var remaining = limitDollars - amt;
                            <div style="font-size:10px;color:var(--text3);margin-top:3px">
                                @if (remaining >= 0)
                                {
                                    @($"{remaining:C} left of {limitDollars:C} limit")
                                }
                                else
                                {
                                    <span style="color:var(--red)">@($"{Math.Abs(remaining):C} over {limitDollars:C} limit")</span>
                                }
                            </div>
                        }
                    </div>
                }
            }

            @if (discCats.Any())
            {
                <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--text3);margin-top:@(billCats.Any()?"14px":"0");margin-bottom:8px">Everyday Spending</div>
                @for (var i = 0; i < discCats.Count; i++)
                {
                    var (cat, amt) = discCats[i];
                    var ofInc = PeriodIncome > 0 ? amt / PeriodIncome : 0m;
                    var limitDollars = GetLimitDisplay(cat);
                    var hasLimit = limitDollars > 0;
                    var limitPct = hasLimit ? amt / limitDollars : 0m;
                    var barW  = hasLimit ? (double)Math.Clamp(limitPct, 0m, 1m) * 100.0 : (breakdownMax > 0 ? (double)(amt / breakdownMax) * 100.0 : 0);
                    var barColor = hasLimit && limitPct >= 1m ? "var(--red)" : hasLimit && limitPct >= 0.8m ? "var(--amber)" : palette[i % palette.Length];
                    <div style="margin-bottom:9px">
                        <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:3px">
                            <span style="color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:55%">
                                @cat
                                @if (cat == "Misc") { <span style="font-size:10px;color:var(--text3)"> (uncategorised)</span> }
                                @if (hasLimit && limitPct >= 0.8m)
                                {
                                    <span style="font-size:9px;margin-left:4px;padding:1px 4px;border-radius:6px;background:@(limitPct>=1?"rgba(248,113,113,0.15)":"rgba(245,158,11,0.15)");color:@(limitPct>=1?"var(--red)":"var(--amber)")">@(limitPct>=1?"over":"near")</span>
                                }
                            </span>
                            <span style="flex-shrink:0;font-weight:600">
                                @amt.ToString("C")
                                <span style="font-size:10px;color:var(--text3);font-weight:400"> @ofInc.ToString("P0")</span>
                            </span>
                        </div>
                        <div style="background:var(--surface2);border-radius:4px;height:8px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:@barColor;width:@($"{barW:F1}")%;transition:width 0.4s ease"></div>
                        </div>
                        @if (hasLimit)
                        {
                            var remaining = limitDollars - amt;
                            <div style="font-size:10px;color:var(--text3);margin-top:3px">
                                @if (remaining >= 0)
                                {
                                    @($"{remaining:C} left of {limitDollars:C} limit")
                                }
                                else
                                {
                                    <span style="color:var(--red)">@($"{Math.Abs(remaining):C} over {limitDollars:C} limit")</span>
                                }
                            </div>
                        }
                    </div>
                }
            }

            <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:4px;display:flex;justify-content:space-between;font-size:12px;color:var(--text3)">
                <span>Total spent</span>
                <span style="font-weight:700;color:var(--text)">@AllPeriodSpend.ToString("C") <span style="font-weight:400">of @PeriodIncome.ToString("C") income</span></span>
            </div>
        </div>
    }

    <!-- Category spending limits (moved here from Settings) -->
    @if (State.Categories.Any(c => c.Type == CategoryType.Expense))
    {
        <div class="card" style="margin-top:12px">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                <div style="font-size:14px;font-weight:600">Category Limits</div>
                <button class="btn btn-secondary btn-sm" @onclick="() => _showCategoryLimits = !_showCategoryLimits">
                    @(_showCategoryLimits ? "Hide" : "Show")
                </button>
            </div>
            @if (_showCategoryLimits)
            {
                <div style="font-size:12px;color:var(--text3);margin:4px 0 12px">@State.SummaryPeriod spending limits per category. Shown as "near"/"over" badges above.</div>
                <div style="display:flex;flex-direction:column;gap:8px">
                    @foreach (var cat in State.Categories.Where(c => c.Type == CategoryType.Expense).OrderBy(c => c.Name))
                    {
                        <div style="display:flex;align-items:center;gap:8px">
                            <span style="flex:1;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@cat.Name</span>
                            <input class="form-input" style="width:90px;text-align:right;padding:6px 10px;font-size:14px"
                                   type="number" min="0" step="1"
                                   value="@GetLimitDisplay(cat.Name)"
                                   @onchange="e => SetLimitAsync(cat.Name, e.Value?.ToString())"
                                   placeholder="0" />
                            <span style="font-size:12px;color:var(--text3);flex-shrink:0">/@(State.SummaryPeriod == "Weekly" ? "wk" : "mo")</span>
                        </div>
                    }
                </div>
                <div style="font-size:11px;color:var(--text3);margin-top:10px">Set to 0 to disable limit for that category.</div>
            }
        </div>
    }

    <!-- Subscriptions / recurring payments -->
    @{
        var subscriptions = State.GetRecurringPayments();
    }
    @if (subscriptions.Any())
    {
        <div class="card" style="margin-top:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px">
                <div class="section-title" style="display:flex;align-items:center;gap:6px"><Icon Name="repeat" Size="14" /> Subscriptions</div>
                <span style="font-size:14px;font-weight:700">@State.SubscriptionWeeklyTotal.ToString("C")<span style="font-size:10px;color:var(--text3);font-weight:400">/wk</span></span>
            </div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:14px;opacity:0.7">@subscriptions.Count recurring payment@(subscriptions.Count == 1 ? "" : "s") detected from your transaction history</div>

            @foreach (var sub in subscriptions)
            {
                var dueColor = sub.DaysUntilNext < 0 ? "var(--red)" : sub.DaysUntilNext <= 2 ? "var(--amber)" : "var(--text3)";
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--border)">
                    <div style="flex:1;min-width:0">
                        <div style="font-size:14px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                            @sub.Name
                            @if (sub.IsAlreadyBill)
                            {
                                <span style="font-size:9px;margin-left:4px;padding:1px 4px;border-radius:6px;background:rgba(52,211,153,0.15);color:var(--green)">bill</span>
                            }
                        </div>
                        <div style="font-size:11px;color:var(--text3)">
                            @sub.Frequency - @sub.AmountRangeDisplay
                            <span style="color:@dueColor"> - @sub.NextDueDisplay</span>
                        </div>
                    </div>
                    <div style="text-align:right;flex-shrink:0">
                        <div style="font-size:14px;font-weight:600">@sub.WeeklyAmount.ToString("C")<span style="font-size:10px;color:var(--text3);font-weight:400">/wk</span></div>
                        @if (!sub.IsAlreadyBill)
                        {
                            <div style="display:flex;gap:8px;margin-top:4px;justify-content:flex-end">
                                <button @onclick="() => StartAddSubscriptionAsBill(sub)" style="background:none;border:none;color:var(--teal);font-size:11px;cursor:pointer;padding:0;text-decoration:underline">Add as Bill</button>
                                <button @onclick="() => State.IgnoreSubscriptionAsync(sub.Name)" style="background:none;border:none;color:var(--text3);font-size:11px;cursor:pointer;padding:0;text-decoration:underline">Ignore</button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    </div>
}
else if (_tab == "History")
{
    <div>
    <!-- Period spending vs budget -->
    @if (State.WeeklyIncome > 0)
    {
        <div class="card">
            <div class="section-title" style="margin-bottom:2px">Everyday Spending This @PeriodNoun</div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:4px;opacity:0.9">@PayCycleDateRange</div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:12px;opacity:0.7">Non-bill transactions only - budget = unallocated spending (@PeriodBudget.ToString("C"))</div>
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
                <span style="font-size:22px;font-weight:700;color:@(PeriodSpend>PeriodBudget?"var(--red)":"var(--text)")">
                    @PeriodSpend.ToString("C")
                </span>
                <span style="font-size:13px;color:var(--text3)">of @PeriodBudget.ToString("C")</span>
            </div>
            @if (PreviousPeriodSpend > 0)
            {
                var cycleDelta = PeriodSpend - PreviousPeriodSpend;
                <div style="font-size:11px;margin-bottom:6px;color:@(cycleDelta>0?"var(--red)":"var(--green)");display:flex;align-items:center;gap:4px">
                    <Icon Name="@(cycleDelta >= 0 ? "trending-up" : "trending-down")" Size="11" /> @Math.Abs(cycleDelta).ToString("C") vs last cycle
                </div>
            }
            <div class="progress-bar" style="height:8px">
                <div class="progress-fill" style="width:@((int)(Math.Min(PeriodSpendPct,1)*100))%;background:@(PeriodSpend>PeriodBudget?"var(--red)":"var(--teal)")"></div>
            </div>
            <div style="margin-top:6px">
                @{
                    var avg = AvgPreviousDiscretionary;
                    var isSpike = avg > 0 && PeriodSpend > avg * 1.3m;
                    var spikeAmount = PeriodSpend - avg;
                }
                @if (PeriodSpend > PeriodBudget)
                {
                    <div style="font-size:12px;color:var(--red);font-weight:600;margin-bottom:8px">@((PeriodSpend - PeriodBudget).ToString("C")) over budget</div>
                    <button class="btn btn-sm btn-secondary" style="margin-bottom:10px" @onclick='() => Nav.NavigateTo("transactions")'>Review Transactions</button>
                }
                else
                {
                    <div style="font-size:12px;color:var(--text3);margin-bottom:8px">@((PeriodBudget - PeriodSpend).ToString("C")) remaining</div>
                }

                @if (isSpike)
                {
                    <div style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.25);border-radius:8px;padding:9px 11px;font-size:12px;margin-bottom:8px">
                        <span style="color:var(--amber);font-weight:600;display:inline-flex;align-items:center;gap:4px"><Icon Name="zap" Size="12" /> High-spend @PeriodNounLower</span>
                        <span style="color:var(--text3)"> - @spikeAmount.ToString("C") above your usual @avg.ToString("C0") avg. Likely one-off expenses.</span>
                    </div>
                }

                <div style="font-size:11px;color:var(--text3)">See the Spending tab for a full category breakdown.</div>
            </div>
        </div>

        <!-- Biggest individual transactions (always shown if there are any) -->
        @if (BiggestPeriodTxns.Any())
        {
            <div class="card" style="margin-top:12px">
                <div class="section-title" style="margin-bottom:2px">Biggest Transactions This Pay Cycle</div>
                <div style="font-size:11px;color:var(--text3);margin-bottom:12px;opacity:0.7">Everyday purchases only (bills excluded)</div>
                @foreach (var t in BiggestPeriodTxns.Take(6))
                {
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                        <div style="flex:1;min-width:0">
                            <div style="font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@t.Description</div>
                            <div style="font-size:11px;color:var(--text3)">@t.CategoryName - @t.Date.ToString("d MMM")</div>
                        </div>
                        <span style="font-size:15px;font-weight:700;color:var(--red);flex-shrink:0">@Math.Abs(t.AmountDollars).ToString("C")</span>
                    </div>
                }
            </div>
        }
    }

    <!-- Pay-cycle history -->
    @{
        var cycleTrend = PayCycleTrend;
        var cycleTrendMax = cycleTrend.Any() ? Math.Max(cycleTrend.Max(c => Math.Max(c.Income, c.Spending)), 1m) : 1m;
    }
    @if (cycleTrend.Any(c => c.Income > 0 || c.Spending > 0))
    {
        <div class="card" style="margin-top:12px">
            <div class="section-title" style="margin-bottom:2px">@PeriodNoun History</div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:14px;opacity:0.7">Last 6 @PeriodNounLower periods - income vs spending vs net</div>
            @foreach (var c in cycleTrend)
            {
                var spendW = cycleTrendMax > 0 ? (double)(c.Spending / cycleTrendMax) * 100.0 : 0;
                var incomeW = cycleTrendMax > 0 ? (double)(c.Income / cycleTrendMax) * 100.0 : 0;
                var net = c.Income - c.Spending;
                <div style="margin-bottom:10px">
                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px">
                        <span style="color:var(--text2)">@c.Label</span>
                        <div style="display:flex;gap:10px">
                            <span style="color:var(--green)">+@c.Income.ToString("C0")</span>
                            <span style="color:@(net<0?"var(--red)":"var(--text)");font-weight:600">-@c.Spending.ToString("C0")</span>
                            <span style="color:@(net>=0?"var(--green)":"var(--red)");font-weight:600">@(net>=0?"+":"")@net.ToString("C0")</span>
                        </div>
                    </div>
                    <div style="position:relative;height:10px">
                        <div style="position:absolute;inset:0;background:var(--surface2);border-radius:4px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:rgba(52,211,153,0.25);width:@($"{incomeW:F1}")%"></div>
                        </div>
                        <div style="position:absolute;inset:0;background:transparent;border-radius:4px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:@(net<0?"var(--red)":"var(--teal)");opacity:0.85;width:@($"{spendW:F1}")%;transition:width 0.4s ease"></div>
                        </div>
                    </div>
                </div>
            }
            <div style="display:flex;gap:16px;margin-top:6px;font-size:11px;color:var(--text3)">
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:var(--teal);margin-right:4px;vertical-align:middle"></span>Spending</span>
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:rgba(52,211,153,0.4);margin-right:4px;vertical-align:middle"></span>Income</span>
            </div>
        </div>
    }

    <!-- Monthly spending history -->
    @{
        var trend = State.GetMonthlyTrend(6);
        var trendMax = trend.Any() ? Math.Max(trend.Max(t => t.Spending), 1m) : 1m;
    }
    @if (trend.Any(t => t.Spending > 0 || t.Income > 0))
    {
        <div class="card" style="margin-top:12px">
            <div class="section-title" style="margin-bottom:14px">Monthly History</div>
            @foreach (var m in trend)
            {
                var spendW = trendMax > 0 ? (double)(m.Spending / trendMax) * 100.0 : 0;
                var incomeW = trendMax > 0 ? (double)(m.Income / trendMax) * 100.0 : 0;
                var isOver = m.Income > 0 && m.Spending > m.Income;
                <div style="margin-bottom:10px">
                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px">
                        <span style="color:var(--text2)">@m.Month</span>
                        <div style="display:flex;gap:10px">
                            @if (m.Income > 0)
                            {
                                <span style="color:var(--green)">+@m.Income.ToString("C0")</span>
                            }
                            <span style="color:@(isOver ? "var(--red)" : "var(--text)");font-weight:600">-@m.Spending.ToString("C0")</span>
                        </div>
                    </div>
                    <div style="position:relative;height:10px">
                        @if (m.Income > 0)
                        {
                            <div style="position:absolute;inset:0;background:var(--surface2);border-radius:4px;overflow:hidden">
                                <div style="height:100%;border-radius:4px;background:rgba(52,211,153,0.25);width:@($"{incomeW:F1}")%"></div>
                            </div>
                        }
                        <div style="position:absolute;inset:0;background:transparent;border-radius:4px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:@(isOver?"var(--red)":"var(--teal)");opacity:0.85;width:@($"{spendW:F1}")%;transition:width 0.4s ease"></div>
                        </div>
                    </div>
                </div>
            }
            <div style="display:flex;gap:16px;margin-top:6px;font-size:11px;color:var(--text3)">
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:var(--teal);margin-right:4px;vertical-align:middle"></span>Spending</span>
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:rgba(52,211,153,0.4);margin-right:4px;vertical-align:middle"></span>Income</span>
            </div>
        </div>
    }
    </div>
}
else if (_tab == "Forecast")
{
    <div>
    @{
        var forecast = ForecastDays;
        var lowest = forecast.OrderBy(f => f.Balance).First();
        var eventDays = forecast.Where(f => f.Note is not null).ToList();
        var totalBills = forecast.Sum(f => f.Bills);
        var totalPay = forecast.Sum(f => f.Pay);
        var balanceMin = forecast.Min(f => f.Balance);
        var balanceMax = forecast.Max(f => f.Balance);
        var bars = BuildForecastBalanceBars(forecast, balanceMin, balanceMax, 12);
    }
    <div class="card">
        <div class="section-title" style="margin-bottom:2px">60-Day Balance Forecast</div>
        <div style="font-size:11px;color:var(--text3);margin-bottom:14px;opacity:0.7">
            Projects all recurring bills, future paydays and @ForecastDailySpendAssumption.ToString("C")/day discretionary spend@(State.NoSpendMode ? " while no-spend mode is on" : " based on your last 30 days")
        </div>
        <div style="display:flex;justify-content:space-between;align-items:baseline">
            <div>
                <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:0.05em">Today</div>
                <div style="font-size:18px;font-weight:700">@State.TotalBalance.ToString("C")</div>
            </div>
            <div style="text-align:right">
                <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:0.05em">In 60 days</div>
                <div style="font-size:18px;font-weight:700;color:@(forecast.Last().Balance>=0?"var(--text)":"var(--red)")">@forecast.Last().Balance.ToString("C")</div>
            </div>
        </div>
        <div class="forecast-chart" aria-hidden="true">
            <div class="forecast-zero-line" style="top:@(ForecastZeroY(balanceMin, balanceMax).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            <div class="forecast-bars-grid" style="grid-template-columns:repeat(@bars.Count,1fr)">
                @foreach (var bar in bars)
                {
                    <div class="forecast-bar-col">
                        <div class="forecast-bar-label @(bar.Negative ? "below" : "above")" style="top:@(bar.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%">@FormatCompactCurrency(bar.Balance)</div>
                        <div class="forecast-bar-fill @(bar.Negative ? "negative" : "")" style="top:@(bar.Top.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;height:@(bar.Height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        @if (bar.HasBill)
                        {
                            <div class="forecast-bar-event bill" style="top:@(bar.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;@(bar.HasPay ? "left:35%" : "")"></div>
                        }
                        @if (bar.HasPay)
                        {
                            <div class="forecast-bar-event pay" style="top:@(bar.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;@(bar.HasBill ? "left:65%" : "")"></div>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="forecast-chart-dates" style="grid-template-columns:repeat(@bars.Count,1fr)">
            @foreach (var bar in bars)
            {
                <span>@bar.Date.ToString("d/M")</span>
            }
        </div>
        <div class="forecast-legend">
            <span style="--legend-color:var(--teal-light)">Balance</span>
            <span style="--legend-color:var(--red)">Bills @totalBills.ToString("C0")</span>
            <span style="--legend-color:var(--green)">Pay @totalPay.ToString("C0")</span>
        </div>
        <div style="border-top:1px solid var(--border);margin-top:12px;padding-top:10px;display:flex;justify-content:space-between;align-items:center">
            <span style="font-size:12px;color:var(--text3)">Lowest projected point</span>
            <span style="font-size:14px;font-weight:700;color:@(lowest.Balance<0?"var(--red)":"var(--text)")">@lowest.Balance.ToString("C") - @lowest.Date.ToString("dd MMM")</span>
        </div>
    </div>

    <div class="budget-calendar">
        <div class="budget-calendar-head">
            <div>
                <div class="section-title">Budget Schedule</div>
                <div style="font-size:16px;font-weight:700">@DateTime.Today.ToString("MMMM yyyy")</div>
            </div>
            <div style="font-size:11px;color:var(--text3);text-align:right">Bills, paydays and forecast balance</div>
        </div>
        <div class="budget-calendar-grid">
            @foreach (var h in new[] { "M", "T", "W", "T", "F", "S", "S" })
            {
                <div class="budget-calendar-weekday">@h</div>
            }
            @foreach (var day in ForecastCalendarDays)
            {
                <div class="budget-calendar-day @(day.IsOutsideMonth ? "is-outside" : "") @(day.Date.Date == DateTime.Today ? "is-today" : "")" style="cursor:pointer" @onclick="() => _selectedCalDay = day.Date">
                    <div class="budget-calendar-date">
                        <span>@day.Date.Day</span>
                        @if (day.IsPayday)
                        {
                            <span style="color:var(--green);font-size:10px">PAY</span>
                        }
                    </div>
                    @if (day.Forecast is not null)
                    {
                        <div class="budget-calendar-balance">@day.Forecast.Balance.ToString("C0")</div>
                        <div class="budget-calendar-markers">
                            @if (day.Forecast.Bills > 0)
                            {
                                <span class="budget-calendar-marker" style="--marker-color:var(--red)" title="Bills"></span>
                            }
                            @if (day.Forecast.Pay > 0)
                            {
                                <span class="budget-calendar-marker" style="--marker-color:var(--green)" title="Payday"></span>
                            }
                            @if (day.Forecast.Spending > 0)
                            {
                                <span class="budget-calendar-marker" style="--marker-color:var(--teal-light)" title="Estimated spending"></span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="forecast-legend" style="padding:10px 12px;border-top:1px solid var(--border);margin-top:0">
            <span style="--legend-color:var(--red)">Bills</span>
            <span style="--legend-color:var(--green)">Payday</span>
            <span style="--legend-color:var(--teal-light)">Daily spend</span>
        </div>
    </div>

    <div class="section-header" style="margin-top:12px"><span class="section-title">Upcoming Events</span></div>
    @if (!eventDays.Any())
    {
        <div class="empty-state" style="padding:20px">
            <span>No unpaid bills or paydays projected in the next 60 days.</span>
        </div>
    }
    else
    {
