    private static IReadOnlyList<string> BuildSpendingPaceRecommendations(decimal remainingBudget, decimal dailyRoom, int daysRemaining, decimal projectedDelta, int excludedCount, int repeatingNameCount)
    {
        var recommendations = new List<string>();

        if (remainingBudget < 0)
        {
            recommendations.Add("Treat the discretionary budget as paused until the next period; only bills and true essentials should go through.");
            recommendations.Add("Open pace exclusions and tick any bill category or repeating merchant that should not count against day-to-day spending.");
            if (repeatingNameCount > 0) recommendations.Add($"Review {repeatingNameCount} repeating name{(repeatingNameCount == 1 ? "" : "s")} below; excluding regular payments keeps pace honest.");
            return recommendations;
        }

        if (projectedDelta > 0)
        {
            recommendations.Add($"Keep discretionary spending around {dailyRoom:C}/day for the next {daysRemaining} day{(daysRemaining == 1 ? "" : "s")}.");
            recommendations.Add($"Cut about {projectedDelta:C} from planned discretionary spending to land inside budget.");
            if (excludedCount == 0) recommendations.Add("If a recurring payment is inflating this, exclude its category or repeating name from pace.");
            return recommendations;
        }

        recommendations.Add($"You can spend about {dailyRoom:C}/day and stay inside budget.");
        recommendations.Add(excludedCount > 0
            ? $"{excludedCount} manual exclusion{(excludedCount == 1 ? "" : "s")} currently keep pace focused on flexible spending."
            : "Add exclusions for recurring payments so future pace stays focused on flexible spending.");
        if (repeatingNameCount > 0) recommendations.Add("Check repeating names after new imports; subscriptions and insurance are easiest to exclude there.");
        return recommendations;
    }

