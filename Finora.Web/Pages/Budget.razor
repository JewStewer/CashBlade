    private sealed record ForecastDay(
        DateTime Date,
        decimal Balance,
        string? Note,
        bool IsPayday,
        decimal Bills,
        decimal Pay,
        decimal Spending);

    private sealed record ForecastCalendarDay(DateTime Date, ForecastDay? Forecast, bool IsOutsideMonth, bool IsPayday);
    private sealed record ForecastBalanceBar(decimal Top, decimal Height, decimal Y, bool Negative, bool HasBill, bool HasPay, DateTime Date, decimal Balance);

    private static string FormatCompactCurrency(decimal v)
    {
        var sign = v < 0 ? "-" : "";
        var abs = Math.Abs(v);
        return abs >= 1000m ? $"{sign}${(abs / 1000m).ToString("0.#")}k" : $"{sign}${abs:0}";
    }

    // Day-by-day 60-day balance projection: starting balance minus average daily
    // discretionary spend, minus all unpaid recurring bill occurrences, plus
    // estimated pay on projected future paydays.
    private List<ForecastDay> ForecastDays
    {
        get
        {
            const int days = 60;
            var avgDaily = ForecastDailySpendAssumption;
            var billOccurrences = State.GetUpcomingBillOccurrences(DateTime.Today, DateTime.Today.AddDays(days))
                .GroupBy(o => o.DueDate.Date)
                .ToDictionary(g => g.Key, g => g.ToList());
            var balance = State.TotalBalance;
            var result = new List<ForecastDay>();

            for (var i = 0; i <= days; i++)
            {
                var date = DateTime.Today.AddDays(i);
                var spending = i > 0 ? avgDaily : 0m;
                if (spending > 0) balance -= spending;

                var billsToday = billOccurrences.GetValueOrDefault(date) ?? new List<BillOccurrencePreview>();
                var billsTotal = billsToday.Sum(o => o.Bill.AmountDollars);
                balance -= billsTotal;

                var isPayday = IsForecastPayday(date);
                var pay = isPayday ? ForecastPayAmount : 0m;
                if (pay > 0) balance += pay;

                string? note = billsToday.Count switch
                {
                    0 => null,
                    1 => billsToday[0].Bill.Name,
                    _ => $"{billsToday.Count} bills"
                };
                if (isPayday) note = note is null ? "Payday" : $"{note} + Payday";

                result.Add(new ForecastDay(date, balance, note, isPayday, billsTotal, pay, spending));
            }
            return result;
        }
    }

    private List<ForecastCalendarDay> ForecastCalendarDays
    {
        get
        {
            var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var startOffset = ((int)monthStart.DayOfWeek + 6) % 7;
            var gridStart = monthStart.AddDays(-startOffset);
            var forecastByDate = ForecastDays.ToDictionary(f => f.Date.Date);
            var result = new List<ForecastCalendarDay>();

            for (var i = 0; i < 42; i++)
            {
                var date = gridStart.AddDays(i);
                forecastByDate.TryGetValue(date.Date, out var forecast);
                result.Add(new ForecastCalendarDay(
                    date,
                    forecast,
                    date.Month != DateTime.Today.Month,
                    forecast?.IsPayday ?? IsForecastPayday(date)));
            }

            return result;
        }
    }


    // The actual lump sum that lands each payday â€” NOT State.WeeklyIncome, which
    // is a weekly-normalized figure used for budgeting math elsewhere. Injecting
    // WeeklyIncome here (as this used to) understates the real deposit for
    // anyone not paid weekly (fortnightly/4-weekly), since it's roughly a
    // quarter to a half of what actually arrives â€” that made the forecast
    // between real paydays look like it was dropping far more than it really
    // will, because the simulated "raises" were too small to offset real bills.
    private decimal ForecastPayAmount =>
        State.HasPayEstimate ? State.EstimatedPayAmount
        : State.WeeklyIncome > 0 ? Math.Round(State.WeeklyIncome * State.PayIntervalDays / 7m, 2)
        : 0m;

    private decimal ForecastDailySpendAssumption
    {
        get
        {
            if (State.NoSpendMode) return 0m;
            var recent = Math.Max(State.GetDiscretionarySpendingForPeriod(DateTime.Today.AddDays(-30), DateTime.Today.AddDays(-1)) / 30m, 0m);
            if (recent > 0) return Math.Round(recent, 2);
            var budgetFallback = WhatIfUnallocated > 0 ? WhatIfUnallocated / 7m : 0m;
            return Math.Round(budgetFallback, 2);
        }
    }

    private bool IsForecastPayday(DateTime date)
    {
        if (ForecastPayAmount <= 0) return false;

        // Must advance by the user's actual pay interval, not a hardcoded 7 â€”
        // otherwise a fortnightly/4-weekly earner gets a fake payday injected
        // every single week, which desyncs the projected balance from the real
        // one more and more the further out the forecast runs.
        var cycleDays = Math.Max(State.PayIntervalDays, 1);
        var payday = State.NextPayDate.Date;
        while (payday < DateTime.Today)
            payday = payday.AddDays(cycleDays);

        return date.Date >= payday && (date.Date - payday).Days % cycleDays == 0;
    }

    private static decimal ForecastZeroY(decimal min, decimal max)
    {
        if (min >= 0) return 100m;
        if (max <= 0) return 0m;
        var range = Math.Max(max - min, 1m);
        return 100m - ((0m - min) / range * 100m);
    }

    // Buckets the 60-day forecast into N bars, each showing the ending balance
    // for that bucket as a bar growing from the zero-line (red below zero,
    // teal above), with small bill/payday dots above whichever bucket they
    // fall in.
    private static List<ForecastBalanceBar> BuildForecastBalanceBars(List<ForecastDay> forecast, decimal min, decimal max, int buckets)
    {
        var range = Math.Max(max - min, 1m);
        var zeroY = ForecastZeroY(min, max);
        var bucketSize = (double)forecast.Count / buckets;
        var result = new List<ForecastBalanceBar>();

        for (var i = 0; i < buckets; i++)
        {
            var start = (int)Math.Floor(i * bucketSize);
            var end = (int)Math.Floor((i + 1) * bucketSize);
            if (i == buckets - 1) end = forecast.Count;
            var slice = forecast.Skip(start).Take(Math.Max(end - start, 1)).ToList();

            var y = Math.Clamp(100m - ((slice[^1].Balance - min) / range * 100m), 0m, 100m);
            var top = Math.Min(zeroY, y);
            var height = Math.Max(Math.Abs(zeroY - y), 1.5m);

            result.Add(new ForecastBalanceBar(top, height, y, y > zeroY, slice.Any(f => f.Bills > 0), slice.Any(f => f.IsPayday), slice[^1].Date, slice[^1].Balance));
        }

        return result;
    }
}
