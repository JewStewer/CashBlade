@if (_selectedCalDay.HasValue)
{
    <div class="modal-backdrop" @onclick="() => _selectedCalDay = null">
        <div class="modal-card" @onclick:stopPropagation>
        <div class="modal-sheet">
            <div class="modal-handle"></div>
            @{
                var selDate = _selectedCalDay!.Value.Date;
                var isPast   = selDate < DateTime.Today;
                var isToday  = selDate == DateTime.Today;
                var selForecast = ForecastCalendarDays.FirstOrDefault(d => d.Date.Date == selDate)?.Forecast;
                var selBills   = State.GetUpcomingBillOccurrences(selDate, selDate);
                var selTxns    = isPast || isToday
                    ? State.Transactions.Where(t => t.Date.Date == selDate && t.AmountCents < 0 && t.TransferId == null).ToList()
                    : new List<Transaction>();
                var selBalance = isToday ? State.TotalBalance : selForecast?.Balance;
            }
            <div class="modal-title" style="font-size:16px">@selDate.ToString("dddd d MMMM")</div>

            <div style="padding:0 16px 4px;display:flex;flex-direction:column;gap:12px">

                @if (selBalance.HasValue)
                {
                    <div style="display:flex;justify-content:space-between;align-items:center">
                        <span style="font-size:13px;color:var(--text3)">@(isToday ? "Current balance" : "Projected balance")</span>
                        <span style="font-size:18px;font-weight:700;color:@(selBalance.Value < 0 ? "var(--red)" : "var(--text)")">
                            @selBalance.Value.ToString("C")
                        </span>
                    </div>
                }

                @if (IsForecastPayday(selDate))
                {
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:rgba(52,211,153,0.08);border-radius:10px;border:1px solid rgba(52,211,153,0.2)">
                        <span style="font-size:13px;color:var(--green);font-weight:600">Payday</span>
                        <span style="font-size:15px;font-weight:700;color:var(--green)">+@ForecastPayAmount.ToString("C")</span>
                    </div>
                }

                @if (selBills.Count > 0)
                {
                    <div>
                        <div style="font-size:11px;color:var(--text3);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.05em">Bills due</div>
                        @foreach (var occ in selBills)
                        {
                            <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)">
                                <span style="font-size:14px">@occ.Bill.Name</span>
                                <span style="font-size:14px;font-weight:600;color:var(--red)">-@occ.Bill.AmountDollars.ToString("C")</span>
                            </div>
                        }
                    </div>
                }

                @if (isPast || isToday)
                {
                    <div>
                        <div style="font-size:11px;color:var(--text3);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.05em">
                            Spending
                        </div>
                        @if (selTxns.Count == 0)
                        {
                            <div style="font-size:13px;color:var(--text3)">No spending recorded for this day.</div>
                        }
                        else
                        {
                            @foreach (var t in selTxns.OrderBy(t => t.AmountCents))
                            {
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)">
                                    <div>
                                        <div style="font-size:14px">@t.Description</div>
                                        @if (!string.IsNullOrEmpty(t.CategoryName))
                                        {
                                            <div style="font-size:11px;color:var(--text3)">@t.CategoryName</div>
                                        }
                                    </div>
                                    <span style="font-size:14px;font-weight:600;color:var(--red)">@(t.AmountDollars.ToString("C"))</span>
                                </div>
                            }
                            <div style="display:flex;justify-content:space-between;padding:8px 0">
                                <span style="font-size:13px;color:var(--text3)">Total spent</span>
                                <span style="font-size:14px;font-weight:700;color:var(--red)">
                                    @(selTxns.Sum(t => t.AmountDollars).ToString("C"))
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="display:flex;justify-content:space-between;align-items:center">
                        <span style="font-size:13px;color:var(--text3)">Daily avg (last 30 days)</span>
                        <span style="font-size:14px;font-weight:600;color:var(--text2)">-@ForecastDailySpendAssumption.ToString("C")</span>
                    </div>
                }

            </div>

            <div class="modal-actions">
                <button class="btn btn-secondary" style="flex:1" @onclick="() => _selectedCalDay = null">Close</button>
            </div>
        </div>
        </div>
    </div>
}

<div style="height:16px"></div>

@code {
    private string _tab = "Overview";
    private bool _showWeeklyBreakdown;
    private SavingsGoal? _goalDraft;
    private string? _expandedGoalGroupName;
    private readonly HashSet<int> _expandedGoalWhatIf = new();

    private void ToggleGoalGroup(string name) =>
        _expandedGoalGroupName = string.Equals(_expandedGoalGroupName, name, StringComparison.OrdinalIgnoreCase) ? null : name;

    private void ToggleGoalWhatIf(int goalId)
    {
        if (!_expandedGoalWhatIf.Add(goalId))
            _expandedGoalWhatIf.Remove(goalId);
    }

    private RenderFragment<SavingsGoal> GoalCardTemplate => goal => @<div style="cursor:pointer" @onclick="() => _goalDraft = goal">
        @{
            var progress = goal.TargetDollars > 0
                ? Math.Clamp(goal.CurrentDollars / goal.TargetDollars, 0m, 1m)
                : 0m;
            var remaining = goal.TargetDollars - goal.CurrentDollars;
            var reached = remaining <= 0;
            if (reached) _celebratedGoalIds.Add(goal.Id);
        }
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px">
            <span style="font-size:14px;font-weight:600">
                @if (!string.IsNullOrEmpty(goal.Emoji)) { <span>@goal.Emoji </span> }
                @goal.Name
            </span>
            <span style="font-size:13px;color:@(reached?"var(--green)":"var(--teal)")">
                @goal.CurrentDollars.ToString("C") / @goal.TargetDollars.ToString("C")
            </span>
        </div>
        <div class="progress-bar goal-jar" style="height:8px">
            <div class="progress-fill goal-jar-fill @(_celebratedGoalIds.Contains(goal.Id) ? "celebrate" : "")" style="width:@((int)(progress*100))%;background:@(reached?"var(--green)":"var(--teal)")"></div>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:4px">
            <span>@progress.ToString("P0") saved</span>
            @if (reached)
            {
                <span style="color:var(--green);font-weight:600">Goal reached!</span>
            }
            else
            {
                <span>@remaining.ToString("C") to go</span>
            }
        </div>
        @{ var pace = GoalPaceLabel(goal); }
        @if (pace is not null)
        {
            <span class="badge @pace.Value.CssClass" style="margin-top:6px;display:inline-block">@pace.Value.Label</span>
        }
        @if (goal.TargetDate.HasValue)
        {
            var daysLeft = (goal.TargetDate.Value.Date - DateTime.Today).Days;
            <div style="font-size:11px;color:@(daysLeft < 30 && !reached ? "var(--amber)" : "var(--text3)");margin-top:2px">
                Target: @goal.TargetDate.Value.ToString("d MMM yyyy")
                @if (!reached) { <span> (@daysLeft days left)</span> }
            </div>
        }
        @if (!reached)
        {
            var isWhatIfOpen = _expandedGoalWhatIf.Contains(goal.Id);
            var whatIfWeekly = _goalWhatIfWeekly.TryGetValue(goal.Id, out var w) && w > 0 ? w : Math.Max(goal.WeeklyContributionDollars, 5m);
            var whatIfWeeks = GoalMath.WeeksToTarget(goal.TargetDollars, goal.CurrentDollars, whatIfWeekly);
            @if (!isWhatIfOpen)
            {
                <button style="background:none;border:none;color:var(--text3);font-size:11px;cursor:pointer;padding:0;margin-top:2px;text-decoration:underline"
                        @onclick="() => ToggleGoalWhatIf(goal.Id)" @onclick:stopPropagation="true">
                    @(goal.WeeklyContributionDollars > 0
                        ? $"{goal.WeeklyContributionDollars:C}/wk - about {whatIfWeeks} weeks to goal"
                        : "What if I saved toward this?")
                </button>
            }
            else
            {
                <div style="margin-top:8px;padding-top:8px;border-top:1px dashed var(--border)" @onclick:stopPropagation="true">
                    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px">
                        <span style="font-size:11px;color:var(--text3)">What if I saved @whatIfWeekly.ToString("C")/week?</span>
                        <button style="background:none;border:none;color:var(--text3);font-size:11px;cursor:pointer;padding:0;text-decoration:underline" @onclick="() => ToggleGoalWhatIf(goal.Id)">Hide</button>
                    </div>
                    <input type="range" min="5" max="@(Math.Max((double)goal.TargetDollars / 4, 50))" step="5"
                           value="@whatIfWeekly" style="width:100%"
                           @oninput="@((ChangeEventArgs e) => OnWhatIfSliderChanged(goal.Id, e))" />
                    <div style="font-size:12px;color:var(--text2);margin-top:2px">
                        @(whatIfWeeks < 0 ? "Add a weekly amount to estimate" : $"Reached in ~{whatIfWeeks} week{(whatIfWeeks == 1 ? "" : "s")}")
                    </div>
                </div>
            }
        }
    </div>;
    private bool _editingBudget;
    private bool _showCategoryLimits;
    private string? _pickerSettingKey;
    private string _pickerCurrentCat = "Bills";
    private bool _showCategoryPicker;
    private string _newCategoryName = "";
    private bool _showNewCatInput;
    private bool _showPaceExclusions;
    private bool _showPaceOptions;
    private decimal _affordAmount;
    private string _affordMode = "OneOff"; // OneOff | Savings | Installments
    private int _goalWeeks = 4;
    private string _goalAccountName = string.Empty;
    private int _installmentCount = 4;
    private int _installmentFrequencyWeeks = 2;
    private Bill? _billDraft;
    private readonly HashSet<int> _celebratedGoalIds = new();
    private readonly Dictionary<int, decimal> _goalWhatIfWeekly = new();
    private readonly Dictionary<string, decimal> _groupWhatIfWeekly = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _excludedBudgetLabels => State.BudgetExcludedLabels;
    private HashSet<int> _excludedBillIds => State.BudgetExcludedBillIds;
    private HashSet<string> _expandedBudgetCategories => State.BudgetExpandedCategories;
    private bool _showBudgetAddPicker;
    private bool _showBudgetEnvelopeForm;
    private string _newEnvelopeName = string.Empty;
    private string _newEnvelopeAmount = string.Empty;
    private DateTime? _selectedCalDay;

    private void SelectTopPill(string tab)
    {
        _tab = tab;
    }
    private Debt? _debtDraft;
    private DateTime GoalTargetDate => State.NthPaydayFromNow(Math.Max(_goalWeeks, 1) + 1);
    private string CycleLabel => State.PayIntervalDays switch { 14 => "fn", 28 => "4wk", _ => "wk" };

    // Multipliers applied to the user's chosen "Over how many weeks?" value â€”
    // Aggressive halves it, Balanced matches it, Passive doubles it, so all
    // three cards recalculate live as weeks/amount change.
    private static readonly (string Label, decimal Multiplier, string Color)[] PaceOptions =
    {
        ("Aggressive", 0.5m, "var(--red)"),
        ("Balanced", 1m, "var(--amber)"),
        ("Passive", 2m, "var(--green)")
    };

    protected override void OnInitialized()
    {
        _affordMode = State.AffordabilityMode;
        _affordAmount = _affordMode switch
        {
            "Savings" => State.AffordabilityGoalAmount,
            "Installments" => State.AffordabilityInstallmentAmount,
            _ => 0m
        };
        _goalWeeks = State.AffordabilityGoalWeeks;
        _goalAccountName = State.AffordabilityGoalAccountName;
        _installmentCount = State.AffordabilityInstallmentCount;
        _installmentFrequencyWeeks = State.AffordabilityInstallmentFrequencyWeeks;
        LoadGroupWhatIfSettings();
    }

    private async Task SetBudgetFieldAsync(string field, ChangeEventArgs e)
    {
        await State.SetBudgetOverrideAsync(field, e.Value?.ToString());
    }

    private AppState.SmartBudgetSuggestion? _smartSuggestion;

    private void PreviewSmartBudget() => _smartSuggestion = State.GetSmartBudgetSuggestion();

    private async Task ApplySmartBudgetAsync()
    {
        if (_smartSuggestion is null) return;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        await State.SetBudgetOverrideAsync("Income", _smartSuggestion.Income.ToString(inv));
        await State.SetBudgetOverrideAsync("Bills", _smartSuggestion.Bills.ToString(inv));
        await State.SetBudgetOverrideAsync("Essentials", _smartSuggestion.Essentials.ToString(inv));
        await State.SetBudgetOverrideAsync("Savings", _smartSuggestion.Savings.ToString(inv));
        await State.SetBudgetOverrideAsync("Unplanned", _smartSuggestion.Unplanned.ToString(inv));
        _smartSuggestion = null;
    }

    private async Task SaveBudgetEnvelopeAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEnvelopeName)) return;
        if (!decimal.TryParse(_newEnvelopeAmount, out var amt) || amt <= 0) return;
        await State.SetCustomBudgetCategoryAmountAsync(_newEnvelopeName.Trim(), amt);
        _newEnvelopeName = string.Empty;
        _newEnvelopeAmount = string.Empty;
        _showBudgetEnvelopeForm = false;
        _showBudgetAddPicker = false;
    }

    private decimal BillWeekly(Bill b) => State.GetBillRecurringWeekly(b);

    private static string FreqAbbr(BillFrequency freq) => freq switch
    {
        BillFrequency.Weekly      => "weekly",
        BillFrequency.Fortnightly => "fortnightly",
        BillFrequency.Monthly     => "monthly",
        BillFrequency.Quarterly   => "quarterly",
        BillFrequency.Yearly      => "yearly",
        _                         => "monthly"
    };

    private IEnumerable<(string Label, string Field, decimal Amount, string Color)> EditableBudgetRows()
    {
        yield return ("Bills", "Bills", State.BudgetBills, "#2563EB");
        yield return ("Essentials", "Essentials", State.BudgetEssentials, "#16A34A");
        yield return ("Savings", "Savings", State.BudgetSavings, "#7C3AED");
        yield return ("Unplanned", "Unplanned", State.BudgetUnplanned, "#D97706");
    }

    private decimal GetLimitDisplay(string categoryName)
    {
        var monthlyLimit = State.GetCategoryLimitDollars(categoryName);
        return State.SummaryPeriod == "Weekly"
            ? Math.Round(monthlyLimit * 12m / 52m, 2)
            : monthlyLimit;
    }

    private async Task SetLimitAsync(string categoryName, string? raw)
    {
        if (!decimal.TryParse(raw, out var dollars)) dollars = 0;
        var monthlyDollars = State.SummaryPeriod == "Weekly"
            ? dollars * 52m / 12m
            : dollars;
        var cents = (int)Math.Round(monthlyDollars * 100m);
        await State.SaveSettingAsync($"CategoryLimit:{categoryName}", cents.ToString());
    }

    private async Task SetAffordModeAsync(string mode)
    {
        if (_affordMode == mode) return;
        _affordMode = mode;
        await State.SaveSettingAsync("AffordabilityMode", _affordMode);
        if (_affordAmount > 0) await SaveAffordabilitySettingsAsync();
    }

    private async Task OnAffordAmountChanged()
    {
        if (_affordAmount > 0) await SaveAffordabilitySettingsAsync();
    }

    private async Task OnGoalWeeksChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var weeks) && weeks > 0)
        {
            _goalWeeks = weeks;
            await SaveAffordabilitySettingsAsync();
        }
    }

    private async Task OnGoalTargetDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var targetDate))
        {
            _goalWeeks = State.PaydaysBefore(targetDate);
            await SaveAffordabilitySettingsAsync();
        }
    }

    private async Task SelectPaceAsync(int weeks)
    {
        _goalWeeks = Math.Max(weeks, 1);
        await SaveAffordabilitySettingsAsync();
    }

    // Shortest number of pay cycles that still keeps the per-cycle contribution
    // comfortably under spare budget (same "Comfortable" threshold as the
    // verdict tiers below: needing less than half of spare budget per cycle),
    // capped at 2 years out so a near-zero spare budget doesn't suggest an
    // absurd timeline. Null when there's no spare budget to save from at all,
    // or the amount is already covered.
    private static int? RecommendedGoalCycles(decimal amountStillNeeded, decimal cycleSpare)
    {
        if (amountStillNeeded <= 0 || cycleSpare <= 0) return null;
        const int maxCycles = 104;
        var minCycles = (int)Math.Ceiling(amountStillNeeded / (cycleSpare * 0.5m));
        return Math.Clamp(minCycles, 1, maxCycles);
    }

    // Kept for any remaining callers; new code prefers State.PaydaysBefore.
    private static int WeeksUntil(DateTime targetDate)
    {
        var days = Math.Max((targetDate.Date - DateTime.Today).TotalDays, 1);
        return Math.Max((int)Math.Ceiling(days / 7d), 1);
    }

    private async Task OnGoalAccountChanged(ChangeEventArgs e)
    {
        _goalAccountName = e.Value?.ToString() ?? string.Empty;
        await SaveAffordabilitySettingsAsync();
    }

    private async Task OnInstallmentCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var count) && count >= 2)
        {
            _installmentCount = count;
            await SaveAffordabilitySettingsAsync();
        }
    }

    private async Task OnInstallmentFrequencyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var weeks) && weeks > 0)
        {
            _installmentFrequencyWeeks = weeks;
            await SaveAffordabilitySettingsAsync();
        }
    }

    private async Task SetSavingsGoalAsync(int accountId, decimal targetDollars, DateTime targetDate)
    {
        await State.SetAccountGoalAsync(accountId, targetDollars, targetDate);
    }

    private void OnWhatIfSliderChanged(int goalId, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var weekly))
            _goalWhatIfWeekly[goalId] = weekly;
    }

    private async Task OnGroupWhatIfSliderChangedAsync(string groupName, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var weekly))
        {
            _groupWhatIfWeekly[groupName] = weekly;
            await State.SaveSettingAsync(GroupWhatIfSettingKey(groupName), weekly.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }
    }

    private void LoadGroupWhatIfSettings()
    {
        foreach (var groupName in State.GetSavingsGoalGroupNames())
        {
            var raw = State.GetSetting(GroupWhatIfSettingKey(groupName));
            if (decimal.TryParse(raw, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var weekly) && weekly > 0)
                _groupWhatIfWeekly[groupName] = weekly;
        }
    }

    private static string GroupWhatIfSettingKey(string groupName) => $"GoalGroupWhatIfWeekly:{groupName}";

    private static string BuildSpendingPaceSummary(decimal spendToDate, decimal periodBudget, decimal remainingBudget, decimal dailyRoom, int daysRemaining, decimal projectedDelta, string periodNounLower)
    {
        if (periodBudget <= 0)
            return "Set a discretionary budget to see how much room you have for the rest of the period.";

        if (remainingBudget < 0)
            return $"You've spent {spendToDate:C} against a {periodBudget:C} {periodNounLower} budget, so you're {Math.Abs(remainingBudget):C} over already.";

        if (projectedDelta > 0)
            return $"You have {remainingBudget:C} left. Keep future discretionary spending near {dailyRoom:C}/day to finish inside budget.";

        var projectedUnder = Math.Abs(projectedDelta);
        return $"You have {remainingBudget:C} left, about {dailyRoom:C}/day for the next {daysRemaining} day{(daysRemaining == 1 ? "" : "s")}. At this pace you'll finish about {projectedUnder:C} under budget.";
    }

    private List<string> PaceCategoryOptions()
    {
        var periodCategories = State.Transactions
            .Where(t => t.Date.Date >= PeriodRange.From.Date && t.Date.Date <= PeriodRange.To.Date && t.AmountCents < 0 && !State.IsInternalMovement(t))
            .Select(t => t.CategoryName)
            .Where(c => !string.IsNullOrWhiteSpace(c));

        return periodCategories
            .Concat(State.PaceExcludedCategories)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private List<string> PaceRecurringNameOptions()
    {
        return State.GetRecurringPayments()
            .Select(r => r.Name)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Concat(State.PaceExcludedTransactionNames)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

