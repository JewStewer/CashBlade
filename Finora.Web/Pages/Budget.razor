    private string GetEffectiveBillBudgetCategory(Bill b)
    {
        var cat = State.GetBillBudgetCategory(b);
        if (!string.IsNullOrEmpty(cat)) return cat;
        if (!string.IsNullOrWhiteSpace(b.AccountName))
        {
            var acct = State.GetBillAccountBudgetCategory(b.AccountName);
            if (!string.IsNullOrEmpty(acct)) return acct;
        }
        return "Bills";
    }

    // Returns (Done, Needed, Required) for the budget category's transfer status.
    // Required = what should already be saved today across every unpaid bill on
    // the matched accounts; Needed = the real catch-up shortfall still to move
    // (Required minus what's already there, floored at 0) — not capped to a
    // week's rate, so it reflects a missed transfer or money pulled back out
    // mid-week just as much as an upcoming bill. Required minus Needed is what's
    // actually been transferred so far, for showing partial progress.
    // Done=true: fully caught up. Done=false: at least one account is short.
    // Done=null: no bills map to a known account (nothing to check).
    // Resolves accounts by AccountId first, then AccountName fallback for bills
    // with AccountId=0 (e.g. Afterpay, Subscriptions shared-account bills).
    private (bool? Done, decimal Needed, decimal Required) GetBudgetCategoryTransferInfo(string label)
    {
        var bills = BillsForBudgetCategory(label);
        if (!bills.Any()) return (null, 0, 0);

        var accountIds = new HashSet<int>();
        foreach (var (bill, _) in bills)
        {
            if (bill.AccountId > 0)
            {
                accountIds.Add(bill.AccountId);
            }
            else if (!string.IsNullOrWhiteSpace(bill.AccountName))
            {
                var acct = State.Accounts.FirstOrDefault(a =>
                    string.Equals(a.Name, bill.AccountName.Trim(), StringComparison.OrdinalIgnoreCase));
                if (acct != null) accountIds.Add(acct.Id);
            }
        }
        if (!accountIds.Any()) return (null, 0, 0);

        var planByAccount = GetFullTransferPlan().ToDictionary(x => x.AccountId);
        var matchedPlans = accountIds
            .Where(planByAccount.ContainsKey)
            .Select(id => planByAccount[id])
            .ToList();
        if (!matchedPlans.Any()) return (null, 0, 0);

        var remaining = matchedPlans.Sum(p => p.Remaining);
        var required = matchedPlans.Sum(p => p.Required);
        return (remaining <= 0, remaining, required);
    }

    private sealed record TransferPlanEntry(int AccountId, decimal Required, decimal Remaining, bool IsDone);

    // Builds the payday transfer plan: each account's Required is the sum of what
    // should already be saved today toward every unpaid bill assigned to it, using
    // GetBillRequiredToDate's progressive accrual (a bill due in 6 months and one
    // due next week are both weighed by how far through their own cycle they are,
    // so there's no horizon cutoff that lets a far-future bill hide entirely).
    // Remaining compares that against the account's live balance, so both a missed
    // transfer and money moved back out mid-week surface as still-needed.
    private List<TransferPlanEntry> GetFullTransferPlan()
    {
        return State.Accounts
            .Where(a => a.Id != State.PayAccountId && a.Type != AccountType.Credit)
            .Select(a =>
            {
                // Bills with AccountId==0 are linked by AccountName; match both ways.
                var bills = State.Bills
                    .Where(b => !State.IsBillPaid(b) &&
                        (b.AccountId == a.Id ||
                         (b.AccountId == 0 && !string.IsNullOrWhiteSpace(b.AccountName) &&
                          string.Equals(b.AccountName.Trim(), a.Name, StringComparison.OrdinalIgnoreCase))))
                    .ToList();
                var required = bills.Sum(b => State.GetBillRequiredToDate(b));
                var currentBalance = State.GetAccountBalance(a.Id);
                var remaining = Math.Max(0m, required - currentBalance);
                return (Entry: new TransferPlanEntry(a.Id, required, remaining, remaining <= 0m), HasBills: bills.Count > 0);
            })
            .Where(x => x.HasBills)
            .Select(x => x.Entry)
            .OrderByDescending(x => x.Remaining)
            .ToList();
    }

