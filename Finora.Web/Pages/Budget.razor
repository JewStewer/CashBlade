@page "/budget"
@inject AppState State

<PageTitle>Budget — Finance Blade</PageTitle>

<div style="padding:16px">
    <!-- Budget overview card -->
    <div class="card">
        <div style="font-size:12px;color:var(--text3);margin-bottom:12px">Weekly Budget</div>
        @if (State.WeeklyIncome <= 0)
        {
            <div style="color:var(--text3);font-size:14px">No budget set up yet. Sync from your PC to load your budget.</div>
        }
        else
        {
            var usedPct = State.WeeklyIncome > 0 ? Math.Min((State.WeeklyIncome - State.BudgetLeftover) / State.WeeklyIncome, 1) : 0;
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
                <span style="font-size:26px;font-weight:700">@State.WeeklyIncome.ToString("C")</span>
                <span style="font-size:13px;color:var(--text3)">per week</span>
            </div>
            <div class="progress-bar" style="height:8px;margin-bottom:12px">
                <div class="progress-fill" style="width:@((int)(usedPct*100))%;background:@(State.BudgetLeftover>=0?"var(--teal)":"var(--red)")"></div>
            </div>

            @foreach (var (label, amount, color) in BudgetRows())
            {
                var pct = State.WeeklyIncome > 0 ? amount / State.WeeklyIncome : 0;
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                    <div class="dot" style="background:@color"></div>
                    <div style="flex:1">
                        <div style="display:flex;justify-content:space-between">
                            <span style="font-size:14px">@label</span>
                            <span style="font-size:14px;font-weight:600">@amount.ToString("C")</span>
                        </div>
                        <div class="progress-bar" style="margin-top:4px">
                            <div class="progress-fill" style="width:@((int)(Math.Clamp(pct,0,1)*100))%;background:@color"></div>
                        </div>
                        <div style="font-size:11px;color:var(--text3);margin-top:2px">@pct.ToString("P0") of income</div>
                    </div>
                </div>
            }

            <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:4px;display:flex;justify-content:space-between;align-items:center">
                <span style="font-size:14px;color:var(--text3)">Remaining</span>
                <span style="font-size:16px;font-weight:700;color:@(State.BudgetLeftover>=0?"var(--green)":"var(--red)")">
                    @State.BudgetLeftover.ToString("C")
                </span>
            </div>
        }
    </div>

    <!-- Period spending vs budget -->
    @if (State.WeeklyIncome > 0)
    {
        <div class="card" style="margin-top:12px">
            <div style="font-size:12px;color:var(--text3);margin-bottom:12px">This @State.SummaryPeriod · Essentials &amp; Unplanned</div>
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
                <span style="font-size:22px;font-weight:700;color:@(PeriodSpend>PeriodBudget?"var(--red)":"var(--text)")">
                    @PeriodSpend.ToString("C")
                </span>
                <span style="font-size:13px;color:var(--text3)">of @PeriodBudget.ToString("C")</span>
            </div>
            <div class="progress-bar" style="height:8px">
                <div class="progress-fill" style="width:@((int)(Math.Min(PeriodSpendPct,1)*100))%;background:@(PeriodSpend>PeriodBudget?"var(--red)":"var(--teal)")"></div>
            </div>
            <div style="margin-top:6px">
                @if (PeriodSpend > PeriodBudget)
                {
                    <div style="font-size:12px;color:var(--red);font-weight:600;margin-bottom:10px">@((PeriodSpend - PeriodBudget).ToString("C")) over budget</div>
                    <div style="font-size:11px;color:var(--text3);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.05em">Biggest drivers</div>
                    @foreach (var (cat, amount) in TopCats.Take(4))
                    {
                        var share = PeriodSpend > 0 ? amount / PeriodSpend : 0;
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">
                            <span style="font-size:13px;color:var(--text2)">@cat</span>
                            <div style="text-align:right">
                                <span style="font-size:13px;font-weight:600;color:@(amount > PeriodBudget * 0.4m ? "var(--red)" : "var(--text)")">@amount.ToString("C")</span>
                                <span style="font-size:11px;color:var(--text3);margin-left:4px">@share.ToString("P0")</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <span style="font-size:12px;color:var(--text3)">@((PeriodBudget - PeriodSpend).ToString("C")) remaining</span>
                }
            </div>
        </div>

        <!-- Top transactions / categories -->
        @if (PeriodSpend > PeriodBudget && BiggestPeriodTxns.Any())
        {
            <div class="card" style="margin-top:12px">
                <div style="font-size:12px;color:var(--text3);margin-bottom:12px">What's costing the most</div>
                @foreach (var t in BiggestPeriodTxns)
                {
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                        <div style="flex:1;min-width:0">
                            <div style="font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@t.Description</div>
                            <div style="font-size:11px;color:var(--text3)">@t.CategoryName · @t.Date.ToString("d MMM")</div>
                        </div>
                        <span style="font-size:15px;font-weight:700;color:var(--red);flex-shrink:0">@Math.Abs(t.AmountDollars).ToString("C")</span>
                    </div>
                }
            </div>
        }
        else if (TopCats.Any())
        {
            <div class="card" style="margin-top:12px">
                <div style="font-size:12px;color:var(--text3);margin-bottom:12px">Top Spending Categories</div>
                @foreach (var (cat, amount) in TopCats)
                {
                    var w = TopCatMax > 0 ? amount / TopCatMax : 0;
                    <div style="margin-bottom:10px">
                        <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:3px">
                            <span>@cat</span>
                            <span style="font-weight:600">@amount.ToString("C")</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width:@((int)(w*100))%"></div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- Spending chart -->
    @if (TopCats.Any())
    {
        <div class="card" style="margin-top:12px">
            <div style="font-size:12px;color:var(--text3);margin-bottom:14px">Spending Breakdown</div>
            @{
                var chartCats = State.GetTopCategories(8, excludeBills: false);
                var chartMax = chartCats.Any() ? chartCats.Max(c => c.Amount) : 1m;
                var palette = new[]{"#2563EB","#16A34A","#D97706","#DC2626","#7C3AED","#0891B2","#BE185D","#65A30D"};
            }
            @for (var i = 0; i < chartCats.Count; i++)
            {
                var (cat, amt) = chartCats[i];
                var barW = chartMax > 0 ? (double)(amt / chartMax) * 100.0 : 0;
                var color = palette[i % palette.Length];
                <div style="margin-bottom:8px">
                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px">
                        <span style="color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:60%">@cat</span>
                        <span style="font-weight:600;color:var(--text);flex-shrink:0">@amt.ToString("C")</span>
                    </div>
                    <div style="background:var(--surface2);border-radius:4px;height:10px;overflow:hidden">
                        <div style="height:100%;border-radius:4px;background:@color;width:@($"{barW:F1}")%;transition:width 0.4s ease"></div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Safe to spend / Over budget breakdown -->
    <div class="card" style="margin-top:12px;border-color:@(State.SafeToSpendAmount>0?"var(--teal)":"var(--red)")">
        <div style="font-size:12px;color:var(--text3)">Safe to Spend</div>
        <div style="font-size:28px;font-weight:700;color:@(State.SafeToSpendAmount>0?"var(--green)":"var(--red)")">
            @(State.SafeToSpendAmount > 0 ? State.SafeToSpendAmount.ToString("C") : "Over budget")
        </div>
        <div style="font-size:13px;color:var(--text3);margin-top:4px">After bills, savings and essentials</div>

        @if (State.SafeToSpendAmount <= 0 && State.WeeklyIncome > 0)
        {
            <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
                <div style="font-size:12px;font-weight:600;color:var(--red);margin-bottom:8px">Why you're over budget</div>
                @foreach (var (label, amount, color) in OverBudgetRows())
                {
                    var pct = State.WeeklyIncome > 0 ? amount / State.WeeklyIncome : 0;
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                        <div style="display:flex;align-items:center;gap:8px">
                            <div class="dot" style="background:@color"></div>
                            <span style="font-size:13px;color:var(--text2)">@label</span>
                        </div>
                        <div style="text-align:right">
                            <span style="font-size:13px;font-weight:600">@amount.ToString("C")</span>
                            <span style="font-size:11px;color:var(--text3);margin-left:4px">@pct.ToString("P0")</span>
                        </div>
                    </div>
                }
                <div style="border-top:1px solid var(--border);margin-top:6px;padding-top:6px;display:flex;justify-content:space-between">
                    <span style="font-size:12px;color:var(--text3)">Total allocated</span>
                    <span style="font-size:13px;font-weight:700;color:var(--red)">
                        @AllocatedTotal.ToString("C")
                        <span style="font-size:11px;font-weight:400;color:var(--text3)"> of @State.WeeklyIncome.ToString("C")</span>
                    </span>
                </div>
                <div style="font-size:12px;color:var(--red);margin-top:4px;text-align:right">
                    @((AllocatedTotal - State.WeeklyIncome).ToString("C")) over your weekly income
                </div>
            </div>
        }
    </div>
</div>

<div style="height:16px"></div>

@code {
    // Discretionary spend/budget: excludes bill categories (Debt, Rent, Phone, Insurance, etc.)
    // which are already tracked in the Bills page and weekly budget allocation.
    private decimal PeriodSpend => State.GetDiscretionarySpending();
    private decimal PeriodBudget => State.SummaryPeriod == "Monthly" ? State.WeeklyIncome * 4.33m : State.WeeklyIncome;
    private decimal PeriodSpendPct => PeriodBudget > 0 ? Math.Min(PeriodSpend / PeriodBudget, 1.5m) : 0;
    private List<(string Category, decimal Amount)> TopCats => State.GetTopCategories(5, excludeBills: true);
    private decimal TopCatMax => TopCats.Any() ? Math.Max(TopCats.Max(c => c.Amount), 1m) : 1m;

    private List<Transaction> BiggestPeriodTxns
    {
        get
        {
            var (from, to) = State.GetCurrentPeriod();
            return State.Transactions
                .Where(t => t.Date.Date >= from && t.Date.Date <= to && t.AmountCents < 0)
                .Where(t => t.CategoryName is not "Transfer" and not "Opening Balance" and not "Balance Adjustment" &&
                            !(t.TransferId.HasValue && t.TransferId.Value != Guid.Empty) &&
                            !AppState.IsBillCategory(t.CategoryName))
                .OrderBy(t => t.AmountCents)
                .Take(10)
                .ToList();
        }
    }

    private decimal AllocatedTotal =>
        State.BudgetBills + State.BudgetEssentials + State.BudgetSavings + State.BudgetUnplanned;

    private IEnumerable<(string Label, decimal Amount, string Color)> BudgetRows()
    {
        yield return ("Bills", State.BudgetBills, "#2563EB");
        yield return ("Essentials", State.BudgetEssentials, "#16A34A");
        yield return ("Savings", State.BudgetSavings, "#7C3AED");
        yield return ("Unplanned", State.BudgetUnplanned, "#D97706");
    }

    private IEnumerable<(string Label, decimal Amount, string Color)> OverBudgetRows() =>
        BudgetRows().OrderByDescending(r => r.Amount);
}
