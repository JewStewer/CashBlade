    private List<(Bill Bill, decimal Weekly)> BillsForBudgetCategory(string label) =>
        State.Bills
            .Where(b => string.Equals(GetEffectiveBillBudgetCategory(b), label, StringComparison.OrdinalIgnoreCase))
            .Select(b => (Bill: b, Weekly: BillWeekly(b)))
