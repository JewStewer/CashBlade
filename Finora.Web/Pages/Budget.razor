@page "/budget"
@inject AppState State
@inject NavigationManager Nav

<PageTitle>Budget — Evergrove</PageTitle>

<div class="pill-tabs">
    @foreach (var t in new[]{"Overview","Spending","History","Forecast","Daily","Holiday"})
    {
        <button class="pill @(_tab==t?"pill-active":"pill-inactive")" @onclick="() => SelectTopPill(t)">@t</button>
    }
</div>

<div style="padding:0 16px 8px;display:flex;align-items:center;gap:8px">
    <span style="font-size:12px;color:var(--text3);font-weight:700;text-transform:uppercase">Budget period</span>
    <div style="display:flex;gap:6px;flex:1;justify-content:flex-end">
        @foreach (var p in new[]{"Weekly","Monthly"})
        {
            <button class="pill @(State.SummaryPeriod==p?"pill-active":"pill-inactive")" @onclick="() => SetPeriodAsync(p)">@p</button>
        }
    </div>
</div>

<div style="padding:16px">

@if (_tab == "Overview")
{
    <div>
    <!-- Payday transfer plan -->
    @{
        var transferPlan = State.GetPaydayTransferPlan();
    }
    @if (transferPlan.Any())
    {
        <div class="card" style="margin-top:12px;border-color:rgba(245,158,11,0.4)">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                <div>
                    <div style="font-size:12px;color:var(--text3)">💸 Payday Transfer Plan</div>
                    <div style="font-size:11px;color:var(--text3);opacity:0.7;margin-top:2px">Move this from your pay account before @State.NextPayDate.ToString("dd MMM") so each account can cover its own bills</div>
                </div>
                <span style="font-size:14px;font-weight:700;color:var(--amber)">@transferPlan.Sum(t => t.Amount).ToString("C")</span>
            </div>
            @foreach (var item in transferPlan)
            {
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
                    <div class="dot" style="background:@item.AccountColorHex"></div>
                    <span style="flex:1;font-size:14px">@item.AccountName</span>
                    <span style="font-size:14px;font-weight:600">@item.Amount.ToString("C")</span>
                </div>
            }
        </div>
    }

    <!-- Pending reimbursements -->
    @{
        var unrepaid = State.LentTransactions.Where(l => State.IsUnrepaid(l.Id))
            .Select(l => (Lent: l, Txn: State.Transactions.FirstOrDefault(t => t.Id == l.Id)))
            .Where(x => x.Txn is not null)
            .OrderByDescending(x => x.Txn!.Date)
            .ToList();
    }
    @if (unrepaid.Any())
    {
        var totalOwed = unrepaid.Sum(x => State.GetLentOutstandingDollars(x.Txn!));
        <div class="card" style="margin-top:12px;border-color:rgba(99,102,241,0.4)">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <div>
                    <div style="font-size:12px;color:var(--text3)">🤝 Pending Reimbursements</div>
                    <div style="font-size:11px;color:var(--text3);opacity:0.7;margin-top:2px">Excluded from your spending until marked repaid</div>
                </div>
                <span style="font-size:14px;font-weight:700;color:#818CF8">@totalOwed.ToString("C")</span>
            </div>
            @foreach (var (lent, txn) in unrepaid)
            {
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--border)">
                    <div style="flex:1;min-width:0">
                        <div style="font-size:14px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@txn!.Description</div>
                        <div style="font-size:11px;color:var(--text3)">
                            @txn.Date.ToString("d MMM")
                            @if (!string.IsNullOrEmpty(lent.Note)) { <span> · @lent.Note</span> }
                        </div>
                    </div>
                    <span style="font-size:14px;font-weight:600;color:#818CF8;flex-shrink:0">@State.GetLentOutstandingDollars(txn).ToString("C") owed</span>
                    <button @onclick="() => State.MarkRepaidAsync(lent.Id)" style="background:rgba(52,211,153,0.1);border:1px solid rgba(52,211,153,0.4);color:var(--green);border-radius:8px;padding:4px 10px;font-size:12px;cursor:pointer;flex-shrink:0">
                        Got paid back ✓
                    </button>
                </div>
            }
        </div>
    }

    <!-- Budget overview card -->
    <div class="card" style="margin-top:12px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px">
            <div style="font-size:12px;color:var(--text3)">Planned Weekly Budget</div>
            @if (State.WeeklyIncome > 0 || _editingBudget)
            {
                <button class="btn btn-sm btn-secondary" @onclick="() => _editingBudget = !_editingBudget">@(_editingBudget ? "Done" : "Edit")</button>
            }
        </div>
        <div style="font-size:11px;color:var(--text3);margin-bottom:12px;opacity:0.7">
            @(_editingBudget ? "Set your own weekly targets from your phone — overrides the PC's budget until changed again." : "How you've told PC to split your income each week")
        </div>
        @if (_editingBudget)
        {
            <div style="display:flex;flex-direction:column;gap:10px">
                <div style="display:flex;align-items:center;gap:8px">
                    <span style="flex:1;font-size:14px;font-weight:600">Weekly Income</span>
                    <input class="form-input" style="width:110px;text-align:right;padding:6px 10px;font-size:14px"
                           type="number" min="0" step="1" value="@State.WeeklyIncome"
                           @onchange='e => SetBudgetFieldAsync("Income", e)' />
                </div>
                @foreach (var (label, field, amount, color) in EditableBudgetRows())
                {
                    <div style="display:flex;align-items:center;gap:8px">
                        <div class="dot" style="background:@color"></div>
                        <span style="flex:1;font-size:14px">@label</span>
                        <input class="form-input" style="width:110px;text-align:right;padding:6px 10px;font-size:14px"
                               type="number" min="0" step="1" value="@amount"
                               @onchange="e => SetBudgetFieldAsync(field, e)" />
                    </div>
                }
                <div style="font-size:11px;color:var(--text3);margin-top:2px">Unallocated (spending budget): <strong>@State.BudgetLeftover.ToString("C")</strong>/wk</div>
            </div>
        }
        else if (State.WeeklyIncome <= 0)
        {
            <div style="color:var(--text3);font-size:14px">No budget set up yet. Sync from your PC, or tap Edit to set one up here.</div>
            <button class="btn btn-primary btn-sm" style="margin-top:10px" @onclick='() => Nav.NavigateTo("settings")'>Open Sync Settings</button>
        }
        else
        {
            var usedPct = State.WeeklyIncome > 0 ? Math.Min((State.WeeklyIncome - State.BudgetLeftover) / State.WeeklyIncome, 1) : 0;
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
                <span style="font-size:26px;font-weight:700">@State.WeeklyIncome.ToString("C")</span>
                <span style="font-size:13px;color:var(--text3)">per week</span>
            </div>
            <div class="progress-bar" style="height:8px;margin-bottom:12px">
                <div class="progress-fill" style="width:@((int)(usedPct*100))%;background:@(State.BudgetLeftover>=0?"var(--teal)":"var(--red)")"></div>
            </div>

            @foreach (var (label, amount, color) in BudgetRows())
            {
                var pct = State.WeeklyIncome > 0 ? amount / State.WeeklyIncome : 0;
                var notSet = amount == 0;
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;@(notSet?"opacity:0.45":"")">
                    <div class="dot" style="background:@color"></div>
                    <div style="flex:1">
                        <div style="display:flex;justify-content:space-between">
                            <span style="font-size:14px">@label</span>
                            <span style="font-size:14px;font-weight:600">
                                @if (notSet) { <span style="font-size:12px;color:var(--text3);font-weight:400">not set</span> }
                                else { @amount.ToString("C") }
                            </span>
                        </div>
                        @if (!notSet)
                        {
                            <div class="progress-bar" style="margin-top:4px">
                                <div class="progress-fill" style="width:@((int)(Math.Clamp(pct,0,1)*100))%;background:@color"></div>
                            </div>
                            <div style="font-size:11px;color:var(--text3);margin-top:2px">@pct.ToString("P0") of income</div>
                        }
                    </div>
                </div>
            }

            @if (State.PlannedSavingsTransfers > 0)
            {
                <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:8px">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                        <span style="font-size:13px;color:var(--text3)">Weekly savings transfers</span>
                        <span style="font-size:14px;font-weight:700;color:var(--teal)">@State.PlannedSavingsTransfers.ToString("C")/wk</span>
                    </div>
                    @foreach (var goal in State.SavingsGoals.Where(g => g.WeeklyContributionDollars > 0))
                    {
                        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
                            <span style="color:var(--text2)">@goal.Name</span>
                            <span style="font-weight:600">@goal.WeeklyContributionDollars.ToString("C")/wk</span>
                        </div>
                    }
                    @foreach (var trip in State.Trips.Where(t => t.WeeklyContributionDollars > 0))
                    {
                        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
                            <span style="color:var(--text2)">@trip.Name holiday</span>
                            <span style="font-weight:600">@trip.WeeklyContributionDollars.ToString("C")/wk</span>
                        </div>
                    }
                </div>
            }

            @if (State.BudgetWeeklyTransfers > 0)
            {
                <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:8px;display:flex;justify-content:space-between;align-items:center">
                    <span style="font-size:13px;color:var(--text3)">Weekly transfers total</span>
                    <span style="font-size:15px;font-weight:700;color:var(--green)">@State.BudgetWeeklyTransfers.ToString("C")/wk</span>
                </div>
            }

            <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:4px;display:flex;justify-content:space-between;align-items:center">
                <span style="font-size:14px;color:var(--text3)">Unallocated (your spending budget)</span>
                <span style="font-size:16px;font-weight:700;color:@(State.BudgetLeftover>=0?"var(--green)":"var(--red)")">
                    @State.BudgetLeftover.ToString("C")
                </span>
            </div>
        }
    </div>

    @if (State.WeeklyIncome > 0)
    {
        var daysRemaining = Math.Max((PeriodRange.To.Date - DateTime.Today).Days + 1, 1);
        var remainingBudget = PeriodBudget - PeriodSpend;
        var dailyPace = Math.Max(remainingBudget / daysRemaining, 0);
        var elapsedDays = Math.Max((DateTime.Today.Date - PeriodRange.From.Date).Days + 1, 1);
        var projectedSpend = PeriodSpend / elapsedDays * PeriodDays;
        var paceColor = projectedSpend <= PeriodBudget ? "var(--green)" : "var(--red)";
        <div class="card" style="margin-top:12px;border-color:@(projectedSpend <= PeriodBudget ? "rgba(52,211,153,0.35)" : "rgba(248,113,113,0.35)")">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px">
                <div>
                    <div style="font-size:12px;color:var(--text3)">Spending Pace</div>
                    <div style="font-size:18px;font-weight:700;color:@paceColor">
                        @(projectedSpend <= PeriodBudget ? "On track" : "Running hot")
                    </div>
                </div>
                <div style="text-align:right">
                    <div style="font-size:11px;color:var(--text3)">Daily room</div>
                    <div style="font-size:16px;font-weight:700">@dailyPace.ToString("C")</div>
                </div>
            </div>
            <div style="font-size:11px;color:var(--text3);margin-top:6px;opacity:0.7">Projects your total spend for this @PeriodNounLower if you keep today's average daily pace — "Daily room" is what's left to spend per remaining day and stay on budget.</div>
            <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:10px">
                <div style="background:var(--surface2);border-radius:8px;padding:8px;text-align:center">
                    <div class="stat-label">Left</div>
                    <div style="font-size:14px;font-weight:700;color:@(remainingBudget >= 0 ? "var(--green)" : "var(--red)")">@remainingBudget.ToString("C")</div>
                </div>
                <div style="background:var(--surface2);border-radius:8px;padding:8px;text-align:center">
                    <div class="stat-label">Projected</div>
                    <div style="font-size:14px;font-weight:700;color:@paceColor">@projectedSpend.ToString("C")</div>
                </div>
                <div style="background:var(--surface2);border-radius:8px;padding:8px;text-align:center">
                    <div class="stat-label">Days left</div>
                    <div style="font-size:14px;font-weight:700">@daysRemaining</div>
                </div>
            </div>
        </div>
    }

    <!-- Debts -->
    @if (State.Debts.Any())
    {
        <div class="card" style="margin-top:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
                <div style="font-size:12px;color:var(--text3)">Debts</div>
                <span style="font-size:13px;font-weight:700;color:var(--red)">@State.Debts.Sum(d => d.BalanceDollars).ToString("C") total</span>
            </div>
            @foreach (var debt in State.Debts)
            {
                var paidOff = debt.OriginalBalanceDollars > 0
                    ? Math.Clamp(1m - debt.BalanceDollars / debt.OriginalBalanceDollars, 0m, 1m)
                    : 0m;
                <div style="margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border);cursor:pointer" @onclick="() => _debtDraft = debt">
                    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px">
                        <span style="font-size:14px;font-weight:600">@debt.Name</span>
                        <span style="font-size:15px;font-weight:700;color:var(--red)">@debt.BalanceDollars.ToString("C")</span>
                    </div>
                    @if (debt.InterestRate.HasValue && debt.InterestRate.Value > 0)
                    {
                        <div style="font-size:11px;color:var(--text3);margin-bottom:5px">
                            @debt.InterestRate.Value.ToString("P1") APR
                            @if (debt.MinimumPaymentDollars > 0)
                            { <span> · Min @debt.MinimumPaymentDollars.ToString("C")/@debt.PaymentPeriod.ToLower()</span> }
                        </div>
                    }
                    @if (debt.OriginalBalanceDollars > 0)
                    {
                        <div class="progress-bar" style="height:6px">
                            <div class="progress-fill" style="width:@((int)(paidOff*100))%;background:#16A34A"></div>
                        </div>
                        <div style="font-size:11px;color:var(--text3);margin-top:3px">@paidOff.ToString("P0") paid off · started @debt.OriginalBalanceDollars.ToString("C")</div>
                    }
                </div>
            }
        </div>
    }

    <!-- Savings goals -->
    @if (State.SavingsGoals.Any())
    {
        <div class="card" style="margin-top:12px">
            <div style="font-size:12px;color:var(--text3);margin-bottom:14px">Savings Goals</div>
            @foreach (var goal in State.SavingsGoals)
            {
                var progress = goal.TargetDollars > 0
                    ? Math.Clamp(goal.CurrentDollars / goal.TargetDollars, 0m, 1m)
                    : 0m;
                var remaining = goal.TargetDollars - goal.CurrentDollars;
                var reached = remaining <= 0;
                <div style="margin-bottom:14px;padding-bottom:14px;border-bottom:1px solid var(--border)">
                    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px">
                        <span style="font-size:14px;font-weight:600">@goal.Name</span>
                        <span style="font-size:13px;color:@(reached?"var(--green)":"var(--teal)")">
                            @goal.CurrentDollars.ToString("C") / @goal.TargetDollars.ToString("C")
                        </span>
                    </div>
                    <div class="progress-bar" style="height:8px">
                        <div class="progress-fill" style="width:@((int)(progress*100))%;background:@(reached?"var(--green)":"var(--teal)")"></div>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:4px">
                        <span>@progress.ToString("P0") saved</span>
                        @if (reached)
                        {
                            <span style="color:var(--green);font-weight:600">Goal reached!</span>
                        }
                        else
                        {
                            <span>@remaining.ToString("C") to go</span>
                        }
                    </div>
                    @if (goal.WeeklyContributionDollars > 0 && !reached)
                    {
                        var weeksLeft = goal.WeeklyContributionDollars > 0
                            ? (int)Math.Ceiling((double)(remaining / goal.WeeklyContributionDollars))
                            : 0;
                        <div style="font-size:11px;color:var(--text3);margin-top:2px">
                            @goal.WeeklyContributionDollars.ToString("C")/wk · ~@weeksLeft weeks to goal
                        </div>
                    }
                    @if (goal.TargetDate.HasValue)
                    {
                        var daysLeft = (goal.TargetDate.Value.Date - DateTime.Today).Days;
                        <div style="font-size:11px;color:@(daysLeft < 30 && !reached ? "var(--amber)" : "var(--text3)");margin-top:2px">
                            Target: @goal.TargetDate.Value.ToString("d MMM yyyy")
                            @if (!reached) { <span> (@daysLeft days left)</span> }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- Can I afford it? -->
    <div class="card" style="margin-top:12px">
        <div style="font-size:12px;color:var(--text3);margin-bottom:8px">Can I Afford It?</div>
        <div style="display:flex;gap:6px;margin-bottom:10px">
            <button class="pill @(_affordMode=="OneOff"?"pill-active":"pill-inactive")" style="flex:1;text-align:center" @onclick='() => SetAffordModeAsync("OneOff")'>One-off</button>
            <button class="pill @(_affordMode=="Savings"?"pill-active":"pill-inactive")" style="flex:1;text-align:center" @onclick='() => SetAffordModeAsync("Savings")'>Saving up</button>
            <button class="pill @(_affordMode=="Installments"?"pill-active":"pill-inactive")" style="flex:1;text-align:center" @onclick='() => SetAffordModeAsync("Installments")'>Installments</button>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
            <span style="font-size:18px;color:var(--text3);font-weight:300">$</span>
            <input class="form-input" type="number" min="0" step="1"
                   @bind="_affordAmount" @bind:event="oninput" @onchange="OnAffordAmountChanged"
                   placeholder="Enter amount…" style="flex:1;font-size:18px;font-weight:600" />
        </div>

        @if (_affordMode == "Savings")
        {
            <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
                <div style="flex:1;min-width:120px">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Over how many weeks?</label>
                    <input class="form-input" type="number" min="1" step="1" @bind="_goalWeeks" @bind:event="oninput" @onchange="OnGoalWeeksChanged" style="font-size:14px" />
                </div>
                <div style="flex:1;min-width:120px">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Or by date</label>
                    <input class="form-input" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@GoalTargetDate.ToString("yyyy-MM-dd")" @onchange="OnGoalTargetDateChanged" style="font-size:14px" />
                </div>
                <div style="flex:1;min-width:160px">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Saving into</label>
                    <select class="form-input" value="@_goalAccountName" @onchange="OnGoalAccountChanged" style="font-size:14px">
                        <option value="">No specific account</option>
                        @foreach (var acc in State.Accounts)
                        {
                            <option value="@acc.Name">@acc.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (_affordAmount > 0)
            {
                var weeks = Math.Max(_goalWeeks, 1);
                var selectedTargetDate = GoalTargetDate;
                var weeklyNeeded = Math.Round(_affordAmount / weeks, 2);
                var weeklySpare = State.BudgetLeftover;
                var leftOver = weeklySpare - weeklyNeeded;
                var ratio = weeklySpare > 0 ? weeklyNeeded / weeklySpare : 999m;
                var (verdict, verdictColor) =
                    ratio < 0.5m ? ("✓ Comfortable — easily on track", "var(--green)") :
                    ratio <= 1m  ? ("⚠ Tight — uses most of your spare budget", "var(--amber)") :
                                   ("✕ Short — not enough spare to hit this goal", "var(--red)");
                var account = State.AffordabilityGoalAccount;

                @if (weeklySpare > 0)
                {
                    <div style="margin-top:12px;background:var(--surface2);border-radius:10px;padding:12px">
                        <div style="font-size:12px;color:var(--text3);margin-bottom:8px;font-weight:600">Savings pace for @_affordAmount.ToString("C")</div>
                        @foreach (var (label, multiplier, color) in PaceOptions)
                        {
                            var paceWeeks = Math.Max((int)Math.Ceiling(weeks * multiplier), 1);
                            var weeklyAmount = Math.Round(_affordAmount / paceWeeks, 2);
                            var paceLeftOver = weeklySpare - weeklyAmount;
                            var paceDate = DateTime.Today.AddDays(paceWeeks * 7);
                            var isSelected = paceWeeks == weeks;
                            <div @onclick="() => SelectPaceAsync(paceWeeks)" style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;border-radius:8px;cursor:pointer;margin-bottom:4px;background:var(--surface);border:1px solid @(isSelected ? color : "transparent")">
                                <div>
                                    <div style="font-size:13px;font-weight:700;color:@color">@label</div>
                                    <div style="font-size:11px;color:var(--text3)">@weeklyAmount.ToString("C")/wk</div>
                                    <div style="font-size:11px;color:@(paceLeftOver>=0?"var(--green)":"var(--red)")">@paceLeftOver.ToString("C")/wk left</div>
                                </div>
                                <div style="text-align:right">
                                    <div style="font-size:13px;font-weight:600">@paceWeeks wk@(paceWeeks == 1 ? "" : "s")</div>
                                    <div style="font-size:11px;color:var(--text3)">by @paceDate.ToString("dd MMM yy")</div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div style="margin-top:12px;background:var(--surface2);border-radius:10px;padding:12px">
                    <div style="font-size:14px;font-weight:700;color:@verdictColor;margin-bottom:10px">@verdict</div>
                    <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                        <span style="color:var(--text3)">Need to save</span>
                        <span style="font-weight:600">@weeklyNeeded.ToString("C")/wk for @weeks wk@(weeks == 1 ? "" : "s")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:13px">
                        <span style="color:var(--text3)">Your spare budget</span>
                        <span style="font-weight:600;color:@(weeklySpare>=weeklyNeeded?"var(--green)":"var(--red)")">@weeklySpare.ToString("C")/wk</span>
                    </div>
                    <div style="border-top:1px solid var(--border);margin-top:5px;padding-top:8px;display:flex;justify-content:space-between;font-size:14px">
                        <span style="color:var(--text3)">Left over after saving</span>
                        <span style="font-weight:700;color:@(leftOver>=0?"var(--green)":"var(--red)")">@leftOver.ToString("C")/wk</span>
                    </div>
                    @if (account is not null)
                    {
                        var currentBalance = State.GetAccountBalance(account.Id);
                        var projected = currentBalance + _affordAmount;
                        var alreadyTracking = account.TargetCents is not null;
                        <div style="border-top:1px solid var(--border);margin-top:5px;padding-top:8px">
                            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                                <span style="color:var(--text3)">@account.Name now</span>
                                <span style="font-weight:600">@currentBalance.ToString("C")</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;font-size:14px">
                                <span style="color:var(--text3)">Projected in @weeks wk@(weeks == 1 ? "" : "s")</span>
                                <span style="font-weight:700;color:@(weeklySpare>=weeklyNeeded?"var(--green)":"var(--red)")">@projected.ToString("C")</span>
                            </div>
                        </div>
                        <button class="btn btn-primary btn-sm btn-full" style="margin-top:10px" @onclick="() => SetSavingsGoalAsync(account.Id, projected, selectedTargetDate)">
                            @(alreadyTracking ? "Update Account Goal" : "Track as Account Goal")
                        </button>
                        @if (alreadyTracking)
                        {
                            <div style="font-size:11px;color:var(--text3);margin-top:6px;text-align:center">@account.Name already has a tracked goal — this will replace it.</div>
                        }
                    }
                </div>
            }
        }
        else if (_affordMode == "Installments")
        {
            <div style="display:flex;gap:8px;margin-top:10px">
                <div style="flex:1">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Number of payments</label>
                    <input class="form-input" type="number" min="2" step="1" @bind="_installmentCount" @bind:event="oninput" @onchange="OnInstallmentCountChanged" style="font-size:14px" />
                </div>
                <div style="flex:1">
                    <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:4px">Every (weeks)</label>
                    <input class="form-input" type="number" min="1" step="1" @bind="_installmentFrequencyWeeks" @bind:event="oninput" @onchange="OnInstallmentFrequencyChanged" style="font-size:14px" />
                </div>
            </div>

            @if (_affordAmount > 0)
            {
                var count = Math.Max(_installmentCount, 2);
                var freq = Math.Max(_installmentFrequencyWeeks, 1);
                var perInstallment = Math.Round(_affordAmount / count, 2);
                var weeklyImpact = Math.Round(perInstallment / freq, 2);
                var totalWeeks = (count - 1) * freq;
                var weeklySpare = State.BudgetLeftover;
                var remainingSpare = weeklySpare - weeklyImpact;
                var ratio = weeklySpare > 0 ? weeklyImpact / weeklySpare : 999m;
                var (verdict, verdictColor) =
                    ratio < 0.5m ? ("✓ Comfortable — easily on track", "var(--green)") :
                    ratio <= 1m  ? ("⚠ Tight — uses most of your spare budget", "var(--amber)") :
                                   ("✕ Short — not enough spare for these repayments", "var(--red)");

                <div style="margin-top:12px;background:var(--surface2);border-radius:10px;padding:12px">
                    <div style="font-size:14px;font-weight:700;color:@verdictColor;margin-bottom:10px">@verdict</div>
                    <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                        <span style="color:var(--text3)">Repayments</span>
                        <span style="font-weight:600">@count × @perInstallment.ToString("C") / @freq wk@(freq == 1 ? "" : "s")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:13px">
                        <span style="color:var(--text3)">Adds to your spending</span>
                        <span style="font-weight:600;color:@(weeklySpare>=weeklyImpact?"var(--green)":"var(--red)")">+@weeklyImpact.ToString("C")/wk</span>
                    </div>
                    <div style="border-top:1px solid var(--border);margin-top:5px;padding-top:8px;display:flex;justify-content:space-between;font-size:14px">
                        <span style="color:var(--text3)">Spare budget after</span>
                        <span style="font-weight:700;color:@(remainingSpare>=0?"var(--green)":"var(--red)")">@remainingSpare.ToString("C")/wk</span>
                    </div>
                    <div style="font-size:11px;color:var(--text3);margin-top:6px">
                        First payment today, then @(count-1) more every @freq wk@(freq == 1 ? "" : "s") · paid off in @totalWeeks wk@(totalWeeks == 1 ? "" : "s")
                    </div>
                    <button class="btn btn-primary btn-sm btn-full" style="margin-top:10px" @onclick="() => StartAddInstallmentBill(perInstallment, freq)">
                        + Add to Budget as a Bill
                    </button>
                </div>
            }
        }
        else if (_affordAmount > 0 && State.WeeklyIncome > 0)
        {
            var safe = State.SafeToSpendAmount;
            var remaining = safe - _affordAmount;
            var pct = safe > 0 ? _affordAmount / safe : (_affordAmount > 0 ? 1.5m : 0m);
            var (verdict, verdictColor) =
                remaining >= 0 && pct < 0.4m ? ("✓ Comfortably affordable", "var(--green)") :
                remaining >= 0 && pct < 0.8m ? ("⚠ Affordable — watch your budget", "var(--amber)") :
                remaining >= 0             ? ("⚠ Very tight — barely affordable", "var(--amber)") :
                                             ("✕ Over budget", "var(--red)");
            <div style="margin-top:12px;background:var(--surface2);border-radius:10px;padding:12px">
                <div style="font-size:14px;font-weight:700;color:@verdictColor;margin-bottom:10px">@verdict</div>
                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                    <span style="color:var(--text3)">Safe to spend now</span>
                    <span style="font-weight:600">@safe.ToString("C")</span>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                    <span style="color:var(--text3)">This purchase</span>
                    <span style="font-weight:600;color:var(--red)">−@_affordAmount.ToString("C")</span>
                </div>
                <div style="border-top:1px solid var(--border);padding-top:8px;display:flex;justify-content:space-between;font-size:14px">
                    <span style="color:var(--text3)">Remaining after</span>
                    <span style="font-weight:700;color:@verdictColor">@remaining.ToString("C")</span>
                </div>
                @if (State.WeeklyIncome > 0)
                {
                    var weeklyImpact = pct * 100m;
                    <div style="font-size:11px;color:var(--text3);margin-top:6px">
                        That's @weeklyImpact.ToString("0.0")% of your safe-to-spend budget
                    </div>
                }
            </div>
        }
    </div>

    <!-- Safe to spend / Over budget breakdown -->
    @{
        // SafeToSpendAmount is forced to $0 while No-Spend Mode is on, regardless of
        // the real underlying budget — BudgetSafeToSpendAmount ignores that override,
        // so it's the only reliable signal for whether the user is actually over
        // budget vs. just voluntarily holding spend at $0.
        var trulyOverBudget = State.BudgetSafeToSpendAmount <= 0 && State.WeeklyIncome > 0;
    }
    <div class="card" style="margin-top:12px;border-color:@(trulyOverBudget?"var(--red)":"var(--teal)")">
        <div style="font-size:12px;color:var(--text3)">Safe to Spend</div>
        <div style="font-size:28px;font-weight:700;color:@(trulyOverBudget?"var(--red)":"var(--green)")">
            @(trulyOverBudget ? "Over budget" : State.SafeToSpendAmount.ToString("C"))
        </div>
        <div style="font-size:13px;color:var(--text3);margin-top:4px">
            @(State.NoSpendMode ? "No-spend mode is holding this at $0" : "After bills, savings and essentials")
        </div>

        @if (State.OutstandingLentDollars > 0)
        {
            <div style="margin-top:10px;background:rgba(99,102,241,0.12);border:1px solid rgba(129,140,248,0.35);border-radius:10px;padding:10px">
                <div style="display:flex;justify-content:space-between;gap:10px">
                    <span style="font-size:12px;color:#A5B4FC">Owed back</span>
                    <strong style="font-size:14px;color:#A5B4FC">@State.OutstandingLentDollars.ToString("C")</strong>
                </div>
                <div style="display:flex;justify-content:space-between;gap:10px;margin-top:4px">
                    <span style="font-size:12px;color:var(--text3)">If paid back</span>
                    <strong style="font-size:14px;color:var(--green)">@State.SafeToSpendIfReimbursed.ToString("C")</strong>
                </div>
            </div>
        }

        @if (trulyOverBudget)
        {
            <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">
                <div style="font-size:12px;font-weight:600;color:var(--red);margin-bottom:8px">Why you're over budget</div>
                @foreach (var (label, amount, color) in OverBudgetRows())
                {
                    var pct = State.WeeklyIncome > 0 ? amount / State.WeeklyIncome : 0;
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                        <div style="display:flex;align-items:center;gap:8px">
                            <div class="dot" style="background:@color"></div>
                            <span style="font-size:13px;color:var(--text2)">@label</span>
                        </div>
                        <div style="text-align:right">
                            <span style="font-size:13px;font-weight:600">@amount.ToString("C")</span>
                            <span style="font-size:11px;color:var(--text3);margin-left:4px">@pct.ToString("P0")</span>
                        </div>
                    </div>
                }
                <div style="border-top:1px solid var(--border);margin-top:6px;padding-top:6px;display:flex;justify-content:space-between">
                    <span style="font-size:12px;color:var(--text3)">Total allocated</span>
                    <span style="font-size:13px;font-weight:700;color:var(--red)">
                        @AllocatedTotal.ToString("C")
                        <span style="font-size:11px;font-weight:400;color:var(--text3)"> of @State.WeeklyIncome.ToString("C")</span>
                    </span>
                </div>
                <div style="font-size:12px;color:var(--red);margin-top:4px;text-align:right">
                    @((AllocatedTotal - State.WeeklyIncome).ToString("C")) over your weekly income
                </div>
                <button class="btn btn-sm btn-secondary btn-full" style="margin-top:10px" @onclick='() => Nav.NavigateTo("settings")'>Open Settings</button>
            </div>
        }
    </div>
    </div>
}
else if (_tab == "Spending")
{
    <div>
    <!-- Unified spending breakdown: all categories with bills/everyday grouping -->
    @{
        var allCats    = State.GetTopCategoriesForPeriod(PayCycle.From, PayCycle.To, 12, excludeBills: false);
        var billCats   = allCats.Where(c => AppState.IsBillCategory(c.Category)).ToList();
        var discCats   = allCats.Where(c => !AppState.IsBillCategory(c.Category)).ToList();
        var breakdownMax = allCats.Any() ? allCats.Max(c => c.Amount) : 1m;
        var palette = new[]{"#2563EB","#16A34A","#D97706","#DC2626","#7C3AED","#0891B2","#BE185D","#65A30D","#B45309","#0F766E","#9333EA","#C2410C"};
    }
    @if (allCats.Any())
    {
        <div class="card">
            <div style="font-size:12px;color:var(--text3);margin-bottom:2px">Spending Breakdown</div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:14px;opacity:0.7">All categories this pay cycle · @PayCycleDateRange · bar = % of largest category</div>

            @if (billCats.Any())
            {
                <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--text3);margin-bottom:8px">Bills &amp; Debt</div>
                @for (var i = 0; i < billCats.Count; i++)
                {
                    var (cat, amt) = billCats[i];
                    var ofInc = PeriodIncome > 0 ? amt / PeriodIncome : 0m;
                    var limitDollars = GetLimitDisplay(cat);
                    var hasLimit = limitDollars > 0;
                    var limitPct = hasLimit ? amt / limitDollars : 0m;
                    var barW  = hasLimit ? (double)Math.Clamp(limitPct, 0m, 1m) * 100.0 : (breakdownMax > 0 ? (double)(amt / breakdownMax) * 100.0 : 0);
                    var barColor = hasLimit && limitPct >= 1m ? "var(--red)" : hasLimit && limitPct >= 0.8m ? "var(--amber)" : "#2563EB";
                    <div style="margin-bottom:9px">
                        <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:3px">
                            <span style="color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:55%">
                                @cat
                                @if (hasLimit && limitPct >= 0.8m)
                                {
                                    <span style="font-size:9px;margin-left:4px;padding:1px 4px;border-radius:6px;background:@(limitPct>=1?"rgba(248,113,113,0.15)":"rgba(245,158,11,0.15)");color:@(limitPct>=1?"var(--red)":"var(--amber)")">@(limitPct>=1?"over":"near")</span>
                                }
                            </span>
                            <span style="flex-shrink:0;font-weight:600">
                                @amt.ToString("C")
                                <span style="font-size:10px;color:var(--text3);font-weight:400"> @ofInc.ToString("P0")</span>
                            </span>
                        </div>
                        <div style="background:var(--surface2);border-radius:4px;height:8px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:@barColor;width:@($"{barW:F1}")%;transition:width 0.4s ease"></div>
                        </div>
                        @if (hasLimit)
                        {
                            var remaining = limitDollars - amt;
                            <div style="font-size:10px;color:var(--text3);margin-top:3px">
                                @if (remaining >= 0)
                                {
                                    @($"{remaining:C} left of {limitDollars:C} limit")
                                }
                                else
                                {
                                    <span style="color:var(--red)">@($"{Math.Abs(remaining):C} over {limitDollars:C} limit")</span>
                                }
                            </div>
                        }
                    </div>
                }
            }

            @if (discCats.Any())
            {
                <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--text3);margin-top:@(billCats.Any()?"14px":"0");margin-bottom:8px">Everyday Spending</div>
                @for (var i = 0; i < discCats.Count; i++)
                {
                    var (cat, amt) = discCats[i];
                    var ofInc = PeriodIncome > 0 ? amt / PeriodIncome : 0m;
                    var limitDollars = GetLimitDisplay(cat);
                    var hasLimit = limitDollars > 0;
                    var limitPct = hasLimit ? amt / limitDollars : 0m;
                    var barW  = hasLimit ? (double)Math.Clamp(limitPct, 0m, 1m) * 100.0 : (breakdownMax > 0 ? (double)(amt / breakdownMax) * 100.0 : 0);
                    var barColor = hasLimit && limitPct >= 1m ? "var(--red)" : hasLimit && limitPct >= 0.8m ? "var(--amber)" : palette[i % palette.Length];
                    <div style="margin-bottom:9px">
                        <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:3px">
                            <span style="color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:55%">
                                @cat
                                @if (cat == "Misc") { <span style="font-size:10px;color:var(--text3)"> (uncategorised)</span> }
                                @if (hasLimit && limitPct >= 0.8m)
                                {
                                    <span style="font-size:9px;margin-left:4px;padding:1px 4px;border-radius:6px;background:@(limitPct>=1?"rgba(248,113,113,0.15)":"rgba(245,158,11,0.15)");color:@(limitPct>=1?"var(--red)":"var(--amber)")">@(limitPct>=1?"over":"near")</span>
                                }
                            </span>
                            <span style="flex-shrink:0;font-weight:600">
                                @amt.ToString("C")
                                <span style="font-size:10px;color:var(--text3);font-weight:400"> @ofInc.ToString("P0")</span>
                            </span>
                        </div>
                        <div style="background:var(--surface2);border-radius:4px;height:8px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:@barColor;width:@($"{barW:F1}")%;transition:width 0.4s ease"></div>
                        </div>
                        @if (hasLimit)
                        {
                            var remaining = limitDollars - amt;
                            <div style="font-size:10px;color:var(--text3);margin-top:3px">
                                @if (remaining >= 0)
                                {
                                    @($"{remaining:C} left of {limitDollars:C} limit")
                                }
                                else
                                {
                                    <span style="color:var(--red)">@($"{Math.Abs(remaining):C} over {limitDollars:C} limit")</span>
                                }
                            </div>
                        }
                    </div>
                }
            }

            <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:4px;display:flex;justify-content:space-between;font-size:12px;color:var(--text3)">
                <span>Total spent</span>
                <span style="font-weight:700;color:var(--text)">@AllPeriodSpend.ToString("C") <span style="font-weight:400">of @PeriodIncome.ToString("C") income</span></span>
            </div>
        </div>
    }

    <!-- Category spending limits (moved here from Settings) -->
    @if (State.Categories.Any(c => c.Type == CategoryType.Expense))
    {
        <div class="card" style="margin-top:12px">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                <div style="font-size:14px;font-weight:600">Category Limits</div>
                <button class="btn btn-secondary btn-sm" @onclick="() => _showCategoryLimits = !_showCategoryLimits">
                    @(_showCategoryLimits ? "Hide" : "Show")
                </button>
            </div>
            @if (_showCategoryLimits)
            {
                <div style="font-size:12px;color:var(--text3);margin:4px 0 12px">@State.SummaryPeriod spending limits per category. Shown as "near"/"over" badges above.</div>
                <div style="display:flex;flex-direction:column;gap:8px">
                    @foreach (var cat in State.Categories.Where(c => c.Type == CategoryType.Expense).OrderBy(c => c.Name))
                    {
                        <div style="display:flex;align-items:center;gap:8px">
                            <span style="flex:1;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@cat.Name</span>
                            <input class="form-input" style="width:90px;text-align:right;padding:6px 10px;font-size:14px"
                                   type="number" min="0" step="1"
                                   value="@GetLimitDisplay(cat.Name)"
                                   @onchange="e => SetLimitAsync(cat.Name, e.Value?.ToString())"
                                   placeholder="0" />
                            <span style="font-size:12px;color:var(--text3);flex-shrink:0">/@(State.SummaryPeriod == "Weekly" ? "wk" : "mo")</span>
                        </div>
                    }
                </div>
                <div style="font-size:11px;color:var(--text3);margin-top:10px">Set to 0 to disable limit for that category.</div>
            }
        </div>
    }

    <!-- What-if budget simulator -->
    @if (State.WeeklyIncome > 0)
    {
        var newLeftover = State.BudgetLeftover - _whatIfAmount;
        var flips = (State.BudgetLeftover >= 0) != (newLeftover >= 0) && _whatIfAmount != 0;
        <div class="card" style="margin-top:12px">
            <div style="font-size:14px;font-weight:600;margin-bottom:4px">Budget What-If</div>
            <div style="font-size:12px;color:var(--text3);margin-bottom:12px">See how a spending change would affect your weekly budget — nothing is saved.</div>
            <div style="display:flex;align-items:center;gap:8px">
                <span style="font-size:13px;color:var(--text2);flex:1">Extra spending per week</span>
                <span style="font-size:16px;color:var(--text3);font-weight:300">$</span>
                <input class="form-input" style="width:100px;text-align:right;padding:6px 10px;font-size:14px"
                       type="number" step="1" @bind="_whatIfAmount" @bind:event="oninput"
                       placeholder="e.g. -50" />
            </div>
            <div style="font-size:11px;color:var(--text3);margin-top:4px">Use a negative number to model cutting spending instead.</div>

            @if (_whatIfAmount != 0)
            {
                <div style="border-top:1px solid var(--border);margin-top:12px;padding-top:10px;display:flex;justify-content:space-between;font-size:13px">
                    <span style="color:var(--text3)">New weekly budget</span>
                    <span style="font-weight:700;color:@(newLeftover>=0?"var(--green)":"var(--red)")">@newLeftover.ToString("C")/wk</span>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:12px;margin-top:5px">
                    <span style="color:var(--text3)">≈ monthly impact</span>
                    <span style="font-weight:600">@((_whatIfAmount * 52m / 12m).ToString("C"))/mo</span>
                </div>
                @if (flips)
                {
                    <div style="font-size:12px;font-weight:600;color:@(newLeftover>=0?"var(--green)":"var(--red)");margin-top:8px">
                        @(newLeftover >= 0 ? "✓ This would bring you back under budget" : "⚠ This would put you over budget")
                    </div>
                }
            }
        </div>
    }

    <!-- Subscriptions / recurring payments -->
    @{
        var subscriptions = State.GetRecurringPayments();
    }
    @if (subscriptions.Any())
    {
        <div class="card" style="margin-top:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px">
                <div style="font-size:12px;color:var(--text3)">🔁 Subscriptions</div>
                <span style="font-size:14px;font-weight:700">@State.SubscriptionWeeklyTotal.ToString("C")<span style="font-size:10px;color:var(--text3);font-weight:400">/wk</span></span>
            </div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:14px;opacity:0.7">@subscriptions.Count recurring payment@(subscriptions.Count == 1 ? "" : "s") detected from your transaction history</div>

            @foreach (var sub in subscriptions)
            {
                var dueColor = sub.DaysUntilNext < 0 ? "var(--red)" : sub.DaysUntilNext <= 2 ? "var(--amber)" : "var(--text3)";
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid var(--border)">
                    <div style="flex:1;min-width:0">
                        <div style="font-size:14px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                            @sub.Name
                            @if (sub.IsAlreadyBill)
                            {
                                <span style="font-size:9px;margin-left:4px;padding:1px 4px;border-radius:6px;background:rgba(52,211,153,0.15);color:var(--green)">bill</span>
                            }
                        </div>
                        <div style="font-size:11px;color:var(--text3)">
                            @sub.Frequency · @sub.AmountRangeDisplay
                            <span style="color:@dueColor"> · @sub.NextDueDisplay</span>
                        </div>
                    </div>
                    <div style="text-align:right;flex-shrink:0">
                        <div style="font-size:14px;font-weight:600">@sub.WeeklyAmount.ToString("C")<span style="font-size:10px;color:var(--text3);font-weight:400">/wk</span></div>
                        @if (!sub.IsAlreadyBill)
                        {
                            <div style="display:flex;gap:8px;margin-top:4px;justify-content:flex-end">
                                <button @onclick="() => StartAddSubscriptionAsBill(sub)" style="background:none;border:none;color:var(--teal);font-size:11px;cursor:pointer;padding:0;text-decoration:underline">Add as Bill</button>
                                <button @onclick="() => State.IgnoreSubscriptionAsync(sub.Name)" style="background:none;border:none;color:var(--text3);font-size:11px;cursor:pointer;padding:0;text-decoration:underline">Ignore</button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    </div>
}
else if (_tab == "History")
{
    <div>
    <!-- Period spending vs budget -->
    @if (State.WeeklyIncome > 0)
    {
        <div class="card">
            <div style="font-size:12px;color:var(--text3);margin-bottom:2px">Everyday Spending This @PeriodNoun</div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:4px;opacity:0.9">@PayCycleDateRange</div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:12px;opacity:0.7">Non-bill transactions only · budget = unallocated spending (@PeriodBudget.ToString("C"))</div>
            <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px">
                <span style="font-size:22px;font-weight:700;color:@(PeriodSpend>PeriodBudget?"var(--red)":"var(--text)")">
                    @PeriodSpend.ToString("C")
                </span>
                <span style="font-size:13px;color:var(--text3)">of @PeriodBudget.ToString("C")</span>
            </div>
            @if (PreviousPeriodSpend > 0)
            {
                var cycleDelta = PeriodSpend - PreviousPeriodSpend;
                <div style="font-size:11px;margin-bottom:6px;color:@(cycleDelta>0?"var(--red)":"var(--green)")">
                    @(cycleDelta >= 0 ? "▲" : "▼") @Math.Abs(cycleDelta).ToString("C") vs last cycle
                </div>
            }
            <div class="progress-bar" style="height:8px">
                <div class="progress-fill" style="width:@((int)(Math.Min(PeriodSpendPct,1)*100))%;background:@(PeriodSpend>PeriodBudget?"var(--red)":"var(--teal)")"></div>
            </div>
            <div style="margin-top:6px">
                @{
                    var avg = AvgPreviousDiscretionary;
                    var isSpike = avg > 0 && PeriodSpend > avg * 1.3m;
                    var spikeAmount = PeriodSpend - avg;
                }
                @if (PeriodSpend > PeriodBudget)
                {
                    <div style="font-size:12px;color:var(--red);font-weight:600;margin-bottom:8px">@((PeriodSpend - PeriodBudget).ToString("C")) over budget</div>
                    <button class="btn btn-sm btn-secondary" style="margin-bottom:10px" @onclick='() => Nav.NavigateTo("transactions")'>Review Transactions</button>
                }
                else
                {
                    <div style="font-size:12px;color:var(--text3);margin-bottom:8px">@((PeriodBudget - PeriodSpend).ToString("C")) remaining</div>
                }

                @if (isSpike)
                {
                    <div style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.25);border-radius:8px;padding:9px 11px;font-size:12px;margin-bottom:8px">
                        <span style="color:var(--amber);font-weight:600">⚡ High-spend @PeriodNounLower</span>
                        <span style="color:var(--text3)"> — @spikeAmount.ToString("C") above your usual @avg.ToString("C0") avg. Likely one-off expenses.</span>
                    </div>
                }

                <div style="font-size:11px;color:var(--text3)">See the Spending tab for a full category breakdown.</div>
            </div>
        </div>

        <!-- Biggest individual transactions (always shown if there are any) -->
        @if (BiggestPeriodTxns.Any())
        {
            <div class="card" style="margin-top:12px">
                <div style="font-size:12px;color:var(--text3);margin-bottom:2px">Biggest Transactions This Pay Cycle</div>
                <div style="font-size:11px;color:var(--text3);margin-bottom:12px;opacity:0.7">Everyday purchases only (bills excluded)</div>
                @foreach (var t in BiggestPeriodTxns.Take(6))
                {
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                        <div style="flex:1;min-width:0">
                            <div style="font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@t.Description</div>
                            <div style="font-size:11px;color:var(--text3)">@t.CategoryName · @t.Date.ToString("d MMM")</div>
                        </div>
                        <span style="font-size:15px;font-weight:700;color:var(--red);flex-shrink:0">@Math.Abs(t.AmountDollars).ToString("C")</span>
                    </div>
                }
            </div>
        }
    }

    <!-- Pay-cycle history -->
    @{
        var cycleTrend = PayCycleTrend;
        var cycleTrendMax = cycleTrend.Any() ? Math.Max(cycleTrend.Max(c => Math.Max(c.Income, c.Spending)), 1m) : 1m;
    }
    @if (cycleTrend.Any(c => c.Income > 0 || c.Spending > 0))
    {
        <div class="card" style="margin-top:12px">
            <div style="font-size:12px;color:var(--text3);margin-bottom:2px">@PeriodNoun History</div>
            <div style="font-size:11px;color:var(--text3);margin-bottom:14px;opacity:0.7">Last 6 @PeriodNounLower periods · income vs spending vs net</div>
            @foreach (var c in cycleTrend)
            {
                var spendW = cycleTrendMax > 0 ? (double)(c.Spending / cycleTrendMax) * 100.0 : 0;
                var incomeW = cycleTrendMax > 0 ? (double)(c.Income / cycleTrendMax) * 100.0 : 0;
                var net = c.Income - c.Spending;
                <div style="margin-bottom:10px">
                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px">
                        <span style="color:var(--text2)">@c.Label</span>
                        <div style="display:flex;gap:10px">
                            <span style="color:var(--green)">+@c.Income.ToString("C0")</span>
                            <span style="color:@(net<0?"var(--red)":"var(--text)");font-weight:600">-@c.Spending.ToString("C0")</span>
                            <span style="color:@(net>=0?"var(--green)":"var(--red)");font-weight:600">@(net>=0?"+":"")@net.ToString("C0")</span>
                        </div>
                    </div>
                    <div style="position:relative;height:10px">
                        <div style="position:absolute;inset:0;background:var(--surface2);border-radius:4px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:rgba(52,211,153,0.25);width:@($"{incomeW:F1}")%"></div>
                        </div>
                        <div style="position:absolute;inset:0;background:transparent;border-radius:4px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:@(net<0?"var(--red)":"var(--teal)");opacity:0.85;width:@($"{spendW:F1}")%;transition:width 0.4s ease"></div>
                        </div>
                    </div>
                </div>
            }
            <div style="display:flex;gap:16px;margin-top:6px;font-size:11px;color:var(--text3)">
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:var(--teal);margin-right:4px;vertical-align:middle"></span>Spending</span>
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:rgba(52,211,153,0.4);margin-right:4px;vertical-align:middle"></span>Income</span>
            </div>
        </div>
    }

    <!-- Monthly spending history -->
    @{
        var trend = State.GetMonthlyTrend(6);
        var trendMax = trend.Any() ? Math.Max(trend.Max(t => t.Spending), 1m) : 1m;
    }
    @if (trend.Any(t => t.Spending > 0 || t.Income > 0))
    {
        <div class="card" style="margin-top:12px">
            <div style="font-size:12px;color:var(--text3);margin-bottom:14px">Monthly History</div>
            @foreach (var m in trend)
            {
                var spendW = trendMax > 0 ? (double)(m.Spending / trendMax) * 100.0 : 0;
                var incomeW = trendMax > 0 ? (double)(m.Income / trendMax) * 100.0 : 0;
                var isOver = m.Income > 0 && m.Spending > m.Income;
                <div style="margin-bottom:10px">
                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px">
                        <span style="color:var(--text2)">@m.Month</span>
                        <div style="display:flex;gap:10px">
                            @if (m.Income > 0)
                            {
                                <span style="color:var(--green)">+@m.Income.ToString("C0")</span>
                            }
                            <span style="color:@(isOver ? "var(--red)" : "var(--text)");font-weight:600">-@m.Spending.ToString("C0")</span>
                        </div>
                    </div>
                    <div style="position:relative;height:10px">
                        @if (m.Income > 0)
                        {
                            <div style="position:absolute;inset:0;background:var(--surface2);border-radius:4px;overflow:hidden">
                                <div style="height:100%;border-radius:4px;background:rgba(52,211,153,0.25);width:@($"{incomeW:F1}")%"></div>
                            </div>
                        }
                        <div style="position:absolute;inset:0;background:transparent;border-radius:4px;overflow:hidden">
                            <div style="height:100%;border-radius:4px;background:@(isOver?"var(--red)":"var(--teal)");opacity:0.85;width:@($"{spendW:F1}")%;transition:width 0.4s ease"></div>
                        </div>
                    </div>
                </div>
            }
            <div style="display:flex;gap:16px;margin-top:6px;font-size:11px;color:var(--text3)">
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:var(--teal);margin-right:4px;vertical-align:middle"></span>Spending</span>
                <span><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:rgba(52,211,153,0.4);margin-right:4px;vertical-align:middle"></span>Income</span>
            </div>
        </div>
    }
    </div>
}
else if (_tab == "Forecast")
{
    <div>
    @{
        var forecast = ForecastDays;
        var lowest = forecast.OrderBy(f => f.Balance).First();
        var eventDays = forecast.Where(f => f.Note is not null).ToList();
        var totalBills = forecast.Sum(f => f.Bills);
        var totalPay = forecast.Sum(f => f.Pay);
        var balanceMin = forecast.Min(f => f.Balance);
        var balanceMax = forecast.Max(f => f.Balance);
        var bars = BuildForecastBalanceBars(forecast, balanceMin, balanceMax, 12);
    }
    <div class="card">
        <div style="font-size:12px;color:var(--text3);margin-bottom:2px">60-Day Balance Forecast</div>
        <div style="font-size:11px;color:var(--text3);margin-bottom:14px;opacity:0.7">
            Projects all recurring bills, future paydays and @ForecastDailySpendAssumption.ToString("C")/day discretionary spend@(State.NoSpendMode ? " while no-spend mode is on" : " capped by your budget pace")
        </div>
        <div style="display:flex;justify-content:space-between;align-items:baseline">
            <div>
                <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:0.05em">Today</div>
                <div style="font-size:18px;font-weight:700">@State.TotalBalance.ToString("C")</div>
            </div>
            <div style="text-align:right">
                <div style="font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:0.05em">In 60 days</div>
                <div style="font-size:18px;font-weight:700;color:@(forecast.Last().Balance>=0?"var(--text)":"var(--red)")">@forecast.Last().Balance.ToString("C")</div>
            </div>
        </div>
        <div class="forecast-chart" aria-hidden="true">
            <div class="forecast-zero-line" style="top:@(ForecastZeroY(balanceMin, balanceMax).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            <div class="forecast-bars-grid" style="grid-template-columns:repeat(@bars.Count,1fr)">
                @foreach (var bar in bars)
                {
                    <div class="forecast-bar-col">
                        <div class="forecast-bar-fill @(bar.Negative ? "negative" : "")" style="top:@(bar.Top.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;height:@(bar.Height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        @if (bar.HasBill)
                        {
                            <div class="forecast-bar-event bill" style="top:@(bar.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;@(bar.HasPay ? "left:35%" : "")"></div>
                        }
                        @if (bar.HasPay)
                        {
                            <div class="forecast-bar-event pay" style="top:@(bar.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;@(bar.HasBill ? "left:65%" : "")"></div>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="forecast-chart-dates" style="grid-template-columns:repeat(@bars.Count,1fr)">
            @foreach (var bar in bars)
            {
                <span>@bar.Date.ToString("d/M")</span>
            }
        </div>
        <div class="forecast-legend">
            <span style="--legend-color:var(--teal-light)">Balance</span>
            <span style="--legend-color:var(--red)">Bills @totalBills.ToString("C0")</span>
            <span style="--legend-color:var(--green)">Pay @totalPay.ToString("C0")</span>
        </div>
        <div style="border-top:1px solid var(--border);margin-top:12px;padding-top:10px;display:flex;justify-content:space-between;align-items:center">
            <span style="font-size:12px;color:var(--text3)">Lowest projected point</span>
            <span style="font-size:14px;font-weight:700;color:@(lowest.Balance<0?"var(--red)":"var(--text)")">@lowest.Balance.ToString("C") · @lowest.Date.ToString("dd MMM")</span>
        </div>
    </div>

    <div class="budget-calendar">
        <div class="budget-calendar-head">
            <div>
                <div style="font-size:12px;color:var(--text3)">Budget Schedule</div>
                <div style="font-size:16px;font-weight:700">@DateTime.Today.ToString("MMMM yyyy")</div>
            </div>
            <div style="font-size:11px;color:var(--text3);text-align:right">Bills, paydays and forecast balance</div>
        </div>
        <div class="budget-calendar-grid">
            @foreach (var h in new[] { "M", "T", "W", "T", "F", "S", "S" })
            {
                <div class="budget-calendar-weekday">@h</div>
            }
            @foreach (var day in ForecastCalendarDays)
            {
                <div class="budget-calendar-day @(day.IsOutsideMonth ? "is-outside" : "") @(day.Date.Date == DateTime.Today ? "is-today" : "")">
                    <div class="budget-calendar-date">
                        <span>@day.Date.Day</span>
                        @if (day.IsPayday)
                        {
                            <span style="color:var(--green);font-size:10px">PAY</span>
                        }
                    </div>
                    @if (day.Forecast is not null)
                    {
                        <div class="budget-calendar-balance">@day.Forecast.Balance.ToString("C0")</div>
                        <div class="budget-calendar-markers">
                            @if (day.Forecast.Bills > 0)
                            {
                                <span class="budget-calendar-marker" style="--marker-color:var(--red)" title="Bills"></span>
                            }
                            @if (day.Forecast.Pay > 0)
                            {
                                <span class="budget-calendar-marker" style="--marker-color:var(--green)" title="Payday"></span>
                            }
                            @if (day.Forecast.Spending > 0)
                            {
                                <span class="budget-calendar-marker" style="--marker-color:var(--teal-light)" title="Estimated spending"></span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="forecast-legend" style="padding:10px 12px;border-top:1px solid var(--border);margin-top:0">
            <span style="--legend-color:var(--red)">Bills</span>
            <span style="--legend-color:var(--green)">Payday</span>
            <span style="--legend-color:var(--teal-light)">Daily spend</span>
        </div>
    </div>

    <div class="section-header" style="margin-top:12px"><span class="section-title">Upcoming Events</span></div>
    @if (!eventDays.Any())
    {
        <div class="empty-state" style="padding:20px">
            <span>No unpaid bills or paydays projected in the next 60 days.</span>
        </div>
    }
    else
    {
        <div style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
            @foreach (var day in eventDays)
            {
                <div class="list-row">
                    <div style="text-align:center;width:38px;flex-shrink:0">
                        <div style="font-size:10px;color:@(day.Date==DateTime.Today?"var(--teal)":"var(--text3)")">@day.Date.ToString("ddd").ToUpper()</div>
                        <div style="font-size:16px;font-weight:700;color:@(day.Date==DateTime.Today?"var(--teal)":"var(--text)")">@day.Date.Day</div>
                        <div style="font-size:10px;color:var(--text3)">@day.Date.ToString("MMM")</div>
                    </div>
                    <div class="row-icon" style="background:@(day.IsPayday?"rgba(52,211,153,0.15)":"rgba(248,113,113,0.12)")">
                        @(day.IsPayday ? "💰" : "📋")
                    </div>
                    <div class="row-main">
                        <div class="row-title">@day.Note</div>
                        <div class="row-sub">
                            Balance after: @day.Balance.ToString("C")
                            @if (day.Bills > 0) { <span> · Bills @day.Bills.ToString("C")</span> }
                            @if (day.Pay > 0) { <span> · Pay @day.Pay.ToString("C")</span> }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    </div>
}
</div>

@if (_tab == "Daily")
{
    <DailyTab />
}
else if (_tab == "Holiday")
{
    <HolidayTab />
}

@if (_billDraft is not null)
{
    <AddEditBillModal Bill="@_billDraft"
        InstallmentTotalDollars="@_affordAmount"
        OnClose="() => _billDraft = null"
        OnSaved="() => _billDraft = null" />
}

@if (_debtDraft is not null)
{
    <AddEditDebtModal Debt="@_debtDraft"
        OnClose="() => _debtDraft = null"
        OnSaved="() => _debtDraft = null" />
}

<div style="height:16px"></div>

@code {
    private string _tab = "Overview";
    private bool _editingBudget;
    private bool _showCategoryLimits;
    private decimal _affordAmount;
    private string _affordMode = "OneOff"; // OneOff | Savings | Installments
    private int _goalWeeks = 4;
    private string _goalAccountName = string.Empty;
    private int _installmentCount = 4;
    private int _installmentFrequencyWeeks = 2;
    private decimal _whatIfAmount;
    private Bill? _billDraft;

    private void SelectTopPill(string tab)
    {
        _tab = tab;
    }
    private Debt? _debtDraft;
    private DateTime GoalTargetDate => DateTime.Today.AddDays(Math.Max(_goalWeeks, 1) * 7);

    // Multipliers applied to the user's chosen "Over how many weeks?" value —
    // Aggressive halves it, Balanced matches it, Passive doubles it, so all
    // three cards recalculate live as weeks/amount change.
    private static readonly (string Label, decimal Multiplier, string Color)[] PaceOptions =
    {
        ("Aggressive", 0.5m, "var(--red)"),
        ("Balanced", 1m, "var(--amber)"),
        ("Passive", 2m, "var(--green)")
    };

    protected override void OnInitialized()
    {
        _affordMode = State.AffordabilityMode;
        _affordAmount = _affordMode switch
        {
            "Savings" => State.AffordabilityGoalAmount,
            "Installments" => State.AffordabilityInstallmentAmount,
            _ => 0m
        };
        _goalWeeks = State.AffordabilityGoalWeeks;
        _goalAccountName = State.AffordabilityGoalAccountName;
        _installmentCount = State.AffordabilityInstallmentCount;
        _installmentFrequencyWeeks = State.AffordabilityInstallmentFrequencyWeeks;
    }

    private async Task SetBudgetFieldAsync(string field, ChangeEventArgs e)
    {
        await State.SetBudgetOverrideAsync(field, e.Value?.ToString());
    }

    private IEnumerable<(string Label, string Field, decimal Amount, string Color)> EditableBudgetRows()
    {
        yield return ("Bills", "Bills", State.BudgetBills, "#2563EB");
        yield return ("Essentials", "Essentials", State.BudgetEssentials, "#16A34A");
        yield return ("Savings", "Savings", State.BudgetSavings, "#7C3AED");
        yield return ("Unplanned", "Unplanned", State.BudgetUnplanned, "#D97706");
    }

    private decimal GetLimitDisplay(string categoryName)
    {
        var monthlyLimit = State.GetCategoryLimitDollars(categoryName);
        return State.SummaryPeriod == "Weekly"
            ? Math.Round(monthlyLimit * 12m / 52m, 2)
            : monthlyLimit;
    }

    private async Task SetLimitAsync(string categoryName, string? raw)
    {
        if (!decimal.TryParse(raw, out var dollars)) dollars = 0;
        var monthlyDollars = State.SummaryPeriod == "Weekly"
            ? dollars * 52m / 12m
            : dollars;
        var cents = (int)Math.Round(monthlyDollars * 100m);
        await State.SaveSettingAsync($"CategoryLimit:{categoryName}", cents.ToString());
    }

    private async Task SetPeriodAsync(string period)
    {
        await State.SaveSettingAsync("SummaryPeriod", period);
    }

    private async Task SetAffordModeAsync(string mode)
    {
        if (_affordMode == mode) return;
        _affordMode = mode;
        await State.SaveSettingAsync("AffordabilityMode", _affordMode);
        if (_affordAmount > 0) await SaveAffordabilitySettingsAsync();
    }

    private async Task OnAffordAmountChanged()
    {
        if (_affordAmount > 0) await SaveAffordabilitySettingsAsync();
    }

    private async Task OnGoalWeeksChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var weeks) && weeks > 0)
        {
            _goalWeeks = weeks;
            await SaveAffordabilitySettingsAsync();
        }
    }

    private async Task OnGoalTargetDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var targetDate))
        {
            _goalWeeks = WeeksUntil(targetDate);
            await SaveAffordabilitySettingsAsync();
        }
    }

    private async Task SelectPaceAsync(int weeks)
    {
        _goalWeeks = Math.Max(weeks, 1);
        await SaveAffordabilitySettingsAsync();
    }

    private static int WeeksUntil(DateTime targetDate)
    {
        var days = Math.Max((targetDate.Date - DateTime.Today).TotalDays, 1);
        return Math.Max((int)Math.Ceiling(days / 7d), 1);
    }

    private async Task OnGoalAccountChanged(ChangeEventArgs e)
    {
        _goalAccountName = e.Value?.ToString() ?? string.Empty;
        await SaveAffordabilitySettingsAsync();
    }

    private async Task OnInstallmentCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var count) && count >= 2)
        {
            _installmentCount = count;
            await SaveAffordabilitySettingsAsync();
        }
    }

    private async Task OnInstallmentFrequencyChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var weeks) && weeks > 0)
        {
            _installmentFrequencyWeeks = weeks;
            await SaveAffordabilitySettingsAsync();
        }
    }

    private async Task SetSavingsGoalAsync(int accountId, decimal targetDollars, DateTime targetDate)
    {
        await State.SetAccountGoalAsync(accountId, targetDollars, targetDate);
    }

    private void StartAddSubscriptionAsBill(RecurringPayment sub)
    {
        _billDraft = new Bill
        {
            Name = sub.Name,
            AmountDollars = sub.AverageAmount,
            DueDate = sub.NextExpected,
            NextPayDate = sub.NextExpected,
            Frequency = Enum.Parse<BillFrequency>(sub.Frequency),
            AccountId = State.Accounts.FirstOrDefault(a => a.Name == sub.AccountName)?.Id ?? 0
        };
    }

    private void StartAddInstallmentBill(decimal perInstallment, int freqWeeks)
    {
        _billDraft = new Bill
        {
            Name = "Afterpay",
            AmountDollars = perInstallment,
            DueDate = DateTime.Today,
            NextPayDate = DateTime.Today,
            Frequency = freqWeeks switch
            {
                1 => BillFrequency.Weekly,
                2 => BillFrequency.Fortnightly,
                <= 6 => BillFrequency.Monthly,
                <= 26 => BillFrequency.Quarterly,
                _ => BillFrequency.Yearly
            }
        };
    }

    private async Task SaveAffordabilitySettingsAsync()
    {
        switch (_affordMode)
        {
            case "Savings":
                await State.SaveSettingAsync("AffordabilityAmount", _affordAmount.ToString());
                await State.SaveSettingAsync("AffordabilityWeeks", _goalWeeks.ToString());
                await State.SaveSettingAsync("AffordabilityAccountName", _goalAccountName);
                break;
            case "Installments":
                await State.SaveSettingAsync("AffordabilityInstallmentAmount", _affordAmount.ToString());
                await State.SaveSettingAsync("AffordabilityInstallments", _installmentCount.ToString());
                await State.SaveSettingAsync("AffordabilityInstallmentWeeks", _installmentFrequencyWeeks.ToString());
                break;
        }
    }

    // Discretionary spend/budget: excludes bill categories (Debt, Rent, Phone, Insurance, etc.)
    private (DateTime From, DateTime To) PeriodRange => State.GetCurrentPeriod();
    private (DateTime From, DateTime To) PayCycle => PeriodRange;
    private int PeriodDays => (PeriodRange.To.Date - PeriodRange.From.Date).Days + 1;
    private int PayCycleDays => PeriodDays;
    private decimal PayCycleWeeks => PayCycleDays / 7m;
    private string PayCycleDateRange => $"{PayCycle.From:dd MMM} - {PayCycle.To:dd MMM}";
    private decimal PeriodSpend    => State.GetDiscretionarySpendingForPeriod(PeriodRange.From, PeriodRange.To);
    private decimal AllPeriodSpend => State.GetPeriodSpendingForPeriod(PeriodRange.From, PeriodRange.To);
    private decimal BillsSpend     => AllPeriodSpend - PeriodSpend;
    private decimal PeriodIncome   => State.WeeklyIncome * PayCycleWeeks;
    // Budget for non-bill spending = unallocated budget after bills, savings and planned allocations.
    private decimal PeriodBudget   => Math.Max(State.BudgetLeftover * PayCycleWeeks, 0m);
    private decimal PeriodSpendPct => PeriodBudget > 0 ? Math.Min(PeriodSpend / PeriodBudget, 1.5m) : 0;
    private string PeriodNoun => State.SummaryPeriod == "Weekly" ? "Week" : "Month";
    private string PeriodNounLower => PeriodNoun.ToLowerInvariant();

    // Discretionary spending for the immediately-preceding pay cycle (for the "vs last cycle" delta)
    private decimal PreviousPeriodSpend
    {
        get
        {
            if (!State.IsLoaded) return 0m;
            var from = PayCycle.From.AddDays(-PayCycleDays);
            var to = PayCycle.From.AddDays(-1);
            return State.GetDiscretionarySpendingForPeriod(from, to);
        }
    }

    // Average discretionary spending over the previous 3 periods (for spike detection)
    private decimal AvgPreviousDiscretionary
    {
        get
        {
            if (!State.IsLoaded) return 0m;
            var sum = 0m;
            var days = PayCycleDays;
            for (var i = 1; i <= 3; i++)
            {
                var from = PayCycle.From.AddDays(-days * i);
                sum += State.GetDiscretionarySpendingForPeriod(from, from.AddDays(days - 1));
            }
            return sum / 3;
        }
    }

    private List<Transaction> BiggestPeriodTxns
    {
        get
        {
            var (from, to) = State.GetCurrentPeriod();
            return State.Transactions
                .Where(t => t.Date.Date >= from && t.Date.Date <= to && t.AmountCents < 0)
                .Where(t => !State.IsInternalMovement(t) &&
                            !State.IsBudgetedBillTransaction(t))
                .OrderBy(t => t.AmountCents)
                .Take(10)
                .ToList();
        }
    }

    // Income/spend/net for the last 6 pay cycles (current cycle included), for the History tab.
    private List<(string Label, decimal Income, decimal Spending)> PayCycleTrend
    {
        get
        {
            var result = new List<(string, decimal, decimal)>();
            var days = PayCycleDays;
            for (var i = 5; i >= 0; i--)
            {
                var from = PayCycle.From.AddDays(-days * i);
                var to = from.AddDays(days - 1);
                var income = State.Transactions
                    .Where(t => t.Date.Date >= from && t.Date.Date <= to && t.AmountCents > 0 && !State.IsInternalMovement(t))
                    .Sum(t => t.AmountDollars);
                var spend = State.GetPeriodSpendingForPeriod(from, to);
                result.Add(($"{from:dd MMM}", income, spend));
            }
            return result;
        }
    }

    private decimal AllocatedTotal =>
        State.BudgetBills + State.BudgetEssentials + State.BudgetSavings + State.BudgetUnplanned;

    private IEnumerable<(string Label, decimal Amount, string Color)> BudgetRows()
    {
        yield return ("Bills", State.BudgetBills, "#2563EB");
        yield return ("Essentials", State.BudgetEssentials, "#16A34A");
        yield return ("Savings", State.BudgetSavings, "#7C3AED");
        yield return ("Unplanned", State.BudgetUnplanned, "#D97706");
    }

    private IEnumerable<(string Label, decimal Amount, string Color)> OverBudgetRows() =>
        BudgetRows().OrderByDescending(r => r.Amount);

    private sealed record ForecastDay(
        DateTime Date,
        decimal Balance,
        string? Note,
        bool IsPayday,
        decimal Bills,
        decimal Pay,
        decimal Spending);

    private sealed record ForecastBillOccurrence(Bill Bill, DateTime DueDate);
    private sealed record ForecastCalendarDay(DateTime Date, ForecastDay? Forecast, bool IsOutsideMonth, bool IsPayday);
    private sealed record ForecastBalanceBar(decimal Top, decimal Height, decimal Y, bool Negative, bool HasBill, bool HasPay, DateTime Date);

    // Day-by-day 60-day balance projection: starting balance minus average daily
    // discretionary spend, minus all unpaid recurring bill occurrences, plus
    // estimated pay on projected future paydays.
    private List<ForecastDay> ForecastDays
    {
        get
        {
            const int days = 60;
            var avgDaily = ForecastDailySpendAssumption;
            var billOccurrences = GetForecastBillOccurrences(DateTime.Today, DateTime.Today.AddDays(days))
                .GroupBy(o => o.DueDate.Date)
                .ToDictionary(g => g.Key, g => g.ToList());
            var balance = State.TotalBalance;
            var result = new List<ForecastDay>();

            for (var i = 0; i <= days; i++)
            {
                var date = DateTime.Today.AddDays(i);
                var spending = i > 0 ? avgDaily : 0m;
                if (spending > 0) balance -= spending;

                var billsToday = billOccurrences.GetValueOrDefault(date) ?? new List<ForecastBillOccurrence>();
                var billsTotal = billsToday.Sum(o => o.Bill.AmountDollars);
                balance -= billsTotal;

                var isPayday = IsForecastPayday(date);
                var pay = isPayday ? ForecastWeeklyPayAmount : 0m;
                if (pay > 0) balance += pay;

                string? note = billsToday.Count switch
                {
                    0 => null,
                    1 => billsToday[0].Bill.Name,
                    _ => $"{billsToday.Count} bills"
                };
                if (isPayday) note = note is null ? "Payday" : $"{note} + Payday";

                result.Add(new ForecastDay(date, balance, note, isPayday, billsTotal, pay, spending));
            }
            return result;
        }
    }

    private List<ForecastCalendarDay> ForecastCalendarDays
    {
        get
        {
            var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var startOffset = ((int)monthStart.DayOfWeek + 6) % 7;
            var gridStart = monthStart.AddDays(-startOffset);
            var forecastByDate = ForecastDays.ToDictionary(f => f.Date.Date);
            var result = new List<ForecastCalendarDay>();

            for (var i = 0; i < 42; i++)
            {
                var date = gridStart.AddDays(i);
                forecastByDate.TryGetValue(date.Date, out var forecast);
                result.Add(new ForecastCalendarDay(
                    date,
                    forecast,
                    date.Month != DateTime.Today.Month,
                    forecast?.IsPayday ?? IsForecastPayday(date)));
            }

            return result;
        }
    }

    private List<ForecastBillOccurrence> GetForecastBillOccurrences(DateTime from, DateTime to)
    {
        var result = new List<ForecastBillOccurrence>();
        foreach (var bill in State.Bills)
        {
            var due = bill.EffectiveDueDate == default ? bill.DueDate.Date : bill.EffectiveDueDate.Date;
            while (due < from.Date)
                due = AdvanceDueDate(due, bill.Frequency);

            while (due <= to.Date)
            {
                if (!IsBillOccurrencePaid(bill, due))
                    result.Add(new ForecastBillOccurrence(bill, due));
                due = AdvanceDueDate(due, bill.Frequency);
            }
        }
        return result.OrderBy(o => o.DueDate).ThenBy(o => o.Bill.Name).ToList();
    }

    private bool IsBillOccurrencePaid(Bill bill, DateTime dueDate)
    {
        var exact = State.BillStatuses.FirstOrDefault(s => s.BillId == bill.Id && s.DueDate.Date == dueDate.Date);
        if (exact is not null) return exact.IsPaid;
        var effective = bill.EffectiveDueDate == default ? bill.DueDate.Date : bill.EffectiveDueDate.Date;
        return dueDate.Date == effective.Date && State.IsBillPaid(bill);
    }

    private decimal ForecastWeeklyPayAmount =>
        State.WeeklyIncome > 0 ? State.WeeklyIncome : State.EstimatedPayAmount;

    private decimal ForecastDailySpendAssumption
    {
        get
        {
            if (State.NoSpendMode) return 0m;
            var recent = Math.Max(State.GetDiscretionarySpendingForPeriod(DateTime.Today.AddDays(-30), DateTime.Today.AddDays(-1)) / 30m, 0m);
            var budgetPace = State.BudgetSafeToSpendAmount > 0 ? State.BudgetSafeToSpendAmount / 7m : recent;
            return Math.Round(Math.Min(recent, budgetPace), 2);
        }
    }

    private bool IsForecastPayday(DateTime date)
    {
        if (ForecastWeeklyPayAmount <= 0) return false;

        var payday = State.NextPayDate.Date;
        while (payday < DateTime.Today)
            payday = payday.AddDays(7);

        return date.Date >= payday && (date.Date - payday).Days % 7 == 0;
    }

    private static DateTime AdvanceDueDate(DateTime d, BillFrequency f) => f switch
    {
        BillFrequency.Weekly => d.AddDays(7),
        BillFrequency.Fortnightly => d.AddDays(14),
        BillFrequency.Monthly => d.AddMonths(1),
        BillFrequency.Quarterly => d.AddMonths(3),
        BillFrequency.Yearly => d.AddYears(1),
        _ => d.AddMonths(1)
    };

    private static decimal ForecastZeroY(decimal min, decimal max)
    {
        if (min >= 0) return 100m;
        if (max <= 0) return 0m;
        var range = Math.Max(max - min, 1m);
        return 100m - ((0m - min) / range * 100m);
    }

    // Buckets the 60-day forecast into N bars, each showing the ending balance
    // for that bucket as a bar growing from the zero-line (red below zero,
    // teal above), with small bill/payday dots above whichever bucket they
    // fall in.
    private static List<ForecastBalanceBar> BuildForecastBalanceBars(List<ForecastDay> forecast, decimal min, decimal max, int buckets)
    {
        var range = Math.Max(max - min, 1m);
        var zeroY = ForecastZeroY(min, max);
        var bucketSize = (double)forecast.Count / buckets;
        var result = new List<ForecastBalanceBar>();

        for (var i = 0; i < buckets; i++)
        {
            var start = (int)Math.Floor(i * bucketSize);
            var end = (int)Math.Floor((i + 1) * bucketSize);
            if (i == buckets - 1) end = forecast.Count;
            var slice = forecast.Skip(start).Take(Math.Max(end - start, 1)).ToList();

            var y = Math.Clamp(100m - ((slice[^1].Balance - min) / range * 100m), 0m, 100m);
            var top = Math.Min(zeroY, y);
            var height = Math.Max(Math.Abs(zeroY - y), 1.5m);

            result.Add(new ForecastBalanceBar(top, height, y, y > zeroY, slice.Any(f => f.Bills > 0), slice.Any(f => f.IsPayday), slice[^1].Date));
        }

        return result;
    }
}
