@page "/accounts"
@inject AppState State
@inject NavigationManager Nav

<PageTitle>Accounts — Evergrove</PageTitle>

<div style="padding:12px 16px 0;display:flex;align-items:center;justify-content:space-between">
    <div>
        <div style="font-size:12px;color:var(--text3)">Total Balance</div>
        <div style="font-size:26px;font-weight:700">@State.TotalBalance.ToString("C")</div>
    </div>
    <div style="text-align:right">
        <div style="font-size:12px;color:var(--text3)">Net Worth</div>
        <div style="font-size:18px;font-weight:600;color:@(State.NetWorth>=0?"var(--green)":"var(--red)")">@State.NetWorth.ToString("C")</div>
    </div>
</div>

@if (State.Accounts.Any())
{
    var billAccounts = State.Accounts.Where(a => a.Type == AccountType.Bills).ToList();
    var savingsAccounts = State.Accounts.Where(a => a.Type == AccountType.Savings).ToList();
    var billBalance = billAccounts.Sum(a => State.GetAccountBalance(a.Id));
    <div class="metric-strip">
        <div>
            <span>Bills buckets</span>
            <strong>@billBalance.ToString("C")</strong>
        </div>
        <div>
            <span>Savings buckets</span>
            <strong>@State.SavingsTotal.ToString("C")</strong>
        </div>
        <div>
            <span>Open goals</span>
            <strong>@(State.SavingsGoals.Count + State.Accounts.Count(a => a.TargetCents is not null))</strong>
        </div>
    </div>
}

@if (!State.Accounts.Any())
{
    <div class="empty-state" style="margin-top:40px">
        <span>No accounts. Sync from your PC to load data.</span>
        <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo("settings")'>Open Sync Settings</button>
    </div>
}
else
{
    @foreach (var typeGroup in State.Accounts.GroupBy(a => a.Type).OrderBy(g => (int)g.Key))
    {
        <div class="section-header" style="margin-top:8px">
            <span class="section-title">@typeGroup.Key</span>
            <span style="font-size:13px;color:var(--text2)">
                @typeGroup.Sum(a => State.GetAccountBalance(a.Id)).ToString("C")
            </span>
        </div>
        <div style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
            @foreach (var acct in typeGroup.OrderByDescending(a => State.GetAccountBalance(a.Id)))
            {
                var balance = State.GetAccountBalance(acct.Id);
                var (acctAfterBills, acctAfterPay) = State.GetAccountForecast(acct.Id);
                var billsDue = balance - acctAfterBills;
                var isPayAcct = acct.Id == State.PayAccountId;
                var isExpanded = _expandedAccountId == acct.Id;
                var accountBills = State.Bills
                    .Where(b => b.AccountId == acct.Id && !State.IsBillPaid(b) && b.EffectiveDueDate.Date <= DateTime.Today.AddDays(30))
                    .OrderBy(b => b.EffectiveDueDate)
                    .Take(4)
                    .ToList();
                var recentAccountTxns = State.Transactions
                    .Where(t => t.AccountId == acct.Id)
                    .OrderByDescending(t => t.Date)
                    .ThenByDescending(t => t.UpSettledAt ?? DateTime.MinValue)
                    .Take(3)
                    .ToList();
                <div style="padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer" @onclick="() => ToggleAccount(acct.Id)">
                    <div style="display:flex;align-items:center;gap:10px">
                        <div class="dot" style="background:@acct.ColorHex;width:12px;height:12px"></div>
                        <div style="flex:1">
                            <div style="font-size:15px;font-weight:500">@acct.Name</div>
                        </div>
                        <div style="text-align:right">
                            <div style="font-size:17px;font-weight:600;color:@(balance>=0?"var(--text)":"var(--red)")">@balance.ToString("C")</div>
                            <div style="font-size:11px;color:var(--text3)">@(isExpanded ? "Tap to close" : "Tap for details")</div>
                        </div>
                    </div>
                    @if (billsDue > 0 || (isPayAcct && State.HasPayEstimate))
                    {
                        <div style="display:flex;margin-top:8px;background:var(--surface2);border-radius:8px;overflow:hidden">
                            <div style="flex:1;padding:6px 8px;text-align:center">
                                <div style="font-size:9px;text-transform:uppercase;letter-spacing:0.05em;color:var(--text3)">Now</div>
                                <div style="font-size:13px;font-weight:600;color:@(balance>=0?"var(--text)":"var(--red)")">@balance.ToString("C")</div>
                            </div>
                            @if (billsDue > 0)
                            {
                                <div style="width:1px;background:var(--border)"></div>
                                <div style="flex:1;padding:6px 8px;text-align:center">
                                    <div style="font-size:9px;text-transform:uppercase;letter-spacing:0.05em;color:var(--text3)">Before Pay</div>
                                    <div style="font-size:13px;font-weight:600;color:@(acctAfterBills>=0?"var(--text)":"var(--red)")">@acctAfterBills.ToString("C")</div>
                                </div>
                            }
                            @if (isPayAcct && State.HasPayEstimate)
                            {
                                <div style="width:1px;background:var(--border)"></div>
                                <div style="flex:1;padding:6px 8px;text-align:center">
                                    <div style="font-size:9px;text-transform:uppercase;letter-spacing:0.05em;color:var(--text3)">After Pay</div>
                                    <div style="font-size:13px;font-weight:600;color:var(--green)">@acctAfterPay.ToString("C")</div>
                                </div>
                            }
                        </div>
                    }
                    @if (isExpanded)
                    {
                        <div style="margin-top:10px;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:10px" @onclick:stopPropagation="true">
                            <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px">
                                <div style="text-align:center">
                                    <div class="stat-label">30d bills</div>
                                    <div style="font-size:14px;font-weight:700;color:@(accountBills.Sum(b => b.AmountDollars) > 0 ? "var(--red)" : "var(--text3)")">@accountBills.Sum(b => b.AmountDollars).ToString("C")</div>
                                </div>
                                <div style="text-align:center">
                                    <div class="stat-label">After bills</div>
                                    <div style="font-size:14px;font-weight:700;color:@(acctAfterBills >= 0 ? "var(--green)" : "var(--red)")">@acctAfterBills.ToString("C")</div>
                                </div>
                                <div style="text-align:center">
                                    <div class="stat-label">After pay</div>
                                    <div style="font-size:14px;font-weight:700;color:@(acctAfterPay >= 0 ? "var(--green)" : "var(--red)")">@acctAfterPay.ToString("C")</div>
                                </div>
                            </div>
                            @if (accountBills.Any())
                            {
                                <div>
                                    <div style="font-size:11px;color:var(--text3);text-transform:uppercase;font-weight:700;margin-bottom:6px">Upcoming from this account</div>
                                    @foreach (var bill in accountBills)
                                    {
                                        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
                                            <span style="color:var(--text2)">@bill.Name · @bill.EffectiveDueDate.ToString("dd MMM")</span>
                                            <span style="font-weight:700;color:var(--red)">@bill.AmountDollars.ToString("C")</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (recentAccountTxns.Any())
                            {
                                <div>
                                    <div style="font-size:11px;color:var(--text3);text-transform:uppercase;font-weight:700;margin-bottom:6px">Recent activity</div>
                                    @foreach (var txn in recentAccountTxns)
                                    {
                                        <div style="display:flex;justify-content:space-between;gap:8px;font-size:12px;margin-bottom:4px">
                                            <span style="color:var(--text2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@txn.Description</span>
                                            <span style="font-weight:700;color:@(txn.AmountCents >= 0 ? "var(--green)" : "var(--red)")">@txn.AmountDollars.ToString("C")</span>
                                        </div>
                                    }
                                </div>
                            }
                            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
                                <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("transactions")'>Transactions</button>
                                <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("bills")'>Bills</button>
                            </div>
                        </div>
                    }
                    @if (isPayAcct || acctAfterBills < 0 || acct.TargetCents is not null)
                    {
                        <div class="attention-row">
                            @if (isPayAcct)
                            {
                                <span class="attention-chip tone-blue">Pay lands here</span>
                            }
                            @if (acctAfterBills < 0)
                            {
                                <button class="attention-chip tone-red" @onclick='() => Nav.NavigateTo("bills")'>Short before payday</button>
                            }
                            @if (acct.TargetCents is not null)
                            {
                                <span class="attention-chip tone-green">Goal tracked</span>
                            }
                        </div>
                    }
                    @if (acct.TargetCents is not null)
                    {
                        var progress = acct.TargetDollars > 0 ? Math.Clamp(balance / acct.TargetDollars!.Value, 0, 1) : 0;
                        <div class="progress-bar" style="margin-top:8px">
                            <div class="progress-fill" style="width:@((int)(progress * 100))%;background:@acct.ColorHex"></div>
                        </div>
                        <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:3px">
                            <span>@((progress).ToString("P0")) of @acct.TargetDollars!.Value.ToString("C")</span>
                            @if (acct.TargetDate is not null)
                            {
                                <span>by @acct.TargetDate.Value.ToString("dd MMM yy")</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
}

<!-- Debts section -->
<div class="section-header" style="margin-top:8px">
    <span class="section-title">Debts</span>
    <div style="display:flex;align-items:center;gap:10px">
        @if (State.Debts.Any())
        {
            <span style="font-size:13px;color:var(--red)">@State.DebtTotal.ToString("C")</span>
        }
        <button class="btn btn-secondary btn-sm" @onclick='() => _debtDraft = new Debt { PaymentPeriod = "Weekly" }'>+ Add</button>
    </div>
</div>
@if (State.Debts.Any())
{
    <div style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
        @foreach (var debt in State.Debts.OrderByDescending(d => d.BalanceDollars))
        {
            var paidOff = Math.Max(debt.OriginalBalanceDollars - debt.BalanceDollars, 0);
            var progress = debt.OriginalBalanceDollars > 0 ? Math.Clamp(paidOff / debt.OriginalBalanceDollars, 0, 1) : 0;
            <div style="padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer" @onclick="() => _debtDraft = debt">
                <div style="display:flex;align-items:center">
                    <div style="flex:1">
                        <div style="font-size:15px;font-weight:500">@debt.Name</div>
                        <div style="font-size:12px;color:var(--text3)">@debt.MinimumPaymentDollars.ToString("C") @debt.PaymentPeriod.ToLowerInvariant()</div>
                    </div>
                    <div style="text-align:right">
                        <div style="font-size:17px;font-weight:600;color:var(--red)">@debt.BalanceDollars.ToString("C")</div>
                        @if (debt.InterestRate is not null)
                        {
                            <div style="font-size:11px;color:var(--text3)">@debt.InterestRate.Value.ToString("0.##")% p.a.</div>
                        }
                    </div>
                </div>
                @if (debt.OriginalBalanceDollars > 0)
                {
                    <div class="progress-bar" style="margin-top:8px">
                        <div class="progress-fill" style="width:@((int)(progress * 100))%;background:var(--green)"></div>
                    </div>
                    <div style="font-size:11px;color:var(--text3);margin-top:3px">
                        @paidOff.ToString("C") paid off · @progress.ToString("P0")
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div style="padding:20px;text-align:center;color:var(--text3);font-size:13px;background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
        No debts tracked yet — tap "+ Add" to add one.
    </div>
}

<!-- Savings goals -->
<div class="section-header" style="margin-top:8px">
    <span class="section-title">Savings Goals</span>
    <div style="display:flex;align-items:center;gap:10px">
        @if (State.SavingsGoals.Any())
        {
            <span style="font-size:13px;color:var(--purple)">@(State.SavingsGoals.Sum(g => g.CurrentDollars).ToString("C"))</span>
        }
        <button class="btn btn-secondary btn-sm" @onclick='() => _goalDraft = new SavingsGoal()'>+ Add</button>
    </div>
</div>
@if (State.SavingsGoals.Any())
{
    <div style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
        @foreach (var goal in State.SavingsGoals)
        {
            var progress = goal.TargetDollars > 0 ? Math.Clamp(goal.CurrentDollars / goal.TargetDollars, 0, 1) : 0;
            <div style="padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer" @onclick="() => _goalDraft = goal">
                <div style="display:flex;align-items:center">
                    <div style="flex:1">
                        <div style="font-size:15px;font-weight:500">@goal.Name</div>
                        @if (goal.WeeklyContributionDollars > 0)
                        {
                            <div style="font-size:12px;color:var(--text3)">@goal.WeeklyContributionDollars.ToString("C")/week</div>
                        }
                    </div>
                    <div style="text-align:right">
                        <div style="font-size:15px;font-weight:600">@goal.CurrentDollars.ToString("C")</div>
                        <div style="font-size:11px;color:var(--text3)">of @goal.TargetDollars.ToString("C")</div>
                    </div>
                </div>
                <div class="progress-bar" style="margin-top:8px">
                    <div class="progress-fill" style="width:@((int)(progress * 100))%;background:var(--purple)"></div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:3px">
                    <span>@progress.ToString("P0")</span>
                    @if (goal.TargetDate is not null)
                    {
                        <span>@goal.TargetDate.Value.ToString("dd MMM yy")</span>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div style="padding:20px;text-align:center;color:var(--text3);font-size:13px;background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
        No savings goals yet — tap "+ Add" to create one.
    </div>
}

<!-- Account targets (a balance goal attached to an existing account, distinct from a dedicated savings goal) -->
@{
    var accountGoals = State.Accounts.Where(a => a.TargetCents is not null).ToList();
}
@if (accountGoals.Any())
{
    <div class="section-header" style="margin-top:8px">
        <span class="section-title">Targets</span>
        <span style="font-size:13px;color:var(--text2)">@(accountGoals.Sum(a => State.GetAccountBalance(a.Id)).ToString("C"))</span>
    </div>
    <div style="background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
        @foreach (var acct in accountGoals)
        {
            var current = State.GetAccountBalance(acct.Id);
            var target = acct.TargetDollars!.Value;
            var progress = target > 0 ? Math.Clamp(current / target, 0, 1) : 0;
            var weekly = GoalMath.WeeklyRequired(target, current, acct.TargetDate);
            <div style="padding:14px 16px;border-bottom:1px solid var(--border);cursor:pointer" @onclick="() => _accountGoalDraft = acct">
                <div style="display:flex;align-items:center">
                    <div style="flex:1">
                        <div style="font-size:15px;font-weight:500">@acct.Name</div>
                        @if (weekly > 0)
                        {
                            <div style="font-size:12px;color:var(--text3)">@weekly.ToString("C")/week</div>
                        }
                    </div>
                    <div style="text-align:right">
                        <div style="font-size:15px;font-weight:600">@current.ToString("C")</div>
                        <div style="font-size:11px;color:var(--text3)">of @target.ToString("C")</div>
                    </div>
                </div>
                <div class="progress-bar" style="margin-top:8px">
                    <div class="progress-fill" style="width:@((int)(progress * 100))%;background:@acct.ColorHex"></div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:3px">
                    <span>@progress.ToString("P0")</span>
                    @if (acct.TargetDate is not null)
                    {
                        <span>@acct.TargetDate.Value.ToString("dd MMM yy")</span>
                    }
                </div>
            </div>
        }
    </div>
}

<div style="height:calc(var(--nav-height) + var(--safe-bottom) + 96px)"></div>

@if (_debtDraft is not null)
{
    <AddEditDebtModal Debt="@_debtDraft"
        OnClose="() => _debtDraft = null"
        OnSaved="() => _debtDraft = null" />
}

@if (_goalDraft is not null)
{
    <AddEditSavingsGoalModal Goal="@_goalDraft"
        OnClose="() => _goalDraft = null"
        OnSaved="() => _goalDraft = null" />
}

@if (_accountGoalDraft is not null)
{
    <EditAccountGoalModal Account="@_accountGoalDraft"
        OnClose="() => _accountGoalDraft = null"
        OnSaved="() => _accountGoalDraft = null" />
}

<!-- FAB -->
<button class="btn btn-primary fab" @onclick="() => showAddTxn = true">
    +
</button>

@if (showAddTxn)
{
    <AddTransactionModal OnClose="() => showAddTxn = false" OnSaved="() => showAddTxn = false" />
}

@code {
    private Debt? _debtDraft;
    private SavingsGoal? _goalDraft;
    private Account? _accountGoalDraft;
    private bool showAddTxn;
    private int _expandedAccountId;

    private void ToggleAccount(int accountId) =>
        _expandedAccountId = _expandedAccountId == accountId ? 0 : accountId;
}
