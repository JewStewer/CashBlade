@page "/transactions"
@inject AppState State
@inject NavigationManager Nav
@inject UiState Ui
@inject IJSRuntime JS

<PageTitle>Transactions — Evergrove</PageTitle>

<div class="pill-tabs">
    @foreach (var f in new[]{"All","Income","Expenses","Transfers"})
    {
        <button class="pill @(filter==f?"pill-active":"pill-inactive")" @onclick="() => filter = f">@f</button>
    }
</div>

<!-- Search + filters -->
<div style="padding:0 16px 10px;display:flex;flex-direction:column;gap:8px">
    <div style="display:flex;gap:8px">
        <input class="form-input" style="flex:1" placeholder="Search…" @bind="search" @bind:event="oninput" />
        @if (!string.IsNullOrEmpty(search))
        {
            <button class="btn btn-icon" @onclick="() => search = string.Empty"><Icon Name="x" Size="14" /></button>
        }
    </div>
    <div style="display:flex;gap:8px">
        <select class="form-input" style="flex:1;height:34px;font-size:13px;padding:0 8px" @bind="dateRange">
            <option value="paycycle">Since payday</option>
            <option value="all">All dates</option>
            <option value="today">Today</option>
            <option value="week">This week</option>
            <option value="month">This month</option>
        </select>
        <select class="form-input" style="flex:1;height:34px;font-size:13px;padding:0 8px" @bind="filterAccountId">
            <option value="0">All accounts</option>
            @foreach (var a in State.Accounts)
            {
                <option value="@a.Id">@a.Name</option>
            }
        </select>
        <select class="form-input" style="flex:1;height:34px;font-size:13px;padding:0 8px" @bind="filterCategoryId">
            <option value="0">All categories</option>
            @foreach (var c in State.Categories.OrderBy(c => c.Name))
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
    </div>
</div>

@{
    var filteredRows = GetFiltered();
    var filteredSpent = filteredRows.Where(t => t.AmountCents < 0 && !State.IsInternalMovement(t)).Sum(t => Math.Abs(t.AmountDollars));
    var filteredIncome = filteredRows.Where(t => t.AmountCents > 0 && !State.IsInternalMovement(t)).Sum(t => t.AmountDollars);
    var filteredNet = filteredRows.Sum(t => t.AmountDollars);
}

<div style="padding:0 16px 10px;display:flex;gap:8px">
    <div class="card-sm" style="flex:1;text-align:center">
        <div class="stat-label">Matching</div>
        <div style="font-size:17px;font-weight:700;color:var(--text)">@filteredRows.Count</div>
    </div>
    <div class="card-sm" style="flex:1;text-align:center">
        <div class="stat-label">Spent</div>
        <div style="font-size:17px;font-weight:700;color:var(--red)">@filteredSpent.ToString("C")</div>
    </div>
    <div class="card-sm" style="flex:1;text-align:center">
        <div class="stat-label">Net</div>
        <div style="font-size:17px;font-weight:700;color:@(filteredNet >= 0 ? "var(--green)" : "var(--red)")">@filteredNet.ToString("C")</div>
    </div>
</div>
@if (State.NoSpendMode)
{
    <div class="info-note">
        No-spend mode is on. Safe-to-spend is held at $0 until you turn it off.
        <button class="btn btn-sm btn-secondary" @onclick="DisableNoSpendAsync">Turn off</button>
    </div>
}
<div style="padding:0 16px 12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <button class="btn btn-secondary btn-sm" disabled="@(!HasActiveFilters)" @onclick="ClearFilters">Clear filters</button>
    <button class="btn btn-secondary btn-sm" disabled="@(!filteredRows.Any())" @onclick="ExportFilteredAsync">Export filtered</button>
</div>

<div class="card-list" style="margin-top:0">
    @{var rows = filteredRows;}
    @if (!rows.Any())
    {
        <div class="empty-state">
            <span>No transactions match.</span>
            <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
                <button class="btn btn-primary btn-sm" @onclick="() => Ui.OpenAddTransaction()">Add Transaction</button>
                <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("settings")'>Sync Settings</button>
            </div>
        </div>
    }
    else
    {
        var grouped = rows.GroupBy(t => t.Date.Date).OrderByDescending(g => g.Key);
        @foreach (var day in grouped)
        {
            <div style="padding:8px 16px 4px;background:var(--bg);border-bottom:1px solid var(--border)">
                <span style="font-size:12px;font-weight:600;color:var(--text3)">
                    @(day.Key == DateTime.Today ? "Today" :
                      day.Key == DateTime.Today.AddDays(-1) ? "Yesterday" :
                      day.Key.ToString("ddd dd MMM"))
                </span>
                <span style="float:right;font-size:12px;color:var(--text3)">
                    @day.Sum(t => t.AmountDollars).ToString("C")
                </span>
            </div>
            @foreach (var t in day.OrderByDescending(x => x.UpSettledAt ?? DateTime.MinValue).ThenByDescending(x => x.Id))
            {
                <div>
                    @{
                        var lentUnrepaid = State.IsUnrepaid(t.Id);
                        var lentRepaid   = !lentUnrepaid && State.IsLent(t.Id);
                        var isInternalMovement = State.IsInternalMovement(t);
                        var rowBorder = lentUnrepaid ? "border-left:3px solid #818CF8"
                                       : lentRepaid  ? "border-left:3px solid #34D399"
                                       : t.IsUnnecessary ? "border-left:3px solid var(--amber)"
                                       : t.IsReimbursement ? "border-left:3px solid var(--blue)"
                                       : "";
                    }
                    <div class="list-row" style="cursor:pointer;@rowBorder" @onclick="() => SelectTxn(t.Id)">
                        @{var visual = CategoryIcon.Get(isInternalMovement ? "Transfer" : t.CategoryName);}
                        <div class="row-icon" style="background:@visual.Bg;color:@visual.Fg"><Icon Name="@visual.Icon" /></div>
                        <div class="row-main">
                            <div class="row-title">@t.Description</div>
                            <div class="row-sub">@t.AccountName · @(isInternalMovement ? "Transfer" : t.CategoryName)</div>
                        </div>
                        <div style="text-align:right">
                            <div class="row-amount @(t.AmountCents>=0?"pos":"neg")">@t.AmountDollars.ToString("C")</div>
                            @if (lentUnrepaid)
                            {
                                <div style="font-size:10px;color:#818CF8;display:flex;align-items:center;gap:3px;justify-content:flex-end"><Icon Name="users" Size="10" /> lent out</div>
                            }
                            else if (lentRepaid)
                            {
                                <div style="font-size:10px;color:var(--green);display:flex;align-items:center;gap:3px;justify-content:flex-end"><Icon Name="check" Size="10" /> repaid</div>
                            }
                            else if (t.IsUnnecessary)
                            {
                                <div style="font-size:10px;color:var(--amber)">unnecessary</div>
                            }
                            else if (t.IsReimbursement)
                            {
                                <div style="font-size:10px;color:var(--blue)">repayment</div>
                            }
                        </div>
                    </div>
                    @if (selectedId == t.Id)
                    {
                        var localT = t;
                        var isLent = State.IsLent(localT.Id);
                        var isUnrepaid = State.IsUnrepaid(localT.Id);
                        var sameNameCount = State.GetSameNameTransactionCount(localT);
                        <div style="padding:8px 12px;background:var(--surface2);border-bottom:1px solid var(--border);display:flex;flex-direction:column;gap:8px" @onclick:stopPropagation="true">
                            <div style="display:flex;align-items:center;gap:8px">
                                <span style="font-size:12px;color:var(--text3);flex-shrink:0">Category</span>
                                <select class="form-input" style="flex:1;height:34px;font-size:13px;padding:0 8px"
                                        value="@localT.CategoryId.ToString()"
                                        @onchange="e => OnCategoryChange(localT, e)">
                                    @foreach (var c in State.Categories.OrderBy(c => c.Name))
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>
                            <div style="display:flex;gap:8px;flex-wrap:wrap">
                                <button class="btn btn-sm btn-secondary" @onclick="() => StartEdit(localT)" @onclick:stopPropagation="true">Edit</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => _moreActionsForId = localT.Id" @onclick:stopPropagation="true">&bull;&bull;&bull;</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DoDelete(localT)" @onclick:stopPropagation="true">Delete</button>
                                <button class="btn btn-sm btn-secondary" style="margin-left:auto" @onclick="() => selectedId = 0" @onclick:stopPropagation="true"><Icon Name="x" Size="13" /></button>
                            </div>
                        </div>
                        @if (_moreActionsForId == localT.Id)
                        {
                            <RowActionSheet Title="More Actions" OnClose="() => _moreActionsForId = 0">
                                @if (sameNameCount > 1)
                                {
                                    <button class="btn btn-sm btn-secondary" @onclick="() => DoApplyCategoryToSameName(localT)">
                                        Apply this category to @sameNameCount matching names
                                    </button>
                                }
                                @if (!string.IsNullOrWhiteSpace(_bulkCategoryStatus) && _bulkCategoryStatusId == localT.Id)
                                {
                                    <div style="font-size:12px;color:@_bulkCategoryStatusColor">@_bulkCategoryStatus</div>
                                }
                                @if (localT.AmountCents < 0 && !State.IsInternalMovement(localT))
                                {
                                    <button class="btn btn-sm @(localT.IsUnnecessary ? "btn-primary" : "btn-secondary")"
                                            style="@(localT.IsUnnecessary ? "background:rgba(245,158,11,0.2);color:var(--amber);border:1px solid var(--amber)" : "")"
                                            @onclick="() => DoToggleUnnecessary(localT)">
                                        @if (localT.IsUnnecessary)
                                        {
                                            <span style="display:inline-flex;align-items:center;gap:4px"><Icon Name="check" Size="13" /> Unnecessary</span>
                                        }
                                        else
                                        {
                                            @("Mark unnecessary")
                                        }
                                    </button>
                                    @if (isLent)
                                    {
                                        @if (isUnrepaid)
                                        {
                                            var outstanding = State.GetLentOutstandingDollars(localT);
                                            <div style="display:flex;gap:6px;align-items:center;width:100%;flex-wrap:wrap">
                                                <span style="font-size:12px;color:#818CF8">@outstanding.ToString("C") owed</span>
                                                <button class="btn btn-sm btn-secondary"
                                                        @onclick="() => DoRecordRepayment(localT.Id, outstanding * 0.5m)">
                                                    50%
                                                </button>
                                                <button class="btn btn-sm btn-secondary"
                                                        @onclick="() => DoMarkRepaid(localT.Id)">
                                                    Full
                                                </button>
                                                @if (_repayPickId == localT.Id)
                                                {
                                                    <input class="form-input" style="width:90px;height:32px;font-size:13px" type="number" min="0" step="0.01"
                                                           @bind="_repayAmount" />
                                                    <button class="btn btn-sm btn-primary"
                                                            @onclick="() => DoRecordRepayment(localT.Id, _repayAmount)">Save</button>
                                                    <button class="btn btn-sm btn-secondary"
                                                            @onclick="CancelRepayPick"><Icon Name="x" Size="13" /></button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-secondary"
                                                            @onclick="() => StartRepayPick(localT.Id, outstanding)">Custom</button>
                                                }
                                            </div>
                                        }
                                        <button class="btn btn-sm"
                                                style="background:rgba(99,102,241,0.15);color:#818CF8;border:1px solid #818CF8;display:inline-flex;align-items:center;gap:5px"
                                                @onclick="() => DoUnmarkLent(localT.Id)">
                                            <Icon Name="users" Size="13" /> @(isUnrepaid ? "Awaiting repayment" : "Repaid") <Icon Name="x" Size="11" />
                                        </button>
                                    }
                                    else if (_lentPickId == localT.Id)
                                    {
                                        <div style="display:flex;gap:6px;align-items:center;width:100%">
                                            <input class="form-input" style="flex:1;height:32px;font-size:13px" placeholder="Who? (optional)"
                                                   @bind="_lentNote" @bind:event="oninput" />
                                            <button class="btn btn-sm btn-primary"
                                                    @onclick="() => DoMarkLent(localT.Id)">Confirm</button>
                                            <button class="btn btn-sm btn-secondary"
                                                    @onclick="CancelLentPick"><Icon Name="x" Size="13" /></button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary"
                                                @onclick="() => StartLentPick(localT.Id)" style="display:inline-flex;align-items:center;gap:5px">
                                            <Icon Name="users" Size="13" /> Lent out
                                        </button>
                                    }
                                }
                                @if (localT.AmountCents > 0 && !State.IsInternalMovement(localT))
                                {
                                    <button class="btn btn-sm @(localT.IsReimbursement ? "btn-primary" : "btn-secondary")"
                                            style="@(localT.IsReimbursement ? "background:rgba(59,130,246,0.2);color:var(--blue);border:1px solid var(--blue)" : "")"
                                            @onclick="() => DoToggleReimbursement(localT)">
                                        @if (localT.IsReimbursement)
                                        {
                                            <span style="display:inline-flex;align-items:center;gap:4px"><Icon Name="check" Size="13" /> Repayment</span>
                                        }
                                        else
                                        {
                                            @("Mark as repayment")
                                        }
                                    </button>
                                }
                            </RowActionSheet>
                        }
                    }
                </div>
            }
        }
    }
</div>

<div style="height:16px"></div>

@if (editingTxn is not null)
{
    <EditTransactionModal Transaction="editingTxn"
        OnClose="() => editingTxn = null"
        OnSaved="OnEditSaved" />
}

@code {
    private string filter = "All";
    private string search = string.Empty;
    private string dateRange = "paycycle";
    private int filterAccountId;
    private int filterCategoryId;
    private int selectedId;
    private Transaction? editingTxn;
    private int _moreActionsForId;
    private int _lentPickId;
    private string _lentNote = string.Empty;
    private int _repayPickId;
    private decimal _repayAmount;
    private int _bulkCategoryStatusId;
    private string _bulkCategoryStatus = string.Empty;
    private string _bulkCategoryStatusColor = "var(--text3)";

    private bool HasActiveFilters =>
        filter != "All" ||
        !string.IsNullOrWhiteSpace(search) ||
        dateRange != "paycycle" ||
        filterAccountId != 0 ||
        filterCategoryId != 0;

    private void SelectTxn(int id) => selectedId = selectedId == id ? 0 : id;

    private void ClearFilters()
    {
        filter = "All";
        search = string.Empty;
        dateRange = "paycycle";
        filterAccountId = 0;
        filterCategoryId = 0;
        selectedId = 0;
    }

    private void StartEdit(Transaction t)
    {
        editingTxn = t;
        selectedId = 0;
    }

    private Task OnEditSaved()
    {
        editingTxn = null;
        return Task.CompletedTask;
    }

    private Task OnCategoryChange(Transaction t, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id) || id == 0 || id == t.CategoryId)
            return Task.CompletedTask;
        _bulkCategoryStatus = string.Empty;
        return State.UpdateTransactionCategoryAsync(t.Id, id);
    }

    private async Task DoApplyCategoryToSameName(Transaction t)
    {
        var changed = await State.UpdateSameNameTransactionCategoriesAsync(t.Id, t.CategoryId);
        _bulkCategoryStatusId = t.Id;
        _bulkCategoryStatus = changed == 0
            ? "Matching transactions already use this category."
            : $"Updated {changed} matching transaction{(changed == 1 ? "" : "s")}.";
        _bulkCategoryStatusColor = changed == 0 ? "var(--text3)" : "var(--green)";
    }

    private async Task DoToggleUnnecessary(Transaction t)
    {
        await State.ToggleUnnecessaryAsync(t.Id);
        selectedId = 0;
    }

    private async Task DoToggleReimbursement(Transaction t)
    {
        await State.ToggleReimbursementAsync(t.Id);
        selectedId = 0;
    }

    private async Task DoDelete(Transaction t)
    {
        await State.DeleteTransactionAsync(t.Id);
        selectedId = 0;
    }

    private async Task DoMarkLent(int txnId)
    {
        await State.MarkLentAsync(txnId, _lentNote.Trim());
        await CancelLentPick();
    }

    private async Task DoUnmarkLent(int txnId) => await State.UnmarkLentAsync(txnId);

    private async Task StartLentPick(int txnId)
    {
        _lentPickId = txnId;
        _lentNote = string.Empty;
        await RepairScrollAfterKeyboardAsync();
    }

    private async Task CancelLentPick()
    {
        _lentPickId = 0;
        await RepairScrollAfterKeyboardAsync();
    }

    private async Task DoMarkRepaid(int txnId)
    {
        await State.MarkRepaidAsync(txnId);
        await CancelRepayPick();
    }

    private async Task StartRepayPick(int txnId, decimal outstanding)
    {
        _repayPickId = txnId;
        _repayAmount = Math.Round(outstanding, 2);
        await RepairScrollAfterKeyboardAsync();
    }

    private async Task CancelRepayPick()
    {
        _repayPickId = 0;
        _repayAmount = 0;
        await RepairScrollAfterKeyboardAsync();
    }

    private async Task DoRecordRepayment(int txnId, decimal amount)
    {
        await State.RecordLentRepaymentAsync(txnId, amount);
        await CancelRepayPick();
    }

    // Opening/closing these inline pickers blurs whatever input is focused
    // (or focuses a new one), dismissing the iOS keyboard. WKWebView frequently
    // fails to re-attach .page-content as a scrollable layer when that happens
    // — the same quirk financeBlade.nudgeRepaint works around for HolidayTab's
    // inline edit forms. Without this, touch-scroll silently stops responding
    // until some other reflow happens.
    private async Task RepairScrollAfterKeyboardAsync()
    {
        try { await JS.InvokeVoidAsync("financeBlade.nudgeRepaint"); }
        catch (JSDisconnectedException) { }
    }

    private async Task ExportFilteredAsync()
    {
        var csv = BuildTransactionsCsv(GetFiltered().OrderBy(t => t.Date).ThenBy(t => t.Id));
        await JS.InvokeVoidAsync("financeBlade.downloadFile", $"transactions-filtered-{DateTime.Today:yyyy-MM-dd}.csv", csv, "text/csv");
    }

    private Task DisableNoSpendAsync() => State.SetNoSpendModeAsync(false);

    private List<Transaction> GetFiltered()
    {
        var q = State.RecentTransactions.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(search))
            q = q.Where(t => t.Description.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                              t.CategoryName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                              t.AccountName.Contains(search, StringComparison.OrdinalIgnoreCase));

        q = dateRange switch
        {
            "paycycle" => q.Where(t =>
            {
                var (from, to) = State.GetCurrentPayCycle();
                return t.Date.Date >= from && t.Date.Date <= to;
            }),
            "today" => q.Where(t => t.Date.Date == DateTime.Today),
            "week"  => q.Where(t => t.Date.Date >= DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek)),
            "month" => q.Where(t => t.Date.Month == DateTime.Today.Month && t.Date.Year == DateTime.Today.Year),
            _ => q
        };

        if (filterAccountId != 0)
            q = q.Where(t => t.AccountId == filterAccountId);

        if (filterCategoryId != 0)
            q = q.Where(t => t.CategoryId == filterCategoryId);

        q = filter switch
        {
            "Income" => q.Where(t => t.AmountCents > 0 && !State.IsInternalMovement(t) && !t.IsReimbursement),
            "Expenses" => q.Where(t => t.AmountCents < 0 && !State.IsInternalMovement(t)),
            "Transfers" => q.Where(t => State.IsInternalMovement(t)),
            // "All" hides internal cover/envelope transfers by default — they're
            // bookkeeping noise, not spending. Switch to the Transfers tab to see them.
            _ => q.Where(t => !State.IsInternalMovement(t))
        };

        return q.ToList();
    }

    private static string BuildTransactionsCsv(IEnumerable<Transaction> rows)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Date,Description,Account,Category,Amount,Unnecessary");
        foreach (var t in rows)
        {
            sb.AppendLine(string.Join(",",
                Csv(t.Date.ToString("yyyy-MM-dd")),
                Csv(t.Description),
                Csv(t.AccountName),
                Csv(t.CategoryName),
                t.AmountDollars.ToString("0.00"),
                t.IsUnnecessary ? "Yes" : "No"));
        }
        return sb.ToString();
    }

    private static string Csv(string value)
    {
        var safe = value.Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }

}
