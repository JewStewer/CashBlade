@page "/tools"
@page "/more"
@inject AppState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Tools - Evergrove</PageTitle>

<div style="padding:10px 16px 16px;display:flex;flex-direction:column;gap:12px">
    <div class="card-sm" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
        <div style="min-width:0">
            <div class="row-title">Settings</div>
            <div class="row-sub">Up Bank, notifications, sync, app lock</div>
            <div style="font-size:11px;color:var(--text3);margin-top:3px">@AppInfo.DisplayVersion</div>
        </div>
        <button class="btn btn-primary btn-sm" @onclick='() => Nav.NavigateTo("settings")'>Open</button>
    </div>

    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
            <div>
                <div class="row-title">Sync queue</div>
                <div class="row-sub">See exactly what iOS is waiting to push.</div>
            </div>
            <span class="badge @(State.HasPendingChanges ? "badge-amber" : "badge-green")">
                @(State.HasPendingChanges ? "Pending" : "Clear")
            </span>
        </div>

        @{
            var queue = State.GetPendingSyncQueue();
        }
        @if (queue.Any())
        {
            <div style="display:flex;flex-direction:column;gap:6px">
                @foreach (var item in queue)
                {
                    <div class="inset-card" style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px">
                        <span style="font-size:13px;color:var(--text2)">@item.Label</span>
                        <span class="badge badge-gray">@item.Count</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="font-size:13px;color:var(--text3)">No local edits are waiting to sync.</div>
        }

        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
            <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SyncNowAsync">Sync now</button>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="ConfirmRepairAsync">Repair queue</button>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="DownloadSnapshotAsync">Snapshot</button>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="ForceUpdateAsync">Clear cache &amp; reload</button>
        </div>
        @if (!string.IsNullOrEmpty(_syncStatus))
        {
            <div style="font-size:12px;color:@_syncStatusColor">@_syncStatus</div>
        }
    </div>

    <div class="pill-tabs">
        @foreach (var t in new[] { "Game", "Cleanup", "Debug", "More" })
        {
            <button class="pill @(_tab == t ? "pill-active" : "pill-inactive")" @onclick="() => _tab = t">@t</button>
        }
    </div>

@if (_tab == "Game")
{
    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
            <div>
                <div class="row-title">Streak &amp; Level</div>
                <div class="row-sub">Level @State.Xp.Level &middot; @State.Xp.TotalXp XP &middot; @State.Streak.CurrentStreakWeeks-week streak (best @State.Streak.BestStreakWeeks)</div>
            </div>
            <span class="badge badge-teal">@State.Streak.FreezesAvailable freeze@(State.Streak.FreezesAvailable == 1 ? "" : "s")</span>
        </div>
        <div style="font-size:12px;color:var(--text3)">
            A freeze protects your streak the next time a week goes over budget, instead of resetting it to zero.
        </div>
        <button class="btn btn-secondary btn-sm" disabled="@(State.Xp.TotalXp < 100)" @onclick="BuyStreakFreezeAsync">
            Buy a freeze (100 XP)
        </button>
        @if (!string.IsNullOrEmpty(_freezeStatus))
        {
            <div style="font-size:12px;color:@_freezeStatusColor">@_freezeStatus</div>
        }
    </div>

    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
            <div>
                <div class="row-title">This week's challenge</div>
                <div class="row-sub">@State.WeeklyChallenge?.Title</div>
            </div>
            @if (State.WeeklyChallenge is not null)
            {
                <span class="badge @(WeeklyChallengeOnTrack ? "badge-green" : "badge-amber")">
                    @(WeeklyChallengeOnTrack ? "On track" : "Over")
                </span>
            }
        </div>
        @if (State.WeeklyChallenge is not null)
        {
            <div style="font-size:13px;color:var(--text2)">@State.WeeklyChallenge.Description</div>
            <div class="progress-bar" style="height:8px">
                <div class="progress-fill" style="width:@WeeklyChallengeProgressPercent%;background:@(WeeklyChallengeOnTrack ? "var(--green)" : "var(--red)")"></div>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3)">
                <span>@State.WeeklyChallengeProgress.ToString("C") spent</span>
                <span>Target @State.WeeklyChallenge.TargetAmount.ToString("C")</span>
            </div>
        }
    </div>

    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
            <div>
                <div class="row-title">Badges</div>
                <div class="row-sub">@State.UnlockedBadges.Count of @(State.UnlockedBadges.Count + State.LockedBadges.Count) unlocked</div>
            </div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
            @foreach (var badge in State.UnlockedBadges)
            {
                <span class="badge badge-green" title="@badge.Description">@badge.Title</span>
            }
            @foreach (var badge in State.LockedBadges)
            {
                <span class="badge badge-gray" title="@badge.Description">@badge.Title</span>
            }
        </div>
    </div>

    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
            <div>
                <div class="row-title">Round-up savings</div>
                <div class="row-sub">Round every spend up and sweep the spare change into a goal.</div>
            </div>
            <label style="display:flex;align-items:center;gap:6px;font-size:12px">
                <input type="checkbox" checked="@State.RoundUp.Enabled" @onchange="ToggleRoundUpAsync" />
                On
            </label>
        </div>
        @if (State.RoundUp.Enabled)
        {
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                <span style="font-size:13px;color:var(--text2)">Round to</span>
                <select class="form-input" style="font-size:13px" value="@State.RoundUp.RoundToCents" @onchange="ChangeRoundUpAmountAsync">
                    <option value="100">$1</option>
                    <option value="500">$5</option>
                </select>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
                <span style="font-size:13px;color:var(--text2)">Accumulated</span>
                <strong>@State.RoundUp.AccumulatedDollars.ToString("C")</strong>
            </div>
            @if (State.SavingsGoals.Any())
            {
                <div style="display:grid;grid-template-columns:1fr auto;gap:8px">
                    <select class="form-input" style="font-size:13px" @bind="_roundUpSweepGoalId">
                        @foreach (var goal in State.SavingsGoals)
                        {
                            <option value="@goal.Id">@goal.Name</option>
                        }
                    </select>
                    <button class="btn btn-primary btn-sm" disabled="@(State.RoundUp.AccumulatedCents <= 0)" @onclick="SweepRoundUpAsync">Sweep</button>
                </div>
            }
        }
    </div>
}
else if (_tab == "Debug")
{
    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div>
            <div class="row-title">Trip debug log</div>
            <div class="row-sub">Diagnostic trail for the trip-item-reverting bug. Reproduce the issue, then export.</div>
        </div>
        <div style="font-size:12px;color:var(--text3)">@State.TripDebugLog.Count entries captured this session.</div>
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="ExportTripDebugLogAsync">Export log</button>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => State.TripDebugLog.Clear()">Clear log</button>
        </div>
    </div>

    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div>
            <div class="row-title">Savings goal debug log</div>
            <div class="row-sub">Diagnostic trail for the savings-goal delete-then-reappear bug. Reproduce the issue, then export.</div>
        </div>
        <div style="font-size:12px;color:var(--text3)">@State.SavingsGoalDebugLog.Count entries captured this session.</div>
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="ExportSavingsGoalDebugLogAsync">Export log</button>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => State.SavingsGoalDebugLog.Clear()">Clear log</button>
        </div>
    </div>
}
else if (_tab == "More")
{
    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
            <div>
                <div class="row-title">No-spend mode</div>
                <div class="row-sub">Treat today as bills and essentials only.</div>
            </div>
            <span class="badge @(State.NoSpendMode ? "badge-amber" : "badge-gray")">
                @(State.NoSpendMode ? "On" : "Off")
            </span>
        </div>
        <div class="stat-grid stat-grid-2">
            <div class="stat-cell">
                <div class="stat-cell-label">Today spent</div>
                <div class="stat-cell-value">@State.GetTodaySpending().ToString("C")</div>
            </div>
            <div class="stat-cell">
                <div class="stat-cell-label">Owed back</div>
                <div class="stat-cell-value">@State.OutstandingLentDollars.ToString("C")</div>
            </div>
            <div class="stat-cell">
                <div class="stat-cell-label">Non-bill spend</div>
                <div class="stat-cell-value">@State.GetDiscretionarySpendingForPeriod(DateTime.Today, DateTime.Today).ToString("C")</div>
            </div>
            <div class="stat-cell">
                <div class="stat-cell-label">Safe today</div>
                <div class="stat-cell-value">@State.SafeToSpendAmount.ToString("C")</div>
            </div>
        </div>
        @if (State.NoSpendMode)
        {
            <div style="font-size:12px;color:var(--text3)">Forecasts assume $0 discretionary spending while this is on.</div>
        }
        <button class="btn @(State.NoSpendMode ? "btn-secondary" : "btn-primary") btn-sm" disabled="@_busy" @onclick="ToggleNoSpendModeAsync">
            @(State.NoSpendMode ? "Turn off no-spend mode" : "Start no-spend mode")
        </button>
        @if (!string.IsNullOrEmpty(_modeStatus))
        {
            <div style="font-size:12px;color:var(--green)">@_modeStatus</div>
        }
    </div>
}
else if (_tab == "Cleanup")
{
    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div>
            <div class="row-title">Smart transaction cleanup</div>
            <div class="row-sub">Find repeated merchants with mixed categories and fix them in one tap.</div>
        </div>
        @{
            var cleanup = State.GetTransactionCleanupSuggestions();
        }
        @if (cleanup.Any())
        {
            @foreach (var suggestion in cleanup)
            {
                <div class="inset-card" style="display:flex;flex-direction:column;gap:8px">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
                        <div>
                            <div style="font-size:14px;font-weight:700;color:var(--text)">@suggestion.Merchant</div>
                            <div style="font-size:12px;color:var(--text3)">
                                @suggestion.AffectedCount of @suggestion.TotalSeen can become @suggestion.SuggestedCategoryName.
                            </div>
                        </div>
                        <span class="badge badge-gray">@suggestion.AffectedAmount.ToString("C")</span>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => ApplyCleanupAsync(suggestion)">
                            Apply category
                        </button>
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => IgnoreCleanupAsync(suggestion)">
                            Ignore
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div style="font-size:13px;color:var(--text3)">No category cleanup needed right now.</div>
        }
        @if (!string.IsNullOrEmpty(_cleanupStatus))
        {
            <div style="font-size:12px;color:var(--green)">@_cleanupStatus</div>
        }
    </div>

    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        <div>
            <div class="row-title">Spending watchlist</div>
            <div class="row-sub">Top non-bill merchants from the last 30 days.</div>
        </div>
        @{
            var watchlist = State.GetMerchantSpendWatchlist();
        }
        @if (watchlist.Any())
        {
            @foreach (var item in watchlist)
            {
                <div class="inset-card" style="display:flex;flex-direction:column;gap:8px">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
                        <div>
                            <div style="font-size:14px;font-weight:700;color:var(--text)">@item.Merchant</div>
                            <div style="font-size:12px;color:var(--text3)">@item.Count transaction@(item.Count == 1 ? "" : "s") · last @item.LastSeen.ToString("dd MMM")</div>
                        </div>
                        <span class="badge badge-gray">@item.Amount.ToString("C")</span>
                    </div>
                    <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => MarkMerchantUnnecessaryAsync(item)">
                        Mark recent as unnecessary
                    </button>
                </div>
            }
        }
        else
        {
            <div style="font-size:13px;color:var(--text3)">No discretionary merchant spend found.</div>
        }
        @if (!string.IsNullOrEmpty(_watchStatus))
        {
            <div style="font-size:12px;color:var(--green)">@_watchStatus</div>
        }
        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="ExportWatchlistAsync">
            Export watchlist CSV
        </button>
    </div>

    <div class="card-sm" style="display:flex;flex-direction:column;gap:10px">
        @{
            var recurring = State.GetRecurringPayments();
        }
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
            <div>
                <div class="row-title">Bill intelligence</div>
                <div class="row-sub">Turn detected recurring charges into bills and catch amount changes.</div>
            </div>
            @if (recurring.Any())
            {
                <button class="btn btn-secondary btn-sm" @onclick="() => _showBillIntelStats = !_showBillIntelStats">
                    @(_showBillIntelStats ? "Hide stats" : "Show stats")
                </button>
            }
        </div>
        @if (recurring.Any() && _showBillIntelStats)
        {
            <div class="stat-grid stat-grid-3">
                <div class="stat-cell stat-cell-sm">
                    <div class="stat-cell-label">Recurring</div>
                    <div class="stat-cell-value stat-cell-value-sm">@recurring.Count</div>
                </div>
                <div class="stat-cell stat-cell-sm">
                    <div class="stat-cell-label">Weekly</div>
                    <div class="stat-cell-value stat-cell-value-sm">@State.SubscriptionWeeklyTotal.ToString("C")</div>
                </div>
                <div class="stat-cell stat-cell-sm">
                    <div class="stat-cell-label">Untracked</div>
                    <div class="stat-cell-value stat-cell-value-sm">@State.SubscriptionsNotInBillsCount</div>
                </div>
            </div>
        }
        @{
            var billSuggestions = State.GetBillIntelligenceSuggestions();
        }
        @if (billSuggestions.Any())
        {
            @foreach (var suggestion in billSuggestions)
            {
                <div class="inset-card" style="display:flex;flex-direction:column;gap:8px">
                    <div>
                        <div style="font-size:14px;font-weight:700;color:var(--text)">@suggestion.Title</div>
                        <div style="font-size:12px;color:var(--text3)">@suggestion.Message</div>
                    </div>
                    @if (suggestion.Kind == "PriceCreep")
                    {
                        <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("bills")'>
                            @suggestion.ActionLabel
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => ApplyBillSuggestionAsync(suggestion)">
                            @suggestion.ActionLabel
                        </button>
                    }
                    @if (suggestion.Kind == "NewBill" && suggestion.RecurringPayment is not null)
                    {
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => IgnoreRecurringAsync(suggestion.RecurringPayment)">
                            Not a bill
                        </button>
                    }
                </div>
            }
        }
        else
        {
            <div style="font-size:13px;color:var(--text3)">No bill suggestions right now.</div>
        }
        @if (!string.IsNullOrEmpty(_billStatus))
        {
            <div style="font-size:12px;color:var(--green)">@_billStatus</div>
        }
        <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="ExportBillsCalendarAsync">
            Export 60-day bill calendar
        </button>
        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="ExportRecurringAsync">
            Export recurring audit CSV
        </button>
    </div>
}
</div>

@code {
    private string _tab = "Game";

    private bool _busy;
    private bool _showBillIntelStats;
    private string _syncStatus = string.Empty;
    private string _syncStatusColor = "var(--text3)";
    private string _cleanupStatus = string.Empty;
    private string _billStatus = string.Empty;
    private string _watchStatus = string.Empty;
    private string _modeStatus = string.Empty;
    private int _roundUpSweepGoalId;
    private string _freezeStatus = string.Empty;
    private string _freezeStatusColor = "var(--text3)";

    private async Task BuyStreakFreezeAsync()
    {
        var bought = await State.BuyStreakFreezeAsync();
        _freezeStatus = bought ? "Freeze purchased." : "Not enough XP yet.";
        _freezeStatusColor = bought ? "var(--green)" : "var(--amber)";
    }

    private int WeeklyChallengeProgressPercent =>
        State.WeeklyChallenge is null || State.WeeklyChallenge.TargetAmount <= 0
            ? 0
            : (int)Math.Clamp(State.WeeklyChallengeProgress / State.WeeklyChallenge.TargetAmount * 100m, 0m, 100m);

    private bool WeeklyChallengeOnTrack =>
        State.WeeklyChallenge is null || State.WeeklyChallengeProgress <= State.WeeklyChallenge.TargetAmount;

    private async Task ToggleRoundUpAsync(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        await State.SetRoundUpEnabledAsync(enabled, State.RoundUp.RoundToCents <= 0 ? 100 : State.RoundUp.RoundToCents);
    }

    private async Task ChangeRoundUpAmountAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var cents))
            await State.SetRoundUpEnabledAsync(true, cents);
    }

    private async Task SweepRoundUpAsync()
    {
        var goalId = _roundUpSweepGoalId != 0 ? _roundUpSweepGoalId : State.SavingsGoals.FirstOrDefault()?.Id ?? 0;
        if (goalId != 0) await State.SweepRoundUpToGoalAsync(goalId);
    }

    private async Task SyncNowAsync()
    {
        _busy = true;
        _syncStatus = "Syncing...";
        _syncStatusColor = "var(--text3)";
        try
        {
            await State.SyncAndReloadAsync();
            _syncStatus = "Sync complete.";
            _syncStatusColor = "var(--green)";
        }
        catch (Exception ex)
        {
            _syncStatus = $"Sync failed: {ex.Message}";
            _syncStatusColor = "var(--red)";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmRepairAsync()
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Clear stuck pending phone sync intents? Existing finance data stays on this device.");
        if (!ok) return;

        _busy = true;
        await State.RepairPendingSyncAsync();
        _busy = false;
        _syncStatus = "Pending queue cleared. Sync now to pull the latest cloud data.";
        _syncStatusColor = "var(--green)";
    }

    private async Task ForceUpdateAsync()
    {
        // Same as Settings' "Clear cache & reload" — duplicated here rather than
        // shared, since it's a one-shot JS eval with no state this page needs back.
        await JS.InvokeVoidAsync("eval", @"
            (async () => {
                if ('serviceWorker' in navigator) {
                    const regs = await navigator.serviceWorker.getRegistrations();
                    for (const r of regs) await r.unregister();
                }
                const cacheKeys = await caches.keys();
                for (const k of cacheKeys) await caches.delete(k);
                const appRoot = new URL('.', document.baseURI).href;
                window.location.replace(appRoot + '?refresh=' + Date.now());
            })()
        ");
    }

    private async Task ExportTripDebugLogAsync()
    {
        _busy = true;
        try
        {
            var text = string.Join("\n", State.TripDebugLog);
            await JS.InvokeVoidAsync("financeBlade.downloadFile", $"trip-debug-log-{DateTime.Now:yyyy-MM-dd-HHmmss}.txt", text, "text/plain");
            _syncStatus = "Trip debug log downloaded.";
            _syncStatusColor = "var(--green)";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportSavingsGoalDebugLogAsync()
    {
        _busy = true;
        try
        {
            var text = string.Join("\n", State.SavingsGoalDebugLog);
            await JS.InvokeVoidAsync("financeBlade.downloadFile", $"savings-goal-debug-log-{DateTime.Now:yyyy-MM-dd-HHmmss}.txt", text, "text/plain");
            _syncStatus = "Savings goal debug log downloaded.";
            _syncStatusColor = "var(--green)";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadSnapshotAsync()
    {
        _busy = true;
        try
        {
            var snapshot = BuildSnapshotText();
            await JS.InvokeVoidAsync("financeBlade.downloadFile", $"finora-snapshot-{DateTime.Today:yyyy-MM-dd}.txt", snapshot, "text/plain");
            _syncStatus = "Snapshot downloaded.";
            _syncStatusColor = "var(--green)";
        }
        finally
        {
            _busy = false;
        }
    }

    private string BuildSnapshotText()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Finora snapshot - {DateTime.Today:yyyy-MM-dd}");
        sb.AppendLine();
        sb.AppendLine($"Balance: {State.TotalBalance:C}");
        sb.AppendLine($"Safe to spend: {State.SafeToSpendAmount:C}");
        sb.AppendLine($"Next payday: {State.NextPayDate:dd MMM yyyy}");
        sb.AppendLine($"Bills before payday: {State.TotalBillsDue:C}");
        sb.AppendLine();

        var upcoming = State.GetUpcomingBills(5).ToList();
        sb.AppendLine("Upcoming bills");
        if (upcoming.Any())
        {
            foreach (var bill in upcoming)
                sb.AppendLine($"- {bill.EffectiveDueDate:dd MMM}: {bill.Name} {bill.AmountDollars:C}");
        }
        else
        {
            sb.AppendLine("- None due soon");
        }

        var signals = State.SmartSignals.Take(5).ToList();
        if (signals.Any())
        {
            sb.AppendLine();
            sb.AppendLine("Smart signals");
            foreach (var signal in signals)
                sb.AppendLine($"- {signal.Title}: {signal.Message}");
        }

        return sb.ToString();
    }

    private async Task ToggleNoSpendModeAsync()
    {
        _busy = true;
        await State.SetNoSpendModeAsync(!State.NoSpendMode);
        _busy = false;
        _modeStatus = State.NoSpendMode
            ? "No-spend mode is on. Dashboard will prioritize it."
            : "No-spend mode is off.";
    }

    private async Task ApplyCleanupAsync(TransactionCleanupSuggestion suggestion)
    {
        _busy = true;
        var count = await State.ApplyTransactionCleanupSuggestionAsync(suggestion);
        _busy = false;
        _cleanupStatus = $"Updated {count} transaction{(count == 1 ? "" : "s")}.";
    }

    private async Task IgnoreCleanupAsync(TransactionCleanupSuggestion suggestion)
    {
        _busy = true;
        await State.IgnoreTransactionCleanupSuggestionAsync(suggestion.Merchant);
        _busy = false;
        _cleanupStatus = $"{suggestion.Merchant} ignored for cleanup.";
    }

    private async Task ApplyBillSuggestionAsync(BillIntelligenceSuggestion suggestion)
    {
        if (suggestion.RecurringPayment is null) return;
        // PriceCreep is informational only (no single correct automated action — the
        // user has to decide whether to call and negotiate, switch provider, etc.) and
        // is routed to a "review in Bills" navigation button instead; never let it fall
        // through to CreateBillFromRecurringAsync, which would duplicate an existing bill.
        if (suggestion.Kind == "PriceCreep") return;

        _busy = true;
        var ok = suggestion.Kind == "AmountChanged" && suggestion.BillId is not null
            ? await State.UpdateBillAmountFromRecurringAsync(suggestion.BillId.Value, suggestion.RecurringPayment)
            : await State.CreateBillFromRecurringAsync(suggestion.RecurringPayment);
        _busy = false;
        _billStatus = ok ? "Bill updated." : "Could not apply that bill suggestion.";
    }

    private async Task IgnoreRecurringAsync(RecurringPayment recurring)
    {
        _busy = true;
        await State.IgnoreSubscriptionAsync(recurring.Name);
        _busy = false;
        _billStatus = $"{recurring.Name} will no longer appear as a bill suggestion.";
    }

    private async Task MarkMerchantUnnecessaryAsync(MerchantSpendWatchItem item)
    {
        _busy = true;
        var count = await State.MarkMerchantUnnecessaryAsync(item.Merchant);
        _busy = false;
        _watchStatus = $"Marked {count} transaction{(count == 1 ? "" : "s")} as unnecessary.";
    }

    private async Task ExportWatchlistAsync()
    {
        var rows = State.GetMerchantSpendWatchlist(30, 25);
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Merchant,Amount,UnnecessaryAmount,Count,LastSeen");
        foreach (var item in rows)
        {
            sb.AppendLine(string.Join(",",
                Csv(item.Merchant),
                item.Amount.ToString("0.00"),
                item.UnnecessaryAmount.ToString("0.00"),
                item.Count.ToString(),
                item.LastSeen.ToString("yyyy-MM-dd")));
        }
        await JS.InvokeVoidAsync("financeBlade.downloadFile", $"spending-watchlist-{DateTime.Today:yyyy-MM-dd}.csv", sb.ToString(), "text/csv");
        _watchStatus = "Watchlist exported.";
    }

    private async Task ExportBillsCalendarAsync()
    {
        var ics = BuildBillsIcs(State.GetUpcomingBills(60));
        await JS.InvokeVoidAsync("financeBlade.downloadFile", $"evergrove-bills-{DateTime.Today:yyyy-MM-dd}.ics", ics, "text/calendar");
        _billStatus = "Bill calendar exported.";
    }

    private async Task ExportRecurringAsync()
    {
        var rows = State.GetRecurringPayments();
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Name,Frequency,AverageAmount,WeeklyAmount,NextExpected,Account,Category,AlreadyBill");
        foreach (var item in rows)
        {
            sb.AppendLine(string.Join(",",
                Csv(item.Name),
                Csv(item.Frequency),
                item.AverageAmount.ToString("0.00"),
                item.WeeklyAmount.ToString("0.00"),
                item.NextExpected.ToString("yyyy-MM-dd"),
                Csv(item.AccountName),
                Csv(item.CategoryName),
                Csv(item.IsAlreadyBill ? "Yes" : "No")));
        }
        await JS.InvokeVoidAsync("financeBlade.downloadFile", $"recurring-audit-{DateTime.Today:yyyy-MM-dd}.csv", sb.ToString(), "text/csv");
        _billStatus = "Recurring audit exported.";
    }

    private static string BuildBillsIcs(IEnumerable<Bill> bills)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("BEGIN:VCALENDAR");
        sb.AppendLine("VERSION:2.0");
        sb.AppendLine("PRODID:-//Evergrove//Bills//EN");
        foreach (var bill in bills.OrderBy(b => b.EffectiveDueDate))
        {
            var date = bill.EffectiveDueDate.ToString("yyyyMMdd");
            sb.AppendLine("BEGIN:VEVENT");
            sb.AppendLine($"UID:evergrove-bill-{bill.Id}-{date}@evergrove");
            sb.AppendLine($"DTSTAMP:{DateTime.UtcNow:yyyyMMddTHHmmssZ}");
            sb.AppendLine($"DTSTART;VALUE=DATE:{date}");
            sb.AppendLine($"SUMMARY:{EscapeIcs($"Bill: {bill.Name} {bill.AmountDollars:C}")}");
            sb.AppendLine($"DESCRIPTION:{EscapeIcs($"{bill.Name} due from {bill.AccountName} for {bill.AmountDollars:C}")}");
            sb.AppendLine("END:VEVENT");
        }
        sb.AppendLine("END:VCALENDAR");
        return sb.ToString();
    }

    private static string EscapeIcs(string value) =>
        value.Replace("\\", "\\\\").Replace(";", "\\;").Replace(",", "\\,").Replace("\r", "").Replace("\n", "\\n");

    private static string Csv(string value)
    {
        var safe = value.Replace("\"", "\"\"");
        return $"\"{safe}\"";
    }
}
