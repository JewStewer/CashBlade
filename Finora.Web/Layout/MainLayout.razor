@inherits LayoutComponentBase
@inject AppState State
@inject NavigationManager Nav
@inject SyncService Sync
@inject UpBankWebSyncService UpSync
@inject IJSRuntime JS
@implements IDisposable

<div class="app-shell">
    <header class="app-header">
        <div class="logo">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="4.7" stroke="#10B981" stroke-opacity="0.35" stroke-width="0.56"/>
                <circle cx="8" cy="8" r="3.2" stroke="#10B981" stroke-opacity="0.65" stroke-width="0.56"/>
                <circle cx="8" cy="8" r="1.7" fill="#10B981"/>
            </svg>
        </div>
        <span class="title">Evergrove</span>
        @{
            var syncBadge = GetSyncBadge();
        }
        @if (syncBadge is not null)
        {
            <span class="badge @syncBadge.Value.Css badge-sync" style="font-size:10px">@syncBadge.Value.Text</span>
        }
    </header>

    <main class="page-content @PageAccentClass">
        @if (State.AppLockEnabled && !State.IsUnlocked)
        {
            <LockScreen />
        }
        else if (_initError is not null)
        {
            <div style="padding:16px">
                <div class="card" style="border-color:var(--red)">
                    <div style="font-size:14px;font-weight:600;color:var(--red);margin-bottom:6px">Startup error</div>
                    <div style="font-size:12px;color:var(--text2);word-break:break-all">@_initError</div>
                    <button class="btn btn-primary btn-sm" style="margin-top:10px" @onclick="Retry">Retry</button>
                </div>
            </div>
        }
        else
        {
            @Body
        }
    </main>

    <nav class="bottom-nav">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Home
        </NavLink>
        <NavLink class="nav-item" href="transactions">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                <line x1="8" y1="18" x2="21" y2="18"/>
                <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/>
                <line x1="3" y1="18" x2="3.01" y2="18"/>
            </svg>
            Txns
        </NavLink>
        <NavLink class="nav-item" href="bills">
            <div style="position:relative;display:inline-flex">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                @if (BillsDueSoonCount > 0)
                {
                    <span class="nav-badge">@BillsDueSoonCount</span>
                }
            </div>
            Bills
        </NavLink>
        <NavLink class="nav-item" href="budget">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            Budget
        </NavLink>
        <NavLink class="nav-item" href="accounts">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"/>
                <line x1="2" y1="10" x2="22" y2="10"/>
            </svg>
            Accounts
        </NavLink>
        <NavLink class="nav-item" href="tools">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="5" cy="12" r="1.6" fill="currentColor" stroke="none"/>
                <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>
                <circle cx="19" cy="12" r="1.6" fill="currentColor" stroke="none"/>
            </svg>
            More
        </NavLink>
    </nav>

    @if (IsTransactionsRoute || IsBillsRoute)
    {
        <button class="btn btn-primary fab" @onclick="OnFabClick">
            +
        </button>
    }
</div>

@if (_showAddTxn)
{
    <AddTransactionModal OnClose="() => _showAddTxn = false" OnSaved="() => _showAddTxn = false" />
}

@if (_showAddBill)
{
    <AddEditBillModal Bill="@((Bill?)null)" OnClose="() => _showAddBill = false" OnSaved="() => _showAddBill = false" />
}

@code {
    private string? _initError;
    private bool _isOffline;
    private PeriodicTimer? _syncTimer;
    private CancellationTokenSource? _syncCts;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private bool _nudgedAfterLoad;
    private bool _pendingNudge;
    private bool _pushSubscriptionChecked;
    private DateTime _lastUpBankSyncAttemptUtc = DateTime.MinValue;
    private DateTime _lastSafeSyncAttemptUtc = DateTime.MinValue;
    private bool _safeSyncInProgress;
    private bool _showAddTxn;
    private bool _showAddBill;

    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
    private bool IsTransactionsRoute => CurrentPath.Equals("transactions", StringComparison.OrdinalIgnoreCase);
    private bool IsBillsRoute => CurrentPath.Equals("bills", StringComparison.OrdinalIgnoreCase);

    private int BillsDueSoonCount => State.IsLoaded ? State.GetUpcomingBills(3).Count : 0;

    private string PageAccentClass => CurrentPath.ToLowerInvariant() switch
    {
        "budget" => "page-accent-budget",
        "bills" => "page-accent-bills",
        "accounts" => "page-accent-accounts",
        "tools" => "page-accent-tools",
        _ => ""
    };

    private void OnFabClick()
    {
        if (IsTransactionsRoute) _showAddTxn = true;
        else if (IsBillsRoute) _showAddBill = true;
    }

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
        Sync.OnSyncStateChanged += OnSyncStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    // State.OnChange fires for EVERY mutation, including ones made directly
    // by a tap (ticking a checkbox, saving a row) which already have a user
    // gesture in the call stack and repaint fine on their own. Don't nudge
    // here — nudgeRepaint's forced scrollTop snap-back fights any scroll the
    // user starts right after. Sync.OnSyncStateChanged (below) covers the
    // actual background-without-a-gesture case this workaround is for.
    private void OnStateChanged()
    {
        StateHasChanged();
    }

    private void OnSyncStateChanged()
    {
        _pendingNudge = true;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await State.LoadAsync();
            await InvokeAsync(StateHasChanged);
            await NotifySmartInsightsAsync();
            await NotifyUpcomingBillsAsync();
            await EnsurePushSubscriptionAsync();
            StartBackgroundSync();
        }
        catch (Exception ex)
        {
            _initError = ex.Message;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("financeBlade.appStarted"); }
            catch { }
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("financeBlade.registerOnVisible", _dotNetRef);
            }
            catch { }
            try { _isOffline = !(await JS.InvokeAsync<bool>("financeBlade.getOnlineStatus")); } catch { }
            try { await JS.InvokeVoidAsync("financeBlade.listenNetworkStatus", _dotNetRef); } catch { }
            try { await JS.InvokeVoidAsync("financeBlade.setupPullToRefresh", _dotNetRef); } catch { }
            try { await JS.InvokeVoidAsync("financeBlade.enableSwipeDismiss"); } catch { }
        }

        // The render that switches the dashboard from its loading spinner to
        // real content happens with no user gesture in the call stack, which
        // WKWebView on iOS can fail to paint until the user taps the screen.
        // Nudge a reflow ourselves so a cold launch doesn't look stuck.
        if (State.IsLoaded && !_nudgedAfterLoad)
        {
            _nudgedAfterLoad = true;
            _pendingNudge = false;
            try { await JS.InvokeVoidAsync("financeBlade.nudgeRepaint"); }
            catch { }
        }
        else if (_pendingNudge)
        {
            _pendingNudge = false;
            try { await JS.InvokeVoidAsync("financeBlade.nudgeRepaint"); }
            catch { }
        }
    }

    [JSInvokable]
    public void OnNetworkStatusChanged(bool isOnline)
    {
        _isOffline = !isOnline;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task TriggerPullRefreshAsync()
    {
        _lastSafeSyncAttemptUtc = DateTime.MinValue;
        await SafeSyncAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnBrowserVisible()
    {
        // iOS may have suspended the app mid-sync, leaving _syncInProgress=true.
        // Reset it so the resume sync isn't silently blocked by the guard.
        State.ForceResetSyncGuard();
        // Bypass the 20-second cooldown so the foreground resume always syncs.
        _lastSafeSyncAttemptUtc = DateTime.MinValue;
        await SafeSyncAsync();
        await NotifySmartInsightsAsync();
        await EnsurePushSubscriptionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Retry()
    {
        _initError = null;
        try
        {
            await State.LoadAsync();
            await InvokeAsync(StateHasChanged);
            await NotifySmartInsightsAsync();
            await NotifyUpcomingBillsAsync();
            await EnsurePushSubscriptionAsync();
            StartBackgroundSync();
        }
        catch (Exception ex) { _initError = ex.Message; }
    }

    // Pull the latest data on open, then keep refreshing in the background —
    // so the app stays current without a manual "Sync Now" or the PC running.
    private void StartBackgroundSync()
    {
        if (_syncTimer is not null) return;

        _ = SafeSyncAsync();

        _syncCts = new CancellationTokenSource();
        _syncTimer = new PeriodicTimer(TimeSpan.FromMinutes(5));
        _ = RunPeriodicSyncAsync(_syncTimer, _syncCts.Token);
    }

    private async Task RunPeriodicSyncAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
                await SafeSyncAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task SafeSyncAsync()
    {
        if (_safeSyncInProgress) return;
        if ((DateTime.UtcNow - _lastSafeSyncAttemptUtc).TotalSeconds < 20) return;

        _safeSyncInProgress = true;
        _lastSafeSyncAttemptUtc = DateTime.UtcNow;
        try
        {
            var upSynced = await SafeUpBankSyncAsync();
            if (Sync.HasCloudSync || Sync.HasLocalSync)
            {
                await State.SyncAndReloadAsync();
            }
            else if (upSynced)
            {
                await State.LoadAsync();
            }
            await NotifySmartInsightsAsync();
            await NotifyUpcomingBillsAsync();
            await EnsurePushSubscriptionAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { /* SyncService records LastError for the Settings page; nothing to do here */ }
        finally
        {
            _safeSyncInProgress = false;
        }
    }

    private async Task<bool> SafeUpBankSyncAsync()
    {
        if (UpSync.IsSyncing) return false;
        if ((DateTime.UtcNow - _lastUpBankSyncAttemptUtc).TotalMinutes < 2) return false;

        string token;
        try { token = await UpSync.GetAccessTokenAsync(); }
        catch { return false; }

        if (string.IsNullOrWhiteSpace(token)) return false;

        _lastUpBankSyncAttemptUtc = DateTime.UtcNow;
        try
        {
            var result = await UpSync.SyncAsync();
            return result is not null;
        }
        catch { return false; }
    }

    private (string Text, string Css)? GetSyncBadge()
    {
        if (_isOffline) return ("offline", "badge-red");
        if (State.IsSyncing || UpSync.IsSyncing) return ("syncing", "badge-teal");
        if (State.HasPendingChanges || State.HasUnconfirmedSettingOverrides) return ("unsync'd", "badge-amber");
        if (Sync.LastSyncedAt is not null) return ("synced", "badge-green");
        return null;
    }

    private async Task NotifySmartInsightsAsync()
    {
        if (!State.IsLoaded) return;

        try
        {
            var permission = await JS.InvokeAsync<string>("pushNotifications.getPermission");
            if (permission != "granted") return;

            var insight = State.SmartSignals.FirstOrDefault();
            if (insight is null) return;

            var key = "smart-" + insight.Key;
            var alreadyShown = await JS.InvokeAsync<bool>("pushNotifications.wasLocalNotificationShown", key);
            if (alreadyShown) return;

            await JS.InvokeAsync<bool>("pushNotifications.showLocal", insight.Title, insight.Message, key);
            await JS.InvokeVoidAsync("pushNotifications.markLocalNotificationShown", key);
        }
        catch { }
    }

    // Local-permission counterpart to the GitHub Actions bill-reminder cron (which only
    // reaches devices that completed the heavier VAPID cloud-push subscribe flow). Each bill
    // occurrence notifies once via its own dedup key, then bundles into a single notification
    // so several bills entering the window at once don't fire separately.
    private async Task NotifyUpcomingBillsAsync()
    {
        if (!State.IsLoaded) return;

        try
        {
            var permission = await JS.InvokeAsync<string>("pushNotifications.getPermission");
            if (permission != "granted") return;

            var upcoming = State.GetUpcomingBills(3);
            if (!upcoming.Any()) return;

            var unnotified = new List<Bill>();
            foreach (var bill in upcoming)
            {
                var key = $"bill-due-{bill.Id}-{bill.EffectiveDueDate:yyyyMMdd}";
                var alreadyShown = await JS.InvokeAsync<bool>("pushNotifications.wasLocalNotificationShown", key);
                if (!alreadyShown) unnotified.Add(bill);
            }
            if (!unnotified.Any()) return;

            var billList = string.Join(", ", unnotified.Select(b =>
            {
                var days = (b.EffectiveDueDate.Date - DateTime.Today).Days;
                var when = days <= 0 ? "today" : days == 1 ? "tomorrow" : $"in {days} days";
                return $"{b.Name} ({when})";
            }));

            await JS.InvokeAsync<bool>("pushNotifications.showLocal", "Bills due soon", billList, "bill-reminder");

            foreach (var bill in unnotified)
            {
                var key = $"bill-due-{bill.Id}-{bill.EffectiveDueDate:yyyyMMdd}";
                await JS.InvokeVoidAsync("pushNotifications.markLocalNotificationShown", key);
            }
        }
        catch { }
    }

    private async Task EnsurePushSubscriptionAsync()
    {
        if (_pushSubscriptionChecked || !Sync.HasCloudSync) return;
        _pushSubscriptionChecked = true;

        try
        {
            var permission = await JS.InvokeAsync<string>("pushNotifications.getPermission");
            if (permission != "granted") return;

            var subJson = await JS.InvokeAsync<string?>("pushNotifications.getSubscription");
            if (string.IsNullOrEmpty(subJson))
            {
                subJson = await JS.InvokeAsync<string?>("pushNotifications.subscribe", State.VapidPublicKey);
            }

            if (!string.IsNullOrEmpty(subJson))
            {
                await Sync.SavePushSubscriptionAsync(subJson);
            }
        }
        catch { }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await InvokeAsync(StateHasChanged);
        try { await JS.InvokeVoidAsync("financeBlade.scrollPageToTop"); }
        catch { }
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        Sync.OnSyncStateChanged -= OnSyncStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _syncCts?.Cancel();
        _syncCts?.Dispose();
        _syncTimer?.Dispose();
        _dotNetRef?.Dispose();
    }
}
