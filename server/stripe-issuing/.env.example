# Stripe secret key (test mode: starts with sk_test_). Never commit the real value.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# From the Stripe Dashboard webhook endpoint you create pointing at /api/webhook.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Origin allowed to call this API (your deployed Evergrove URL). Use * only while testing locally.
ALLOWED_ORIGIN=*

# Only used by server.js (Express) — ignored on Vercel.
PORT=4242
