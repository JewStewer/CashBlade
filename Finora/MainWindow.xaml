<Window x:Class="Finora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Finora.Converters"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Finance Blade"
        Height="800"
        Width="1280"
        MinHeight="620"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/financeblade-app.ico"
        Background="#0E1116">

    <Window.Resources>
        <converters:AmountToBrushConverter x:Key="AmountToBrushConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ShareToGridLengthConverter x:Key="ShareToGridLengthConverter"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="BorderBrush" Value="#52525B"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="RowBackground" Value="#111827"/>
            <Setter Property="AlternatingRowBackground" Value="#0B1120"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="VerticalGridLinesBrush" Value="#334155"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="MinHeight" Value="40"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#0B1120"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="WrappingCellText">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="RightAlignedCellText" BasedOn="{StaticResource WrappingCellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="8,0,14,0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#0F766E"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#172033"/>
                    <Setter Property="BorderBrush" Value="#0F766E"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="Both"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#F8FAFC"/>
            <Setter Property="SelectionBrush" Value="#2563EB"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0D9488"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                                                  RecognizesAccessKey="True"/>
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      Fill="#94A3B8"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Stretch="Fill"
                                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#0D9488"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#14B8A6"/>
                                                <Setter TargetName="Chrome" Property="Background" Value="#0F172A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#161B22"
                                            BorderBrush="#14B8A6"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,4,0,0">
                                        <ScrollViewer CanContentScroll="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CaretBrush" Value="#F8FAFC"/>
            <Setter Property="SelectionBrush" Value="#2563EB"/>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#0F766E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="12,7"
                                Margin="0,0,4,0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0F766E"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#14B8A6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#243244"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0F766E"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#0F766E"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#14B8A6"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#111827"/>
                                <Setter Property="Foreground" Value="#FAFAF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0D9488"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#134E4A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0D9488"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="148"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nav Rail -->
        <Border Grid.Column="0" Background="#080A12">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="14,22,14,18" BorderBrush="#1F2A44" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="FB" FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                        <TextBlock Text="Finance Blade" FontSize="9" Foreground="#7DD3FC" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="8,4,8,0">
                <StackPanel>
                    <Button Content="Dashboard" Click="NavDashboard_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDashboardSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Transactions" Click="NavTransactions_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransactionsSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Categories" Click="NavCategories_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCategoriesSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Insights" Click="NavPlanning_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlanningHomeSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="Plan" Foreground="#6E7681" FontSize="10" FontWeight="SemiBold" Margin="18,16,0,6"/>
                    <Button Content="Bills" Click="NavBills_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBillsSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Budget" Click="NavBudget_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBudgetSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Debts" Click="NavDebts_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDebtsSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Goals" Click="NavGoals_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGoalsSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="Review" Foreground="#6E7681" FontSize="10" FontWeight="SemiBold" Margin="18,16,0,6"/>
                    <Button Content="Subscriptions" Click="NavSubscriptions_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSubscriptionsSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Calendar" Click="NavCalendar_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalendarSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Reports" Click="NavReports_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReportsSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Tools" Click="NavTools_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToolsSection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Daily" Click="NavDaily_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDailySection}" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Visibility="Collapsed">
                    <TextBlock Text="At a glance"
                               Foreground="#A8A29E"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="8,20,0,8"/>
                    <Border Padding="14" Margin="0,0,0,8" Background="#1C1917" BorderBrush="#3B332B" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Safe today" Foreground="#A8A29E" FontSize="11"/>
                            <TextBlock Text="{Binding SafeToSpendAmount, StringFormat={}{0:C}}" Foreground="#FAFAF9" FontSize="21" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="14" Margin="0,0,0,8" Background="#1C1917" BorderBrush="#3B332B" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Next payday" Foreground="#A8A29E" FontSize="11"/>
                            <TextBlock Text="{Binding DaysUntilPaydayDisplay}" Foreground="#86EFAC" FontSize="21" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="14" Margin="0,0,0,8" Background="#1C1917" BorderBrush="#3B332B" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Funding gap" Foreground="#A8A29E" FontSize="11"/>
                            <TextBlock Text="{Binding BillsFundingShortfall, StringFormat={}{0:C}}" Foreground="#FDBA74" FontSize="21" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="14" Background="#1C1917" BorderBrush="#3B332B" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Forecast low" Foreground="#A8A29E" FontSize="11"/>
                            <TextBlock Text="{Binding ForecastLowPointSummary}" TextWrapping="Wrap" Foreground="#BAE6FD" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
                <FrameworkElement/>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="All" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Click="All_Click"/>
                        <Button Content="Weekly" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Click="Weekly_Click"/>
                        <Button Content="Monthly" Style="{StaticResource SmallButton}" Click="Monthly_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#x276E;" Style="{StaticResource SmallButton}" Width="36" Margin="0,0,4,0" ToolTip="Previous period" Click="PreviousWeek_Click"/>
                        <Button Content="Now" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Click="CurrentWeek_Click"/>
                        <Button Content="&#x276F;" Style="{StaticResource SmallButton}" Width="36" ToolTip="Next period" Click="NextWeek_Click"/>
                    </StackPanel>
                    <Border Grid.Column="4" Background="#111827" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SummaryPeriod}" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SummaryDateRange}" Foreground="#E5E7EB" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Payday" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="NextPaydayPicker" Width="140" Height="32" SelectedDateChanged="NextPaydayPicker_SelectedDateChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ Transaction" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" FontSize="12" Margin="0,0,6,0" Click="AddTransaction_Click"/>
                        <Button Content="Transfer" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" FontSize="12" Margin="0,0,6,0" Click="Transfer_Click"/>
                        <Button x:Name="MoreActionsButton" Content="&#x2022;&#x2022;&#x2022; More" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" FontSize="12" Click="MoreActions_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New account" Click="AddAccount_Click"/>
                                    <MenuItem Header="Up API settings" Click="UpBankSettings_Click"/>
                                    <MenuItem Header="Sync Up Bank" Click="SyncUpBank_Click"/>
                                    <MenuItem Header="Export statement..." Click="ExportStatement_Click"/>
                                    <MenuItem Header="Diagnostics" Click="Diagnostics_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DASHBOARD SECTION -->
            <ScrollViewer Grid.Row="1"
                          Visibility="{Binding IsDashboardSection, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#0D1117">
                <Grid Margin="24,20,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hero card -->
                    <Border Padding="28,24"
                            Background="#161B22"
                            BorderBrush="#30363D"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CommandCenterStatus}"
                                           Foreground="{Binding CommandCenterStatusColorHex, Converter={StaticResource HexToBrushConverter}}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="Today's money desk"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="#E6EDF3"/>
                                <TextBlock Text="{Binding CommandCenterPrimaryMove}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="#8B949E"
                                           Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding BudgetPressureMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="#6E7681"
                                           Margin="0,5,0,0"/>
                                <Button Content="{Binding CommandCenterNavLabel}"
                                        Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"
                                        Tag="{Binding CommandCenterNavTarget}"
                                        Click="GoToNavTarget_Click"
                                        Visibility="{Binding HasCommandCenterAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <!-- Vertical divider -->
                            <Rectangle Grid.Column="1" Width="1" Fill="#30363D" Margin="28,0"/>
                            <!-- Stats: no nested boxes, just clean stat blocks -->
                            <UniformGrid Grid.Column="2" Columns="2" Rows="2">
                                <StackPanel Margin="14,10">
                                    <TextBlock Text="BALANCE" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                    <TextBlock Text="{Binding TotalBalance, StringFormat={}{0:C}}" FontSize="26" FontWeight="Bold" Foreground="#3FB950" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="14,10">
                                    <TextBlock Text="SAFE NOW" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                    <TextBlock Text="{Binding SafeToSpendAmount, StringFormat={}{0:C}}" FontSize="26" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="14,10">
                                    <TextBlock Text="PAYDAY" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                    <TextBlock Text="{Binding DaysUntilPaydayDisplay}" FontSize="26" FontWeight="Bold" Foreground="#58A6FF" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="14,10">
                                    <TextBlock Text="DEBT LEFT" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                    <TextBlock Text="{Binding DebtTotal, StringFormat={}{0:C}}" FontSize="26" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,5,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Metric strip: one card, dividers between sections -->
                    <Border Grid.Row="6" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="18,14">
                                <TextBlock Text="FORECAST" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                <TextBlock Text="{Binding ForecastLowPointSummary}" TextWrapping="Wrap" FontWeight="Bold" FontSize="14" Foreground="#E6EDF3" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ForecastEventSummary}" TextWrapping="Wrap" FontSize="12" Foreground="#6E7681" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Fill="#30363D"/>
                            <StackPanel Grid.Column="2" Margin="18,14">
                                <TextBlock Text="BILLS" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                <TextBlock Text="{Binding BillsFundingShortfall, StringFormat=Needs {0:C}}" FontWeight="Bold" FontSize="14" Foreground="#F0883E" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding BillsDueOnPayday, StringFormat=Payday bills {0:C}}" FontSize="12" Foreground="#6E7681" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Fill="#30363D"/>
                            <StackPanel Grid.Column="4" Margin="18,14">
                                <TextBlock Text="SUBSCRIPTIONS" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                <TextBlock Text="{Binding SubscriptionCommandSummary}" TextWrapping="Wrap" FontWeight="Bold" FontSize="14" Foreground="#E6EDF3" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding SubscriptionsNotInBillsCount, StringFormat={}{0} not in bills}" FontSize="12" Foreground="#6E7681" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="5" Fill="#30363D"/>
                            <StackPanel Grid.Column="6" Margin="18,14">
                                <TextBlock Text="GOALS" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                <TextBlock Text="{Binding GoalCommandSummary}" TextWrapping="Wrap" FontWeight="Bold" FontSize="14" Foreground="#E6EDF3" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding AccountCoverageSummary}" TextWrapping="Wrap" FontSize="12" Foreground="#6E7681" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bottom 3-col: better proportions, no nested boxes on list items -->
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Recommended actions -->
                        <Border Padding="20,18" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,14"/>
                                <ItemsControl ItemsSource="{Binding DangerAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" RadiusX="1.5" RadiusY="1.5"/>
                                                <StackPanel Grid.Column="2" Margin="0,10,0,10">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Rectangle Grid.Column="0" Grid.ColumnSpan="3" Height="1" Fill="#21262D" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Bill queue -->
                        <Border Grid.Column="2" Padding="20,18" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BILL QUEUE" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BillsDueNext7Days.Count, StringFormat={}{0} due soon}" FontSize="11" Foreground="#6E7681"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding BillsDueNext7Days}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" RadiusX="1.5" RadiusY="1.5"/>
                                                <StackPanel Grid.Column="2" Margin="0,11,0,11">
                                                    <TextBlock Text="{Binding DisplayLine}" Foreground="#E6EDF3" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding AccountName}" Foreground="#6E7681" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat={}{0:C}}" Foreground="#F0883E" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                <Rectangle Grid.Column="0" Grid.ColumnSpan="4" Height="1" Fill="#21262D" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Watchlist -->
                        <Border Grid.Column="4" Padding="20,18" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="WATCHLIST" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,14"/>
                                <StackPanel Margin="0,0,0,0">
                                    <TextBlock Text="CASH RUNWAY" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                    <TextBlock Text="{Binding CashRunwaySummary}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding CashRunwayExplanation}" TextWrapping="Wrap" FontSize="11" Foreground="#8B949E" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Rectangle Height="1" Fill="#30363D" Margin="0,14"/>
                                <StackPanel>
                                    <TextBlock Text="UPCOMING SQUEEZE" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                    <TextBlock Text="{Binding UpcomingSqueezeSummary}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding UpcomingSqueezeExplanation}" TextWrapping="Wrap" FontSize="11" Foreground="#8B949E" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Cash position before payday -->
                    <Border Grid.Row="4"
                            Padding="20,18"
                            Background="#161B22"
                            BorderBrush="#30363D"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="CASH BEFORE PAYDAY" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>

                            <!-- Column headers -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Account" FontSize="10" Foreground="#6E7681"/>
                                <TextBlock Grid.Column="1" Text="Balance" FontSize="10" Foreground="#6E7681" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="Bills due" FontSize="10" Foreground="#6E7681" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Net" FontSize="10" Foreground="#6E7681" HorizontalAlignment="Right"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#30363D" Margin="0,0,0,6"/>

                            <!-- Per-account rows (bills = before + on payday, matches account cards) -->
                            <ItemsControl ItemsSource="{Binding BillFundingPlanRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SaverName}" Foreground="#8B949E" FontSize="13"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentBalance, StringFormat={}{0:C}}" Foreground="#E6EDF3" FontSize="13" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DueThroughPaydayDisplay}" Foreground="#F87171" FontSize="13" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding BalanceAfterBills, StringFormat={}{0:C}}"
                                                       Foreground="{Binding BalanceAfterBillsColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                       FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle Height="1" Fill="#30363D" Margin="0,8"/>

                            <!-- Total row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="After bills, before pay" Foreground="#E6EDF3" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalBalance, StringFormat={}{0:C}}" Foreground="#E6EDF3" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Foreground="#F87171" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding BillsDueThroughPayday, StringFormat=-{0:C}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BillsDueThroughPayday}" Value="0">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding BalanceAfterAllBills, StringFormat={}{0:C}}"
                                           Foreground="{Binding BalanceAfterAllBillsColorHex, Converter={StaticResource HexToBrushConverter}}"
                                           FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Payday income -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Payday income" Foreground="#8B949E" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding WeeklyIncome, StringFormat=+{0:C}}" Foreground="#34D399" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#30363D" Margin="0,6,0,8"/>

                            <!-- After payday -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="After payday" Foreground="#E6EDF3" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding BalanceAfterAllBillsPlusIncome, StringFormat={}{0:C}}" Foreground="#3FB950" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Negative alert (only when committed bills exceed current balance) -->
                            <Border Margin="0,14,0,0"
                                    Padding="14,10"
                                    CornerRadius="8"
                                    Background="#1C0A0A"
                                    Visibility="{Binding BalanceAfterAllBillsNegative, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="BILLS EXCEED CURRENT BALANCE" FontSize="10" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding BillsFundingShortfall, StringFormat=Move {0:C} to bill accounts now to avoid overdraft.}"
                                               TextWrapping="Wrap" Foreground="#F59E0B" FontSize="12" FontWeight="SemiBold"
                                               Visibility="{Binding HasBillsFundingShortfall, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="6" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Padding="18" Background="#0F172A" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Funding board" FontSize="18" FontWeight="Bold" Foreground="#FAFAF9"/>
                                    <ComboBox Grid.Column="1"
                                              Width="138"
                                              ItemsSource="{Binding ForecastRangeOptions}"
                                              SelectedItem="{Binding ForecastRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <UniformGrid Grid.Row="2" Columns="3">
                                    <Border Padding="14" Margin="0,0,10,0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Lowest balance" Foreground="#A8A29E" FontSize="11"/>
                                            <TextBlock Text="{Binding ForecastLowPointSummary}" TextWrapping="Wrap" Foreground="#BAE6FD" FontSize="16" FontWeight="Bold" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="14" Margin="0,0,10,0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Needs before payday" Foreground="#A8A29E" FontSize="11"/>
                                            <TextBlock Text="{Binding BillsFundingShortfall, StringFormat={}{0:C}}" Foreground="#FACC15" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="14" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Planned transfers" Foreground="#A8A29E" FontSize="11"/>
                                            <TextBlock Text="{Binding BudgetPlannerWeeklyTransfers, StringFormat={}{0:C}/wk}" Foreground="#86EFAC" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock Grid.Row="4"
                                           Text="{Binding PaydayTransferPlanExplanation}"
                                           TextWrapping="Wrap"
                                           Foreground="#D6D3D1"/>
                                <ItemsControl Grid.Row="6" ItemsSource="{Binding CashForecastChartRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,5,0" ToolTip="{Binding ProjectedBalanceDisplay}">
                                                <Border Height="92" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                                    <ProgressBar Minimum="0"
                                                                 Maximum="1"
                                                                 Value="{Binding Share}"
                                                                 Height="14"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Bottom"
                                                                 Margin="8"
                                                                 Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                 Background="#161B22"/>
                                                </Border>
                                                <TextBlock Text="{Binding Label}" TextAlignment="Center" FontSize="10" Foreground="#8B949E" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Padding="18" Background="#0A1322" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Recommended actions" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding DangerAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" Margin="0,0,0,8" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="2"/>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Padding="18" Background="#0A1322" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bill queue" FontSize="18" FontWeight="Bold" Foreground="#E6EDF3"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BillsDueNext7Days.Count, StringFormat={}{0} due soon}" Foreground="#8B949E"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding BillsDueNext7Days}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" Margin="0,0,0,7" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="2"/>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding DisplayLine}" Foreground="#E6EDF3" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding AccountName}" Foreground="#6E7681" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat={}{0:C}}" Foreground="#F0883E" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Padding="18" Background="#0A1322" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Debt focus" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,12"/>
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <Border Padding="12" Margin="0,0,8,0" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="Progress" Foreground="#6E7681" FontSize="11"/>
                                            <TextBlock Text="{Binding DebtProgressPercent, StringFormat={}{0:P0}}" Foreground="#3FB950" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="Best move" Foreground="#6E7681" FontSize="11"/>
                                            <TextBlock Text="{Binding BestDebtStrategyTitle}" TextWrapping="Wrap" Foreground="#F0883E" FontWeight="Bold" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock Text="{Binding BestDebtStrategySummary}" TextWrapping="Wrap" Foreground="#8B949E"/>
                                <TextBlock Text="{Binding DebtFreeTargetExtraSummary}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Accounts panel -->
                    <Border Grid.Row="2" Padding="20,18" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ACCOUNTS" FontSize="10" FontWeight="SemiBold" Foreground="#6E7681"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalBalance, StringFormat=Total {0:C}}" FontSize="11" Foreground="#6E7681"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Accounts}" MouseDoubleClick="DashboardAccountCard_MouseDoubleClick">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,10" Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="8,0,0,8"/>
                                                <StackPanel Grid.Column="1" Margin="12,12,14,12">
                                                    <!-- Name + Balance -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#E6EDF3" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Balance, StringFormat={}{0:C}}" FontSize="17" FontWeight="Bold" Foreground="{Binding Balance, Converter={StaticResource AmountToBrushConverter}}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <!-- Bills row (hidden when no bills) -->
                                                    <Grid Margin="0,7,0,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BillsDueDisplay}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding BillsDueDisplay}" FontSize="11" Foreground="#6E7681"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding BillsCoverageDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RemainingAfterBillsColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                    </Grid>
                                                    <!-- Next upcoming bill (hidden when none before payday) -->
                                                    <TextBlock Text="{Binding NextUpcomingBillDisplay}"
                                                               FontSize="11" Foreground="#6E7681"
                                                               Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NextUpcomingBillDisplay}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Goal progress (hidden when no target) -->
                                                    <StackPanel Margin="0,8,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Target}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ProgressBar Value="{Binding TargetProgress, Mode=OneWay}" Minimum="0" Maximum="1" Height="5" Foreground="#58A6FF" Background="#21262D" VerticalAlignment="Center"/>
                                                            <!-- Progress % + target amount -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TargetProgress, StringFormat={}{0:P0}}" FontSize="11" FontWeight="SemiBold" Foreground="#58A6FF"/>
                                                                <TextBlock Text="{Binding TargetAmountLabel}" FontSize="11" Foreground="#6E7681" Margin="4,0,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding TargetCountdownSummary}" FontSize="11" Foreground="#8B949E" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <!-- Type label (shown only when no bills and no goal) -->
                                                    <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#6E7681" Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BillsDueDisplay}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Columns="2">
                            <Border Padding="18" Margin="0,0,9,0" Background="#0A1322" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Cash runway" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding CashRunwaySummary}" TextWrapping="Wrap" Foreground="#8B949E"/>
                                    <TextBlock Text="{Binding CashRunwayExplanation}" TextWrapping="Wrap" Foreground="#6E7681" FontSize="11" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding PeriodSpending, StringFormat=Period spending {0:C}}" Foreground="#8B949E" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="18" Margin="9,0,0,0" Background="#0A1322" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Upcoming squeeze" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding UpcomingSqueezeSummary}" TextWrapping="Wrap" Foreground="#8B949E"/>
                                    <TextBlock Text="{Binding UpcomingSqueezeExplanation}" TextWrapping="Wrap" Foreground="#6E7681" FontSize="11" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding ForecastEventSummary}" Foreground="#8B949E" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Grid.Row="2" Columns="3">
                            <Border Padding="18" Margin="0,0,10,0" Background="#0F172A" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Payday checklist" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding PaydayChecklistRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="11" Margin="0,0,0,7" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#BAE6FD"/>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                        <Button Content="{Binding NavLabel}"
                                                                Style="{StaticResource SmallButton}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,8,0,0"
                                                                Tag="{Binding NavTarget}"
                                                                Click="GoToNavTarget_Click"
                                                                Visibility="{Binding HasNavTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Padding="18" Margin="0,0,10,0" Background="#0F172A" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Spending leaks" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding SpendingLeakRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="11" Margin="0,0,0,7" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#F0883E"/>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Padding="18" Background="#0F172A" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Subscriptions cleanup" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding SubscriptionCleanupRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="11" Margin="0,0,0,7" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Grid.Row="4" Columns="3">
                            <Border Padding="18" Margin="0,14,10,0" Background="#0F172A" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Goal momentum" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding GoalMomentumRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="11" Margin="0,0,0,7" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#86EFAC"/>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Padding="18" Margin="0,14,10,0" Background="#0F172A" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Account health" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding AccountHealthRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="11" Margin="0,0,0,7" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#BAE6FD"/>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Padding="18" Margin="0,14,0,0" Background="#0F172A" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Debt accelerator" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding DebtAcceleratorRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="11" Margin="0,0,0,7" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#F0883E"/>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" MinWidth="340" MaxWidth="580"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

                <Border CornerRadius="8"
                        Background="#0D1117"
                        BorderBrush="#1E2D42"
                        BorderThickness="1"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Total balance hero -->
                        <Border Padding="16,14,16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Total Balance" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding TotalBalance, StringFormat={}{0:C}}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#3FB950"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding BillsBalance, StringFormat=Bills: {0:C}}"
                                               Foreground="#6E7681"
                                               FontSize="11"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Period stats strip -->
                        <Border Height="1" Background="#30363D"/>
                        <UniformGrid Rows="1" Columns="4">
                            <Border Padding="12,10" BorderBrush="#1E2D42" BorderThickness="0,0,1,0">
                                <StackPanel>
                                    <TextBlock Text="Spending" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding PeriodSpending, StringFormat={}{0:C}}" FontSize="13" FontWeight="Bold" Foreground="#F87171" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="12,10" BorderBrush="#1E2D42" BorderThickness="0,0,1,0">
                                <StackPanel>
                                    <TextBlock Text="Income" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding PeriodIncome, StringFormat={}{0:C}}" FontSize="13" FontWeight="Bold" Foreground="#3FB950" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="12,10" BorderBrush="#1E2D42" BorderThickness="0,0,1,0">
                                <StackPanel>
                                    <TextBlock Text="Bills owed" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding BillsOwedTotal, StringFormat={}{0:C}}" FontSize="13" FontWeight="Bold" Foreground="#8B949E" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Net flow" Foreground="#6E7681" FontSize="11"/>
                                    <TextBlock Text="{Binding PeriodNetCashFlow, StringFormat={}{0:C}}" FontSize="13" FontWeight="Bold" Foreground="{Binding PeriodNetCashFlow, Converter={StaticResource AmountToBrushConverter}}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,0,0,0"
                        Background="#0C1525"
                        BorderBrush="#1E2D42"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Accounts"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F1F5F9"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Edit"
                                Style="{StaticResource SmallButton}"
                                Click="EditAccount_Click"/>
                        <Button Grid.Column="3"
                                Content="+ Budget"
                                Style="{StaticResource SmallButton}"
                                Click="AddAccountTargetToBudget_Click"/>
                        <Button Grid.Column="5"
                                Content="Delete"
                                Style="{StaticResource SmallButton}"
                                Background="#991B1B"
                                Click="DeleteAccount_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding AccountSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"
                                 ToolTip="Search accounts"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding AccountSortOptions}"
                                  SelectedItem="{Binding AccountSortOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Height="30"/>
                    </Grid>
                    <ListView x:Name="AccountsList"
                              Grid.Row="2"
                              ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount}"
                              SelectionMode="Extended"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="AccountsList_PreviewMouseWheel"
                              KeyDown="AccountsList_KeyDown"
                              MouseDoubleClick="AccountsList_MouseDoubleClick"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3"
                                        Padding="0"
                                        Background="#0C1525"
                                        BorderBrush="#1E2D42"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border CornerRadius="8,0,0,8"
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>

                                        <StackPanel Grid.Column="1" Margin="14,12,14,12">

                                            <!-- Row 0: Name + Balance -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F1F5F9"/>
                                                    <TextBlock Text="{Binding Type}"
                                                               FontSize="11"
                                                               Foreground="#6E7681"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Balance, StringFormat={}{0:C}}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Balance, Converter={StaticResource AmountToBrushConverter}}"/>
                                            </Grid>

                                            <!-- Divider -->
                                            <Border Height="1" Background="#30363D" Margin="0,10,0,10"/>

                                            <!-- Row 1: Needed now status -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NeededNowStatus}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding NeededNowColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding NeededNow, StringFormat={}{0:C}}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding NeededNowColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                            </Grid>

                                            <!-- Row 2: After-bills summary (collapsed if empty) -->
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Text="{Binding RemainingAfterBillsSummary}"
                                                       Foreground="{Binding RemainingAfterBillsColorHex, Converter={StaticResource HexToBrushConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RemainingAfterBillsSummary}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Row 3: Target info (collapsed if no target) -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Target}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TargetPaceSummary}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding TargetPaceColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding TargetCountdownSummary}"
                                                               FontSize="11"
                                                               Foreground="#6E7681"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding TargetAmountDisplay}"
                                                               HorizontalAlignment="Right"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#E6EDF3"/>
                                                    <TextBlock Text="{Binding TargetDateDisplay}"
                                                               HorizontalAlignment="Right"
                                                               FontSize="11"
                                                               Foreground="#6E7681"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Progress bar (collapsed if no target) -->
                                            <ProgressBar Height="4"
                                                         Minimum="0"
                                                         Maximum="1"
                                                         Value="{Binding TargetProgress, Mode=OneWay}"
                                                         Foreground="#0D9488"
                                                         Background="#1E2D42"
                                                         Margin="0,8,0,0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Target}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
                </Border>

            <Border Grid.Row="2"
                    Margin="0,12,4,0"
                    Padding="12"
                    MinHeight="108"
                    MaxHeight="160"
                    Background="#161B22"
                    BorderBrush="#30363D"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SelectedAccountFundingTitle}"
                               FontWeight="SemiBold"
                               Foreground="#E6EDF3"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedAccountAuditSummary}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="#3FB950"/>
                    <TextBlock Grid.Row="2"
                               Text="{Binding SelectedAccountFundingMessage}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="#8B949E"/>
                    <ScrollViewer Grid.Row="3"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedAccountFundingBills}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="84"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#E6EDF3"/>
                                            <TextBlock Text="{Binding DueDate, StringFormat=Due {0:dd/MM/yyyy}}"
                                                       FontSize="11"
                                                       Foreground="#8B949E"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Amount, StringFormat={}{0:C}}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="#8B949E"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding NeededNow, StringFormat={}{0:C}}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F0883E"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding RemainingAfterBill, StringFormat={}{0:C} left}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="#8B949E"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#172033" ShowsPreview="True"/>
                <Border Grid.Column="2" Background="#111827" CornerRadius="8" Margin="18,16,16,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <TextBlock Text="Quick Overview" FontSize="16" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,0,14"/>
                            <UniformGrid Rows="2" Columns="3" Margin="0,0,0,18">
                                <Border Background="#0D1117" BorderBrush="#1E2D42" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,6,6">
                                    <StackPanel>
                                        <TextBlock Text="Payday in" Foreground="#6E7681" FontSize="11"/>
                                        <TextBlock Text="{Binding DaysUntilPaydayDisplay}" FontSize="18" FontWeight="Bold" Foreground="#3FB950" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0D1117" BorderBrush="#1E2D42" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,6,6">
                                    <StackPanel>
                                        <TextBlock Text="Bills on payday" Foreground="#6E7681" FontSize="11"/>
                                        <TextBlock Text="{Binding BillsDueOnPayday, StringFormat={}{0:C}}" FontSize="18" FontWeight="Bold" Foreground="#F0883E" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0D1117" BorderBrush="#1E2D42" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Transfer payday" Foreground="#6E7681" FontSize="11"/>
                                        <TextBlock Text="{Binding PaydayTransferTotal, StringFormat={}{0:C}}" FontSize="18" FontWeight="Bold" Foreground="#3FB950" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0D1117" BorderBrush="#1E2D42" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Safe to spend" Foreground="#6E7681" FontSize="11"/>
                                        <TextBlock Text="{Binding SafeToSpendAmount, StringFormat={}{0:C}}" FontSize="18" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0D1117" BorderBrush="#1E2D42" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Needs funding" Foreground="#6E7681" FontSize="11"/>
                                        <TextBlock Text="{Binding BillsFundingShortfall, StringFormat={}{0:C}}" FontSize="18" FontWeight="Bold" Foreground="#F0883E" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0D1117" BorderBrush="#1E2D42" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Budget gap" Foreground="#6E7681" FontSize="11"/>
                                        <TextBlock Text="{Binding BudgetPlannerIncomeGap, StringFormat={}{0:C}}" FontSize="18" FontWeight="Bold" Foreground="{Binding BudgetPlannerIncomeGap, Converter={StaticResource AmountToBrushConverter}}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Height="1" Background="#30363D" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bills due this week" FontSize="15" FontWeight="Bold" Foreground="#F0883E"/>
                                <TextBlock Grid.Column="1" Text="{Binding BillsDueNext7Days.Count, StringFormat={}{0} upcoming}" Foreground="#6E7681" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding BillsDueNext7Days}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="10,8" CornerRadius="6" Background="#0D1117">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="2" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayLine}" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="3" Text="{Binding AccountName}" Foreground="#6E7681" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- TRANSACTIONS SECTION -->
            <Grid Grid.Row="1" Margin="0,16,16,16" Visibility="{Binding IsTransactionsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#111827"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Transactions"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#E6EDF3"
                                   VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 Width="280"
                                 Height="34"
                                 Padding="8,5"
                                 Text="{Binding TransactionSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search description, account, or category"/>

                        <WrapPanel Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Left"
                                   Margin="0,10,0,0">
                            <Button Content="All types"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Click="AllTransactionTypes_Click"/>
                            <Button Content="Spending"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Click="SpendingTransactions_Click"/>
                            <Button Content="Income"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Click="IncomeTransactions_Click"/>
                            <Button Content="Transfers"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,12,0"
                                    Click="TransferTransactions_Click"/>
                            <Button Content="{Binding HideCoverTransfersButtonText}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,12,0"
                                    Click="ToggleCoverTransfers_Click"/>
                            <Button Content="Edit Selected"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,12,0"
                                    Click="EditTransaction_Click"/>
                            <Button Content="Add to budget"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,12,0"
                                    Click="AddTransactionToBudget_Click"/>
                            <Button Content="Needs category"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,12,0"
                                    Click="NeedsCategory_Click"/>
                            <Button Content="Assign category"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,12,0"
                                    Click="AssignCategory_Click"/>
                            <Button Content="Make bill"
                                    Style="{StaticResource SecondaryButton}"
                                    Background="#0F766E"
                                    Margin="0,0,12,0"
                                    Click="MakeBillFromTransaction_Click"/>
                            <Button Content="Delete"
                                    Style="{StaticResource SecondaryButton}"
                                    Background="#991B1B"
                                    Click="DeleteTransaction_Click"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding TransactionFilterLabel, StringFormat=Showing: {0}}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Foreground="#8B949E"
                                   Margin="0,8,0,0"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="10"
                            Background="#161B22"
                            BorderBrush="#30363D"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Collapsed cover groups"
                                       FontWeight="SemiBold"
                                       Foreground="#E6EDF3"
                                       Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding CoverTransferGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="105"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy}" Foreground="#8B949E"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Display}" Foreground="#8B949E"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat=C}" HorizontalAlignment="Right" Foreground="#E6EDF3"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="TransactionsGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding Transactions}"
                              SelectedItem="{Binding SelectedTransaction}"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              KeyDown="TransactionsGrid_KeyDown"
                              MouseDoubleClick="TransactionsGrid_MouseDoubleClick"
                              PreviewMouseRightButtonDown="TransactionsGrid_PreviewMouseRightButtonDown"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#111827"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              RowBackground="#111827"
                              AlternatingRowBackground="#161B22"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#243244"
                              VerticalGridLinesBrush="#243244">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Make bill / recurring payment"
                                          Click="MakeBillFromTransaction_Click"/>
                                <Separator/>
                                <MenuItem Header="Edit transaction"
                                          Click="EditTransaction_Click"/>
                                <MenuItem Header="Delete transaction"
                                          Click="DeleteTransaction_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Padding" Value="10"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                        <Setter Property="BorderThickness" Value="0,1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="105" ElementStyle="{StaticResource WrappingCellText}"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource WrappingCellText}"/>
                            <DataGridTextColumn Header="Link" Binding="{Binding CoverPair}" Width="100" ElementStyle="{StaticResource WrappingCellText}"/>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="135" ElementStyle="{StaticResource WrappingCellText}"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="135" ElementStyle="{StaticResource WrappingCellText}"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Transaction count / load-all footer -->
                    <Border Grid.Row="3"
                            Margin="0,6,0,0"
                            Padding="10,8"
                            Background="#161B22"
                            BorderBrush="#30363D"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TransactionCountSummary}"
                                       Foreground="#6E7681"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="Load all"
                                    Style="{StaticResource SmallButton}"
                                    Click="LoadAllTransactions_Click"
                                    Visibility="{Binding HasHiddenTransactions, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </Grid>
                </Border>
            </Grid>

            <!-- CATEGORIES SECTION -->
            <Grid Grid.Row="1" Margin="0,16,16,16" Visibility="{Binding IsCategoriesSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#111827"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Content="Edit" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="EditCategory_Click"/>
                            <Button Content="Delete" Style="{StaticResource SmallButton}" Background="#991B1B" Margin="0,0,8,0" Click="DeleteCategory_Click"/>
                            <Button Content="Add" Style="{StaticResource SmallButton}" Background="#0F766E" Click="AddCategory_Click"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="CategoriesGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource WrappingCellText}"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" ElementStyle="{StaticResource WrappingCellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- PLANNING SECTION -->
            <Grid Grid.Row="1" Margin="0,16,16,16" Visibility="{Binding IsPlanningSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#161B22"
                        BorderBrush="#30363D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,10,0,0">
                <TabControl Padding="0" Margin="0" SelectedIndex="{Binding SelectedPlanningTabIndex, Mode=TwoWay}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                        <TabItem Header="Insights">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,10,0,0">
                                    <UniformGrid Columns="4" Margin="0,0,0,14">
                                        <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Payday" Foreground="#8B949E"/>
                                                <TextBlock Text="{Binding DaysUntilPaydayDisplay}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#E6EDF3"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Bills on payday" Foreground="#8B949E"/>
                                                <TextBlock Text="{Binding BillsDueOnPayday, StringFormat={}{0:C}}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#F0883E"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Transfer payday" Foreground="#8B949E"/>
                                                <TextBlock Text="{Binding PaydayTransferTotal, StringFormat={}{0:C}}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#3FB950"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Safe to spend" Foreground="#8B949E"/>
                                                <TextBlock Text="{Binding SafeToSpendAmount, StringFormat={}{0:C}}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#E6EDF3"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <UniformGrid Columns="4" Margin="0,0,0,14">
                                        <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Needs funding" Foreground="#8B949E"/>
                                                <TextBlock Text="{Binding BillsFundingShortfall, StringFormat={}{0:C}}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#F0883E"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Weekly bills" Foreground="#8B949E"/>
                                                <TextBlock Text="{Binding BudgetPlannerWeeklyBills, StringFormat={}{0:C}}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#E6EDF3"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Planned transfers" Foreground="#8B949E"/>
                                                <TextBlock Text="{Binding BudgetPlannerWeeklyTransfers, StringFormat={}{0:C}}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#3FB950"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Budget gap" Foreground="#8B949E"/>
                                                <TextBlock Text="{Binding BudgetPlannerIncomeGap, StringFormat={}{0:C}}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding BudgetPlannerIncomeGap, Converter={StaticResource AmountToBrushConverter}}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Monthly spending trend chart -->
                                    <Border Padding="14"
                                            Margin="0,0,0,14"
                                            Background="#161B22"
                                            BorderBrush="#30363D"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="6-MONTH TREND"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6E7681"
                                                       Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding MonthlyTrend}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="3,0">
                                                            <!-- Bar pair -->
                                                            <Grid Height="115" VerticalAlignment="Bottom">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="3"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Income bar -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                                                    <TextBlock Text="{Binding IncomeLabelShort}"
                                                                               FontSize="9"
                                                                               TextAlignment="Center"
                                                                               Foreground="#3FB950"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,0,0,2"/>
                                                                    <Border Height="{Binding IncomeBarHeight}"
                                                                            Background="#34D399"
                                                                            CornerRadius="2,2,0,0"/>
                                                                </StackPanel>
                                                                <!-- Spending bar -->
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                                                    <TextBlock Text="{Binding SpendingLabelShort}"
                                                                               FontSize="9"
                                                                               TextAlignment="Center"
                                                                               Foreground="#F87171"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,0,0,2"/>
                                                                    <Border Height="{Binding SpendingBarHeight}"
                                                                            Background="#F87171"
                                                                            CornerRadius="2,2,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                            <!-- Month label -->
                                                            <TextBlock Text="{Binding MonthLabel}"
                                                                       FontSize="10"
                                                                       TextAlignment="Center"
                                                                       Foreground="#6E7681"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Legend -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Width="10" Height="10" Background="#34D399" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Income" Foreground="#8B949E" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" Background="#F87171" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Spending" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Net worth + streak tiles -->
                                    <UniformGrid Columns="2" Margin="0,0,0,14">
                                        <Border Padding="12" Margin="0,0,7,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="Net worth" Foreground="#8B949E"/>
                                                <TextBlock Text="{Binding NetWorth, StringFormat={}{0:C}}"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding NetWorth, Converter={StaticResource AmountToBrushConverter}}"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock Text="Assets minus debts" Foreground="#6E7681" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="Budget streak" Foreground="#8B949E"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding BudgetStreakWeeks}"
                                                               FontSize="22"
                                                               FontWeight="Bold"
                                                               Foreground="#F0883E"/>
                                                    <TextBlock Text=" wks"
                                                               FontSize="14"
                                                               Foreground="#6E7681"
                                                               VerticalAlignment="Bottom"
                                                               Margin="2,0,0,3"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding BudgetStreakDisplay}" Foreground="#6E7681" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Financial health breakdown card -->
                                    <Border Padding="16"
                                            Margin="0,0,0,14"
                                            Background="#161B22"
                                            BorderBrush="#30363D"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <!-- Header row: title + overall score -->
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Financial health" Foreground="#8B949E" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding FinancialHealthScore}"
                                                                   FontSize="26"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding FinancialHealthColor, Converter={StaticResource HexToBrushConverter}}"/>
                                                        <TextBlock Text="/100"
                                                                   FontSize="14"
                                                                   Foreground="#6E7681"
                                                                   VerticalAlignment="Bottom"
                                                                   Margin="3,0,0,4"/>
                                                        <TextBlock Text="{Binding FinancialHealthGrade}"
                                                                   FontSize="24"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding FinancialHealthColor, Converter={StaticResource HexToBrushConverter}}"
                                                                   Margin="12,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="Each category is scored out of 25"
                                                           Foreground="#4B5563"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom"/>
                                            </Grid>

                                            <!-- Emergency fund account selector -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Emergency fund account"
                                                           Foreground="#8B949E"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding BudgetTransferAccountOptions}"
                                                          SelectedItem="{Binding EmergencyFundAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          FontSize="11"/>
                                            </Grid>

                                            <!-- Component rows -->
                                            <ItemsControl ItemsSource="{Binding FinancialHealthComponents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="12,10"
                                                                Margin="0,0,0,6"
                                                                Background="#0D1117"
                                                                BorderBrush="#21262D"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="180"/>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Left: name + detail + tip -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#E6EDF3"
                                                                               FontSize="13"/>
                                                                    <TextBlock Text="{Binding Detail}"
                                                                               Foreground="#8B949E"
                                                                               FontSize="11"
                                                                               Margin="0,3,0,0"
                                                                               TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Tip}"
                                                                               Foreground="#F59E0B"
                                                                               FontSize="11"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,4,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasTip}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Button Content="{Binding NavLabel}"
                                                                            Style="{StaticResource SmallButton}"
                                                                            HorizontalAlignment="Left"
                                                                            Margin="0,8,0,0"
                                                                            Tag="{Binding NavTarget}"
                                                                            Click="GoToNavTarget_Click"
                                                                            Visibility="{Binding HasNavTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                </StackPanel>

                                                                <!-- Progress bar -->
                                                                <ProgressBar Grid.Column="2"
                                                                             Minimum="0"
                                                                             Maximum="1"
                                                                             Value="{Binding Progress, Mode=OneWay}"
                                                                             Height="8"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                             Background="#1E293B"/>

                                                                <!-- Score badge -->
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Score}"
                                                                               FontSize="16"
                                                                               FontWeight="Bold"
                                                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                    <TextBlock Text="/"
                                                                               FontSize="12"
                                                                               Foreground="#4B5563"
                                                                               VerticalAlignment="Bottom"
                                                                               Margin="2,0,1,1"/>
                                                                    <TextBlock Text="{Binding MaxScore}"
                                                                               FontSize="12"
                                                                               Foreground="#4B5563"
                                                                               VerticalAlignment="Bottom"
                                                                               Margin="0,0,0,1"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Category spending chart -->
                                    <Border Padding="14"
                                            Margin="0,0,0,14"
                                            Background="#161B22"
                                            BorderBrush="#30363D"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Spending by category (this period)"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E6EDF3"
                                                       Margin="0,0,0,12"/>
                                            <ItemsControl ItemsSource="{Binding InsightsCategoryRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="46"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}"
                                                                       Foreground="#8B949E"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <ProgressBar Grid.Column="1"
                                                                         Minimum="0" Maximum="1"
                                                                         Value="{Binding Share}"
                                                                         Height="12"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Background="#1E293B"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding AmountDisplay}"
                                                                       Foreground="#E6EDF3"
                                                                       FontSize="12"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding ShareDisplay}"
                                                                       Foreground="#6E7681"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pre-payday funding shortfall banner -->
                                    <Border Padding="14"
                                            Margin="0,0,0,14"
                                            Background="#1C1008"
                                            BorderBrush="#92400E"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding HasBillsFundingShortfall, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Move money before payday"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#FBBF24"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding BillsFundingShortfall, StringFormat={}{0:C} needed now}"
                                                           Foreground="#F59E0B"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="These bill accounts don't have enough to cover bills due before your next payday. Transfer the amounts below from your spending account now — don't wait until payday."
                                                       TextWrapping="Wrap"
                                                       Foreground="#D97706"
                                                       FontSize="12"
                                                       Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding BillFundingPlanRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,2" Padding="10,7" CornerRadius="6" Background="#111827">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasPrePaydayShortfall}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding SaverName}" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                                                                    <TextBlock Text="{Binding PrePaydayDetail}" Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding NeededBeforePayday, StringFormat=Move {0:C} now}"
                                                                           Foreground="#FBBF24"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           Margin="12,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bills due in next 7 days banner -->
                                    <Border Padding="14"
                                            Margin="0,0,0,14"
                                            Background="#0F1A2A"
                                            BorderBrush="#1E3A5F"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding HasBillsDueNext7Days, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Bills due this week"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F0883E"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding BillsDueNext7Days.Count, StringFormat={}{0} upcoming}"
                                                           Foreground="#6E7681"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding BillsDueNext7Days}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,2" Padding="10,8" CornerRadius="6" Background="#111827">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="10"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border CornerRadius="2"
                                                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding DisplayLine}"
                                                                           Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3"
                                                                           Text="{Binding AccountName}"
                                                                           Foreground="#6E7681"
                                                                           FontSize="12"
                                                                           Margin="12,0,0,0"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="14"
                                            Margin="0,0,0,14"
                                            Background="#161B22"
                                            BorderBrush="#30363D"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Action list"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#E6EDF3"
                                                       Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding DangerAlerts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="12"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border CornerRadius="3"
                                                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                <TextBlock Text="{Binding Message}"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="#8B949E"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="14"
                                            Margin="0,0,0,14"
                                            Background="#161B22"
                                            BorderBrush="#30363D"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Cash forecast"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="#E6EDF3"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding ForecastRangeOptions}"
                                                          SelectedItem="{Binding ForecastRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Column="3"
                                                        Content="Export"
                                                        Style="{StaticResource SmallButton}"
                                                        Click="ExportCashForecast_Click"/>
                                            </Grid>
                                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                                <Border Padding="10" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Low point" Foreground="#8B949E"/>
                                                        <TextBlock Text="{Binding ForecastLowPointSummary}" FontWeight="Bold" TextWrapping="Wrap" Foreground="#F0883E"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Padding="10" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="End balance" Foreground="#8B949E"/>
                                                        <TextBlock Text="{Binding ForecastEndBalanceSummary}" FontWeight="Bold" TextWrapping="Wrap" Foreground="#3FB950"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Padding="10" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Bills in range" Foreground="#8B949E"/>
                                                        <TextBlock Text="{Binding ForecastBillsTotal, StringFormat={}{0:C}}" FontWeight="Bold" Foreground="#F87171"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Padding="10" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Income in range" Foreground="#8B949E"/>
                                                        <TextBlock Text="{Binding ForecastIncomeTotal, StringFormat={}{0:C}}" FontWeight="Bold" Foreground="#3FB950"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>
                                            <ItemsControl ItemsSource="{Binding CashForecastChartRows}" Margin="0,0,0,12">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="1,0">
                                                            <!-- Balance label above bar -->
                                                            <TextBlock Text="{Binding BalanceLabel}"
                                                                       FontSize="9"
                                                                       TextAlignment="Center"
                                                                       Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0,0,2"/>
                                                            <!-- Vertical bar: fills from bottom proportional to Share -->
                                                            <Grid Height="80" Background="#0D1117" ToolTip="{Binding ProjectedBalanceDisplay}">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="{Binding Share, Converter={StaticResource ShareToGridLengthConverter}, ConverterParameter=inverse}"/>
                                                                    <RowDefinition Height="{Binding Share, Converter={StaticResource ShareToGridLengthConverter}}"/>
                                                                </Grid.RowDefinitions>
                                                                <Border Grid.Row="1"
                                                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        Opacity="0.85"
                                                                        CornerRadius="2,2,0,0"/>
                                                            </Grid>
                                                            <!-- Net change -->
                                                            <TextBlock Text="{Binding NetChangeDisplay}"
                                                                       FontSize="9"
                                                                       TextAlignment="Center"
                                                                       Foreground="{Binding NetChangeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,1"/>
                                                            <!-- Straight date label -->
                                                            <TextBlock Text="{Binding ShortLabel}"
                                                                       FontSize="9"
                                                                       TextAlignment="Center"
                                                                       Foreground="#6E7681"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding ForecastEventSummary}"
                                                       Foreground="#8B949E"
                                                       Margin="0,0,0,8"/>
                                            <DataGrid ItemsSource="{Binding CashForecastRows}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      MinHeight="140"
                                                      MaxHeight="260">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="105"/>
                                                    <DataGridTextColumn Header="Event" Binding="{Binding Description}" Width="*"/>
                                                    <DataGridTextColumn Header="Change" Binding="{Binding ChangeDisplay}" Width="110"/>
                                                    <DataGridTextColumn Header="Projected" Binding="{Binding ProjectedBalanceDisplay}" Width="120">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedCellText}">
                                                                <Setter Property="Foreground" Value="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Cash flow" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding CashFlowInsights}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Bills &amp; savers" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding BillSaverInsights}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Subscriptions" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding SubscriptionInsights}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="2" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Spending" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding SpendingInsights}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="4" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Budget health" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding BudgetHealthInsights}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="4" Grid.Column="2" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Goals" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding GoalInsights}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="6" Grid.ColumnSpan="3" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Account cleanup" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding CleanupInsights}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <UniformGrid Columns="3" Margin="0,14,0,0">
                                        <Border Padding="14" Margin="0,0,10,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Payday checklist" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding PaydayChecklistRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="14" Margin="0,0,10,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Spending leaks" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding SpendingLeakRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F0883E"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Debt accelerator" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding DebtAcceleratorRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F0883E"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Bills">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="New bill" Style="{StaticResource SmallButton}" Background="#0F766E" Margin="0,0,6,0" Click="AddBill_Click"/>
                                        <Button Content="Match paid bills" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="MatchPaidBills_Click"/>
                                        <Button Content="Clean adjustments" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="CleanupBillAdjustments_Click"/>
                                        <Button Content="Undo cleanup" Style="{StaticResource SmallButton}" Click="UndoLastBillCleanup_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Edit" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="EditBill_Click"/>
                                        <Button Content="Add to budget" Style="{StaticResource SmallButton}" Background="#0F766E" Margin="0,0,6,0" Click="AddBillToBudget_Click"/>
                                        <Button Content="Mark paid" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="MarkBillsPaid_Click"/>
                                        <Button Content="Mark unpaid" Style="{StaticResource SmallButton}" Margin="0,0,6,0" Click="MarkBillsUnpaid_Click"/>
                                        <Button Content="Delete" Style="{StaticResource SmallButton}" Background="#7F1D1D" Click="DeleteBill_Click"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                                    <Border Padding="10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Due soon" Foreground="#6E7681" FontSize="11"/>
                                            <TextBlock Text="{Binding BillsDueSoonCount}" FontSize="20" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Needs funding" Foreground="#6E7681" FontSize="11"/>
                                            <TextBlock Text="{Binding BillsNeedingFundingCount}" FontSize="20" FontWeight="Bold" Foreground="#F0883E" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Paid in view" Foreground="#6E7681" FontSize="11"/>
                                            <TextBlock Text="{Binding BillsPaidThisPeriodCount}" FontSize="20" FontWeight="Bold" Foreground="#3FB950" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="Needs review" Foreground="#6E7681" FontSize="11"/>
                                            <TextBlock Text="{Binding AmbiguousBillMatchCount}" FontSize="20" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <DataGrid x:Name="BillsGrid"
                                          Grid.Row="2"
                                          ItemsSource="{Binding Bills}"
                                          SelectedItem="{Binding SelectedBill}"
                                          SelectionMode="Extended"
                                          SelectionUnit="FullRow"
                                          KeyDown="BillsGrid_KeyDown"
                                          MouseDoubleClick="BillsGrid_MouseDoubleClick"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="#111827"
                                          BorderBrush="#1E293B"
                                          BorderThickness="1"
                                          RowBackground="#0D1117"
                                          AlternatingRowBackground="#0D1117"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#1E293B">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="MinHeight" Value="52"/>
                                            <Setter Property="Foreground" Value="#F1F5F9"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#12264A"/>
                                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Bill" Width="*" MinWidth="160" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="12,8,8,8" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#F1F5F9"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding AccountName}"
                                                                       FontSize="11"
                                                                       Foreground="#6E7681"/>
                                                            <TextBlock Text=" Â· "
                                                                       FontSize="11"
                                                                       Foreground="#334155"/>
                                                            <TextBlock Text="{Binding PayTiming}"
                                                                       FontSize="11"
                                                                       Foreground="#6E7681"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="96" IsReadOnly="True" ElementStyle="{StaticResource WrappingCellText}"/>
                                        <DataGridTemplateColumn Header="Auto" Width="48">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="A" FontSize="10" FontWeight="Bold" Foreground="#3FB950" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsAutoPay, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="Auto-pay"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Paid" Width="42">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsPaid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Click="BillPaidCheckBox_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                        <DataGridTemplateColumn Header="Status" Width="*" MinWidth="100" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CoverageStatus}"
                                                               Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="3"
                                        Margin="0,10,0,0"
                                        Padding="10"
                                        Background="#161B22"
                                        BorderBrush="#30363D"
                                        BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Possible bill payment review"
                                                   FontWeight="Bold"
                                                   Foreground="#E6EDF3"
                                                   Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding BillMatchReviews}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.3*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="1.7*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="74"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding BillName}" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DueDate, StringFormat=dd/MM/yyyy}" Foreground="#8B949E"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat=C}" Foreground="#E6EDF3" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding TransactionDescription}" Foreground="#8B949E" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Reason}" Foreground="#8B949E" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                                                        <Button Grid.Column="5"
                                                                Content="Apply"
                                                                Height="24"
                                                                Style="{StaticResource SmallButton}"
                                                                Click="ApplyReviewedBillMatch_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Payment history"
                                                   FontWeight="Bold"
                                                   Foreground="#E6EDF3"
                                                   Margin="0,12,0,6"/>
                                        <ItemsControl ItemsSource="{Binding BillPaymentHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="92"/>
                                                            <ColumnDefinition Width="74"/>
                                                            <ColumnDefinition Width="1.6*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="74"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding BillName}" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DueDate, StringFormat=dd/MM/yyyy}" Foreground="#8B949E"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#E6EDF3"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding MatchedTransaction}" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding MatchNote}" Foreground="#8B949E" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                                                        <Button Grid.Column="5"
                                                                Content="Unmark"
                                                                Height="24"
                                                                Style="{StaticResource SmallButton}"
                                                                Click="UnmarkBillPayment_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Subscriptions">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Padding="12"
                                        Margin="0,0,0,10"
                                        Background="#161B22"
                                        BorderBrush="#30363D"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Recurring payments and subscriptions"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="#E6EDF3"/>
                                            <TextBlock Text="Detected from repeated spending with similar names and timing, even when prices vary."
                                                       Foreground="#8B949E"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RecurringPayments.Count, StringFormat={}{0} found}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#3FB950"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <DataGrid x:Name="RecurringPaymentsGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding RecurringPayments}"
                                          SelectedItem="{Binding SelectedRecurringPayment}"
                                          KeyDown="RecurringPaymentsGrid_KeyDown"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="#111827"
                                          BorderBrush="#CBD5E1"
                                          BorderThickness="1"
                                          RowBackground="#111827"
                                          AlternatingRowBackground="#161B22"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#243244">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource WrappingCellText}"/>
                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="90" ElementStyle="{StaticResource WrappingCellText}"/>
                                        
                                        <DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="80" ElementStyle="{StaticResource WrappingCellText}"/>
                                        <DataGridTextColumn Header="Last" Binding="{Binding Amount, StringFormat=C}" Width="72" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                        <DataGridTextColumn Header="Range" Binding="{Binding AmountRangeDisplay}" Width="112" ElementStyle="{StaticResource WrappingCellText}"/>
                                        <DataGridTextColumn Header="Weekly" Binding="{Binding WeeklyAmount, StringFormat=C}" Width="78" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                        <DataGridTextColumn Header="Next" Binding="{Binding NextDueDisplay}" Width="95" ElementStyle="{StaticResource WrappingCellText}"/>
                                        <DataGridTextColumn Header="Seen" Binding="{Binding TimesSeen}" Width="50" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                        <DataGridTemplateColumn Header="Actions" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding ActionText}" Style="{StaticResource SmallButton}" Height="26" Margin="0,0,4,0" Click="AddRecurringPaymentAsBill_Click"/><Button Content="Ignore" Style="{StaticResource SmallButton}" Height="26" Margin="0,0,4,0" Click="IgnoreRecurringPayment_Click"/><Button Content="Delete" Style="{StaticResource SmallButton}" Background="#991B1B" Height="26" Click="DeleteRecurringPayment_Click"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Calendar">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Margin="0,0,0,12"
                                        Padding="12"
                                        Background="#161B22"
                                        BorderBrush="#1F2937"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding BillCalendarTitle}"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="#E6EDF3"/>
                                        <TextBlock Text="{Binding BillCalendarSubtitle}"
                                                   Foreground="#8B949E"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding BillCalendarModeSummary}"
                                                   Foreground="#6E7681"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="&lt;"
                                            Style="{StaticResource SmallButton}"
                                            Width="34"
                                            ToolTip="Previous period"
                                            Click="PreviousBillCalendarMonth_Click"/>
                                    <Button Grid.Column="3"
                                            Content="Today"
                                            Style="{StaticResource SmallButton}"
                                            Click="CurrentBillCalendarMonth_Click"/>
                                    <Button Grid.Column="5"
                                            Content="&gt;"
                                            Style="{StaticResource SmallButton}"
                                            Width="34"
                                            ToolTip="Next period"
                                            Click="NextBillCalendarMonth_Click"/>
                                    <Button Grid.Column="7"
                                            Content="Week"
                                            Style="{StaticResource SmallButton}"
                                            ToolTip="Show one week only"
                                            Click="CalendarWeekly_Click"/>
                                    <Button Grid.Column="9"
                                            Content="Month"
                                            Style="{StaticResource SmallButton}"
                                            ToolTip="Show month"
                                            Click="CalendarMonthly_Click"/>
                                </Grid>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <UniformGrid Columns="4">
                                        <Border Padding="10" Margin="0,0,6,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Visible total" Foreground="#6E7681" FontSize="11"/>
                                                <TextBlock Text="{Binding BillCalendarVisibleTotal, StringFormat={}{0:C}}" Foreground="#F0883E" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="10" Margin="0,0,6,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Bills" Foreground="#6E7681" FontSize="11"/>
                                                <TextBlock Text="{Binding BillCalendarBillCount}" Foreground="#E6EDF3" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="10" Margin="0,0,6,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Unpaid" Foreground="#6E7681" FontSize="11"/>
                                                <TextBlock Text="{Binding BillCalendarUnpaidCount}" Foreground="#F87171" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="Paid" Foreground="#6E7681" FontSize="11"/>
                                                <TextBlock Text="{Binding BillCalendarPaidCount}" Foreground="#3FB950" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding BillCalendarDayHeaders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="7"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#8B949E" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding BillCalendarDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="3"
                                                        Padding="8"
                                                        MinHeight="92"
                                                        BorderBrush="#1F2937"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Background="#111827">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInSelectedPeriod}" Value="True">
                                                                <Setter Property="Background" Value="#102A2A"/>
                                                                <Setter Property="BorderBrush" Value="#0D9488"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                                <Setter Property="Background" Value="#0B1120"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasBills}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Background" Value="#134E4A"/>
                                                                <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel LastChildFill="True">
                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DayNumber}"
                                                                   FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                                                    <Setter Property="FontSize" Value="14"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                            <Setter Property="Foreground" Value="#5EEAD4"/>
                                                                            <Setter Property="FontSize" Value="16"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border Grid.Column="1"
                                                                Background="#0D9488"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="Today"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="#FFFFFF"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding TotalDisplay}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#F0883E"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Bills}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Display}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           FontSize="11"
                                                                           Foreground="#8B949E"
                                                                           Margin="0,1,0,0">
                                                                    <TextBlock.ContextMenu>
                                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                            <MenuItem Header="Mark paid"
                                                                                      Click="CalendarBillMarkPaid_Click"/>
                                                                            <MenuItem Header="Mark unpaid"
                                                                                      Click="CalendarBillMarkUnpaid_Click"/>
                                                                        </ContextMenu>
                                                                    </TextBlock.ContextMenu>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Reports">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Padding="14"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            Background="#161B22">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Spending vs bills"
                                                           FontWeight="Bold"
                                                           Foreground="#E6EDF3"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SummaryDateRange}"
                                                           Foreground="#8B949E"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SpendingBillRatioRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="55"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Label}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#8B949E"/>
                                                            <ProgressBar Grid.Column="1"
                                                                         Height="18"
                                                                         Minimum="0"
                                                                         Maximum="1"
                                                                         Value="{Binding Share}"
                                                                         Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Background="#30363D"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding AmountDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#E6EDF3"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding ShareDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#8B949E"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Padding="14"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            Background="#161B22">
                                        <StackPanel>
                                            <TextBlock Text="Spending by category"
                                                       FontWeight="Bold"
                                                       Foreground="#E6EDF3"
                                                       Margin="0,0,0,10"/>

                                            <ItemsControl ItemsSource="{Binding CategorySpendingRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="55"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Label}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#8B949E"/>
                                                            <ProgressBar Grid.Column="1"
                                                                         Height="18"
                                                                         Minimum="0"
                                                                         Maximum="1"
                                                                         Value="{Binding Share}"
                                                                         Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Background="#30363D"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding AmountDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#E6EDF3"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding ShareDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#8B949E"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="4"
                                            Padding="14"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            Background="#161B22">
                                        <StackPanel>
                                            <TextBlock Text="Top merchants"
                                                       FontWeight="Bold"
                                                       Foreground="#E6EDF3"
                                                       Margin="0,0,0,10"/>

                                            <ItemsControl ItemsSource="{Binding MerchantSpendingRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="240"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="55"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Label}"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap" Foreground="#8B949E"/>
                                                            <ProgressBar Grid.Column="1"
                                                                         Height="18"
                                                                         Minimum="0"
                                                                         Maximum="1"
                                                                         Value="{Binding Share}"
                                                                         Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Background="#30363D"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding AmountDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#E6EDF3"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding ShareDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#8B949E"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="6"
                                            Padding="14"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            Background="#161B22">
                                        <StackPanel>
                                            <TextBlock Text="Income sources"
                                                       FontWeight="Bold"
                                                       Foreground="#E6EDF3"
                                                       Margin="0,0,0,10"/>

                                            <ItemsControl ItemsSource="{Binding IncomeCategoryRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="240"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="55"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Label}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#8B949E"/>
                                                            <ProgressBar Grid.Column="1"
                                                                         Height="18"
                                                                         Minimum="0"
                                                                         Maximum="1"
                                                                         Value="{Binding Share}"
                                                                         Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Background="#30363D"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding AmountDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#E6EDF3"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding ShareDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#8B949E"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="8"
                                            Padding="14"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            Background="#161B22">
                                        <StackPanel>
                                            <TextBlock Text="Monthly cash flow"
                                                       FontWeight="Bold"
                                                       Foreground="#E6EDF3"
                                                       Margin="0,0,0,10"/>

                                            <ItemsControl ItemsSource="{Binding MonthlyCashFlowRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="180"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="90"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Label}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#8B949E"/>
                                                            <ProgressBar Grid.Column="1"
                                                                         Height="18"
                                                                         Minimum="0"
                                                                         Maximum="1"
                                                                         Value="{Binding Share}"
                                                                         Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Background="#30363D"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding AmountDisplay}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Budget">
                            <Grid Margin="0,12,0,0" Background="#0D1117">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Real saved budget"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E6EDF3"/>
                                        <TextBlock Text="Changes here affect the actual budget used throughout Finance Blade."
                                                   Foreground="#8B949E"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Add goal" Style="{StaticResource SmallButton}" Background="#0F766E" Margin="0,0,8,0" Click="BudgetAddGoal_Click"/>
                                    <Button Content="Make Budget For Me" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="MakeBudgetForMe_Click"/>
                                    <Button Content="Edit Weekly Budget" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="Budget_Click"/>
                                    <Button Content="Sync bills to budget" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="SyncBillsToBudget_Click"/>
                                    <Button Content="What if..." Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="WhatIfBudget_Click"/>
                                    <Button Content="Clear budget" Style="{StaticResource SmallButton}" Background="#991B1B" Margin="0,0,8,0" Click="ClearBudget_Click"/>
                                    <Button Content="Export budget" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="ExportBudget_Click"/>
                                    <Button Content="Monthly report" Style="{StaticResource SmallButton}" Click="ExportMonthlyReport_Click"/>
                                </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              Margin="0,14,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Background="#0D1117">
                                    <StackPanel Background="#0D1117">
                                        <!-- Equation row: Income − Allocated = Leftover -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Income -->
                                            <Border Padding="12,10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Income" Foreground="#8B949E" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding WeeklyIncome, StringFormat={}{0:C}}" FontSize="22" FontWeight="Bold" Foreground="#3FB950" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- − operator -->
                                            <TextBlock Grid.Column="1" Text="−" FontSize="22" Foreground="#6E7681" VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Center"/>
                                            <!-- Allocated (= Bills + Essentials + Targets + Unplanned) -->
                                            <Border Grid.Column="2" Padding="12,10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Allocated  (Bills + Essentials + Targets + Unplanned)" Foreground="#8B949E" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding BudgetTotal, StringFormat={}{0:C}}" FontSize="22" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- = operator -->
                                            <TextBlock Grid.Column="3" Text="=" FontSize="22" Foreground="#6E7681" VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Center"/>
                                            <!-- Leftover -->
                                            <Border Grid.Column="4" Padding="12,10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Leftover" Foreground="#8B949E" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding BudgetLeftover, StringFormat={}{0:C}}" FontSize="22" FontWeight="Bold" Foreground="{Binding BudgetLeftover, Converter={StaticResource AmountToBrushConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <!-- Breakdown of Allocated — 4 category tiles -->
                                        <UniformGrid Columns="4" Margin="0,0,0,14">
                                            <Border Padding="12,8" Margin="0,0,8,0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Bills" Foreground="#8B949E" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding BudgetBills, StringFormat={}{0:C}}" FontSize="17" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                    <TextBlock Text="{Binding BudgetBillsShare}" FontSize="11" Foreground="#6E7681" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="12,8" Margin="0,0,8,0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Essentials" Foreground="#8B949E" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding BudgetEssentials, StringFormat={}{0:C}}" FontSize="17" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                    <TextBlock Text="{Binding BudgetEssentialsShare}" FontSize="11" Foreground="#6E7681" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="12,8" Margin="0,0,8,0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Savings" Foreground="#8B949E" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding BudgetSavings, StringFormat={}{0:C}}" FontSize="17" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                    <TextBlock Text="{Binding BudgetSavingsShare}" FontSize="11" Foreground="#6E7681" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="12,8" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Unplanned" Foreground="#8B949E" FontSize="11" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding BudgetUnplanned, StringFormat={}{0:C}}" FontSize="17" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                    <TextBlock Text="{Binding BudgetUnplannedShare}" FontSize="11" Foreground="#6E7681" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Bills and targets detail — one tile per saver or target -->
                                        <Border Padding="14,12"
                                                Margin="0,0,0,14"
                                                Background="#161B22"
                                                BorderBrush="#30363D"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Bills and targets breakdown" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="weekly equivalent per item" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                </Grid>
                                                <!-- Per-bill tiles -->
                                                <ItemsControl ItemsSource="{Binding BudgetBillDetailTiles}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="190"
                                                                    Padding="12,10"
                                                                    Margin="0,0,8,8"
                                                                    Background="#0D1117"
                                                                    BorderBrush="#30363D"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="#E6EDF3"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding AmountDisplay}"
                                                                               FontSize="15" FontWeight="Bold"
                                                                               Foreground="#E6EDF3"
                                                                               Margin="0,4,0,2"/>
                                                                    <TextBlock Text="{Binding Detail}"
                                                                               FontSize="11"
                                                                               Foreground="#6E7681"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Empty state when no bills -->
                                                <TextBlock Text="No bills saved yet. Add bills and click 'Sync bills to budget' to see them here."
                                                           Foreground="#6E7681" FontSize="12" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BudgetBills}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14"
                                                Margin="0,0,0,14"
                                                Background="#161B22"
                                                BorderBrush="#30363D"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Budget tracking"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="#E6EDF3"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock TextWrapping="Wrap"
                                                           Foreground="#8B949E"
                                                           FontSize="12"
                                                           Margin="0,0,0,10">
                                                    <Run Text="How much you budgeted vs how much you actually spent "/>
                                                    <Run Text="{Binding BudgetVariancePeriodLabel, Mode=OneWay}"/>
                                                    <Run Text=". Green = under budget, red = over budget."/>
                                                </TextBlock>

                                                <!-- "All" period: table doesn't make sense, show a note instead -->
                                                <TextBlock Text="Switch to Weekly or Monthly to compare actual spending against your budget for that period."
                                                           Foreground="#8B949E"
                                                           FontStyle="Italic"
                                                           TextWrapping="Wrap"
                                                           FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowBudgetVarianceTable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <StackPanel Visibility="{Binding ShowBudgetVarianceTable, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="72"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Category" Foreground="#6E7681" FontSize="11"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding BudgetVarianceBudgetHeader, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#6E7681" FontSize="11"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding BudgetVarianceActualHeader, Mode=OneWay}" HorizontalAlignment="Right" Foreground="#6E7681" FontSize="11"/>
                                                        <TextBlock Grid.Column="3" Text="Remaining" HorizontalAlignment="Right" Foreground="#6E7681" FontSize="11"/>
                                                        <TextBlock Grid.Column="4" Text="Used" HorizontalAlignment="Right" Foreground="#6E7681" FontSize="11"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding BudgetVarianceRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="72"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Category}" Foreground="#8B949E"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Budgeted, StringFormat={}{0:C}}" HorizontalAlignment="Right" Foreground="#8B949E"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Actual, StringFormat={}{0:C}}" HorizontalAlignment="Right" Foreground="#8B949E"/>
                                                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                                               Text="{Binding Difference, StringFormat={}{0:C}}"
                                                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                               Visibility="{Binding HasBudget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right"
                                                                               Text="{Binding PercentUsedLabel}"
                                                                               Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                               Visibility="{Binding HasBudget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="12,10"
                                                Margin="0,0,0,14"
                                                Background="#161B22"
                                                BorderBrush="#F0883E"
                                                BorderThickness="1"
                                                Visibility="{Binding ShowSavingsRecommendation, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Savings suggestion"
                                                               FontWeight="SemiBold"
                                                               Foreground="#E6EDF3"/>
                                                    <TextBlock Text="{Binding SavingsRecommendation}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#F0883E"
                                                               FontSize="13"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="Per week" Foreground="#8B949E" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding SavingsRecommendationAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="Add"
                                                        Style="{StaticResource SmallButton}"
                                                        Background="#0F766E"
                                                        Margin="12,18,0,0"
                                                        Click="AddSavingsRecommendationToBudget_Click"/>
                                                <Button Grid.Column="3"
                                                        Content="Ignore"
                                                        Style="{StaticResource SmallButton}"
                                                        Margin="8,18,0,0"
                                                        Click="IgnoreSavingsRecommendation_Click"/>
                                                <Button Grid.Column="4"
                                                        Content="Decline"
                                                        Style="{StaticResource SmallButton}"
                                                        Background="#7F1D1D"
                                                        Margin="8,18,0,0"
                                                        Click="DeclineSavingsRecommendation_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Padding="14"
                                                Margin="0,0,0,14"
                                                Background="#161B22"
                                                BorderBrush="#30363D"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="260"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding BudgetPressureTitle}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#E6EDF3"/>
                                                    <TextBlock Text="{Binding BudgetPressureMessage}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#8B949E"
                                                               Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding BudgetSyncMessage}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#F0883E"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Margin="18,0,0,0">
                                                    <TextBlock Text="Income used"
                                                               Foreground="#8B949E"/>
                                                    <ProgressBar Height="18"
                                                                 Minimum="0"
                                                                 Maximum="1"
                                                                Value="{Binding BudgetUsagePercent, Mode=OneWay}"
                                                                 Foreground="#F0883E"
                                                                 Background="#30363D"
                                                                 Margin="0,6,0,4"/>
                                                    <TextBlock Text="{Binding BudgetUsagePercent, StringFormat={}{0:P0}}"
                                                               FontWeight="Bold"
                                                               Foreground="#E6EDF3"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Margin="18,0,0,0">
                                                    <TextBlock Text="Left after weekly budget"
                                                               Foreground="#8B949E"/>
                                                    <TextBlock Text="{Binding BudgetLeftover, StringFormat={}{0:C}/week}"
                                                               FontSize="22"
                                                               FontWeight="Bold"
                                                               Foreground="#3FB950"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Padding="16"
                                                    Background="#161B22"
                                                    BorderBrush="#30363D"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock Text="Can I afford this?"
                                                               FontSize="16" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,0,14"/>

                                                    <!-- Inputs: amount | account | weeks -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Amount" Foreground="#6E7681" FontSize="11" Margin="0,0,0,4"/>
                                                            <TextBox Text="{Binding AffordabilityAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="From account" Foreground="#6E7681" FontSize="11" Margin="0,0,0,4"/>
                                                            <ComboBox ItemsSource="{Binding BudgetTransferAccountOptions}"
                                                                      SelectedItem="{Binding AffordabilityAccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="Over (wks)" Foreground="#6E7681" FontSize="11" Margin="0,0,0,4"/>
                                                            <TextBox Text="{Binding AffordabilityWeeks, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- ① Status badge -->
                                                    <Border Visibility="{Binding HasAffordabilityInputs, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="12,10" CornerRadius="6" Margin="0,0,0,8" BorderThickness="1" Background="#111827"
                                                            BorderBrush="{Binding AffordabilityStatusColorHex, Converter={StaticResource HexToBrushConverter}}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                                <TextBlock Text="{Binding AffordabilityStatusIcon}" FontSize="15" FontWeight="Bold"
                                                                           Foreground="{Binding AffordabilityStatusColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding AffordabilityStatusLabel}" FontSize="15" FontWeight="Bold"
                                                                           Foreground="{Binding AffordabilityStatusColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding AffordabilityStatusDetail}"
                                                                       Foreground="#8B949E" FontSize="12" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- ② Account balance + purchase cost -->
                                                    <Border Visibility="{Binding HasAffordabilityInputs, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="12,10" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Account balance" Foreground="#6E7681" FontSize="11" Margin="0,0,0,3"/>
                                                                <TextBlock Text="{Binding AffordabilityStat1Value}" FontSize="18" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Purchase cost" Foreground="#6E7681" FontSize="11" Margin="0,0,0,3"/>
                                                                <TextBlock Text="{Binding AffordabilityWeeklyCostDisplay}" FontSize="15" FontWeight="Bold"
                                                                           Foreground="{Binding AffordabilityWeeklyCostColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ③ Week-by-week projection table -->
                                                    <Border Visibility="{Binding HasAffordabilityWeekRows, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="12,10" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="WEEK BY WEEK" Foreground="#6E7681" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                            <!-- Header -->
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Wk"       Foreground="#6E7681" FontSize="10" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="Start"    Foreground="#6E7681" FontSize="10" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="2" Text="Bills"    Foreground="#6E7681" FontSize="10" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="3" Text="Purchase" Foreground="#6E7681" FontSize="10" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="4" Text="Left"     Foreground="#6E7681" FontSize="10" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="5" Text="End"      Foreground="#6E7681" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <!-- Rows -->
                                                            <ItemsControl ItemsSource="{Binding AffordabilityWeekRows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,3">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="36"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding WeekLabel}"           Foreground="#6E7681" FontSize="12"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding StartBalanceDisplay}" Foreground="#8B949E" FontSize="12"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding BillsDisplay}"         Foreground="#8B949E" FontSize="12"/>
                                                                            <TextBlock Grid.Column="3" Text="{Binding PurchaseDisplay}"      Foreground="#8B949E" FontSize="12"/>
                                                                            <TextBlock Grid.Column="4" Text="{Binding LeftAfterPurchaseDisplay}" FontSize="12"
                                                                                       Foreground="{Binding LeftAfterPurchaseColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                            <TextBlock Grid.Column="5" Text="{Binding EndBalanceDisplay}"    FontSize="12" FontWeight="Bold"
                                                                                       HorizontalAlignment="Right"
                                                                                       Foreground="{Binding EndColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- ④ Bills in this window -->
                                                    <Border Visibility="{Binding HasAffordabilityBillRows, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="12,10" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <TextBlock Text="BILLS IN THIS WINDOW" Foreground="#6E7681" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                            <ItemsControl ItemsSource="{Binding AffordabilityBillRows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Name}" Foreground="#E6EDF3" FontSize="13"/>
                                                                                <TextBlock Text="{Binding OccurrenceDisplay}" Foreground="#6E7681" FontSize="11" Margin="0,2,0,0"/>
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="1" Text="{Binding WeeklyAmountDisplay}"
                                                                                       Foreground="#8B949E" FontSize="13" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                <Border Padding="7,3" CornerRadius="4" BorderThickness="1"
                                                                                        BorderBrush="{Binding StatusColorHex, Converter={StaticResource HexToBrushConverter}}">
                                                                                    <TextBlock Text="{Binding CoverageDisplay}"
                                                                                               Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                                               FontSize="11" FontWeight="SemiBold"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding ShortfallDisplay}" Foreground="#8B949E" FontSize="10"
                                                                                           HorizontalAlignment="Right" Margin="0,2,0,0"
                                                                                           Visibility="{Binding HasShortfall, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                                <TextBlock Text="{Binding ExtraWeeklyDisplay}" Foreground="#F59E0B" FontSize="11"
                                                                                           HorizontalAlignment="Right" Margin="0,1,0,0"
                                                                                           Visibility="{Binding HasExtraWeekly, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- ⑤ With vs Without comparison -->
                                                    <Border Visibility="{Binding HasAffordabilityWeekRows, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="12,10" Background="#111827" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Without this purchase" Foreground="#6E7681" FontSize="11" Margin="0,0,0,3"/>
                                                                <TextBlock Text="{Binding AffordabilityEndBalanceWithoutDisplay}" FontSize="16" FontWeight="Bold"
                                                                           Foreground="{Binding AffordabilityEndBalanceWithoutColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                <TextBlock Text="{Binding AffordabilityWeeksSuffix}" Foreground="#6E7681" FontSize="11" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="With this purchase" Foreground="#6E7681" FontSize="11" Margin="0,0,0,3"/>
                                                                <TextBlock Text="{Binding AffordabilityEndBalanceWithDisplay}" FontSize="16" FontWeight="Bold"
                                                                           Foreground="{Binding AffordabilityEndBalanceWithColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                <TextBlock Text="{Binding AffordabilityWeeksSuffix}" Foreground="#6E7681" FontSize="11" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ⑥ Action line (only when bills are at risk) -->
                                                    <Border Visibility="{Binding HasAffordabilityAction, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="12,10" Background="#111827" CornerRadius="6" BorderThickness="1" BorderBrush="#F59E0B">
                                                        <TextBlock Text="{Binding AffordabilityActionText}"
                                                                   TextWrapping="Wrap" Foreground="#F59E0B"
                                                                   FontSize="13" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2"
                                                    Padding="16"
                                                    Background="#161B22"
                                                    BorderBrush="#30363D"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Add budget item"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#E6EDF3"
                                                               Margin="0,0,0,10"/>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Name" Foreground="#8B949E" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="Per week" Foreground="#8B949E" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" Text="Category" Foreground="#8B949E" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="3" Text="Transfer to" Foreground="#8B949E" Margin="0,0,8,0"/>
                                                        <TextBox Grid.Row="2"
                                                                 Text="{Binding CustomBudgetName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,0,8,0"/>
                                                        <TextBox Grid.Row="2"
                                                                 Grid.Column="1"
                                                                 Text="{Binding CustomBudgetAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,0,8,0"/>
                                                        <ComboBox Grid.Row="2"
                                                                  Grid.Column="2"
                                                                  ItemsSource="{Binding BudgetCategoryOptions}"
                                                                  SelectedItem="{Binding CustomBudgetBucket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="0,0,8,0"/>
                                                        <ComboBox Grid.Row="2"
                                                                  Grid.Column="3"
                                                                  ItemsSource="{Binding BudgetTransferAccountOptions}"
                                                                  SelectedItem="{Binding CustomBudgetTransferTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Margin="0,0,8,0"/>
                                                        <Button Grid.Row="2"
                                                                Grid.Column="4"
                                                                Content="Add"
                                                                Style="{StaticResource SmallButton}"
                                                                Background="#0F766E"
                                                                Click="AddCustomBudgetItem_Click"/>
                                                        <TextBlock Grid.Row="4"
                                                                   Grid.ColumnSpan="5"
                                                                   Text="Use this for one-off savings, repairs, gifts, rego, or anything that is not already a bill."
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#8B949E"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Padding="16"
                                                    Background="#161B22"
                                                    BorderBrush="#30363D"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Payday transfer plan"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   Foreground="#E6EDF3"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding PaydayTransferTotal, StringFormat=Transfer {0:C}}"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   Foreground="#3FB950"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding PaydayTransferPlanExplanation}"
                                                               TextWrapping="Wrap"
                                                               Foreground="#8B949E"
                                                               Margin="0,0,0,12"/>

                                                    <ItemsControl ItemsSource="{Binding BillFundingPlanRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="12"
                                                                        Margin="0,0,0,10"
                                                                        Background="#111827"
                                                                        BorderBrush="#30363D"
                                                                        BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="100"/>
                                                                            <ColumnDefinition Width="105"/>
                                                                            <ColumnDefinition Width="112"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding SaverName}"
                                                                                       FontWeight="SemiBold"
                                                                                       TextWrapping="Wrap"
                                                                                       Foreground="#E6EDF3"/>
                                                                            <TextBlock Text="{Binding TransferExplanation}"
                                                                                       FontSize="12"
                                                                                       TextWrapping="Wrap"
                                                                                       Foreground="#8B949E"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                                            <TextBlock Text="{Binding WeeklyAmount, StringFormat={}{0:C}/wk}"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#3FB950"/>
                                                                            <TextBlock Text="weekly portion"
                                                                                       FontSize="11"
                                                                                       Foreground="#8B949E"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                                            <TextBlock Text="{Binding DueOnPayday, StringFormat={}{0:C}}"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#F0883E"/>
                                                                            <TextBlock Text="due payday"
                                                                                       FontSize="11"
                                                                                       Foreground="#8B949E"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                                                            <TextBlock Text="{Binding PaydayTransfer, StringFormat={}{0:C}}"
                                                                                       FontSize="16"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="#E6EDF3"/>
                                                                            <TextBlock Text="{Binding PaydayStatus}"
                                                                                       FontSize="11"
                                                                                       Foreground="#8B949E"/>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Row="1"
                                                                                   Grid.ColumnSpan="4"
                                                                                   Text="{Binding NextDueDisplay, StringFormat=Next due {0}}"
                                                                                   FontSize="12"
                                                                                   Foreground="#8B949E"
                                                                                   Margin="0,8,0,0"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2"
                                                    Padding="16"
                                                    Background="#161B22"
                                                    BorderBrush="#30363D"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Insights"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#E6EDF3"
                                                               Margin="0,0,0,12"/>
                                                    <ItemsControl ItemsSource="{Binding BudgetInsightRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="10"
                                                                        Margin="0,0,0,8"
                                                                        Background="#111827"
                                                                        BorderBrush="#30363D"
                                                                        BorderThickness="1">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#3FB950"/>
                                                                        <TextBlock Text="{Binding Message}"
                                                                                   TextWrapping="Wrap"
                                                                                   Foreground="#8B949E"
                                                                                   Margin="0,4,0,0"/>
                                                                        <Button Content="{Binding NavLabel}"
                                                                                Style="{StaticResource SmallButton}"
                                                                                HorizontalAlignment="Left"
                                                                                Margin="0,8,0,0"
                                                                                Tag="{Binding NavTarget}"
                                                                                Click="GoToNavTarget_Click"
                                                                                Visibility="{Binding HasNavTarget, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding BudgetBreakdownGroups}" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="18"
                                                            Margin="0,0,0,12"
                                                            Background="#161B22"
                                                            BorderBrush="#30363D"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Bucket}"
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           Foreground="#E6EDF3"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Total, StringFormat={}{0:C}/week}"
                                                                           FontSize="20"
                                                                           FontWeight="Bold"
                                                                           Foreground="#3FB950"/>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Padding="12"
                                                                                Margin="0,0,0,8"
                                                                                Background="#111827"
                                                                                BorderBrush="#30363D"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                MouseLeftButtonDown="BudgetBreakdownRow_MouseLeftButtonDown">
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="{Binding Name}"
                                                                                           FontSize="16"
                                                                                           FontWeight="SemiBold"
                                                                                           TextWrapping="Wrap"
                                                                                           Foreground="#E6EDF3"/>
                                                                                <StackPanel Grid.Column="1"
                                                                                            Orientation="Horizontal"
                                                                                            HorizontalAlignment="Right"
                                                                                            Margin="20,0,0,0">
                                                                                    <TextBlock Text="{Binding TransferTo}"
                                                                                               FontSize="14"
                                                                                               FontWeight="SemiBold"
                                                                                               TextWrapping="Wrap"
                                                                                               Foreground="#3FB950"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <Button Content="Edit"
                                                                                            Style="{StaticResource SmallButton}"
                                                                                            Height="26"
                                                                                            Margin="8,0,0,0"
                                                                                            Click="EditBudgetRow_Click"/>
                                                                                    <Button Content="Remove"
                                                                                            Style="{StaticResource SmallButton}"
                                                                                            Height="26"
                                                                                            Margin="4,0,0,0"
                                                                                            Background="#7F1D1D"
                                                                                            Click="RemoveBudgetRow_Click"/>
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding Amount, StringFormat={}{0:C}/wk}"
                                                                                           FontSize="16"
                                                                                           FontWeight="Bold"
                                                                                           HorizontalAlignment="Right"
                                                                                           Foreground="#8B949E"
                                                                                           Margin="20,0,0,0"/>
                                                                                <TextBlock Grid.Row="1"
                                                                                           Grid.Column="0"
                                                                                           Grid.ColumnSpan="3"
                                                                                           Text="{Binding Detail}"
                                                                                           FontSize="14"
                                                                                           TextWrapping="Wrap"
                                                                                           Foreground="#8B949E"
                                                                                           Margin="0,6,0,0"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Debts">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Debts"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#E6EDF3"/>
                                        <TextBlock Text="{Binding DebtProgressSummary}"
                                                   Foreground="#8B949E"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Content="Edit" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="EditDebt_Click"/>
                                        <Button Content="Delete" Style="{StaticResource SmallButton}" Background="#991B1B" Margin="0,0,8,0" Click="DeleteDebt_Click"/>
                                        <Button Content="Add" Style="{StaticResource SmallButton}" Background="#0F766E" Click="AddDebt_Click"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <UniformGrid Columns="4" Margin="0,0,0,14">
                                            <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Remaining" Foreground="#8B949E"/>
                                                    <TextBlock Text="{Binding DebtTotal, StringFormat={}{0:C}}"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="#F87171"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Paid off" Foreground="#8B949E"/>
                                                    <TextBlock Text="{Binding DebtPaidTotal, StringFormat={}{0:C}}"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="#3FB950"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Highest rate" Foreground="#8B949E"/>
                                                    <TextBlock Text="{Binding HighestInterestDebtSummary}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"
                                                               Foreground="#F0883E"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Padding="12" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6">
                                                <StackPanel>
                                                    <TextBlock Text="Next payoff" Foreground="#8B949E"/>
                                                    <TextBlock Text="{Binding NextDebtPayoffSummary}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"
                                                               Foreground="#E6EDF3"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border Padding="14"
                                                Background="#161B22"
                                                BorderBrush="#30363D"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Overall payoff progress"
                                                               Foreground="#8B949E"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DebtProgressPercent, StringFormat={}{0:P0}}"
                                                               HorizontalAlignment="Right"
                                                               FontWeight="Bold"
                                                               Foreground="#3FB950"/>
                                                </Grid>
                                                <ProgressBar Height="16"
                                                             Minimum="0"
                                                             Maximum="1"
                                                             Value="{Binding DebtProgressPercent, Mode=OneWay}"
                                                             Foreground="#0F766E"
                                                             Background="#30363D"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14"
                                                Margin="0,14,0,0"
                                                Background="#161B22"
                                                BorderBrush="#30363D"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Balances"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="#E6EDF3"
                                                           Margin="0,0,0,10"/>
                                                <DataGrid ItemsSource="{Binding Debts}"
                                                          SelectedItem="{Binding SelectedDebt}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          MaxHeight="260"
                                                          PreviewMouseWheel="NestedDataGrid_PreviewMouseWheel"
                                                          MouseDoubleClick="DebtsGrid_MouseDoubleClick">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Loan" Binding="{Binding Name}" Width="1.5*" MinWidth="170" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" Width="140" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidOff, StringFormat=C}" Width="135" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentDisplay}" Width="185" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Rate" Binding="{Binding InterestRateDisplay}" Width="90" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                        <DataGridTemplateColumn Header="Progress" Width="170">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Grid VerticalAlignment="Center">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="44"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ProgressBar Height="10"
                                                                                     Minimum="0"
                                                                                     Maximum="1"
                                                                                     Value="{Binding PayoffProgress, Mode=OneWay}"
                                                                                     Foreground="#0F766E"
                                                                                     Background="#30363D"
                                                                                     VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding PayoffProgressDisplay}"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="#8B949E"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTextColumn Header="Match text" Binding="{Binding UpPaymentMatchText}" Width="1.1*" MinWidth="130" ElementStyle="{StaticResource WrappingCellText}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="14"
                                                Margin="0,14,0,0"
                                                Background="#161B22"
                                                BorderBrush="#30363D"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Payoff planner"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="#E6EDF3"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                                <DataGrid ItemsSource="{Binding DebtPayoffPlanRows}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          MaxHeight="240"
                                                          PreviewMouseWheel="NestedDataGrid_PreviewMouseWheel">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Debt" Binding="{Binding Name}" Width="1.4*" MinWidth="180" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" Width="145" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentDisplay}" Width="190" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Interest" Binding="{Binding RateDisplay}" Width="105" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Months" Binding="{Binding MonthsRemainingDisplay}" Width="105" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Est. paid off" Binding="{Binding EstimatedPaidOffDisplay}" Width="135" ElementStyle="{StaticResource WrappingCellText}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Tools">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Danger alerts" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding DangerAlerts}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Backup" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <Button Content="Back up database" Style="{StaticResource SmallButton}" Background="#0F766E" Margin="0,0,0,8" Click="BackupDatabase_Click"/>
                                                <Button Content="Restore database" Style="{StaticResource SmallButton}" Background="#991B1B" Click="RestoreDatabase_Click"/>
                                                <TextBlock Text="Restore replaces the local database after confirmation." TextWrapping="Wrap" Foreground="#8B949E" Margin="0,10,0,0"/>

                                                <TextBlock Text="Export" FontSize="16" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,18,0,10"/>
                                                <Button Content="Export transactions to CSV" Style="{StaticResource SmallButton}" Background="#1D4ED8" Margin="0,0,0,8" Click="ExportTransactionsCsv_Click"/>
                                                <TextBlock Text="Exports all transactions for the current period as a CSV file." TextWrapping="Wrap" Foreground="#8B949E"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Budget templates" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <WrapPanel Margin="0,0,0,8">
                                                    <Button Content="Normal" Margin="0,0,8,0" Click="ApplyNormalBudgetTemplate_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNormalTemplateActive}" Value="True">
                                                                        <Setter Property="Background" Value="#0D9488"/>
                                                                        <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Lean" Margin="0,0,8,0" Click="ApplyLeanBudgetTemplate_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLeanTemplateActive}" Value="True">
                                                                        <Setter Property="Background" Value="#0D9488"/>
                                                                        <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Debt payoff" Click="ApplyDebtPayoffBudgetTemplate_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                                <Setter Property="Background" Value="#374151"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDebtTemplateActive}" Value="True">
                                                                        <Setter Property="Background" Value="#0D9488"/>
                                                                        <Setter Property="BorderBrush" Value="#5EEAD4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </WrapPanel>

                                                <!-- No template selected hint -->
                                                <TextBlock Text="Choose a template to preview suggested weekly amounts."
                                                           Foreground="#8B949E"
                                                           Margin="0,0,0,10"
                                                           Visibility="{Binding HasBudgetTemplateSuggestion, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>

                                                <!-- Template preview (shown when template is selected) -->
                                                <Border Visibility="{Binding HasBudgetTemplateSuggestion, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Background="#111827" BorderBrush="#0F766E" BorderThickness="1"
                                                        Padding="12" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding BudgetTemplateName, StringFormat={}{0} template — preview}"
                                                                   FontWeight="SemiBold" Foreground="#3FB950" Margin="0,0,0,8"/>

                                                        <!-- Bills total + per-account breakdown -->
                                                        <Grid Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Bills" Foreground="#8B949E"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding BudgetTemplateBills, StringFormat={}{0:C}/wk}" Foreground="#E6EDF3" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding BillFundingPlanRows}" Margin="0,0,0,8">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding SaverName}" Foreground="#6E7681" FontSize="11" Margin="12,0,0,2"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding WeeklyAmount, StringFormat={}{0:C}/wk}" Foreground="#6E7681" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Weekly spending (Essentials) -->
                                                        <Grid Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Weekly spending" Foreground="#8B949E"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding BudgetTemplateEssentials, StringFormat={}{0:C}/wk}" Foreground="#E6EDF3" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <TextBlock Text="Groceries, transport and other day-to-day cash costs" Foreground="#6E7681" FontSize="11" Margin="12,0,0,8"/>

                                                        <!-- Set-asides & goals (Savings) + per-account breakdown -->
                                                        <Grid Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Set-asides &amp; goals" Foreground="#8B949E"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding BudgetTemplateSavings, StringFormat={}{0:C}/wk}" Foreground="#E6EDF3" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding BudgetTemplateSavingsBreakdown}" Margin="0,0,0,2">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Name}" Foreground="#6E7681" FontSize="11" Margin="12,0,0,2"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:C}/wk}" Foreground="#6E7681" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding BudgetTemplateSavingsNote}" Foreground="#6E7681" FontSize="11"
                                                                   Margin="12,0,0,8" TextWrapping="Wrap"/>

                                                        <!-- Buffer (Unplanned) -->
                                                        <Grid Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Buffer" Foreground="#8B949E"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding BudgetTemplateUnplanned, StringFormat={}{0:C}/wk}" Foreground="#E6EDF3" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <TextBlock Text="One-off and unexpected costs" Foreground="#6E7681" FontSize="11" Margin="12,0,0,6"/>

                                                        <!-- Separator + Leftover -->
                                                        <Border BorderBrush="#30363D" BorderThickness="0,1,0,0" Margin="0,0,0,6"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Leftover" Foreground="#8B949E"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding BudgetTemplateLeftover, StringFormat={}{0:C}/wk}"
                                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                                       Foreground="{Binding BudgetTemplateLeftover, Converter={StaticResource AmountToBrushConverter}}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <WrapPanel>
                                                    <Button Content="Apply suggestion" Style="{StaticResource SmallButton}" Background="#0F766E" Margin="0,0,8,0"
                                                            Visibility="{Binding HasBudgetTemplateSuggestion, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Click="ApplyBudgetTemplateSuggestion_Click"/>
                                                    <Button Content="Clear preview" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                                            Visibility="{Binding HasBudgetTemplateSuggestion, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Click="ClearBudgetTemplateSuggestion_Click"/>
                                                    <Button Content="Clear saved budget" Style="{StaticResource SmallButton}" Background="#991B1B" Click="ResetSavedBudget_Click"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="2" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Exports &amp; reports" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <Button Content="Export cash forecast" Style="{StaticResource SmallButton}" Margin="0,0,0,8" Click="ExportCashForecast_Click"/>
                                                <Button Content="Export budget" Style="{StaticResource SmallButton}" Margin="0,0,0,8" Click="ExportBudget_Click"/>
                                                <Button Content="Monthly report" Style="{StaticResource SmallButton}" Click="ExportMonthlyReport_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="4" Grid.ColumnSpan="3" Padding="16" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Debt strategy" FontSize="20" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                        <TextBlock Text="Compare avalanche and snowball payoff orders. Untick debts to model a smaller payoff plan."
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#8B949E"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" MinWidth="260" Margin="18,0,0,0">
                                                        <TextBlock Text="{Binding BestDebtStrategyTitle}" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                        <TextBlock Text="{Binding BestDebtStrategySummary}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,14">
                                                    <Border Padding="12" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Selected debts" Foreground="#8B949E"/>
                                                            <TextBlock Text="{Binding DebtStrategyActiveSummary}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Foreground="#E6EDF3"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Padding="12" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Selected balance" Foreground="#8B949E"/>
                                                            <TextBlock Text="{Binding DebtStrategySelectedBalanceSummary}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Foreground="#E6EDF3"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Padding="12" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Payment pool" Foreground="#8B949E"/>
                                                            <TextBlock Text="{Binding DebtStrategyPaymentPoolSummary}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Foreground="#E6EDF3"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Padding="12" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Highest selected rate" Foreground="#8B949E"/>
                                                            <TextBlock Text="{Binding DebtStrategyHighestSelectedRateSummary}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Foreground="#F0883E"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Padding="12" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Extra payment" Foreground="#8B949E"/>
                                                            <TextBlock Text="{Binding DebtStrategyExtraSummary}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Foreground="#F0883E"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Padding="12" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Next payoff" Foreground="#8B949E"/>
                                                            <TextBlock Text="{Binding NextDebtPayoffSummary}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Foreground="#3FB950"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Padding="12" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="Excluded debt" Foreground="#8B949E"/>
                                                            <TextBlock Text="{Binding DebtStrategyExcludedSummary}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Foreground="#8B949E"/>
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>

                                                <Grid Grid.Row="2" Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Extra payment" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding DebtStrategyExtraPayment, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/>
                                                    <ComboBox Grid.Column="3"
                                                              ItemsSource="{Binding DebtPaymentPeriodOptions}"
                                                              SelectedItem="{Binding DebtStrategyExtraPaymentPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Column="4"
                                                               Text="Changing this updates the comparison instantly."
                                                               Foreground="#8B949E"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0"/>
                                                </Grid>

                                                <Grid Grid.Row="3" Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding DebtStrategyRollsOverMinimums, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="Roll over paid minimums" Foreground="#E6EDF3" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding DebtStrategyRolloverSummary}" Foreground="#8B949E" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Grid.Row="4" Padding="12" Margin="0,0,0,14" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Debt-free target" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                        <DatePicker Grid.Column="1"
                                                                    SelectedDate="{Binding DebtFreeTargetDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    Margin="12,0,12,0"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DebtFreeTargetExtraSummary}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#8B949E"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Row="5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.05*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <DataGrid ItemsSource="{Binding Debts}"
                                                                  AutoGenerateColumns="False"
                                                                  MaxHeight="210"
                                                                  PreviewMouseWheel="NestedDataGrid_PreviewMouseWheel">
                                                            <DataGrid.Columns>
                                                                <DataGridTemplateColumn Header="Use" Width="54">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding IncludeInStrategy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      HorizontalAlignment="Center"
                                                                                      Click="DebtStrategyIncludeCheckBox_Click"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTextColumn Header="Debt" Binding="{Binding Name}" Width="*" MinWidth="130" ElementStyle="{StaticResource WrappingCellText}"/>
                                                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" Width="125" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                                <DataGridTextColumn Header="Rate" Binding="{Binding InterestRateDisplay}" Width="75" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Button Content="Select all" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Click="SelectAllDebtStrategies_Click"/>
                                                            <Button Content="Clear all" Style="{StaticResource SmallButton}" Margin="0,0,8,8" Click="ClearDebtStrategies_Click"/>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding DebtStrategyRows}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="2"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="12" Margin="0,0,10,0" Background="#111827" BorderBrush="#30363D" BorderThickness="1">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Strategy}" FontSize="18" FontWeight="Bold" Foreground="#3FB950"/>
                                                                        <WrapPanel Margin="0,10,0,8">
                                                                            <Border Padding="8" Margin="0,0,8,8" MinWidth="90" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="Payoff" Foreground="#8B949E"/>
                                                                                    <TextBlock Text="{Binding MonthsDisplay}" FontSize="17" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <Border Padding="8" Margin="0,0,8,8" MinWidth="112" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="Date" Foreground="#8B949E"/>
                                                                                    <TextBlock Text="{Binding EstimatedPaidOffDisplay}" FontSize="17" FontWeight="Bold" Foreground="#3FB950"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <Border Padding="8" Margin="0,0,8,8" MinWidth="120" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="Interest" Foreground="#8B949E"/>
                                                                                    <TextBlock Text="{Binding InterestPaidDisplay}" FontSize="17" FontWeight="Bold" Foreground="#F0883E"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <Border Padding="8" Margin="0,0,8,8" MinWidth="120" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="Total paid" Foreground="#8B949E"/>
                                                                                    <TextBlock Text="{Binding TotalPaidDisplay}" FontSize="17" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <Border Padding="8" Margin="0,0,8,8" MinWidth="120" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="Monthly plan" Foreground="#8B949E"/>
                                                                                    <TextBlock Text="{Binding MonthlyPaymentPoolDisplay}" FontSize="17" FontWeight="Bold" Foreground="#8B949E"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </WrapPanel>
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="10"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Text="Principal" Foreground="#8B949E"/>
                                                                                <TextBlock Text="{Binding PrincipalDisplay}" FontWeight="SemiBold" Foreground="#8B949E"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2">
                                                                                <TextBlock Text="Interest load" Foreground="#8B949E"/>
                                                                                <TextBlock Text="{Binding InterestRateImpactDisplay}" FontWeight="SemiBold" Foreground="#8B949E"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding FirstTargetDisplay, StringFormat=First target: {0}}" Foreground="#8B949E"/>
                                                                        <TextBlock Text="{Binding DebtCountDisplay}" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                                        <TextBlock Text="{Binding RolloverDisplay}" Foreground="#8B949E" Margin="0,4,0,0"/>
                                                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,6,0,0"/>
                                                                        <TextBlock Text="{Binding InterestDetail}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,6,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Debt payment audit" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <DataGrid ItemsSource="{Binding DebtPaymentAuditRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260" PreviewMouseWheel="NestedDataGrid_PreviewMouseWheel">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding PaidOn, StringFormat=dd/MM/yyyy}" Width="92" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Debt" Binding="{Binding DebtName}" Width="*" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="86" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="110" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Budget history" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                                <DataGrid x:Name="BudgetSnapshotsGrid" ItemsSource="{Binding BudgetSnapshots}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" PreviewMouseWheel="NestedDataGrid_PreviewMouseWheel">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Saved" Binding="{Binding CreatedAt, StringFormat=g}" Width="130" ElementStyle="{StaticResource WrappingCellText}"/>
                                                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" ElementStyle="{StaticResource WrappingCellText}"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Button Content="Restore selected budget" Style="{StaticResource SmallButton}" Margin="0,10,0,0" Click="RestoreBudgetSnapshot_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Padding="14" Margin="0,14,0,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Transaction rules" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,10"/>
                                            <TextBlock Text="Rules recategorise transactions by description. Example: contains 'Spotify' -> Subscriptions. Add a rule, then Apply rules to update matching existing transactions."
                                                       TextWrapping="Wrap"
                                                       Foreground="#8B949E"
                                                       Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Description contains" Foreground="#8B949E"/>
                                                <TextBlock Grid.Column="1" Text="Set category to" Foreground="#8B949E"/>
                                                <TextBlock Grid.Column="2" Text="Display name (optional)" Foreground="#8B949E"/>
                                                <TextBox Grid.Row="2" Text="{Binding NewRuleContainsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Text to match in transaction description"/>
                                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TransactionRuleCategoryOptions}" SelectedItem="{Binding NewRuleCategoryName, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding NewRuleDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Friendly name shown in the Daily tab instead of raw description"/>
                                                <Button Grid.Row="2" Grid.Column="3" Content="Add rule" Style="{StaticResource SmallButton}" Background="#0F766E" Margin="0,0,8,0" Click="AddTransactionRule_Click"/>
                                                <Button Grid.Row="2" Grid.Column="4" Content="Apply rules" Style="{StaticResource SmallButton}" Click="ApplyTransactionRules_Click"/>
                                            </Grid>
                                            <DataGrid ItemsSource="{Binding TransactionRules}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180" PreviewMouseWheel="NestedDataGrid_PreviewMouseWheel">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Contains" Binding="{Binding ContainsText}" Width="*" ElementStyle="{StaticResource WrappingCellText}"/>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140" ElementStyle="{StaticResource WrappingCellText}"/>
                                                    <DataGridTextColumn Header="Display as" Binding="{Binding DisplayName}" Width="160" ElementStyle="{StaticResource WrappingCellText}"/>
                                                    <DataGridTextColumn Header="Matches" Binding="{Binding MatchedCount}" Width="80" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Spending limits -->
                                    <Border Padding="14" Margin="0,14,0,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Spending limits" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,6"/>
                                            <TextBlock Text="Set a weekly cap per category. The Daily tab flags categories that are approaching or over the limit."
                                                       TextWrapping="Wrap" Foreground="#8B949E" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Category" Foreground="#8B949E"/>
                                                <TextBlock Grid.Column="1" Text="Weekly limit ($)" Foreground="#8B949E"/>
                                                <ComboBox Grid.Row="2" ItemsSource="{Binding TransactionRuleCategoryOptions}" SelectedItem="{Binding NewLimitCategory, Mode=TwoWay}" Margin="0,0,8,0"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewLimitAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                                <Button Grid.Row="2" Grid.Column="2" Content="Set limit" Style="{StaticResource SmallButton}" Background="#0F766E" Click="AddCategoryLimit_Click"/>
                                            </Grid>
                                            <DataGrid ItemsSource="{Binding CategoryLimits}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="150" PreviewMouseWheel="NestedDataGrid_PreviewMouseWheel">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" ElementStyle="{StaticResource WrappingCellText}"/>
                                                    <DataGridTextColumn Header="Weekly limit" Binding="{Binding WeeklyLimitDisplay}" Width="110" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                    <DataGridTemplateColumn Header="" Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Remove" FontSize="10" Height="22" Padding="4,0"
                                                                        Background="#7F1D1D" Foreground="#FCA5A5" BorderThickness="0"
                                                                        Cursor="Hand" Tag="{Binding Category}" Click="DeleteCategoryLimit_Click"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Transaction search -->
                                    <Border Padding="14" Margin="0,14,0,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Find transactions" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding TransactionSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,8,0" ToolTip="Search transaction descriptions (min 2 characters)"/>
                                                <Button Grid.Column="1" Content="Search" Style="{StaticResource SmallButton}" Click="SearchTransactions_Click"/>
                                            </Grid>
                                            <DataGrid ItemsSource="{Binding TransactionSearchResults}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="280" PreviewMouseWheel="NestedDataGrid_PreviewMouseWheel">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="100"/>
                                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource WrappingCellText}"/>
                                                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120"/>
                                                    <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="110"/>
                                                    <DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" Width="90" ElementStyle="{StaticResource RightAlignedCellText}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Import CSV -->
                                    <Border Padding="14" Margin="0,14,0,0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Import transactions from CSV" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,6"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="#8B949E" Margin="0,0,0,10"
                                                       Text="Import bank transactions exported from your bank. Headers are auto-detected — common column names like Date, Description, Amount, Debit, Credit are recognised."/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CsvFilePathBox" IsReadOnly="True" Margin="0,0,8,0" Foreground="#8B949E" ToolTip="Selected CSV file path"/>
                                                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SmallButton}" Click="BrowseCsvImport_Click"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Account:" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ComboBox x:Name="CsvImportAccountPicker" Grid.Column="1"
                                                          ItemsSource="{Binding Accounts}"
                                                          DisplayMemberPath="Name"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Import" Style="{StaticResource SmallButton}" Background="#0F766E" Click="ImportCsv_Click" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="CsvImportStatusLabel" Foreground="#8B949E" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Goals">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <Button Content="Add to budget" Style="{StaticResource SmallButton}" Background="#0F766E" Margin="0,0,8,0" Click="AddSavingsGoalToBudget_Click"/>
                                    <Button Content="Edit" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="EditSavingsGoal_Click"/>
                                    <Button Content="Delete" Style="{StaticResource SmallButton}" Background="#991B1B" Margin="0,0,8,0" Click="DeleteSavingsGoal_Click"/>
                                    <Button Content="Add" Style="{StaticResource SmallButton}" Background="#0F766E" Click="AddSavingsGoal_Click"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SavingsGoals}" SelectedItem="{Binding SelectedSavingsGoal}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="SavingsGoalsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Goal" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource WrappingCellText}"/>
                                        <DataGridTextColumn Header="Current" Binding="{Binding Current, StringFormat=C}" Width="100"/>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Target, StringFormat=C}" Width="100"/>
                                        <DataGridTextColumn Header="By" Binding="{Binding TargetDateDisplay}" Width="95"/>
                                        <DataGridTextColumn Header="Weekly" Binding="{Binding WeeklyContributionDisplay}" Width="95"/>
                                        <DataGridTextColumn Header="Progress" Binding="{Binding Progress, StringFormat=P0}" Width="85"/>
                                        <DataGridTextColumn Header="ETA" Binding="{Binding EstimatedTimeToGoal}" Width="120" ElementStyle="{StaticResource WrappingCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Daily">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,10,0,0">

                                    <!-- Week header -->
                                    <Border Padding="20,16" Margin="0,0,0,10" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WeekLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="Spent " Foreground="#6E7681" FontSize="13"/>
                                                    <TextBlock Text="{Binding PeriodTotalSpending, StringFormat={}{0:C}}" FontSize="13" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,10,0"/>
                                                    <TextBlock Text="unnecessary " Foreground="#6E7681" FontSize="13"/>
                                                    <TextBlock Text="{Binding PeriodUnnecessarySpending, StringFormat={}{0:C}}" FontSize="13" FontWeight="Bold" Foreground="#F87171"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding WeekOnWeekChangeDisplay}" FontSize="12"
                                                           Foreground="{Binding WeekOnWeekColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                           Margin="0,0,0,2"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding HasBudgetSetUp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="Safe to spend today: " Foreground="#6E7681" FontSize="12"/>
                                                    <TextBlock Text="{Binding SafeToSpendTodayDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#3FB950"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WeeklyGrade}" FontSize="36" FontWeight="Bold"
                                                           Foreground="{Binding WeeklyGradeColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                <TextBlock Text="{Binding WeeklyScore, StringFormat={}  {0}%}" FontSize="14" Foreground="#6E7681" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 7-day calendar strip -->
                                    <Border Padding="10,10" Margin="0,0,0,14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding WeekCalendarDays}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="7"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="3,0" Padding="6,8" CornerRadius="6"
                                                                Background="{Binding BackgroundHex, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="{Binding BorderHex, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderThickness="1">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding DayAbbrev}" FontSize="10" Foreground="#6E7681" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Grade}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,2"
                                                                           Foreground="{Binding GradeColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                <TextBlock Text="{Binding SpendingDisplay}" FontSize="9" Foreground="#6E7681" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding DailyTopCategories}" Margin="0,10,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,8,4" Padding="8,4" CornerRadius="4" Background="#0F172A"
                                                                BorderBrush="{Binding ChipColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" Foreground="#8B949E" FontSize="11" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding TotalDisplay}"
                                                                           Foreground="{Binding ChipColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                           FontSize="11" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding LimitSuffix}" Foreground="#6E7681" FontSize="10" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Month calendar -->
                                    <Border Padding="14,12" Margin="0,0,0,14" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="Past 35 Days" FontSize="11" FontWeight="SemiBold" Foreground="#6E7681" Margin="0,0,0,8"/>
                                            <!-- Day-of-week headers -->
                                            <UniformGrid Rows="1" Columns="7" Margin="0,0,0,3">
                                                <TextBlock Text="Mon" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Tue" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Wed" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Thu" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Fri" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Sat" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Sun" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
                                            </UniformGrid>
                                            <!-- Calendar cells -->
                                            <ItemsControl ItemsSource="{Binding MonthCalendarCells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="7"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="2" MinHeight="54" CornerRadius="5"
                                                                Background="{Binding BackgroundHex, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="{Binding BorderHex, Converter={StaticResource HexToBrushConverter}}"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <TextBlock Text="{Binding DayText}" FontSize="9" Foreground="#475569"
                                                                           VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4,3,0,0"/>
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                                                                    <TextBlock Text="{Binding Grade}" FontSize="13" FontWeight="Bold"
                                                                               Foreground="{Binding GradeColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                               HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding SpendingText}" FontSize="8" Foreground="#475569"
                                                                               HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Day cards -->
                                    <ItemsControl ItemsSource="{Binding DailyTrackerDays}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10"
                                                        Padding="18,14"
                                                        Background="#161B22"
                                                        BorderBrush="#30363D"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <StackPanel>
                                                        <!-- Day header -->
                                                        <Grid Margin="0,0,0,10">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DayLabel}" FontSize="16" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,0,10,0"/>
                                                                <TextBlock Text="{Binding DateLabel}" FontSize="12" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                                <Border CornerRadius="3" Background="#0D2E22" Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsCleanDay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="clean" Foreground="#3FB950" FontSize="10" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Border CornerRadius="3" Background="#2D1214" Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasUnnecessarySpending, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding UnnecessaryTotal, StringFormat=unnecessary: {0:C}}" Foreground="#F87171" FontSize="10" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SpendingTotal, StringFormat={}{0:C}}"
                                                                           FontSize="13" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <Border CornerRadius="4" Padding="7,3" VerticalAlignment="Center"
                                                                        Background="#0F172A"
                                                                        BorderBrush="{Binding DayScoreColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                        BorderThickness="1"
                                                                        Visibility="{Binding HasSpending, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding DayGrade}" FontSize="12" FontWeight="Bold"
                                                                               Foreground="{Binding DayScoreColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Bills due today -->
                                                        <ItemsControl ItemsSource="{Binding Bills}" Margin="0,0,0,4">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,3" Padding="10,6" CornerRadius="5"
                                                                            Background="{Binding CardBackground, Converter={StaticResource HexToBrushConverter}}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="📋 " FontSize="11"/>
                                                                                <TextBlock Text="{Binding Name}" Foreground="#F0883E" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:C}}" Foreground="#F0883E" FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
                                                                            <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                                                                       Text="{Binding PaidStatusLabel}"
                                                                                       Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Transactions -->
                                                        <ItemsControl ItemsSource="{Binding Transactions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,3" Padding="10,8" CornerRadius="6" Background="#0D1117"
                                                                            BorderThickness="3,0,0,0"
                                                                            BorderBrush="{Binding LeftBorderColorHex, Converter={StaticResource HexToBrushConverter}}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="26"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding DisplayDescription}" Foreground="#E6EDF3" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                    <Border CornerRadius="3" Background="#1C1710" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                            Visibility="{Binding IsBillPayment, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <TextBlock Text="bill" Foreground="#F0883E" FontSize="9" FontWeight="SemiBold"/>
                                                                                    </Border>
                                                                                    <Border CornerRadius="3" Background="#0D2E1A" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                            Visibility="{Binding IsIncome, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <TextBlock Text="income" Foreground="#3FB950" FontSize="9" FontWeight="SemiBold"/>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                <TextBlock Text="{Binding CategoryName}" Foreground="#6E7681" FontSize="11" Margin="0,2,0,0"/>
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding SpendingAmountDisplay}"
                                                                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                                                                       Foreground="{Binding AmountColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                                       Margin="10,0,0,0"/>
                                                                            <Button Grid.Column="2"
                                                                                    Width="22" Height="22"
                                                                                    Margin="4,0,0,0"
                                                                                    VerticalAlignment="Center"
                                                                                    FontSize="11"
                                                                                    Content="{Binding NecessaryDot}"
                                                                                    Foreground="{Binding NecessaryColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                    Background="Transparent"
                                                                                    BorderBrush="{Binding NecessaryColor, Converter={StaticResource HexToBrushConverter}}"
                                                                                    BorderThickness="1"
                                                                                    Cursor="Hand"
                                                                                    Tag="{Binding Id}"
                                                                                    ToolTip="{Binding NecessaryLabel}"
                                                                                    Visibility="{Binding IsSpending, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                    Click="ToggleUnnecessary_Click"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Text="No activity today."
                                                                   Foreground="#334155"
                                                                   FontSize="12"
                                                                   Margin="0,4,0,0"
                                                                   Visibility="{Binding HasAnyActivity, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
