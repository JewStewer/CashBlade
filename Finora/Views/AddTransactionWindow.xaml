<Window x:Class="Finora.Views.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Add Transaction"
        Height="560"
        Width="460"
        MinHeight="560"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Border Margin="18"
            Padding="22"
            Background="White"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add Transaction"
                   x:Name="HeaderText"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Date"/>
        <DatePicker Grid.Row="2"
                    x:Name="DatePicker"
                    SelectedDate="{x:Static sys:DateTime.Today}"
                    Margin="0,4,0,12"/>

        <TextBlock Grid.Row="3" Text="Description"/>
        <TextBox Grid.Row="4"
                 x:Name="DescriptionBox"
                 Margin="0,4,0,12"/>

        <StackPanel Grid.Row="5">
            <TextBlock Text="Transaction Type"/>

            <ComboBox x:Name="TransactionTypeBox"
          Margin="0,4,0,12"
          SelectedIndex="0"
          SelectionChanged="TransactionTypeBox_SelectionChanged">

                <ComboBoxItem Content="Expense"/>
                <ComboBoxItem Content="Income"/>

            </ComboBox>

            <TextBlock Text="Amount"/>

            <TextBox x:Name="AmountBox"
         Margin="0,4,0,12"/>

            <TextBlock Text="Account"/>
            <ComboBox x:Name="AccountBox"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      Margin="0,4,0,12"/>

            <TextBlock Text="Category"/>
            <ComboBox x:Name="CategoryBox"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      Margin="0,4,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Save"
                    Width="90"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
