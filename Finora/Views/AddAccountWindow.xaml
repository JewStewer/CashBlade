<Window x:Class="Finora.Views.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Finora.Converters"
        Title="Account"
        Height="720"
        Width="460"
        MinHeight="620"
        MinWidth="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Window.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Margin="18"
            Padding="22"
            Background="White"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText"
                       Text="Add Account"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Margin="0,0,0,18"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Account name" Foreground="#334155"/>
                <TextBox x:Name="NameBox"
                         Height="36"
                         Margin="0,5,0,0"
                         Padding="9,6"
                         BorderBrush="#CBD5E1"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Account type" Foreground="#334155"/>
                <ComboBox x:Name="TypeBox"
                          Height="36"
                          Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock x:Name="BalanceLabel" Text="Opening balance" Foreground="#334155"/>
                <TextBox x:Name="BalanceBox"
                         Height="36"
                         Margin="0,5,0,0"
                         Padding="9,6"
                         BorderBrush="#CBD5E1"
                         Text="0.00"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Colour" Foreground="#334155"/>
                <ComboBox x:Name="ColorBox"
                          Height="40"
                          Margin="0,5,0,0"
                          SelectedValuePath="Hex">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="18"
                                        Height="18"
                                        CornerRadius="3"
                                        Margin="0,0,8,0"
                                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,12">
                <TextBlock Text="Target amount" Foreground="#334155"/>
                <TextBox x:Name="TargetAmountBox"
                         Height="36"
                         Margin="0,5,0,0"
                         Padding="9,6"
                         BorderBrush="#CBD5E1"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,0,0,12">
                <TextBlock Text="Target date" Foreground="#334155"/>
                <DatePicker x:Name="TargetDatePicker"
                            Height="36"
                            Margin="0,5,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="7"
                       x:Name="HelpText"
                       Text="Leave target amount blank if this account does not need a target."
                       TextWrapping="Wrap"
                       Foreground="#64748B"/>

            <Button x:Name="AddToBudgetButton"
                    Grid.Row="7"
                    Content="＋ Add to budget"
                    Height="32"
                    Margin="0,10,0,0"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Background="#0F766E"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="12,0"
                    Visibility="Collapsed"
                    Click="AddToBudget_Click"/>

            <StackPanel Grid.Row="8"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Cancel"
                        Width="94"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Save"
                        Width="94"
                        Height="36"
                        Click="Save_Click"
                        Background="#0F766E"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
    </ScrollViewer>
</Window>
