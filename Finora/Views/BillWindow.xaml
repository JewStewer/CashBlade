<Window x:Class="Finora.Views.BillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Bill"
        Height="680"
        Width="460"
        MinHeight="620"
        MinWidth="460"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Margin="18"
            Padding="22"
            Background="White"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderText"
                       Text="Add Bill"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Margin="0,0,0,18"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Bill name" Foreground="#334155"/>
                <TextBox x:Name="NameBox" Height="36" Margin="0,5,0,0" Padding="9,6"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Account" Foreground="#334155"/>
                <ComboBox x:Name="AccountBox"
                          Height="36"
                          Margin="0,5,0,0"
                          SelectedValuePath="Id">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="Amount" Foreground="#334155"/>
                <TextBox x:Name="AmountBox" Height="36" Margin="0,5,0,0" Padding="9,6"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Linked debt" Foreground="#334155"/>
                <ComboBox x:Name="DebtBox"
                          Height="36"
                          Margin="0,5,0,0"
                          SelectedValuePath="Id">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,12">
                <TextBlock Text="Due date" Foreground="#334155"/>
                <DatePicker x:Name="DueDatePicker"
                            Height="36"
                            Margin="0,5,0,0"
                            SelectedDate="{x:Static sys:DateTime.Today}"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,0,0,12">
                <TextBlock Text="Frequency" Foreground="#334155"/>
                <ComboBox x:Name="FrequencyBox" Height="36" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox x:Name="PaidBox"
                          Content="Paid"
                          Foreground="#334155"
                          Margin="0,0,20,0"/>
                <CheckBox x:Name="AutoPayBox"
                          Content="Auto-pay (direct debit)"
                          Foreground="#334155"/>
            </StackPanel>

            <StackPanel Grid.Row="8" Margin="0,0,0,12">
                <TextBlock Text="Payment match text" Foreground="#334155"/>
                <TextBox x:Name="PaymentMatchTextBox"
                         Height="36"
                         Margin="0,5,0,0"
                         Padding="9,6"
                         ToolTip="Optional text that can appear on payments for this bill"/>
            </StackPanel>

            <TextBlock Grid.Row="9"
                       Text="If the due date is before the next payday, Cashglade counts any shortfall as money needed right now."
                       TextWrapping="Wrap"
                       Foreground="#64748B"
                       Margin="0,4,0,0"/>

            <StackPanel Grid.Row="10"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Cancel"
                        Width="94"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Save"
                        Width="94"
                        Height="36"
                        Click="Save_Click"
                        Background="#0F766E"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
    </ScrollViewer>
</Window>
